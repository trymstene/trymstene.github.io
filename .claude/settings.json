{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/guard-copy.mjs",
            "timeout": 10,
            "statusMessage": "guarding the approved copy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/check-all.mjs --quiet",
            "timeout": 60,
            "statusMessage": "checking the gates"
          }
        ]
      }
    ]
  }
}
