---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nana from '../components/Nana.astro';
import PixelIcon from '../components/PixelIcon.astro';
import PixelArtIcon from '../components/PixelArtIcon.astro';
import { PATCHES } from '../lib/pass-defs.js';

const title = 'Your Banana Pass — badges, shelf and stats';
const description = 'Your membership card to the banana world: the badges you have earned, your creations, and your nights on the dance floor. Log in with your email — no password to remember.';

// 🔢 THE NUMBERS PANE, SERVER-RENDERED. Labels and earn-hints live here as HTML
// because the pass JS budget counts only the script chunk — a string in the
// markup is free, the same string in a JS array is not.
// `data-stat` is the pass stat key (the script overrides a handful by name),
// `free` = a number everyone has (never proof that a stat moved),
// `noshare` = never picked for the share card's proud one-liner.
const NUMBERS = [
  { k: 'level',   free: 1, noshare: 1, label: 'level',             hint: 'XP from anywhere in the world levels you up' },
  { k: 'rep',     noshare: 1,          label: 'XP',                hint: 'every area of Banana World pays it' },
  { k: 'coins',                        label: 'bananacoins',       hint: 'the floor, the park and the beach all pay' },
  { k: 'raveMin',                      label: 'rave minutes',      hint: 'time spent on the dance floor' },
  { k: 'builds',                       label: 'bananas built',     hint: 'build one in the workshop and take it home' },
  { k: 'forges',                       label: 'emojis forged',     hint: 'draw one from raw pixels in the forge' },
  { k: 'items',                        label: 'items made',        hint: 'make a wearable at the Items Workshop' },
  { k: 'badges',                       label: 'badges earned',     hint: 'moments, not points — they hide everywhere' },
  { k: 'drops',                        label: 'drops survived',    hint: 'stay standing when the DJ drops the floor' },
  { k: 'jelly',                        label: 'jelly collected',   hint: 'grab the jelly that flies off the stage' },
  { k: 'hypes',                        label: 'jelly times',       hint: 'fill the meter and drop the floor yourself' },
  { k: 'fives',                        label: 'fistbumps',         hint: 'bump another banana on the floor' },
  { k: 'beers',                        label: 'happy hours won',   hint: 'be first to the bar when Barty calls it' },
  { k: 'vinyls',                       label: 'records delivered', hint: 'run a lost record back up to the DJ' },
  { k: 'days',    free: 1,             label: 'days on the pass',  hint: 'come back another day' },
];
---
<BaseLayout
  title={title}
  description={description}
  ogTitle="Your Banana Pass 🎫"
  ogDescription="Badges, creations and rave nights — your membership card to the banana world."
  robots="noindex"
>
  <style is:inline slot="head">
    /* ⚠️ ONE GUARD FOR THE WHOLE PAGE. `[hidden]` and a class have the same
       specificity, so any `display:` rule written later silently un-hides the
       element — which is how an empty code box shipped saying "type this on the
       other device" before a code existed. Bitten four times; ends here. */
    [hidden] { display: none !important; }
    .ps-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* ── THE SPINE (29 Sep 2026, Trym: "it looks a bit cramped, small text, not much space … the gui need to breathe more on
       desktop and mobile … categorize the information better and make it less cluttery"). ONE column, in the markup's own
       reading order, on every screen: the card, the lines under it, your account, the news, your things behind three tabs,
       the membership, where to next, the newsletter. A laptop gets the same column, wider: its old rail beside a body
       crammed the tabs, the membership, the doors and the account into one 320-px strip. Nothing is re-ordered with CSS
       (§46: a block with no place in an `order` list jumps above the card), nothing outside the card is set under 12 px
       and no running text under 14 (§48), and the sections stand 24–32 px apart. */
    .ps-wrap {
      --ps-muted: rgba(17, 17, 17, 0.72);
      max-width: 920px; margin: 0 auto; padding: 1rem 1rem 3rem;
      display: flex; flex-direction: column; gap: 1.5rem;
    }
    .ps-wrap > section, .ps-wrap > details, .ps-wrap > div { min-width: 0; }

    /* ── THE CARD — the page header. ONE size: the thing on screen IS the
       keepsake, and the PNG people share is the same document. ── */
    .ps-card {
      position: relative; cursor: pointer; overflow: hidden;   /* the sunburst stays inside the frame */
      background: var(--banana); border: var(--line); box-shadow: var(--shadow-sm);
    }
    /* the busy strip sits directly under the card's black header, full width,
       and pushes nothing around when it appears (the card is position:relative
       and clips, so an absolute bar cannot shift the layout under the reader) */
    .ps-finish {
      position: absolute; left: 0; right: 0; top: 0; z-index: 4;
      background: var(--banana); color: var(--ink); border-bottom: 3px solid var(--ink);
      padding: 0.7rem 0.8rem 0.75rem; display: grid; gap: 0.5rem; justify-items: start;
    }
    .ps-finish__line { margin: 0; font-size: 0.92rem; line-height: 1.3; }
    .ps-finish__go { white-space: nowrap; }
    .ps-finish__alt { margin: 0; font-size: 0.74rem; line-height: 1.4; opacity: 0.85; }
    .ps-finish__copy {
      appearance: none; background: none; border: 0; padding: 0; font: inherit; font-weight: 800;
      color: inherit; text-decoration: underline; cursor: pointer;
    }
    .ps-signing {
      position: absolute; left: 0; right: 0; top: 0; z-index: 3;
      display: flex; align-items: center; gap: 0.5rem;
      background: var(--ink); color: var(--banana);
      padding: 0.42rem 0.7rem; font-size: 0.6rem; font-weight: 800;
      letter-spacing: 0.09em; text-transform: uppercase;
    }
    .ps-signing__bar {
      flex: 0 0 auto; width: 46px; height: 6px; border-radius: 999px;
      background: rgba(255, 225, 53, 0.25); overflow: hidden; position: relative;
    }
    .ps-signing__bar::after {
      content: ''; position: absolute; inset: 0 auto 0 0; width: 45%;
      border-radius: 999px; background: var(--banana);
      animation: ps-sweep 1.1s ease-in-out infinite;
    }
    @keyframes ps-sweep { 0% { left: -45%; } 100% { left: 100%; } }
    /* ⚠️ a moving bar with nothing to say is worse than a still one */
    @media (prefers-reduced-motion: reduce) {
      .ps-signing__bar::after { animation: none; left: 0; width: 100%; opacity: 0.6; }
    }
    .ps-card__head {
      position: relative; z-index: 1;   /* the sunburst is positioned, so the strip must out-rank it */
      display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
      /* ⚠️ NO MARGIN: inset by 5px this read as a black stripe placed ON the
         card. It is part OF the pass — it runs to all three edges, under the
         card's own border, the way the printed header does. */
      background: var(--ink); color: var(--banana); padding: 0.42rem 0.7rem;
      font-size: 0.56rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase;
      white-space: nowrap; overflow: hidden;
    }
    .ps-card__hole { flex: none; width: 11px; height: 11px; border-radius: 50%; background: var(--paper); box-shadow: 0 0 0 3px var(--banana); }
    /* the banana rides the RIGHT with a sunburst behind it and a friendly +8°
       lean — the same composition as the shared PNG, which is the document
       people actually show each other. */
    .ps-card__body {
      display: flex; gap: 0.6rem; padding: 0.3rem 0.65rem 0;
      align-items: center; flex-direction: row-reverse;
    }
    .ps-card__sig { position: relative; flex: none; width: 118px; height: 118px; }
    .ps-card__sig::before {
      content: ''; position: absolute; left: 50%; top: 52%; width: 260px; height: 260px;
      transform: translate(-50%, -50%);
      background: repeating-conic-gradient(from 0deg, rgba(255, 253, 245, 0.55) 0deg 14deg, transparent 14deg 30deg);
      -webkit-mask-image: radial-gradient(circle, #000 38%, transparent 72%);
      mask-image: radial-gradient(circle, #000 38%, transparent 72%);
      pointer-events: none;
    }
    .ps-card__sig canvas {
      position: relative; display: block; width: 118px; height: 118px;
      image-rendering: pixelated; transform: rotate(8deg);
    }
    /* the zero state: an empty frame is a stronger door than a banana you did
       not make wearing an OFFICIAL stamp */
    .ps-card__slot {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      text-align: center; text-decoration: none; font-size: 0.66rem; font-weight: 800;
      line-height: 1.3; padding: 0.3rem; color: rgba(17, 17, 17, 0.7);
      border: 3px dashed rgba(17, 17, 17, 0.4);
    }
    .ps-card__meta { min-width: 0; flex: 1; }
    .ps-card__name {
      font-family: "Archivo Black", sans-serif; font-size: 1.15rem; line-height: 1.1;
      margin: 0; min-width: 0; color: var(--ink); overflow-wrap: anywhere;
      display: flex; align-items: center; gap: 0.1rem;
    }
    /* ✏️ NAME YOUR BANANA is one of the page's named jobs — it gets a real 44px
       target, not a 20px pencil glyph. */
    .ps-nameedit {
      flex: none; width: 44px; height: 44px; display: grid; place-items: center;
      border: 0; background: none; cursor: pointer; color: var(--ink); opacity: 0.55; padding: 0;
    }
    .ps-nameedit:hover, .ps-nameedit:focus-visible { opacity: 1; }
    #psNameInput { font: inherit; font-size: 1rem; width: 100%; background: #fffdf5; border: 3px solid var(--ink); padding: 0.1rem 0.35rem; }
    .ps-card__since { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; opacity: 0.75; margin: 0 0 0.25rem; }
    .ps-rankchip { display: inline-block; background: var(--ink); color: var(--banana); font-weight: 800; font-size: 0.7rem; padding: 0.2rem 0.45rem; }
    .ps-rankbar { display: block; height: 6px; background: rgba(17, 17, 17, 0.22); max-width: 200px; margin: 4px 0 1px; }
    .ps-rankbar i { display: block; height: 100%; background: var(--ink); }
    .ps-ranknote { display: block; font-size: 0.58rem; font-weight: 700; line-height: 1.35; opacity: 0.7; }
    /* the lines under the card belong to it: tucked up close, then the page's own spacing resumes */
    .ps-under { display: grid; gap: 0.45rem; margin-top: -0.5rem; }
    .ps-week { margin: 0; font-size: 1rem; line-height: 1.5; }   /* aligned as the promise above it is: left here, centred at 900 */
    .ps-week a { font-weight: 700; white-space: nowrap; }   /* the ask moves down whole, never "Log in to get / nominated" */
    /* ✦ a sparkle, not the Citizen's frame: at 16 px the frame read as an empty checkbox (and a plaque's own badge is no
       better inline — the Farmer's is the three-bar "burger", a menu button). PixelIcon writes its size inline, so this
       only states it */
    .ps-week svg { vertical-align: -3px; margin-right: 0.15rem; }
    .ps-card__blabel {
      margin: 0.4rem 0 0.22rem; font-size: 0.52rem; font-weight: 800;
      letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7;
    }
    .ps-card__patches { display: flex; gap: 0.3rem; flex-wrap: wrap; padding: 0; line-height: 1; }
    .ps-card__more {
      display: grid; place-items: center; min-width: 28px; height: 28px; padding: 0 4px;
      background: var(--ink); color: var(--banana); font-size: 0.62rem; font-weight: 800;
      box-shadow: 2px 2px 0 var(--ink);
    }
    .ps-card__stats {
      margin: 0.45rem 0 0; font-size: 0.56rem; font-weight: 800; letter-spacing: 0.03em;
      text-transform: uppercase; line-height: 1.4; max-width: calc(100% - 78px);
    }
    .ps-card__stats span { white-space: nowrap;
    }
    /* ⚠️ the strip clones the pane's badge svgs, and PixelIcon writes its size as
       an INLINE style — a class rule loses to it, so the shrink must shout. */
    .ps-card__patches svg { display: block; width: 28px !important; height: 28px !important; background: #fffdf5; border: 2px solid var(--ink); box-shadow: 2px 2px 0 var(--ink); padding: 3px; }
    .ps-card__patches span { font-size: 0.66rem; opacity: 0.62; align-self: center; }
    .ps-card__foot {
      display: flex; align-items: center; gap: 0.5rem; padding: 0 0.65rem 0.1rem;
      max-width: calc(100% - 100px);   /* the stamp's corner is not the foot's to use */
    }
    #psBarcode { display: block; height: 20px; width: 96px; flex: none; }
    .ps-serial { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.04em; white-space: nowrap; }
    /* ⚠️ NOT pushed to the right edge: the OFFICIAL stamp owns that corner (it
       sits over the banana, like the shared PNG), and a share control tucked
       under a rotated red box read as a broken checkbox. */
    .ps-card__share {
      display: inline-flex; align-items: center; gap: 0.35rem;
      min-height: 44px; padding: 0 0.6rem; font: inherit; font-size: 0.72rem; font-weight: 800;
      background: none; border: 0; cursor: pointer; color: var(--ink); white-space: nowrap;
    }
    .ps-card__share:hover { text-decoration: underline; text-underline-offset: 3px; }
    .ps-stamp {
      position: absolute; right: 12px; bottom: 62px; transform: rotate(-8deg);   /* over the banana's feet, clear of the foot row */
      border: 3px solid #e22020; color: #e22020; padding: 2px 9px; opacity: 0.85;
      font-family: "Archivo Black", sans-serif; font-size: 0.8rem; letter-spacing: 0.04em;
      pointer-events: none;
    }
    .ps-stamp::before { content: ''; position: absolute; inset: 2px; border: 2px solid #e22020; }
    /* 🎫 the magic link has to PAY OFF: coming back signed in stamps the card */
    .ps-card--stamped .ps-stamp { animation: psStamp 0.5s ease-out; }
    @keyframes psStamp { from { transform: rotate(-8deg) scale(3); opacity: 0; } 60% { opacity: 1; } to { transform: rotate(-8deg) scale(1); opacity: 0.85; } }
    @media (prefers-reduced-motion: reduce) { .ps-card--stamped .ps-stamp { animation: none; } }

    .ps-promise { margin: 0; font-size: 0.9rem; line-height: 1.5; color: var(--ps-muted); }

    /* ── A SECTION'S HEAD: the one heading grammar under the card — a black-letter title, a count or a word of help beside
       it. (The card keeps its own small print: it is a document, and its type is part of the look.) ── */
    .ps-h { margin: 0; font-family: "Archivo Black", sans-serif; font-size: 1.2rem; line-height: 1.2; display: flex; align-items: center; gap: 0.55rem; }
    .ps-h .pai { width: 22px; height: 22px; }

    /* 💛 the support block — the world's card furniture, tier-tinted */
    .ps-sup { border: 3px solid var(--ink); box-shadow: var(--shadow-sm); background: #fffdf5; padding: 1.1rem 1.2rem 1.2rem; }
    .ps-sup__head { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.6rem; }
    .ps-sup__hat { image-rendering: pixelated; height: 40px; width: auto; }
    .ps-sup__kicker { margin: 0; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ps-muted); }
    .ps-sup__tier { margin: 0; font-family: "Archivo Black", sans-serif; font-size: 1.2rem; }
    .ps-sup__meta { margin: 0 0 1rem; font-size: 0.95rem; line-height: 1.55; }
    .ps-sup__acts { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; }
    .ps-sup__manage {
      background: var(--banana); color: var(--ink); font-weight: 800; font-size: 0.95rem; min-height: 44px;
      text-decoration: none; padding: 0.55rem 1rem; border: 3px solid var(--ink);
      box-shadow: 3px 3px 0 var(--ink); white-space: nowrap;
    }
    .ps-sup__manage:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
    .ps-sup__wall { font-size: 0.95rem; font-weight: 700; }
    button.ps-sup__manage { font: inherit; font-weight: 800; font-size: 0.95rem; cursor: pointer; }
    .ps-sup__ask { margin-top: 1rem; border-top: 2px dashed var(--ink); padding-top: 0.9rem; }
    .ps-sup__askt { margin: 0 0 0.75rem; font-size: 0.95rem; line-height: 1.55; }
    .ps-sup__why { display: block; font-size: 0.875rem; font-weight: 700; margin-bottom: 0.85rem; }
    .ps-sup__why small { font-weight: 400; color: var(--ps-muted); }
    .ps-sup__why select { display: block; margin-top: 0.35rem; font: inherit; font-size: 0.95rem; padding: 0.45rem; border: 2px solid var(--ink); background: #fff; max-width: 100%; }
    .ps-sup__askrow { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .ps-sup__yes, .ps-sup__no {
      font: inherit; font-weight: 800; font-size: 0.95rem; cursor: pointer; min-height: 44px;
      padding: 0.5rem 1rem; border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink);
    }
    .ps-sup__yes { background: #fffdf5; }
    .ps-sup__no { background: var(--banana); }
    .ps-sup__yes:active, .ps-sup__no:active, button.ps-sup__manage:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
    .ps-sup__note { margin: 0.8rem 0 0; font-size: 0.95rem; line-height: 1.5; font-weight: 700; }
    .ps-sup--ending { background: #fff6e0; }
    .ps-sup__miss { margin: 0.8rem 0 0; font-size: 0.875rem; line-height: 1.55; color: var(--ps-muted); }

    /* ── NEWS FOR YOU — verdicts on YOUR stuff, never system chatter. Renders
       only when there is something to say (anti-fatigue). ── */
    .ps-news { display: grid; gap: 0.8rem; }
    #psNotices { display: grid; gap: 0.7rem; }
    #psNotices:empty { display: none; }
    .ps-pendingline { font-size: 0.95rem; line-height: 1.5; color: var(--ps-muted); margin: 0; }
    .ps-notice {
      display: flex; gap: 0.8rem; align-items: flex-start; cursor: pointer;
      border: 3px solid var(--ink); background: var(--paper); box-shadow: var(--shadow-sm);
      padding: 0.8rem 1rem;
    }
    .ps-notice--unread { background: var(--banana); }
    .ps-notice__icon { flex: none; font-size: 1.3rem; line-height: 1.35; }
    .ps-notice__main { min-width: 0; flex: 1; }
    .ps-notice__side { flex: none; text-align: right; }
    /* ⚠️ CLAMPED ON PURPOSE. Unread notices are unbounded, and every line of
       them pushes the tabs — the route to the rest of the page — off the
       first screen. Two lines, then tap the notice for the whole thing. */
    .ps-notice__body { font-size: 0.95rem; line-height: 1.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .ps-notice--open .ps-notice__body { display: block; }
    .ps-notice__date { display: block; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ps-muted); white-space: nowrap; }
    .ps-notice__side::after { content: '▾'; display: block; font-size: 0.85rem; font-weight: 800; color: var(--ps-muted); }
    .ps-notice--open .ps-notice__side::after { content: '▴'; }
    /* 🗞 news already read waits behind one row instead of standing on the page for ever */
    .ps-news__old > summary { display: flex; align-items: center; gap: 0.5rem; min-height: 44px; cursor: pointer; font-size: 0.95rem; font-weight: 800; list-style: none; color: var(--ps-muted); }
    .ps-news__old > summary::-webkit-details-marker { display: none; }
    .ps-news__old > summary::after { content: '▾'; }
    .ps-news__old[open] > summary::after { content: '▴'; }
    .ps-news__old > div { display: grid; gap: 0.7rem; margin-top: 0.4rem; }
    .ps-news__old .ps-notice { box-shadow: none; }

    /* 📣 THE ASK — the newsletter, at the FOOT of the page: never the first thing a newcomer meets and nowhere near the login,
       so consent is never bundled with the thing they came for. Its own form, its own double opt-in. */
    .ps-ask { border-top: 3px dashed rgba(17, 17, 17, 0.2); padding-top: 0.5rem; }
    .ps-ask__row { display: flex; align-items: center; gap: 0.55rem; min-height: 52px; cursor: pointer; font-size: 1rem; font-weight: 800; list-style: none; }
    .ps-ask__row::-webkit-details-marker { display: none; }
    .ps-ask__row::after { content: ' ▾'; margin-left: auto; color: var(--ps-muted); }
    .ps-ask[open] .ps-ask__row::after { content: ' ▴'; }
    .ps-ask form { display: grid; gap: 0.7rem; padding: 0.2rem 0 0.4rem; }
    .ps-ask p { margin: 0; font-size: 0.95rem; line-height: 1.55; }
    .ps-ask__note { font-size: 0.875rem !important; color: var(--ps-muted); }
    .ps-ask__note:empty { display: none; }

    /* ── YOUR THINGS: three tabs over three panes. The tabs are one joined control across the column — the page's main
       navigation, so they are big, labelled and iconed. `flex: 1 1 0` + `min-width: 0` keep all three on one row at
       320 px; a label never wraps. ── */
    .ps-things { display: grid; gap: 1.25rem; }
    .ps-nav { display: flex; border: 3px solid var(--ink); box-shadow: var(--shadow-sm); background: var(--paper); }
    .ps-tab {
      flex: 1 1 0; min-width: 0; min-height: 58px; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      font: inherit; font-weight: 800; font-size: 1rem; cursor: pointer; background: transparent; color: var(--ink);
      border: 0; border-left: 3px solid var(--ink); padding: 0.4rem 0.5rem; overflow: hidden;
    }
    .ps-tab:first-child { border-left: 0; }
    .ps-tab .pai { width: 22px; height: 22px; }
    .ps-tab[aria-selected="true"] { background: var(--banana); }
    .ps-tab:not([aria-selected="true"]):hover { background: rgba(255, 225, 53, 0.3); }
    .ps-tab:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; position: relative; z-index: 1; }

    .ps-pane__h { margin: 0; font-family: "Archivo Black", sans-serif; font-size: 1.2rem; line-height: 1.25; }
    /* ⚠️ the pane's rhythm out-ranks the heading's `margin: 0` (one class each, and the later rule won: the heading sat on
       the chips and its grid on the heading) — a pane's blocks stand 16 px apart, a heading 10 px over what it names */
    .ps-wrap .ps-pane > * + * { margin-top: 1rem; }
    .ps-wrap .ps-pane__h + *, .ps-wrap .ps-pane__h + .ps-note + * { margin-top: 0.65rem; }
    .ps-wrap #psLiveBlock { margin-top: 1.75rem; }
    .ps-note { margin: 0.35rem 0 0; font-size: 0.95rem; line-height: 1.5; color: var(--ps-muted); }
    .ps-count { font-family: "Space Grotesk", sans-serif; font-weight: 700; color: var(--ps-muted); margin-left: 0.15rem; }
    /* filter chips — the same grammar in both panes */
    .ps-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .ps-chip {
      min-height: 44px; padding: 0 1rem; font: inherit; font-weight: 800; font-size: 0.95rem;
      cursor: pointer; background: var(--paper); color: var(--ink); border: 3px solid var(--ink);
      box-shadow: 3px 3px 0 var(--ink);
    }
    .ps-chip[aria-pressed="true"] { background: var(--banana); }
    .ps-chip:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }

    /* ── THE DOORS — the world's "where to?" row grammar (see /dev/design/):
       yellow slab, icon, bold name, arrow hard right. Side by side where they fit. ── */
    .ps-next { display: grid; gap: 0.8rem; }
    .ps-doors { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
    .ps-door {
      display: flex; align-items: center; gap: 0.8rem; min-height: 60px; padding: 0.6rem 1rem;
      text-decoration: none; color: var(--ink); background: var(--banana);
      border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink);
    }
    /* one 38 px slot for every door's picture: OUR banana is 38, the icons 24, and the words start on one line */
    .ps-door > .pxi, .ps-door > .nana-mark { flex: 0 0 38px; }
    .ps-door b { font-size: 1rem; }
    .ps-door span { margin-left: auto; font-size: 1.1rem; font-weight: 800; }
    .ps-door:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
    .ps-door--out { background: var(--paper); }

    /* ── THE SHELF ── */
    /* 🏷 a published item: art, what it is called, what state it is in, and
       one (...) that holds everything you can do to it. No card border — the
       pane already has edges and a row inside a card inside a pane is the
       third box (design library, "boxes"). A single rule separates them. */
    .ps-live { display: flex; align-items: center; gap: 0.9rem; padding: 0.85rem 0.2rem; border-top: 2px solid var(--ps-line, rgba(17,17,17,0.12)); }
    .ps-live:first-child { border-top: 0; }
    .ps-live__art { width: 64px; height: 64px; flex: none; image-rendering: pixelated; background: var(--paper, #faf6ee); border: 2px solid var(--ink, #111); }
    .ps-live__art--gone { opacity: 0.4; }
    .ps-live__t { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
    .ps-live__name { font-weight: 800; font-size: 1rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ps-live__state { font-size: 0.875rem; font-weight: 700; color: var(--ps-muted); }
    /* the one number on this row that is a reward, so it is not the quiet grey
       the state line is — a value is never quieter than its own label */
    .ps-live__have { font-size: 0.9rem; font-weight: 800; color: var(--ink, #111); }
    /* 44px, because a 20px dotted glyph is a miss on a phone and 85% of this
       world is on one */
    .ps-live__more { flex: none; width: 44px; height: 44px; display: grid; place-items: center; font: inherit; font-size: 1.3rem; font-weight: 800; line-height: 1; cursor: pointer; background: none; border: 2px solid transparent; border-radius: 10px; }
    .ps-live__more:hover { border-color: var(--ink, #111); }
    .ps-live__more:focus-visible { outline: 3px solid var(--ink, #111); outline-offset: 2px; }
    .ps-live__menu { display: flex; flex-direction: column; gap: 0.35rem; padding: 0 0.2rem 0.8rem; }
    /* ⚠️ justify-content, not text-align — text-align does nothing to a flex
       child. And the override below is needed on top of it: the site centres
       ANY button whose first child is a pixel icon
       (`:where(.btn, a, button, summary, label):has(> .pai:first-child)`),
       which is right for a standalone button and wrong for a vertical list of
       choices, read down one left edge. `:has()` lends that rule its argument's
       specificity, so it outranks a plain class+type selector — beaten here by
       adding the id, not by !important. */
    #psLiveBlock .ps-live__menu button { justify-content: flex-start; }
    .ps-live__menu button { font: inherit; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 0.55rem; padding: 0.55rem 0.7rem; min-height: 44px; background: var(--paper, #faf6ee); color: var(--ink, #111); border: 3px solid var(--ink, #111); box-shadow: 3px 3px 0 var(--ink, #111); }
    .ps-live__menu button:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink, #111); }
    .ps-live__vers { display: flex; gap: 0.6rem; flex-wrap: wrap; padding: 0 0.2rem 0.9rem; }
    .ps-live__ver { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; font-size: 0.75rem; font-weight: 800; color: var(--ps-muted); }
    .ps-live__ver canvas { width: 64px; height: 64px; image-rendering: pixelated; background: var(--paper, #faf6ee); border: 2px solid var(--ink, #111); }
    /* the shelf fills the column: tiles share its width (never a ragged row of fixed boxes), 3 across on a phone */
    .ps-shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 0.9rem; }
    .shelf-empty { font-size: 0.95rem; color: var(--ps-muted); margin: 0; }
    .shelf-item { position: relative; border: 3px solid var(--ink); background: var(--paper); box-shadow: var(--shadow-sm); cursor: pointer; padding-bottom: 44px; }
    .shelf-item canvas { display: block; width: 100%; height: auto; aspect-ratio: 1; image-rendering: pixelated; }
    /* 🛍 THE ASK AT THE LAST CLICK, ON THE ITEM — a labelled 44px button in the
       tile's foot, never a bare 🏷 glyph ([[cro-placement-doctrine]]). */
    .shelf-tag {
      position: absolute; left: 0; right: 0; bottom: 0; width: auto; height: 44px;
      display: flex; align-items: center; justify-content: center; gap: 0.25rem;
      font-size: 0.75rem; font-weight: 800; text-decoration: none; border: 0; white-space: nowrap;
      background: var(--ink); color: var(--banana); border-top: 3px solid var(--ink);
    }
    .shelf-tag:hover { transform: none; background: var(--hot, #ff4d6d); color: #fff; }
    .shelf-tag svg { width: 13px; height: 13px; }
    /* housekeeping is a VETERAN act: a real 44px hit area, a quiet glyph — it
       must not be the loudest thing on the work they are proudest of */
    .shelf-x {
      position: absolute; top: 0; right: 0; width: 44px; height: 44px; padding: 0 0 12px 12px;
      line-height: 1; background: none; color: rgba(17, 17, 17, 0.35); border: 0;
      font-weight: 800; font-size: 1.1rem; cursor: pointer;
    }
    .shelf-x:hover, .shelf-x:focus-visible { color: var(--hot, #ff4d6d); }

    /* the closet: earned wearables a banana models; unearned = grey silhouette,
       so the closet doubles as a feature map. Earned first, in CSS. */
    /* ── THE CLOSET AND THE BADGES. An earned one is a card with its shadow and the date it came; one still to earn is
       only its outline — a dashed frame, the art in grey, and its hint in full-strength ink, because the hint is how to
       earn it and it was the faintest text on the page (0.55 opacity over grey). Earned first, in CSS. ── */
    .ps-gear { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
    .ps-gear__item {
      border: 3px solid var(--ink); background: var(--paper); box-shadow: var(--shadow-sm);
      padding: 1rem 0.8rem 0.9rem; text-align: center;
    }
    .ps-gear__item canvas { width: 88px; height: 88px; image-rendering: pixelated; }
    .ps-gear__item h3 { margin: 0.45rem 0 0.3rem; font-size: 1rem; line-height: 1.25; }
    .ps-gear__item p { margin: 0 0 0.7rem; font-size: 0.875rem; line-height: 1.45; color: var(--ps-muted); }
    .ps-gear__by { display: block; font-size: 0.8rem; font-weight: 800; color: #0b7f91; margin: -0.4rem 0 0.6rem; } /* the maker's credit — "by Barty" */
    .ps-gear__item:not(.ps-gear__item--earned) { order: 1; border-style: dashed; box-shadow: none; background: transparent; }
    .ps-gear__item:not(.ps-gear__item--earned) canvas { filter: grayscale(1) contrast(0.65) brightness(0.9); opacity: 0.6; }
    .ps-gear__item--earned { outline: 3px solid var(--banana); outline-offset: -6px; }
    .ps-gear__btn {
      min-height: 44px; padding: 0 1rem; font: inherit; border: 3px solid var(--ink);
      background: var(--paper); font-weight: 800; font-size: 0.875rem; cursor: pointer;
      /* the wear-toggle is a LINK to the builder now — keep the button look */
      display: inline-flex; align-items: center; justify-content: center;
      text-decoration: none; color: var(--ink); text-align: center; white-space: nowrap;
    }
    .ps-gear__btn.on { background: var(--banana); }

    .ps-patches { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
    .ps-patch {
      border: 3px solid var(--ink); background: var(--paper); box-shadow: var(--shadow-sm);
      padding: 1rem 0.8rem 0.9rem; text-align: center;
    }
    .ps-patch svg { width: 40px; height: 40px; }
    .ps-patch .nana-mark { margin: 1px; }   /* OUR banana, 38 px, in the badges' 40 px slot */
    .ps-patch h3 { margin: 0.5rem 0 0.3rem; font-size: 1rem; line-height: 1.25; }
    .ps-patch p { margin: 0; font-size: 0.875rem; line-height: 1.45; color: var(--ps-muted); }
    .ps-patch .ps-patch__date { display: none; margin-top: 0.5rem; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ps-muted); }
    .ps-patch:not(.ps-patch--earned) { order: 1; border-style: dashed; box-shadow: none; background: transparent; }
    .ps-patch:not(.ps-patch--earned) svg { filter: grayscale(1) contrast(0.6) brightness(0.9); opacity: 0.55; }
    .ps-patch--earned { outline: 3px solid var(--banana); outline-offset: -6px; }
    .ps-patch--earned .ps-patch__date { display: block; }

    /* ── NUMBERS — a zero keeps its tile and carries its earn hint (the badge
       pane's own pattern); non-zero ranks first. Never a grey list of failures. ── */
    .ps-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.9rem; }
    .ps-stat { border: 3px solid var(--ink); background: var(--paper); box-shadow: var(--shadow-sm); padding: 0.9rem 1rem; }
    .ps-stat b { display: block; font-family: "Archivo Black", sans-serif; font-size: 1.75rem; line-height: 1.05; }
    .ps-stat span { display: block; margin-top: 0.4rem; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ps-muted); }
    .ps-stat i { display: none; margin-top: 0.4rem; font-size: 0.875rem; font-style: normal; line-height: 1.45; }
    .ps-stat--zero { order: 1; background: transparent; border-style: dashed; box-shadow: none; }
    .ps-stat--zero b { opacity: 0.3; }
    .ps-stat--zero i { display: block; }

    /* ── YOUR ACCOUNT — one bar right under the card (it lived at the foot of the rail). Its summary IS the sync line, so
       magic-link feedback and the offline apology are never inside a closed drawer, and it opens by itself with the email
       box for anybody who has something to lose and is not logged in. Native <details>: the toggle costs no JS. ── */
    .ps-keep { border: 3px solid var(--ink); background: var(--paper); box-shadow: var(--shadow-sm); }
    .ps-keep[open] { background: #fffdf5; }
    .ps-keep__row {
      display: flex; align-items: center; gap: 0.7rem; min-height: 60px; padding: 0.55rem 1rem;
      cursor: pointer; font-size: 1rem; font-weight: 700; line-height: 1.4; list-style: none;
    }
    .ps-keep__row::-webkit-details-marker { display: none; }
    /* ⚠️ a summary that starts with a pixel icon is INLINE-flex site-wide (styles.css, `:has(> .pai:first-child)`, which
       out-ranks one class): the row shrank to its words, "Account ▾" sat against them instead of the right edge, and on a
       phone the sync line broke over three lines. The whole bar is the row. */
    .ps-wrap .ps-keep > .ps-keep__row, .ps-wrap .ps-ask > .ps-ask__row { display: flex; width: 100%; justify-content: flex-start; }
    .ps-keep__row .pai { width: 22px; height: 22px; }
    .ps-keep__line { min-width: 0; }
    .ps-keep__more { margin-left: auto; font-size: 0.9rem; font-weight: 800; color: var(--ps-muted); white-space: nowrap; }
    .ps-keep__more::after { content: ' ▾'; }
    .ps-keep[open] .ps-keep__more::after { content: ' ▴'; }
    .ps-keep__body { padding: 0.25rem 1rem 1.2rem; display: grid; gap: 0.9rem; }
    .ps-keep__claim { margin: 0; font-size: 1rem; line-height: 1.55; }
    /* the three phrases that are the whole answer to "why give you my address" */
    .ps-perks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
    .ps-perks li { padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.875rem; font-weight: 700; background: rgba(0, 0, 0, 0.07); }
    /* ✉️ ONE FIELD, ONE BUTTON. The button must never wrap its label. */
    .ps-mail { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .ps-mail__in {
      flex: 1 1 220px; min-width: 0; min-height: 48px; padding: 0.6rem 0.8rem; font: inherit; font-size: 1rem;
      border: 3px solid var(--ink); background: #fffdf5; color: var(--ink);
    }
    .ps-mail .btn { flex: none; padding: 0.65rem 1.2rem; }
    .ps-mail__whose { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--ps-muted); }
    .ps-alt { font-size: 0.95rem; }
    .ps-alt > summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; font-weight: 800; color: var(--ps-muted); }
    .ps-sync__row { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
    .ps-sync__row .btn { padding: 0.65rem 1rem; font-size: 0.95rem; }
    .ps-link .btn { padding: 0.65rem 1rem; font-size: 0.95rem; }
    .ps-link__code {
      display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap;
      margin-top: 0.7rem; padding: 0.65rem 0.9rem; background: rgba(255, 225, 53, 0.16); border: 2px dashed var(--banana);
    }
    .ps-link__code b { font-size: 1.35rem; font-weight: 800; letter-spacing: 0.16em; font-variant-numeric: tabular-nums; }
    .ps-link__code span { font-size: 0.875rem; color: var(--ps-muted); }
    .ps-link__lbl { display: block; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; }
    .ps-link__row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .ps-link__in {
      flex: 1 1 150px; min-width: 0; min-height: 48px; padding: 0.55rem 0.7rem; font: inherit; font-size: 1rem;
      letter-spacing: 0.12em; text-transform: uppercase; border: 3px solid var(--ink); background: #fffdf5; color: var(--ink);
    }
    /* ⚠️ Log out is the most destructive control on the page: LAST, quiet,
       and inside a drawer — never above the player's own things. */
    .ps-out__btn {
      min-height: 44px; padding: 0; appearance: none; background: none; border: 0; cursor: pointer;
      font: inherit; font-size: 0.875rem; font-weight: 700; color: var(--ps-muted);
      text-decoration: underline; text-underline-offset: 3px;
    }
    .ps-out__btn:hover { color: var(--ink); }
    /* 🍌📌 the Discord this pass is tied to, quiet beside Log out, with its own way to untie */
    .ps-disc { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
    .ps-disc__name { font-size: 0.875rem; color: var(--ps-muted); }

    /* share-card lightbox — our own reveal (the OS sheet is previewless on
       Windows, so it is an opt-in button, not the default) */
    .ps-sharemodal { position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; background: rgba(17, 17, 17, 0.6); padding: 1rem; }
    .ps-sharemodal__box { position: relative; max-width: min(92vw, 640px); width: 100%; background: var(--paper); border: var(--line); box-shadow: var(--shadow); padding: 0.9rem; }
    .ps-sharemodal__card canvas { display: block; width: 100%; height: auto; border: 3px solid var(--ink); }
    .ps-sharemodal__row { display: flex; gap: 0.5rem; margin-top: 0.7rem; flex-wrap: wrap; }
    .ps-sharemodal__row .btn { flex: 1 1 140px; }
    .ps-sharemodal__close {
      position: absolute; top: -16px; right: -16px; width: 44px; height: 44px;
      background: var(--banana); color: var(--ink); border: 3px solid var(--ink);
      font-weight: 800; cursor: pointer; box-shadow: 3px 3px 0 var(--ink); touch-action: manipulation;
    }

    /* ── DESKTOP: a rail and a body. Only the CARD is sticky — a rail taller
       than the viewport pins its top and strands the doors at 1280×800. ── */
    @media (min-width: 900px) {
      /* ⭐ THE SAME ONE COLUMN, with more air. The card is a keepsake and reads as one only with room; under it everything
         runs the column's width in reading order. Nothing is sticky: the site's own bar slides in on the way up. */
      .ps-wrap { padding: 1.75rem 1.5rem 4rem; gap: 2rem; }
      .ps-under { text-align: center; }
      .ps-week { margin: 0 auto; max-width: 62ch; }
      .ps-h, .ps-pane__h { font-size: 1.35rem; }
      .ps-shelf { grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 1rem; }
      .ps-gear, .ps-patches { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
      .ps-stats { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 1rem; }
      /* ⚠️ it is a CARD, not a banner: stretched to the column the content
         clustered left and the middle went empty. Capped near a real pass's
         proportions and centred, so the width reads as room around it. */
      .ps-card { max-width: 680px; margin: 0 auto; width: 100%; }
      .ps-card__body { gap: 1.4rem; align-items: center; }
      /* the banana carries the card at this width — the shared PNG gives it
         about 40% of the frame, and anything less reads as a stray sticker */
      .ps-card__sig, .ps-card__sig canvas { width: 200px; height: 200px; }
      .ps-card__sig::before { width: 420px; height: 420px; }
      .ps-card__body { padding: 0.5rem 1.1rem 0; gap: 1rem; }
      .ps-card__foot { padding: 0 1.1rem 0.4rem; }
      .ps-stamp { bottom: 46px; right: 34px; font-size: 1rem; }   /* across the FEET, like the shared PNG */
      .ps-card__name { font-size: 1.75rem; }
      .ps-ranknote { max-width: none; }
    }
    @media (max-width: 360px) {
      .ps-card__body { gap: 0.5rem; }
      .ps-card__sig, .ps-card__sig canvas { width: 84px; height: 84px; }
      .ps-card__name { font-size: 0.95rem; }
    }
  </style>

  <div class="ps-wrap">
    <h1 class="ps-sr">Your banana pass</h1>

      <!-- ── 1. THE CARD IS THE PAGE HEADER. The whole thing taps to the share
           modal; the pencil and the empty-slot door opt out of that. ── -->
      <div class="ps-card" id="psCard">
        <div class="ps-card__head">
          <span>★ Banana World · Membership Pass</span>
          <span class="ps-card__hole" aria-hidden="true"></span>
        </div>
        <!-- 🎫 SIGNING IN. Spending a magic link takes seconds, and the page
             renders the LOCAL pass while it happens — so a returning player
             watched a stranger's blank banana and reasonably assumed the link
             had failed (Trym, 4 Sep: "6-7 seconds is enough for me to think
             and act on 'hmm ill try to click the link in the email again'").
             The one signal we had said "Signing you in…" on the keep row,
             ninety lines further down the page and off the fold on a phone.
             This sits ON the card, which is where they are looking. -->
        <!-- ✉️ a login link lands here and WAITS for a tap: a mail scanner that
             opens links cannot spend it, and a person reading mail in an app can
             copy it into the browser they actually play in -->
        <div class="ps-finish" id="psFinish" hidden>
          <p class="ps-finish__line"><b>One tap to finish logging in.</b></p>
          <button class="btn btn--dark ps-finish__go" id="psFinishGo" type="button">Log me in</button>
          <p class="ps-finish__alt">Playing in another browser or app? <button class="ps-finish__copy" id="psFinishCopy" type="button">Copy the link</button> and open it there. It works once, for 30 minutes.</p>
        </div>
        <!-- 🍌📌 a Discord /link code lands here and WAITS for a tap that names the Discord account it belongs to
             (banana-pass-page.js discordLanding): a code sent to somebody else must never tie THEIR pass quietly -->
        <div class="ps-finish" id="psDiscord" hidden>
          <p class="ps-finish__line"><b id="psDiscordAsk"></b></p>
          <button class="btn btn--dark ps-finish__go" id="psDiscordGo" type="button"></button>
          <p class="ps-finish__alt"><span id="psDiscordNote"></span> <button class="ps-finish__copy" id="psDiscordLater" type="button"></button></p>
        </div>
        <div class="ps-signing" id="psSigning" hidden>
          <span class="ps-signing__bar" aria-hidden="true"></span>
          <span class="ps-signing__txt" id="psSigningTxt">Signing you in…</span>
        </div>
        <div class="ps-card__body">
          <div class="ps-card__sig">
            <canvas id="psSig" width="200" height="200" aria-label="Your signature banana"></canvas>
            <a class="ps-card__slot" id="psSigSlot" href="/make-a-banana/" hidden>your banana<br />goes here →</a>
          </div>
          <div class="ps-card__meta">
            <!-- ✏️ the pencil sits ON the name: at the far right of the card it
                 read as page furniture, not as "this name is yours to write" -->
            <p class="ps-card__name"><span id="psName">Fresh Dancing Banana</span><button
                class="ps-nameedit" id="psNameEdit" type="button"
                aria-label="Write your own name on the pass"><PixelArtIcon name="pencil" size="20px" /></button></p>
            <p class="ps-card__since" id="psSince">member since tonight</p>
