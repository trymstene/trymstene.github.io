---
// 🧪 WEARABLES REVIEW — Trym's approval desk for new items. Lists every
// preview-flagged wearable: the sprite by itself + the dancing banana wearing
// it, side by side (his call: "a long list, item by itself, and on the banana
// so i can compare"). Unlinked + noindex + absent from the sitemap allowlist.
// Approve an item = delete its `preview` flag in src/data/wearables.js.
import BaseLayout from '../layouts/BaseLayout.astro';
import { WEARABLE_PACKS } from '../data/wearables.js';

const packs = Object.values(WEARABLE_PACKS);
const rows = [];
// preview === true → on the desk; preview === 'stand' → APPROVED stand
// stock, hidden from every surface until the banana stand sells it
packs.forEach((p) => {
  (p.hats || []).filter((d) => d.preview === true).forEach((d) => rows.push({ id: d.id, label: d.label, slot: 'hat', zone: 'Hat', art: d.art }));
  (p.shades || []).filter((d) => d.preview === true).forEach((d) => rows.push({ id: d.id, label: d.label, slot: 'glasses', zone: 'Shades', art: d.front }));
  (p.extras || []).filter((d) => d.preview === true).forEach((d) => rows.push({
    id: d.id, label: d.label, slot: 'extra',
    zone: d.zone === 'body' ? 'Body' : d.anchor === 'feet' ? 'Shoes' : d.anchor === 'hand' ? `Hand (${d.hand})` : 'Extra',
    art: d.front || d.art,
  }));
});
---
<BaseLayout title="🧪 Wearables review" description="Internal review desk." showFooter={false} robots="noindex">
  <style is:inline slot="head">
    .dw-wrap { max-width: 760px; margin: 0 auto; padding: 1.6rem 1rem 4rem; }
    .dw-wrap h1 { margin: 0 0 0.2rem; }
    .dw-sub { opacity: 0.7; margin: 0 0 1.4rem; font-size: 0.9rem; }
    .dw-row {
      display: flex; gap: 1rem; align-items: center;
      border: var(--line); background: var(--paper); box-shadow: 4px 4px 0 var(--ink);
      padding: 0.9rem; margin-bottom: 1rem;
    }
    /* the preview background is switchable (white gear on white = invisible;
       Trym's catch) — JS sets --dw-bg from the swatch row, grey by default */
    .dw-sprite {
      flex: 0 0 150px; height: 150px; border: 3px solid var(--ink);
      display: flex; align-items: center; justify-content: center;
      background: var(--dw-bg, #888888);
    }
    .dw-sprite svg { max-width: 84%; max-height: 84%; width: auto; height: auto; image-rendering: pixelated; }
    /* preview column: the frame box + transport controls BELOW it (outside
       the frame — Trym), so wearables can be inspected frame by frame */
    .dw-prev { flex: 0 0 170px; display: flex; flex-direction: column; gap: 5px; }
    .dw-banana { width: 170px; height: 170px; border: 3px solid var(--ink); background: var(--dw-bg, #888888); }
    .dw-ctrl { display: flex; gap: 5px; align-items: center; justify-content: center; }
    .dw-ctrl button {
      border: 2px solid var(--ink); background: var(--paper); cursor: pointer;
      font: inherit; font-size: 0.72rem; font-weight: 800; line-height: 1;
      padding: 3px 9px; box-shadow: 2px 2px 0 var(--ink);
    }
    .dw-ctrl button:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--ink); }
    .dw-ctrl .dw-step, .dw-ctrl .dw-fr { display: none; }
    .dw-ctrl.is-paused .dw-step { display: inline-block; }
    .dw-ctrl.is-paused .dw-fr { display: inline-block; font-size: 0.68rem; font-weight: 700; min-width: 4.4em; text-align: center; white-space: nowrap; }
    .dw-bgs { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1.2rem; }
    .dw-bgs span { font-size: 0.72rem; font-weight: 700; opacity: 0.7; }
    .dw-bg {
      width: 30px; height: 30px; border: 3px solid var(--ink); cursor: pointer; padding: 0;
      box-shadow: 2px 2px 0 var(--ink);
    }
    .dw-bg.is-on { outline: 3px solid #e6b800; outline-offset: 2px; }
    .dw-banana canvas { width: 100%; height: 100%; display: block; }
    .dw-meta { flex: 1; min-width: 0; }
    .dw-meta h2 { margin: 0 0 0.15rem; font-size: 1.05rem; }
    .dw-meta .dw-zone {
      display: inline-block; border: 2px solid var(--ink); background: var(--banana);
      font-size: 0.66rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
      padding: 0.12rem 0.45rem; transform: rotate(-1deg);
    }
    .dw-meta code { font-size: 0.72rem; opacity: 0.6; display: block; margin-top: 0.35rem; }
    @media (max-width: 560px) {
      .dw-row { flex-wrap: wrap; }
      .dw-sprite, .dw-prev { flex: 1 1 45%; }
      .dw-banana { width: 100%; }
      .dw-meta { flex-basis: 100%; }
    }
  </style>

  <div class="dw-wrap">
    <h1>🧪 wearables review</h1>
    <p class="dw-sub">{rows.length} candidates awaiting the banana guy's verdict — item alone, and on the banana. Approve = the preview flag comes off.</p>
    <div class="dw-bgs" aria-label="Preview background">
      <span>bg:</span>
      <button class="dw-bg" type="button" data-bg="#ffffff" style="background:#ffffff" aria-label="white"></button>
      <button class="dw-bg" type="button" data-bg="#888888" style="background:#888888" aria-label="grey"></button>
      <button class="dw-bg" type="button" data-bg="#1a1f1a" style="background:#1a1f1a" aria-label="dark"></button>
      <button class="dw-bg" type="button" data-bg="#569a4a" style="background:#569a4a" aria-label="park green"></button>
    </div>
    {rows.map((r) => (
      <article class="dw-row" data-id={r.id} data-slot={r.slot} data-art={r.art}>
        <div class="dw-sprite" aria-label={`${r.label} sprite`}></div>
        <div class="dw-prev">
          <div class="dw-banana"><canvas width="200" height="200" aria-label={`Banana wearing ${r.label}`}></canvas></div>
          <div class="dw-ctrl">
            <button class="dw-step" data-step="-1" type="button" aria-label="previous frame">◀</button>
            <button class="dw-play" type="button" aria-label="pause">⏸</button>
            <span class="dw-fr" aria-live="polite"></span>
            <button class="dw-step" data-step="1" type="button" aria-label="next frame">▶</button>
          </div>
        </div>
        <div class="dw-meta">
          <h2>{r.label}</h2>
          <span class="dw-zone">{r.zone}</span>
          <code>id: {r.id}</code>
        </div>
      </article>
    ))}
    {rows.length === 0 && <p><strong>No candidates in preview.</strong> Add items with <code>preview: true</code> to wearables.js.</p>}
  </div>

  <script>
    import '../scripts/dev-wearables.js';
  </script>
</BaseLayout>
