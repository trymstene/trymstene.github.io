    /* 📱 THE BANANA PHONE DESIGN LANGUAGE (Trym, 1 Sep: "this is the
       way"): inside the phone there are NO black borders — sticker cards
       (radius 16, soft 0 3px 0 shadow), pastel tiles, PILL buttons and
       chips. The world outside the phone keeps its chunky black-border
       chrome; the contrast is deliberate. Every new phone surface follows
       this block. */
    .hs-phoneshell .hs-btn { border: 0; border-radius: 999px; text-align: center;
      box-shadow: 0 2px 0 rgba(31, 26, 8, 0.22); }
    .hs-phoneshell .hs-btn--ghost { background: #fff3c4; }
    .hs-phoneshell .hs-btn[disabled] { opacity: 0.4; box-shadow: none; }
    /* 📱 the phone ROW — one shape for stall/market/animals/shed. Trym's
       laws (1 Sep): NO black borders inside the apps ("boxy... web
       dashboard") — sticker cards, pill buttons, pill chips, rounded
       pastel thumb tiles, like the app home screen; the list PACKS TO THE
       TOP (align-content — the shell is tall, and a stretched grid floated
