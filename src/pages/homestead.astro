  <script>
    import '../scripts/banana-homestead.js';
  </script>
  <script>
    // 🕯 RETURN TO SENDER — dark until launch: the module never loads for a
    // regular visitor. ?questtest turns it on for THIS device (sticky, so it
    // survives fast travel, which drops query params); ?questtest=off turns it
    // off. Launch = flip QUEST_LIVE here + the other three areas (grep it).
    const QUEST_LIVE = true;
    try {
      if (/[?&]questtest=off/.test(location.search)) localStorage.removeItem('bwq-dev');
      else if (/[?&]questtest/.test(location.search)) localStorage.setItem('bwq-dev', '1');
      if (QUEST_LIVE || localStorage.getItem('bwq-dev') === '1') {
        import('../lib/world-quest.js').then((m) => m.bootQuest());
      }
    } catch (e) { /* quest is optional garnish — the area must never break */ }
  </script>
</BaseLayout>
