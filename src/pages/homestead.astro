---
// 🏡 THE HOMESTEAD — your own clearing west of the park (M0, task #106).
// NOINDEXED + not in the sitemap: Rule Zero — the world advertises an area
// when it's ready, and the park's west road stays shut until then. This page
// exists for building and field-testing via the direct URL.
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelIcon from '../components/PixelIcon.astro';

const title = 'The Homestead — your own corner of Banana World';
const description = 'A clearing west of the park with your name on the sign: claim it, pitch a tent, order decor at the mailbox and grow the garden bed.';
---
<BaseLayout
  title={title}
  description={description}
  robots="noindex,nofollow"
  ogTitle="The Homestead 🏡"
  ogDescription="A clearing in Banana World with your name on the sign."
>
  <style is:inline slot="head">
    /* JS toggles hidden on flex/grid elements — the UA rule must always win */
    .hs-wrap [hidden], .hs-veil[hidden], .hs-tabs[hidden] { display: none !important; }
    /* 🏡 the marquee — the park/bay header grammar in hearth-gold: dark warm
       page, centered glowing sign, small dim tagline (Trym: the left-aligned
       white header read basic next to the other areas) */
    body { background: #16130a; }
    .hs-wrap { max-width: 1100px; margin: 0 auto; padding: 0.6rem 1rem 2.5rem; color: #fffdf5; }
    .hs-sign {
      font-family: "Archivo Black", sans-serif; text-align: center;
      color: #ffc94d; font-size: clamp(1.4rem, 6.4vw, 2.2rem); line-height: 1.05;
      margin: 0.7rem 0 0.15rem; letter-spacing: 0.02em;
      text-shadow: 0 0 12px rgba(255, 201, 77, 0.4), 0 0 30px rgba(200, 140, 40, 0.3);
    }
    .hs-tag { text-align: center; margin: 0 0 0.8rem; font-size: 0.82rem; opacity: 0.6; }

    .hs-stage { position: relative; border: 4px solid #000; box-shadow: 8px 8px 0 #000; }
    /* 🍪 --hs-ccb is the cookie banner's band (0 when it is gone) — the frame
       gives up exactly that much so the controls under it stay reachable */
    .hs-view {
      position: relative; height: max(240px, calc(min(74vh, 580px) - var(--hs-ccb, 0px)));
      overflow: hidden; cursor: pointer;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent;
      background: #10200c;
    }
    .hs-world { position: absolute; left: 0; top: 0; image-rendering: pixelated; will-change: transform; }
    .hs-base {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background: url('/assets/homestead/homestead.png') 0 0 / 100% 100% no-repeat;
      image-rendering: pixelated;
    }
    .hs-ov, .hs-it, .hs-crop {
      position: absolute; pointer-events: none; image-rendering: pixelated;
      background-size: 100% 100%; background-repeat: no-repeat;
    }
    .hs-it--ghost { opacity: 0.78; outline: 3px dashed #ffe135; outline-offset: 3px; }
    .hs-it--ghost.is-bad { outline-color: #ff5f5f; filter: saturate(0.4); }
    /* 🏠 structure ghosts: the dashed ring marks the FLOOR, not the roof */
    .hs-it--struct { outline: none; }
    /* 📖 the field guide below the frame — the world's guide grammar */
    .hsg { max-width: 760px; margin: 3rem auto 0; padding: 0 1.2rem; color: #ece4d4; }
    .hsg__block { margin-top: 2.6rem; }
    .hsg__kicker { color: #ffd23f; font-weight: 800; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 0.4rem; }
    .hsg__block h2 { font-family: "Archivo Black", sans-serif; font-size: 1.5rem; margin: 0 0 0.8rem; color: #a7d98a; }
    .hsg__block p { line-height: 1.6; font-size: 0.96rem; margin: 0 0 0.8rem; }
    .hsg__block a { color: #ffd23f; }
    .hsg__grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); margin-top: 1.2rem; }
    .hsg__card { background: #16200f; border: 3px solid #a7d98a; box-shadow: 6px 6px 0 #000; padding: 0.9rem; }
    .hsg__thumb { height: 64px; display: flex; align-items: center; justify-content: center; margin-bottom: 0.55rem; }
    .hsg__thumb img { image-rendering: pixelated; max-height: 64px; max-width: 110px; width: auto; height: auto; }
    .hsg__thumb i { display: block; image-rendering: pixelated; background-repeat: no-repeat; transform-origin: center; }   /* one frame of a strip, scaled whole */
    .hsg__card h3 { font-family: "Archivo Black", sans-serif; font-size: 0.92rem; color: #a7d98a; margin: 0 0 0.35rem; text-align: center; }
    .hsg__card p { margin: 0; font-size: 0.84rem; line-height: 1.5; opacity: 0.92; }
    .hs-footring {
      position: absolute; left: 0; right: 0; bottom: 0;
      border: 3px dashed #ffe135; box-sizing: border-box; pointer-events: none;
    }
    .hs-it--ghost.is-bad .hs-footring { border-color: #ff5f5f; }
    .hs-crop.is-ripe { animation: hsRipe 1.4s ease-in-out infinite; }
    @keyframes hsRipe { 50% { transform: translateY(-3px); } }
    @media (prefers-reduced-motion: reduce) { .hs-crop.is-ripe { animation: none; } }
    .hs-tentspot {
      position: absolute; pointer-events: none; display: grid; place-items: center;
      border: 3px dashed rgba(255, 225, 53, 0.65); border-radius: 8px; text-align: center;
    }
    .hs-tentspot span {
      font-size: 11px; font-weight: 800; color: #fffdf5; line-height: 1.3;
      text-shadow: 0 2px 0 rgba(0,0,0,0.7); background: rgba(10, 16, 8, 0.55);
      padding: 3px 7px; border-radius: 5px;
    }
    .hs-tentspot small { font-weight: 700; opacity: 0.8; }
    /* ⚠️ % of the WORLD, like the park's 3.6% — a fixed px banana ignored the
       zoom, towering over the fence on phones (why the yard "felt small") */
    .hs-me { position: absolute; left: 0; top: 0; width: 5.5%; pointer-events: none; }
    .hs-me canvas { width: 100%; height: auto; display: block; }
    /* 🌐 neighbours in the yard (M5) — the park's peer look, homestead-scaled.
       place() moves them by transform, so the glide transitions transform. */
    .hs-peer {
      position: absolute; left: 0; top: 0; width: 5.5%; pointer-events: none;
      transition: transform 0.18s linear;
    }
    .hs-peer canvas { width: 100%; height: auto; display: block; }
    .hs-peer span {
      position: absolute; left: 50%; top: -12px; transform: translateX(-50%);
      font-size: 0.5rem; font-weight: 800; letter-spacing: 0.05em;
      color: #fffdf5; text-shadow: 1px 1px 0 #000; white-space: nowrap;
    }
    /* leavers go in a puff, never a blink — the world-lib smoke */
    .hs-poof { position: absolute; transform: translate(-50%, -50%); width: 3%; z-index: 1800; pointer-events: none; }
    .hs-poof span { position: absolute; inset: 0; opacity: 0; }
    .hs-poof svg { width: 100%; height: auto; image-rendering: pixelated; }
    .hs-poof__1 { animation: hsPoofStep 0.75s steps(1) forwards; }
    .hs-poof__2 { animation: hsPoofStep 0.75s steps(1) 0.25s forwards; }
    .hs-poof__3 { animation: hsPoofStep 0.75s steps(1) 0.5s forwards; }
    @keyframes hsPoofStep { 0% { opacity: 1; } 33%, 100% { opacity: 0; } }
    /* ⚡ indoors the shade covers the whole yard — stop PAINTING it too:
       visibility keeps layout but skips paint and animated-GIF compositing
       (fountain, lit campfire). The room plate + indoor pieces are exempt. */
    .hs-world.is-inside :is(.hs-it:not(.hs-it--in), .hs-ov:not(.hs-ov--room),
      .hs-bird, .hs-hen, .hs-soil, .hs-crop, .hs-signname, .hs-fpiece,
      .hs-tentspot, .hs-peer) { visibility: hidden; }
    /* 🐦 garden birds — 16px frames on a 4-frame strip, world-scaled */
    .hs-bird { position: absolute; left: 0; top: 0; width: 1.8%; pointer-events: none; }
    .hs-hen { position: absolute; left: 0; top: 0; width: 1.8%; pointer-events: none; }
    .hs-toastico { width: 15px; height: 15px; vertical-align: -3px; image-rendering: pixelated; }
    /* ⚠️ the SPRITE class, never a bare span — `.hs-hen span` also dressed
       the mood bubble (a span in the same element) in this square box and
       400% background: Trym's screenshot, a stretched white slab with the
       heart in its corner. */
    .hs-hen .hs-henimg {
      display: block; width: 100%; aspect-ratio: 1;
      background-size: 400% 100%; background-repeat: no-repeat; image-rendering: pixelated;
    }
    /* 🐄 the cow's frames are 4:3, not square — forcing them square stretched
       her a third too tall (and 4.4% read as a monster). 3.4% ≈ 61 world px
       against her 72px native frame. */
    .hs-hen--cow .hs-henimg { aspect-ratio: 144 / 81; }
    .hs-bird span {
      display: block; width: 100%; aspect-ratio: 1;
      background-size: 400% 100%; background-repeat: no-repeat; image-rendering: pixelated;
    }

    .hs-signname {
      /* the property name lives ON the plank — it stretches with the name.
         ⚠️ SIZED IN vw, NOT px (Trym, iOS Safari: "oversized and clumpy big").
         Every other thing in this world is a % of the map, so it shrinks with
         the map; this was the one fixed-px object, which means on a phone the
         scene halves and the sign does not — at tier 3 it was eating ~40% of
         the map width. The clamp cap keeps desktop where it already was.
         Padding is deliberately mean: the plank should hug the letters, so a
         longer name buys characters instead of board. */
      position: absolute; transform: translate(-50%, -100%); pointer-events: none;
      background: #7c5630 repeating-linear-gradient(90deg, transparent 0 6px, rgba(30, 16, 4, 0.16) 6px 7px);
      /* ⚠️ 1px frame (Trym): the dark brown was reading FAT because it is three
         things stacked, not one — this border, the tier-3 roof cap on top of it,
         and a drop shadow under the bottom. Each looked small in isolation and
         together they put ~4px of dark on a 22px plank. Thin all three or the
         frame just moves its weight around. */
      color: #ffe9c4; border: 1px solid #34241a;
      padding: 2px 7px; font-size: clamp(8px, 2.3vw, 10px);
      font-weight: 800; white-space: nowrap;
      max-width: min(300px, 46vw); overflow: hidden; text-overflow: ellipsis;
      border-radius: 3px;
      box-shadow: inset 0 1px 0 rgba(255, 234, 190, 0.25), inset 0 -1px 0 rgba(20, 10, 2, 0.3);
      text-shadow: 0 1px 0 rgba(20, 10, 2, 0.55);
    }
    .hs-signname[data-tier="2"] { padding: 2px 9px; font-size: clamp(8.5px, 2.5vw, 11px); }
    .hs-signname[data-tier="3"] {
      padding: 3px 11px; font-size: clamp(9px, 2.7vw, 12px);
      border-top: 2px solid #4a3322;      /* the house sign's roof cap */
      box-shadow: inset 0 1px 0 rgba(255, 234, 190, 0.3), inset 0 -1px 0 rgba(20, 10, 2, 0.3), 0 1px 0 rgba(20, 10, 2, 0.25);
    }
    .hs-signname[hidden] { display: none; }
    .hs-float {
      position: absolute; transform: translate(-50%, -100%); pointer-events: none;
      font-weight: 900; font-size: 15px; color: #fffdf5; z-index: 4000;
      text-shadow: 0 2px 0 #000; animation: hsFloat 0.95s ease-out forwards;
    }
    @keyframes hsFloat { to { transform: translate(-50%, -220%); opacity: 0; } }

    /* ✏️ the blank sign's pencil: a small white pill bobbing over the plank */
    .hs-signhint { position: absolute; transform: translate(-50%, -100%); width: 24px; height: 24px; border-radius: 999px;
      background: #fff; color: #6b5200; display: grid; place-items: center; box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
      pointer-events: none; animation: hs-signbob 1.4s ease-in-out infinite; }
    .hs-signhint svg { display: block; }
    @keyframes hs-signbob { 0%, 100% { margin-top: 0; } 50% { margin-top: -5px; } }
    .hs-chip {
      position: absolute; transform: translate(-50%, -100%); display: flex; gap: 6px;
      background: rgba(10, 16, 8, 0.92); border: 3px solid #000; padding: 6px;
      border-radius: 6px; box-shadow: 4px 4px 0 rgba(0,0,0,0.5);
    }
    /* 🌱 the seed picker is the PARK'S SEED SHEET, in homestead colours: a
       scrollable modal of rows. It used to be a row of buttons pinned to the
       bed — one per crop in the game — which ran off the side of a phone
       (Kiwi, 28 Aug). A modal cannot overflow the world, and the park already
       taught everyone what choosing a seed looks like. */
    .hs-seedlist {
      display: grid; gap: 0.5rem; max-height: 46vh; overflow-y: auto;
      overscroll-behavior: contain;
    }
    .hs-seedrow {
      appearance: none; font-family: inherit; width: 100%; cursor: pointer;
      display: flex; align-items: center; gap: 0.7rem; text-align: left;
      border: 2px solid #000; background: #fff; color: #1a1408;
      padding: 0.5rem 0.6rem;
    }
    .hs-seedrow:hover { outline: 2px solid #a7d98a; outline-offset: 1px; }
    .hs-seedrow:active { transform: translate(2px, 2px); }
    .hs-seedrow i { font-style: normal; font-size: 1.4rem; line-height: 1; }
    .hs-seedrow b { flex: 1; min-width: 0; font-size: 0.9rem; }
    .hs-seedrow span { flex: 0 0 auto; font-weight: 800; font-size: 0.82rem; }
    .hs-btn {
      font: inherit; font-size: 0.8rem; font-weight: 800; cursor: pointer;
      border: 3px solid #000; background: #ffe135; color: #1a1408;
      padding: 0.4rem 0.6rem; white-space: nowrap;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent;
    }
    .hs-btn[disabled] { opacity: 0.45; cursor: default; }
    .hs-btn--ghost { background: #fffdf5; }

    .hs-hint {
      position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%);
      z-index: 20; pointer-events: none; white-space: nowrap;
      background: rgba(10, 16, 8, 0.8); color: #fffdf5; border: 2px solid #000;
      padding: 0.35rem 0.7rem; font-size: 0.78rem; font-weight: 700; border-radius: 5px;
      transition: opacity 0.4s ease;
    }
    .hs-hint.is-off { opacity: 0; }
    /* the PARK's toast grammar — dark card, yellow ink, dropped to 16% so it
       never shares a line with the quest chip (top-left, yellow): a yellow
       toast at the chip's row read as one smear of quest UI (Trym) */
    .hs-toast {
      position: absolute; left: 50%; top: max(18%, 140px); transform: translateX(-50%);
      z-index: 30; pointer-events: none; max-width: calc(100% - 2rem); text-align: center;
      background: #101a10; color: #ffe135; border: 3px solid #ffe135;
      box-shadow: 4px 4px 0 #000; padding: 0.5rem 0.9rem; line-height: 1.35;
      font-size: 0.85rem; font-weight: 800; opacity: 0; transition: opacity 0.25s ease;
    }
    .hs-toast.is-on { opacity: 1; }
    .hs-exit {
      position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      z-index: 20; pointer-events: none; background: rgba(10, 16, 8, 0.85);
      color: #ffe135; border: 2px solid #000; padding: 0.35rem 0.65rem;
      font-size: 0.78rem; font-weight: 800; border-radius: 5px; opacity: 0;
      transition: opacity 0.3s ease;
    }
    .hs-exit.is-on { opacity: 1; }
    .hs-cut { position: absolute; inset: 0; z-index: 60; background: #000; opacity: 0;
      pointer-events: none; transition: opacity 0.16s ease; }
    /* 🛋 indoors: the shade hides the yard under the floating room */
    .hs-inshade { position: absolute; inset: 0; z-index: 2000; background: #0d0b14; pointer-events: none; }
    .hs-inshade[hidden] { display: none; }
    .hs-cut.is-on { opacity: 1; }

    .hs-actions {
      display: flex; gap: 0.5rem; align-items: center; justify-content: center;
      background: #10200c; border-top: 4px solid #000; padding: 0.55rem;
    }
    /* ⚠️ Same latent fault as .hs-planbar: yellow fill, inherited cream ink,
       contrast 1.28. It only LOOKS fine because every one of these buttons is
       an emoji today, and emoji ignore `color`. The pressed state declared its
       ink, so the day one of these gains a word it would vanish. */
    .hs-act {
      font: inherit; font-size: 1.05rem; cursor: pointer; border: 3px solid #000;
      background: #ffe135; color: #17120c; padding: 0.45rem 0.9rem; font-weight: 800;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent;
    }
    .hs-act--icon { display: inline-flex; align-items: center; justify-content: center; }
    .hs-act[aria-pressed="true"] { background: #1a1408; color: #ffe135; }
    /* 🔨 THE PLANNER — build mode: zoomed-out land, dimmed world, lit grid */
    /* ⚠️ SPANS THE VIEW, NEVER CENTRES ON A FIXED POINT. Six nowrap buttons
       measure 475px; a phone stage is 335px. With `left:50%` + translateX(-50%)
       that overflowed by 70px off BOTH edges at once, so the first and last
       tools were unreachable (Trym, 8 Aug: "offscreen, small, not mobile
       friendly"). Anchored left+right instead, it centres while it fits and
       WRAPS to a second row when it doesn't — every tool stays full size and
       tappable, which a shrink-to-fit or a scroll-with-no-affordance loses. */
    .hs-planbar {
      position: absolute; left: 8px; right: 8px; top: 10px;
      z-index: 2600; display: flex; flex-wrap: wrap;
      gap: 0.4rem; justify-content: center;
      background: rgba(10, 16, 8, 0.92); border: 3px solid #000; border-radius: 7px;
      padding: 0.3rem; box-sizing: border-box;
    }
    /* ⚠️ A BUTTON THAT SETS background MUST SET color. This bar painted a cream
       button and let the ink inherit — and the ink it inherited was the page's
       own cream, #fffdf5 on #fffdf5, contrast 1.0. Four of the six tools were
       blank rectangles with only their emoji showing, and the fifth was cream
       on banana yellow. `done` was legible for one reason only: it happened to
       declare a colour. (Trym, 30 Aug.) */
    .hs-planbar button {
      font: inherit; font-size: 0.78rem; font-weight: 800; cursor: pointer;
      border: 2px solid #000; background: #fffdf5; color: #17120c;
      padding: 0.35rem 0.6rem;
      white-space: nowrap; touch-action: manipulation;
      min-height: 40px;                      /* thumbs, not cursors */
    }
    .hs-planbar button[aria-pressed="true"] { background: #ffe135; color: #17120c; }
    #hsPlanDone { background: #1a1408; color: #ffe135; }
    .hs-planbar[hidden] { display: none; }
    /* 🐔 slice 1: the egg on the ground, the hen's mood bubble, the stall */
    .hs-egg {
      position: absolute; width: 26px; height: 26px; pointer-events: none;
      background: url(/assets/park/e-egg.png) center/contain no-repeat;
      image-rendering: pixelated;
      filter: drop-shadow(0 0 6px rgba(255, 240, 180, 0.8)) drop-shadow(0 2px 2px rgba(20, 40, 10, 0.3));
    }
    /* ❤️/💔 — the park's mood bubble, COPIED VERBATIM from .pk-mood (Trym:
       "why didnt you just copy the one from the ducks" — because I styled a
       new circle instead, the heart overflowed it, and it had no tail. The
       reuse rule exists for exactly this). Rounded rect, black down-arrow. */
    .hs-mood {
      /* ⚠️ the drop is a PERCENT of the animal's box, not fixed px — the
         bubble itself never scales with the world (11px text must stay
         readable), so a 6px drop that sat on a 38px desktop duck BURIED a
         21px mobile hen (Trym: looks broken on mobile). 15%% of the box =
         the same approved 6px on desktop, 3px on a phone. */
      /* the calc lift: a flat 7px above the proportional drop (Trym: "5-10
         pixels up above the animal") — a lift can't bury a small sprite the
         way the old fixed DROP did, so flat px is safe in this direction */
      position: absolute; left: 50%; top: calc(15% - 7px); transform: translate(-50%, -100%);
      background: #fffdf5; border: 2px solid #000; border-radius: 6px;
      padding: 2px 4px; font-size: 11px; line-height: 1; white-space: nowrap;
      opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
    }
    /* ⚠️ the tail is ONE rotated square now, not two stacked triangles —
       the wedge pair could never both bridge the border seam AND keep a
       thin outline (round 5's fix just made the black tip fatter, Trym's
       Betsy screenshot). A white 8px diamond with 2px black on only its
       two LOWER edges: the top corner hides white-on-white inside the
       bubble (killing the border seam), and the side corners land inside
       the border band so its black merges into the bubble's own line.
       ⚠️ `bottom` here measures from the PADDING box — the 2px border
       sits below it, so -5px puts the box bottom 3px below the outer
       edge, the diamond's centre 1px inside the border band. Tuned at 6x
       on a bench page (scratchpad bubble-bench), not in-game squinting. */
    .hs-mood::after {
      content: ''; position: absolute; left: 50%; bottom: -6px;
      width: 8px; height: 8px; transform: translateX(-50%) rotate(45deg);
      background: #fffdf5; border-right: 2px solid #000; border-bottom: 2px solid #000;
    }
    /* the diamond's top corner must cross into the interior to bridge the
       border — so the CONTENT gets its own raised layer, or the tail paints
       over the emoji's bottom (positioned pseudos always beat plain text;
       Trym caught the half-hidden heart). Every mood writer wraps in <b>. */
    .hs-mood b { position: relative; z-index: 1; font-weight: inherit; font-style: normal; }
    .hs-mood.is-on { opacity: 1; }
    .hs-stallrow { display: flex; gap: 0.5rem; margin-top: 0.55rem; }
    /* ✏️ slice 2: the naming chip (bond 3) and the said-over-her-head name */
    .hs-nameinp {
      font: inherit; font-size: 0.8rem; width: 9.5rem; padding: 0.3rem 0.45rem;
      border: 2px solid #000; background: #fffdf5; color: #17120c;
    }
    .hs-henname {
      /* stacked ABOVE the mood bubble (Trym's Betsy screenshot: the round-5
         bubble lift pushed the bubble up into the name and the two collided
         — "the name cant be on the bubble"). Bubble bottom = 15% - 7px,
         bubble ≈ 19px tall → 15% - 31px clears its top by ~5px. */
      position: absolute; left: 50%; top: calc(15% - 31px); transform: translate(-50%, -100%);
      font-style: normal; font-size: 10px; font-weight: 800; white-space: nowrap;
      color: #fffdf5; text-shadow: 1px 1px 0 #000, -1px 1px 0 #000, 1px -1px 0 #000, -1px -1px 0 #000;
      opacity: 0; transition: opacity 0.25s; pointer-events: none;
    }
    .hs-henname.is-on { opacity: 1; }
    /* 🚧 slice 3: the pen tint (fence mode only), the flock's sizes, milk */
    .hs-pen {
      position: absolute; pointer-events: none; z-index: 66;
      background: rgba(140, 230, 120, 0.16); border: 2px dashed rgba(150, 235, 130, 0.6);
    }
    .hs-pen i {
      position: absolute; left: 50%; top: -10px; transform: translate(-50%, -100%);
      font-style: normal; font-size: 10px; font-weight: 800; white-space: nowrap;
      color: #d9ffd0; text-shadow: 1px 1px 0 #000;
      background: rgba(10, 16, 8, 0.75); padding: 2px 6px; border-radius: 4px;
    }
    .hs-hen--goat { width: 2.2%; }
    .hs-hen--goat .hs-henimg { aspect-ratio: 96 / 78; }
    .hs-hen--sheep { width: 3.0%; }
    .hs-hen--sheep .hs-henimg { aspect-ratio: 96 / 57; }
    .hs-hen--ygoat { width: 2.05%; }   /* Trym on iOS: the kid read too small next to the flock */
    .hs-hen--ygoat .hs-henimg { aspect-ratio: 96 / 57; }
    .hs-hen--ysheep { width: 2.1%; }
    .hs-hen--ysheep .hs-henimg { aspect-ratio: 96 / 48; }
    .hs-milk {
