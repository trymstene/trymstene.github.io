---
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelIcon from '../components/PixelIcon.astro';

const title = "Trym Stene — the Dancing Banana Guy, since 1999";
const description = "Trym Stene — the guy who made the Dancing Banana GIF in 1999. Where the banana lives: the story, make your own, the live rave, and the official shop.";
const ogDescription = "The guy who made the Dancing Banana GIF. The story, the builder, the rave, the shop.";

// Entity / authorship: establishes Trym Stene as the verified creator for search + AI
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://trymstene.com/#website",
      "url": "https://trymstene.com/",
      "name": "Trym Stene",
      "description": "Trym Stene — the creator of the Dancing Banana GIF (1999). The banana's home: story, builder, live rave, and official shop.",
      "inLanguage": "en",
      "publisher": { "@id": "https://trymstene.com/#trym" }
    },
    {
      "@type": "Person",
      "@id": "https://trymstene.com/#trym",
      "name": "Trym Stene",
      "url": "https://trymstene.com/",
      "image": "https://trymstene.com/assets/trym-stene-profile-photo.jpg",
      "description": "Norwegian creator of the Dancing Banana GIF (1999). Lead SEO & CRO specialist, web comedian, and music producer as Sentry.",
      "jobTitle": "Lead SEO & CRO Specialist",
      "sameAs": [
        "https://www.facebook.com/trymstene",
        "https://twitter.com/trymstene",
        "https://www.linkedin.com/in/trymstene/",
        "https://www.instagram.com/trymstene/",
        "https://soundcloud.com/sentryofficial",
        "https://open.spotify.com/artist/3mPwC4BdfC6fxNg8pIlA4F"
      ]
    }
  ]
};

const marqueeText = "the dancing banana  ·  since 1999  ·  the rave is open  ·  make your own  ·  licensing enquiries welcome  ·  ".repeat(5);

// 🌍 THE WORLD LANDING (13 Aug): the doors became a visual sell — feature
// stills exported from the reel scenes (tools/reel/export_stills.py) and
// REAL community homesteads (tools/build-yard-cards.py; re-run to refresh).
import yardCards from '../data/yard-cards.json';
// hero slides are HONEST world shots (tools/reel/export_hero.py: real plate
// crops, sprites at true game scale) — the stylized reel stills stay in the
// small feature cards where poster close-ups belong
const HERO_SLIDES = [
  { img: '/assets/world/hero-park.jpg', alt: 'The Park in Banana World — bananas at the fountain plaza' },
  { img: '/assets/world/hero-home.jpg', alt: 'A real visitor-built homestead in Banana World' },
  { img: '/assets/world/hero-bay.jpg', alt: 'Banana Bay — volleyball court, beach hut and palms' },
  { img: '/assets/world/hero-quest.jpg', alt: 'Nib the registrar waiting with a quest at the homestead gate' },
];
const FEATURES = [
  { k: 'homestead', line: 'Build your corner.', href: '/homestead/' },
  { k: 'builder', line: 'Dress the legend.', href: '/make-a-banana/' },
  { k: 'items', line: 'Draw it. Own it.', href: '/forge/items/' },
  { k: 'quest', line: 'A mystery from 1999.', href: '/homestead/' },
  { k: 'rave', line: 'The floor never stops.', href: '/rave/' },
  { k: 'treasure', line: 'X marks the sand.', href: '/beach/' },
  { k: 'fishing', line: 'Something’s biting.', href: '/beach/' },
  { k: 'tending', line: 'The park needs you.', href: '/park/' },
];
---
<BaseLayout title={title} description={description} ogDescription={ogDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <style is:inline slot="head">
    /* 🌍 the world landing — highly visual, tiny copy, CTA always in reach */
    /* a cinematic STRIP, not a billboard — capped height so it never owns
       the whole viewport (Trym: way too much space) */
    .bwl-hero {
      position: relative; max-width: 1160px; margin: 1.6rem auto 0; aspect-ratio: 21 / 9;
      max-height: 420px; width: 100%;
      border: 4px solid var(--ink); border-radius: 16px; overflow: hidden;
      box-shadow: 8px 8px 0 var(--ink); background: var(--ink);
    }
    @media (max-width: 640px) { .bwl-hero { aspect-ratio: 4 / 3; } }
    .bwl-hero img {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      opacity: 0; transition: opacity 0.7s ease;
    }
    .bwl-hero img.on { opacity: 1; animation: bwlKen 5s ease-in-out forwards; }
    @keyframes bwlKen { from { transform: scale(1); } to { transform: scale(1.07); } }
    /* ⚠️ centred WITHOUT a transform: .btn:hover sets its own transform, which
       REPLACES translateX(-50%) and threw the button half its width to the
       right on every hover (Trym saw it flicker). Same trap as the quest
       dialogue's keyframes — never centre a .btn with transform. */
    .bwl-hero__cta {
      position: absolute; left: 0; right: 0; bottom: 5%; margin-inline: auto;
      width: max-content; z-index: 2;
      white-space: nowrap; box-shadow: 4px 4px 0 rgba(0,0,0,0.55);
    }
    @media (prefers-reduced-motion: reduce) { .bwl-hero img.on { animation: none; } }
    .bwl-grid {
      display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr);
      max-width: 1160px; margin: 1.4rem auto 0;
    }
    @media (min-width: 760px) { .bwl-grid { grid-template-columns: repeat(4, 1fr); } }
    .bwl-card {
      display: block; position: relative; border: 3px solid var(--ink); border-radius: 14px;
      overflow: hidden; box-shadow: 5px 5px 0 var(--ink); text-decoration: none; color: #fffdf5;
      transition: transform 0.12s ease, box-shadow 0.12s ease; background: var(--ink);
    }
    .bwl-card:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); }
    .bwl-card img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
    .bwl-card b {
      position: absolute; left: 0; right: 0; bottom: 0; padding: 1.6rem 0.7rem 0.6rem;
      font-family: "Archivo Black", sans-serif; font-size: clamp(0.85rem, 2.2vw, 1.05rem); line-height: 1.1;
      background: linear-gradient(transparent, rgba(10, 8, 4, 0.88) 55%);
      text-shadow: 0 2px 0 rgba(0,0,0,0.6);
    }
    .bwl-sub { font-family: "Archivo Black", sans-serif; font-size: clamp(1.2rem, 4vw, 1.7rem); margin: 2.4rem 0 0.2rem; }
    .bwl-subnote { margin: 0.2rem 0 0; font-size: 0.92rem; opacity: 0.75; }
    .bwl-yards {
      display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      max-width: 1160px; margin: 1.2rem auto 0;
    }
    .bwl-yard {
      display: block; position: relative; border: 3px solid var(--ink); border-radius: 14px;
      overflow: hidden; box-shadow: 5px 5px 0 var(--ink); text-decoration: none; color: var(--ink);
      transition: transform 0.12s ease, box-shadow 0.12s ease; background: var(--paper);
    }
    .bwl-yard:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); }
    .bwl-yard img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
    .bwl-yard__tag {
      position: absolute; left: 10px; top: 10px; max-width: calc(100% - 20px);
      background: var(--banana); border: 2px solid var(--ink); border-radius: 6px;
      padding: 0.2rem 0.5rem; font-size: 0.8rem; font-weight: 800;
      transform: rotate(-2deg); box-shadow: 2px 2px 0 rgba(0,0,0,0.4);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .bwl-yard__go {
      position: absolute; right: 10px; bottom: 10px;
      background: var(--ink); color: var(--banana); border-radius: 999px;
      padding: 0.25rem 0.65rem; font-size: 0.75rem; font-weight: 800;
    }
    .bwl-yard--you {
      display: grid; place-content: center; gap: 0.2rem; text-align: center;
      background: repeating-linear-gradient(45deg, var(--paper) 0 14px, #f2ecdc 14px 28px);
      min-height: 180px; border-style: dashed;
    }
    .bwl-yard--you .bwl-yard__plus { font-family: "Archivo Black", sans-serif; font-size: 2.4rem; line-height: 1; }
    .bwl-yard--you b { font-family: "Archivo Black", sans-serif; }
    .bwl-yard--you span:last-child { font-size: 0.8rem; font-weight: 800; opacity: 0.7; }
    .bwl-cta { text-align: center; margin-top: 2.2rem; }
    .bwl-fine { margin: 0.6rem 0 0; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.6; }
    .bwl-also { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-top: 1.6rem; font-weight: 700; }
  </style>

  <!-- scrolling marquee banner -->
  <div class="marquee" slot="banner" aria-hidden="true">
    <div class="marquee__track">
      <span>{marqueeText}</span>
      <span>{marqueeText}</span>
    </div>
  </div>

  <!-- hero -->
  <section class="hero">
    <div class="hero__banana">
      <img src="/assets/dancing-banana-gif.gif" alt="The Dancing Banana GIF, created by Trym Stene in 1999"
           width="500" height="500"
           onerror="this.outerHTML='<div class=&quot;banana-fallback&quot;>🍌</div>';">
    </div>
    <h1 class="hero__title">hello yes,<br>it's the <span class="wobble">banana</span> guy</h1>
    <p class="hero__tag">Welcome in. This is where the dancing banana lives — since 1999, still dancing.</p>
    <!-- 🌍 ONE DOOR (Trym, 13 Aug): the per-area buttons collapsed into a
         single entrance — the world is one place now and the homestead is
         its front door (the quest + tour greet you there). "Enter" was the
         chosen verb: a place you walk into — "Join" read as signing up,
         "Play" shrank it to a minigame. -->
    <div class="hero__cta">
      <a class="btn btn--dark" href="/homestead/">🌍 Enter Banana World →</a>
      <a class="btn btn--light" href="/make-a-banana/" data-place="hero"><PixelIcon name="palette" /> Make a banana</a>
    </div>
  </section>

  <!-- 🌍 the world landing — the doors became a visual sell (Trym, 13 Aug):
       feature stills from the reel scenes, real community homesteads with
       names tagged, a CTA always in reach. Copy stays tiny and sharp. -->
  <section class="block" id="doors">
    <p class="kicker">Banana World</p>
    <h2>One world. Every banana.</h2>
    <div class="bwl-hero" id="bwlHero">
      {HERO_SLIDES.map((h, i) => (
        <img class={i === 0 ? 'on' : ''} src={h.img} alt={h.alt}
             width="1400" height="600" loading={i === 0 ? 'eager' : 'lazy'} />
      ))}
      <a class="btn btn--dark bwl-hero__cta" href="/homestead/">🌍 Enter Banana World →</a>
    </div>
    <p class="doors__daily" style="text-align:center">
      <span class="door__dot" style="display:inline-block;vertical-align:1px;margin-right:0.4rem"></span>
      <span id="raveCount">the world is open</span>
    </p>

    <div class="bwl-grid">
      {FEATURES.map((f) => (
        <a class="bwl-card" href={f.href}>
          <img src={`/assets/world/feat-${f.k}.jpg`} alt={`Banana World — ${f.line}`}
               width="640" height="800" loading="lazy" />
          <b>{f.line}</b>
        </a>
      ))}
    </div>

    <h3 class="bwl-sub">Real homesteads. Real bananas.</h3>
    <p class="bwl-subnote">Built by visitors like you — knock on any door.</p>
    <div class="bwl-yards">
      {yardCards.map((y) => (
        <a class="bwl-yard" href={`/homestead/${y.slug}/`}>
          <img src={`/assets/world/yard-${y.slug}.jpg`} alt={`${y.name} — a visitor's homestead in Banana World`}
               width="640" height="480" loading="lazy" />
          <span class="bwl-yard__tag">🏡 {y.name}</span>
          <span class="bwl-yard__go">👋 visit →</span>
        </a>
      ))}
      <a class="bwl-yard bwl-yard--you" href="/homestead/">
        <span class="bwl-yard__plus">+</span>
        <b>Your name here</b>
        <span>claim your plot →</span>
      </a>
    </div>

    <div class="bwl-cta">
      <a class="btn btn--dark" href="/homestead/">🌍 Enter Banana World →</a>
      <p class="bwl-fine">free · plays in the browser · your banana is waiting</p>
    </div>
    <p class="bwl-also">
      <a href="/dancing-banana-gif-meme/">grab the 1999 GIF →</a>
      <a href="/shop/">hit the shop →</a>
      <a href="/banana-of-the-day/">the banana of the day →</a>
    </p>

    <!-- 💬 THE DISCORD CARD — right under the doors to the areas, because it is
         one of them: the world has a park, a rave, a bay, and a room where the
         people who play them talk. The makers whose items are IN the game are
         there, which is the actual reason to join and so it is the line used.

         ⚠️ THE HEADLINE MUST SAY "DISCORD" AND CARRY THE LOGO. It used to read
         "The doors just opened", with Discord only in the small kicker — and a
         real visitor told Trym they thought that WAS the entrance to Banana
         World and got confused. Every other card on this page is a door into
         the world, so a door metaphor here reads as one more area. The logo is
         the fastest disambiguator there is: nobody mistakes it for a place we
         built. Never put the word back in the kicker alone. -->
    <a class="dc" href="https://discord.gg/cuF6BHfZT4" target="_blank" rel="noopener"
       data-place="home_discord">
      <span class="dc__stage">
        <span class="dc__bubble">come say hi!</span>
        <img class="dc__banana" src="/assets/dancing-banana-transparent.gif"
             alt="" width="240" height="240" loading="lazy">
      </span>
      <span class="dc__body">
        <span class="dc__k">Come and chat</span>
        <span class="dc__h">
          <svg class="dc__logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>The Banana Discord</span>
        <p class="dc__l">Mostly empty, which is the good bit — you get in early. Drop nights,
        work-in-progress pixels, and the makers whose hats are already in the game.</p>
        <span class="dc__go">Join the server →</span>
      </span>
    </a>
  </section>

  <!-- banana hook -->
  <section class="block block--yellow" id="banana">
    <p class="kicker">Yes, THAT banana</p>
    <h2>I accidentally made the internet's favourite fruit.</h2>
    <p class="lead">
      Back in <strong>1999</strong>, on an AMD K6-2 running at a screaming 350MHz, I made a little
      dancing banana GIF. It became <strong>Peanut Butter Jelly Time</strong>, it cameo'd in
      <strong>Family Guy</strong>, and it's been bouncing across the internet ever since.
    </p>
    <p class="lead">
      The full story — the remixes, the FAQ, and how to <strong>license</strong> the banana
      (spoiler: not for your crypto coin) — lives on its own page.
    </p>
    <a class="btn btn--dark" href="/dancing-banana-gif-meme/">Read the full banana story →</a>
  </section>

  <!-- the host -->
  <section class="block" id="about">
    <div class="split">
      <div class="split__media">
        <img src="/assets/trym-stene-profile-photo.jpg" alt="Trym Stene" loading="lazy">
      </div>
      <div class="split__text">
        <p class="kicker">Your host</p>
        <h2>Me</h2>
        <p class="lead">
          I'm Trym Stene — a Norwegian who does SEO for a living, makes jokes on the internet for fun,
          and produces music as <a href="https://www.djsentry.com" target="_blank" rel="noopener">Sentry</a>.
          One time in 1999 I drew a fruit and it got a little out of hand.
        </p>
        <p class="lead">
          <a href="/contact/">Say hello →</a>
        </p>
        <a class="btn btn--dark" href="/me/">More about me →</a>
      </div>
    </div>
  </section>

  <script>
    // 🌍 the one-door funnel: which frontpage door opened Banana World —
    // homestead_open via=direct can't tell the hero button from a typed URL
    document.querySelectorAll('a[href="/homestead/"]').forEach((a) => {
      a.addEventListener('click', () => {
        try {
          // @ts-ignore
          window.gtag && window.gtag('event', 'world_door', {
            from: a.closest('.hero') ? 'hero' : 'doors', transport_type: 'beacon',
          });
        } catch (e) {}
      });
    });
    // 🎠 the hero reel — fade through the world's best moments, Ken Burns
    // restarting per slide; still image under reduced motion
    const slides = [...document.querySelectorAll('#bwlHero img')];
    if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let k = 0;
      setInterval(() => {
        slides[k].classList.remove('on');
        k = (k + 1) % slides.length;
        slides[k].classList.add('on');
      }, 4200);
    }
    // proof of life on the dance door — fail silently, never block the page
    fetch('https://banana-rave.trymstene.workers.dev/count')
      .then((r) => r.json())
      .then((d) => {
        const el = document.getElementById('raveCount');
        if (el && typeof d.count === 'number' && d.count > 0) {
          el.textContent = d.count === 1 ? '1 banana at the rave right now' : `${d.count} bananas at the rave right now`;
        }
      })
      .catch(() => {});
  </script>
</BaseLayout>
