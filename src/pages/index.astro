    </div>
  </section>

  <script>
    // 🌍 which frontpage door opened Banana World: public/js/main.js counts every door on every page now
    // (world_door, from = the link's data-place: hero or doors here), so this page no longer counts its own
    // 🎠 the hero reel — fade through the world's best moments, Ken Burns
    // restarting per slide; still image under reduced motion
    const slides = [...document.querySelectorAll('#bwlHero img')];
    if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let k = 0;
      setInterval(() => {
        slides[k].classList.remove('on');
        k = (k + 1) % slides.length;
        slides[k].classList.add('on');
      }, 4200);
    }

    // 🎉 THE HERO: tap the banana and it throws confetti, counted once a page view as hero_play
    const hero = document.getElementById('hero');
    const send = (name) => { try { if (window.gtag) window.gtag('event', name); } catch (e) { /* analytics never breaks the toy */ } };
    if (hero) {
      const banana = hero.querySelector('.hw__banana');
      const COLS = ['#ff4d6d', '#55aaff', '#111111', '#fffdf5', '#58c05c', '#ff7bac'];
      banana.addEventListener('click', (e) => {
        if (!hero.classList.contains('is-played')) { hero.classList.add('is-played'); send('hero_play'); }
        banana.animate([{ scale: '1' }, { scale: '1.07' }, { scale: '1' }], { duration: 320, easing: 'ease-out' });
        const h = hero.getBoundingClientRect(), x = e.clientX - h.left, y = e.clientY - h.top;
        for (let i = 0; i < 18; i++) {
          const b = document.createElement('b');
          b.className = 'hw__bit';
          b.style.cssText = `left:${x}px;top:${y}px;background:${COLS[i % COLS.length]}`;
          hero.appendChild(b);
          const a = (i / 18) * Math.PI * 2 + Math.random() * 0.35, v = 80 + Math.random() * 90;
          const dx = Math.cos(a) * v, dy = Math.sin(a) * v - 40;
          b.animate([
            { transform: 'translate(-50%, -50%) rotate(0deg)', opacity: 1 },
            { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) rotate(${220 + i * 25}deg)`, opacity: 1, offset: 0.55 },
            { transform: `translate(calc(-50% + ${dx * 1.25}px), calc(-50% + ${dy + 150}px)) rotate(${420 + i * 35}deg)`, opacity: 0 },
          ], { duration: 1100 + Math.random() * 500, easing: 'cubic-bezier(0.2, 0.7, 0.4, 1)' }).onfinish = () => b.remove();
        }
      });
      // every loop in the hero rests while it is off screen
      if ('IntersectionObserver' in window) new IntersectionObserver(([en]) => hero.classList.toggle('hw--rest', !en.isIntersecting)).observe(hero);
    }

    // 📰 THE LIVE TICKER, once the page has loaded and gone quiet: who is in Banana World right now (the four rooms'
    // own headcounts, added up), the town's day and the Wheel of Peel's pot, put in front of the all-time numbers.
    // Each only when it says something (two or more); a room that does not answer is left out, never guessed.
    const RAVE = 'https://banana-rave.trymstene.workers.dev/';
    const get = (u) => fetch(u).then((r) => (r.ok ? r.json() : null)).catch(() => null);
    const heads = (o) => (o && typeof o.count === 'number' ? o.count : 0);
    const live = async () => {
      const [rave, town, park, beach, life, pot] = await Promise.all([get(RAVE + 'count'), get(RAVE + 'town-count'),
        get(RAVE + 'park-count'), get(RAVE + 'beach-count'), get(RAVE + 'town-life'), get('https://banana-pass.trymstene.workers.dev/town/pot')]);
      // proof of life on the dance door
      const rc = document.getElementById('raveCount');
      if (rc && heads(rave) > 0) rc.textContent = heads(rave) === 1 ? '1 banana at the rave right now' : `${heads(rave)} bananas at the rave right now`;
      const tk = document.getElementById('tk');
      if (!tk) return;
      const L = JSON.parse(tk.dataset.live || '{}');
      const all = heads(rave) + heads(town) + heads(park) + heads(beach);
      const day = life && life.today;
      const items = [];
      if (all > 1) items.push([L.world, { n: all }]);
      else if (all === 1) items.push([L.worldOne, {}]);
      if (day && day.fixes > 1 && day.people > 1) items.push([L.town, { fixes: day.fixes, people: day.people }]);
      if (pot && pot.pot > 1) items.push([L.pot, { pot: pot.pot }]);
      if (!items.length) return;
      tk.querySelectorAll('.tk__half').forEach((half) => {
        const frag = document.createDocumentFragment();
        for (const [line, holes] of items) {
          const s = document.createElement('span');
          s.className = 'tk__i tk__i--live';
          for (const part of String(line).split(/(\{\w+\})/)) {
            const m = /^\{(\w+)\}$/.exec(part);
            if (m) { const b = document.createElement('b'); b.textContent = Number(holes[m[1]]).toLocaleString('en-GB'); s.appendChild(b); }
            else if (part) s.appendChild(document.createTextNode(part));
          }
          frag.appendChild(s);
        }
        half.prepend(frag);
      });
      tk.style.setProperty('--tk-len', String(+tk.dataset.len + items.reduce((a, [l]) => a + String(l).length, 0)));
    };
    addEventListener('load', () => (window.requestIdleCallback || setTimeout)(live));
  </script>
</BaseLayout>
