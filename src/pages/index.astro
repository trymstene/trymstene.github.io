---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackFan from '../components/PackFan.astro';
import { PACK_PRICE } from '../data/sticker-packs.js';

const title = "Trym Stene — the Dancing Banana Guy, since 1999";
const description = "Trym Stene — the guy who made the Dancing Banana GIF in 1999. Where the banana lives: the story, make your own, the live rave, and the official shop.";
const ogDescription = "The guy who made the Dancing Banana GIF. The story, the builder, the rave, the shop.";

// Entity / authorship: establishes Trym Stene as the verified creator for search + AI
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://trymstene.com/#website",
      "url": "https://trymstene.com/",
      "name": "Trym Stene",
      "description": "Trym Stene — the creator of the Dancing Banana GIF (1999). The banana's home: story, builder, live rave, and official shop.",
      "inLanguage": "en",
      "publisher": { "@id": "https://trymstene.com/#trym" }
    },
    {
      "@type": "Person",
      "@id": "https://trymstene.com/#trym",
      "name": "Trym Stene",
      "url": "https://trymstene.com/",
      "image": "https://trymstene.com/assets/trym-stene-profile-photo.jpg",
      "description": "Norwegian creator of the Dancing Banana GIF (1999). Lead SEO & CRO specialist, web comedian, and music producer as Sentry.",
      "jobTitle": "Lead SEO & CRO Specialist",
      "sameAs": [
        "https://www.facebook.com/trymstene",
        "https://twitter.com/trymstene",
        "https://www.linkedin.com/in/trymstene/",
        "https://www.instagram.com/trymstene/",
        "https://soundcloud.com/sentryofficial",
        "https://open.spotify.com/artist/3mPwC4BdfC6fxNg8pIlA4F"
      ]
    }
  ]
};

// 🌍 THE WORLD LANDING (13 Aug): the doors became a visual sell — feature
// stills exported from the reel scenes (tools/reel/export_stills.py) and
// REAL community homesteads (tools/build-yard-cards.py; re-run to refresh).
import yardCards from '../data/yard-cards.json';
// 🏆 the citizens of the week — frames baked by tools/build-citizen-cards.py (the deploy runs it daily)
import citizens from '../data/citizen.json';

// 🎉 THE HERO (26 Sep 2026). Trym: "hello there, and welcome to BANANA WORLD … small text on top and banana world in
// a slight arc and big text", "some movement and animations are nice and lively overall", the buttons with "no icons".
// The party: rays turning behind a spotlit banana, confetti, a crew in builder outfits dancing on the same beat (one
// strip each, the builder's own render resized once: tools/build-hero-dancers.py). The words are
// src/data/copy/home-hero.json. The rules it paid for (the builder's render never resampled, clip not hide, numbers that
// count what the line says) are design library §38; the page's inline CSS keeps only labels, because it ships to every
// visitor as written.
import W from '../data/copy/home-hero.json';
import homeStats from '../data/home-stats.json';
import { cleanName } from '../lib/player-name.js';
import CREW from '../data/hero-dancers.json';
// the name on its arch, a letter at a time: --t runs -1..1 across the whole name (one line), --tw across its own word
// (the two lines of a phone)
const NAME = W.title.split(' ');
const NAME_LEN = W.title.length;
let at = 0;
const LETTERS = NAME.map((w) => {
  const row = [...w].map((ch, i) => ({ ch, k: at + i, t: (2 * (at + i)) / (NAME_LEN - 1) - 1, tw: w.length > 1 ? (2 * i) / (w.length - 1) - 1 : 0 }));
  at += w.length + 1;
  return row;
});
// the crew, nearest the banana first: party, sombrero, duck, viking | crown, cowboy, propeller, top hat
const CREW_L = CREW.crew.slice(0, 4), CREW_R = CREW.crew.slice(4, 8);
const CONF_COLORS = ['#ff4d6d', '#55aaff', '#111111', '#fffdf5', '#58c05c', '#ff7bac'];
const CONFETTI = Array.from({ length: 24 }, (_, i) => `left:${(i * 37 + 11) % 100}%;background:${CONF_COLORS[i % CONF_COLORS.length]};`
  + `animation-duration:${(6 + (i % 5) * 1.6).toFixed(1)}s;animation-delay:-${((i * 1.37) % 9).toFixed(2)}s`);

// 📰 THE TICKER: the world's best numbers by popularity, all-time and read low (src/data/home-stats.json, tools/
// build-home-stats.py), between them the banana and a thing to do; the page's script puts the live ones in front
// (who is in the world right now, the town's day, the Wheel of Peel's pot). ⚠️ a line is split around its {holes}
// and the number goes in a <b>: nothing from the copy file is ever parsed as markup.
const fill = (line, holes) => line.split(/(\{\w+\})/).filter(Boolean).map((p) => {
  const m = /^\{(\w+)\}$/.exec(p);
  return m ? { b: holes[m[1]] } : { t: p };
});
const floorOf = (key) => {
  if (homeStats.n[key] == null) throw new Error(`home-hero.json ticker.stats "${key}" is not in src/data/home-stats.json — run python tools/build-home-stats.py`);
  return homeStats.n[key].toLocaleString('en-GB') + '+';
};
const citName = citizens.winners && citizens.winners.citizen ? cleanName(citizens.winners.citizen.name) : '';
const TICKS = [];
W.ticker.stats.forEach((s, i) => {
  TICKS.push(fill(s.line, { n: floorOf(s.key) }));
  if (i === 1 && citName) TICKS.push(fill(W.ticker.citizen, { name: citName }));
  if (i % 4 === 3 && W.ticker.lines[i >> 2]) TICKS.push(fill(W.ticker.lines[i >> 2], {}));
});
W.ticker.lines.slice(W.ticker.stats.length >> 2).forEach((l) => TICKS.push(fill(l, {})));
const TICK_LEN = TICKS.reduce((a, it) => a + it.reduce((b, p) => b + String(p.b ?? p.t).length, 0), 0);
const TICK_LIVE = JSON.stringify({ world: W.ticker.world, worldOne: W.ticker.worldOne, town: W.ticker.town, pot: W.ticker.pot });
const CIT_ORDER = [['citizen', 'Citizen of the week'], ['gardener', 'Gardener'], ['neighbour', 'Neighbour'], ['farmer', 'Farmer'], ['raver', 'Raver']];
const citWon = CIT_ORDER.filter(([p]) => citizens.winners && citizens.winners[p]);
// hero slides are HONEST world shots (tools/reel/export_hero.py: real plate
// crops, sprites at true game scale) — the stylized reel stills stay in the
// small feature cards where poster close-ups belong
const HERO_SLIDES = [
  { img: '/assets/world/hero-park.jpg', alt: 'The Park in Banana World — bananas at the fountain plaza' },
  { img: '/assets/world/hero-home.jpg', alt: 'A real visitor-built homestead in Banana World' },
  { img: '/assets/world/hero-bay.jpg', alt: 'Banana Bay — volleyball court, beach hut and palms' },
  { img: '/assets/world/hero-quest.jpg', alt: 'Nib the registrar waiting with a quest at the homestead gate' },
];
const FEATURES = [
  { k: 'homestead', line: 'Build your corner.', href: '/homestead/' },
  { k: 'builder', line: 'Dress the legend.', href: '/make-a-banana/' },
  { k: 'items', line: 'Draw it. Own it.', href: '/forge/items/' },
  { k: 'quest', line: 'A mystery from 1999.', href: '/town/' },
  { k: 'rave', line: 'The floor never stops.', href: '/rave/' },
  { k: 'treasure', line: 'X marks the sand.', href: '/beach/' },
  { k: 'fishing', line: 'Something’s biting.', href: '/beach/' },
  { k: 'tending', line: 'The park needs you.', href: '/park/' },
];
---
<BaseLayout title={title} description={description} ogDescription={ogDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <style is:inline slot="head">
    /* the hero: design library §38 */
    .hw {
      --ax: 2;
      position: relative; overflow: hidden; overflow: clip; isolation: isolate; text-align: center;
      background: var(--banana); padding: 1.1rem 1rem 2.6rem;
    }
    @media (min-width: 900px) { .hw { --ax: 3; padding-top: 1.4rem; } }
    .hw__conf { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
    .hw__conf b { position: absolute; top: -14px; width: 9px; height: 9px; animation: hwFall linear infinite; }
    .hw__conf b:nth-child(3n) { width: 7px; height: 12px; }
    @media (max-width: 699px) { .hw__conf b:nth-child(2n) { display: none; } }
    @keyframes hwFall { to { transform: translateY(1100px) rotate(620deg); } }

    /* the name on its arch: the outer span sits on the curve, the inner one pops (scale) and bobs (translate) */
    .hw__title { margin: 0; line-height: 1; }
    .hw__kicker {
      display: table; margin: 0 auto 0.5rem; text-transform: none; letter-spacing: 0.02em;
      font-family: "Space Grotesk", system-ui, sans-serif; font-size: clamp(0.9rem, 3.4vw, 1.15rem);
      transform: rotate(-2deg); box-shadow: 3px 3px 0 var(--ink);
    }
    .hw__name {
      display: block; margin: 0 auto 0.12em; text-transform: uppercase; color: var(--paper);
      font-size: clamp(2.6rem, 16.5vw, 4.6rem); font-size: clamp(2.6rem, min(16.5vw, 8.4svh), 4.6rem); line-height: 1.02; letter-spacing: 0.01em;
      -webkit-text-stroke: 0.055em var(--ink); paint-order: stroke fill;
    }
    .hw__word { display: block; white-space: nowrap; }
    .hw__l { --u: var(--tw); display: inline-block; transform: translateY(calc(var(--u) * var(--u) * 0.2em)) rotate(calc(var(--u) * 7deg)); }
    .hw__l > span { display: inline-block; filter: drop-shadow(0.05em 0.07em 0 var(--ink)); animation: hwPop 0.6s cubic-bezier(0.3, 1.7, 0.5, 1) calc(var(--k) * 45ms) backwards, hwWave 2.4s ease-in-out calc(var(--k) * -0.14s) infinite; }
    @keyframes hwPop { from { scale: 0.3; } }
    @keyframes hwWave { 50% { translate: 0 -0.07em; } }
    @media (min-width: 700px) {
      .hw__name { margin-bottom: 0.3em; font-size: clamp(3.4rem, 8.6vw, 7.4rem); }
      .hw__word { display: inline-block; }
      .hw__l { --u: var(--t); transform: translateY(calc(var(--u) * var(--u) * 0.3em)) rotate(calc(var(--u) * 8deg)); }
    }

    /* the stage */
    .hw__stage { position: relative; margin: 0 auto; width: clamp(150px, 52vw, 240px); width: clamp(150px, min(52vw, 26svh), 240px); }
    @media (min-width: 700px) { .hw__stage { width: clamp(150px, min(52vw, 29svh), 240px); } }
    .hw__rays {
      --R: max(135vw, 1250px);
      position: absolute; left: 50%; top: 50%; width: var(--R); height: var(--R); margin: calc(var(--R) / -2) 0 0 calc(var(--R) / -2);
      z-index: -3; pointer-events: none; border-radius: 50%;
      background: repeating-conic-gradient(from 0deg, #fff27a 0deg 9deg, rgba(255, 242, 122, 0) 9deg 18deg);
      animation: hwSpin 90s linear infinite;
    }
    @keyframes hwSpin { to { transform: rotate(360deg); } }
    .hw__stage::before {
      content: ''; position: absolute; left: 50%; top: 52%; width: 250%; aspect-ratio: 1; z-index: -2; pointer-events: none;
      transform: translate(-50%, -50%); border-radius: 50%;
      background: radial-gradient(closest-side, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.6) 40%, rgba(255, 255, 255, 0) 100%);
    }
    .hw__stage::after {
      content: ''; position: absolute; left: 24%; right: 24%; bottom: 3%; height: 7%; z-index: -1;
      border-radius: 50%; background: rgba(60, 40, 0, 0.18);
    }
    .hw__banana { position: relative; display: block; width: 100%; height: auto; cursor: pointer; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; }
    .hw__crew { position: absolute; bottom: 4%; display: flex; align-items: flex-end; gap: calc(var(--ax) * 5px); pointer-events: none; }
    .hw__crew--l { right: 86%; flex-direction: row-reverse; }
    .hw__crew--r { left: 86%; }
    .hw__d { position: relative; flex: none; overflow: hidden; overflow: clip; width: calc(var(--cols) * var(--ax) * 1px); height: calc(var(--rows) * var(--ax) * 1px); }
    .hw__d::before {
      content: ''; position: absolute; left: 0; top: 0; width: calc(var(--cols) * var(--ax) * 8px); height: 100%;
      background: var(--img) 0 0 / 100% 100% no-repeat; animation: hwDance 0.8s steps(8) infinite;
    }
    @keyframes hwDance { to { transform: translateX(calc(var(--cols) * var(--ax) * -8px)); } }
    .hw__crew--r .hw__d { scale: -1 1; }
    .hw__d:nth-of-type(n+2) { display: none; }
    @media (min-width: 560px) { .hw__d:nth-of-type(n+2) { display: block; } .hw__d:nth-of-type(n+3) { display: none; } }
    @media (min-width: 1100px) { .hw__d:nth-of-type(n+3) { display: block; } .hw__d:nth-of-type(n+4) { display: none; } }
    @media (min-width: 1300px) { .hw__d:nth-of-type(n+4) { display: block; } }

    .hw__bit { position: absolute; z-index: 4; width: 9px; height: 9px; pointer-events: none; }

    /* the line and the two doors: no icons, a drawn arrow */
    .hw__tag { max-width: 36ch; margin: 1.2rem auto 0; font-weight: 700; font-size: clamp(0.98rem, 2.6vw, 1.15rem); line-height: 1.4; text-wrap: balance; }
    .hw__cta { margin-top: 1.1rem; display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }
    .hw__cta .btn { display: inline-flex; align-items: center; justify-content: center; font-size: 1.08rem; padding: 0.9rem 1.5rem; }
    .hw__go { position: relative; overflow: hidden; overflow: clip; font-size: 1.15rem; }
    .hw__go::after {
      content: ''; position: absolute; top: -10%; bottom: -10%; left: 0; width: 34%; pointer-events: none;
      background: linear-gradient(100deg, rgba(255, 225, 53, 0), rgba(255, 225, 53, 0.32), rgba(255, 225, 53, 0));
      transform: translateX(-120%) skewX(-18deg); animation: hwShine 5s ease-in-out 1.6s infinite;
    }
    @keyframes hwShine { 0% { transform: translateX(-120%) skewX(-18deg); } 24%, 100% { transform: translateX(420%) skewX(-18deg); } }
    .hw__arrow { display: inline-block; margin-left: 0.45em; animation: hwNudge 1.6s ease-in-out infinite; }
    @keyframes hwNudge { 50% { translate: 4px 0; } }
    @media (max-width: 559px) { .hw__cta { flex-direction: column; align-items: center; } .hw__cta .btn { width: min(100%, 19rem); } }

    .hw--rest *, .hw--rest *::before, .hw--rest *::after { animation-play-state: paused !important; }
    @media (prefers-reduced-motion: reduce) {
      .hw__conf { display: none; }
      .hw__rays, .hw__l > span, .hw__d::before, .hw__go::after, .hw__arrow { animation: none; }
    }

    /* the ticker */
    .tk .marquee__track { animation-duration: calc(var(--tk-len) * 0.16s); }
    .tk__i { display: inline-block; }
    .tk__i::after { content: ''; display: inline-block; vertical-align: 0.1em; width: 7px; height: 7px; margin: 0 1.05rem; background: var(--hot); transform: rotate(45deg); }
    .tk__i b { color: var(--paper); }
    .tk__i--live::before { content: ''; display: inline-block; vertical-align: 0.05em; width: 8px; height: 8px; margin-right: 0.5rem; background: #37d67a; animation: doorPulse 1.2s steps(2) infinite; }

    /* 🌍 the world landing — highly visual, tiny copy, CTA always in reach */
    /* a cinematic STRIP, not a billboard — capped height so it never owns
       the whole viewport (Trym: way too much space) */
    .bwl-hero {
      position: relative; max-width: 1160px; margin: 1.6rem auto 0; aspect-ratio: 21 / 9;
      max-height: 420px; width: 100%;
      border: 4px solid var(--ink); border-radius: 16px; overflow: hidden;
      box-shadow: 8px 8px 0 var(--ink); background: var(--ink);
    }
    @media (max-width: 640px) { .bwl-hero { aspect-ratio: 4 / 3; } }
    .bwl-hero img {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      opacity: 0; transition: opacity 0.7s ease;
    }
    .bwl-hero img.on { opacity: 1; animation: bwlKen 5s ease-in-out forwards; }
    @keyframes bwlKen { from { transform: scale(1); } to { transform: scale(1.07); } }
    /* ⚠️ centred WITHOUT a transform: .btn:hover sets its own transform, which
       REPLACES translateX(-50%) and threw the button half its width to the
       right on every hover (Trym saw it flicker). Same trap as the quest
       dialogue's keyframes — never centre a .btn with transform. */
    .bwl-hero__cta {
      position: absolute; left: 0; right: 0; bottom: 5%; margin-inline: auto;
      width: max-content; z-index: 2;
      white-space: nowrap; box-shadow: 4px 4px 0 rgba(0,0,0,0.55);
    }
    @media (prefers-reduced-motion: reduce) { .bwl-hero img.on { animation: none; } }
    .bwl-grid {
      display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr);
      max-width: 1160px; margin: 1.4rem auto 0;
    }
    @media (min-width: 760px) { .bwl-grid { grid-template-columns: repeat(4, 1fr); } }
    .bwl-card {
      display: block; position: relative; border: 3px solid var(--ink); border-radius: 14px;
      overflow: hidden; box-shadow: 5px 5px 0 var(--ink); text-decoration: none; color: #fffdf5;
      transition: transform 0.12s ease, box-shadow 0.12s ease; background: var(--ink);
    }
    .bwl-card:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); }
    .bwl-card img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
    .bwl-card b {
      position: absolute; left: 0; right: 0; bottom: 0; padding: 1.6rem 0.7rem 0.6rem;
      font-family: "Archivo Black", sans-serif; font-size: clamp(0.85rem, 2.2vw, 1.05rem); line-height: 1.1;
      background: linear-gradient(transparent, rgba(10, 8, 4, 0.88) 55%);
      text-shadow: 0 2px 0 rgba(0,0,0,0.6);
    }
    .bwl-sub { font-family: "Archivo Black", sans-serif; font-size: clamp(1.2rem, 4vw, 1.7rem); margin: 2.4rem 0 0.2rem; }
    /* 🏆 the citizens' frames: the Citizen big, the five plaques in a row */
    .bwl-cit { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.7rem; margin: 1rem auto 0; max-width: 820px; }
    .bwl-cit__frame { display: block; }
    .bwl-cit__frame img { display: block; width: 100%; height: auto; }
    .bwl-cit__frame--big { grid-column: 1 / -1; max-width: 300px; margin: 0 auto; }
    .bwl-cit__rule { margin: 0.7rem 0 0; font-size: 0.86rem; opacity: 0.8; }
    @media (max-width: 640px) { .bwl-cit { grid-template-columns: repeat(2, minmax(0, 1fr)); } .bwl-cit__frame--big { max-width: 240px; } }
    .bwl-subnote { margin: 0.2rem 0 0; font-size: 0.92rem; opacity: 0.75; }
    .bwl-yards {
      display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      max-width: 1160px; margin: 1.2rem auto 0;
    }
    .bwl-yard {
      display: block; position: relative; border: 3px solid var(--ink); border-radius: 14px;
      overflow: hidden; box-shadow: 5px 5px 0 var(--ink); text-decoration: none; color: var(--ink);
      transition: transform 0.12s ease, box-shadow 0.12s ease; background: var(--paper);
    }
    .bwl-yard:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); }
    .bwl-yard img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
    .bwl-yard__tag {
      position: absolute; left: 10px; top: 10px; max-width: calc(100% - 20px);
      background: var(--banana); border: 2px solid var(--ink); border-radius: 6px;
      padding: 0.2rem 0.5rem; font-size: 0.8rem; font-weight: 800;
      transform: rotate(-2deg); box-shadow: 2px 2px 0 rgba(0,0,0,0.4);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .bwl-yard__go {
      position: absolute; right: 10px; bottom: 10px;
      background: var(--ink); color: var(--banana); border-radius: 999px;
      padding: 0.25rem 0.65rem; font-size: 0.75rem; font-weight: 800;
    }
    .bwl-yard--you {
      display: grid; place-content: center; gap: 0.2rem; text-align: center;
      background: repeating-linear-gradient(45deg, var(--paper) 0 14px, #f2ecdc 14px 28px);
      min-height: 180px; border-style: dashed;
    }
    .bwl-yard--you .bwl-yard__plus { font-family: "Archivo Black", sans-serif; font-size: 2.4rem; line-height: 1; }
    .bwl-yard--you b { font-family: "Archivo Black", sans-serif; }
    .bwl-yard--you span:last-child { font-size: 0.8rem; font-weight: 800; opacity: 0.7; }
    .bwl-cta { text-align: center; margin-top: 2.2rem; }
    .bwl-fine { margin: 0.6rem 0 0; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.6; }
    .bwl-also { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-top: 1.6rem; font-weight: 700; }
  </style>

  {/* 📰 the ticker: the world's numbers (the frontmatter), the live ones put in front by the script below */}
  <div class="marquee tk" slot="banner" aria-hidden="true" id="tk" data-live={TICK_LIVE} data-len={TICK_LEN} style={`--tk-len:${TICK_LEN}`}>
    <div class="marquee__track">
      {[0, 1].map(() => (
        <span class="tk__half">{TICKS.map((it) => <span class="tk__i">{it.map((p) => (p.b != null ? <b>{p.b}</b> : p.t))}</span>)}</span>
      ))}
    </div>
  </div>

  {/* 🎉 the hero: the hello, the arched name, the banana and its crew, the two doors */}
  <section class="hw" id="hero" style={`--cols:${CREW.cols};--rows:${CREW.rows}`}>
    <div class="hw__conf" aria-hidden="true">{CONFETTI.map((s) => <b style={s}></b>)}</div>
    <h1 class="hw__title">
      <span class="kicker hw__kicker">{W.kicker}</span>
      <span class="hw__name">{LETTERS.map((w, wi) => (
        <Fragment>{wi > 0 && ' '}<span class="hw__word">{w.map((l) => <span class="hw__l" style={`--t:${l.t.toFixed(3)};--tw:${l.tw.toFixed(3)};--k:${l.k}`}><span>{l.ch}</span></span>)}</span></Fragment>
      ))}</span>
    </h1>
    <div class="hw__stage">
      <div class="hw__rays" aria-hidden="true"></div>
      <div class="hw__crew hw__crew--l" aria-hidden="true">{CREW_L.map((n) => <i class="hw__d" style={`--img:url(/assets/hero/dancer-${n}.webp)`}></i>)}</div>
      <img class="hw__banana" src="/assets/dancing-banana-transparent.gif" alt={W.alt}
           width="500" height="500" fetchpriority="high" draggable="false">
      <div class="hw__crew hw__crew--r" aria-hidden="true">{CREW_R.map((n) => <i class="hw__d" style={`--img:url(/assets/hero/dancer-${n}.webp)`}></i>)}</div>
    </div>
    <p class="hw__tag">{W.tag}</p>
    {/* 🌍 ONE DOOR (Trym, 13 Aug): the per-area buttons collapsed into a
         single entrance — the world is one place now and the town is its
         front door. "Enter" was the chosen verb: a place you walk into —
         "Join" read as signing up, "Play" shrank it to a minigame. No icons
