---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyLine from '../components/CopyLine.astro';
import { faqLd } from '../lib/faq.js';
import PP from '../data/copy/pbjt-page.json';   // ❓ the questions: on the page and in its FAQPage, one list
import PixelIcon from '../components/PixelIcon.astro';

const title = "Peanut Butter Jelly Time — the Dancing Banana, Explained";
const description = "Yes — the dancing banana in 'Peanut Butter Jelly Time' is the original 1999 GIF by Trym Stene, made years before the song. Who made what, explained.";
const ogDescription = "The dancing banana in Peanut Butter Jelly Time is the original 1999 GIF — it predates the song by years. Who made what, explained.";

// 🕸 who made what, said to a machine: the banana (Trym's, the image below) and the song (The Buckwheat Boyz') are two
// works; the Flash video that paired them was someone else's again
const bananaLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  '@id': 'https://trymstene.com/peanut-butter-jelly-time/#image',
  contentUrl: 'https://trymstene.com/assets/dancing-banana-gif.gif',
  url: 'https://trymstene.com/peanut-butter-jelly-time/',
  name: 'The Peanut Butter Jelly Time banana — the original 1999 Dancing Banana GIF',
  encodingFormat: 'image/gif',
  width: 500,
  height: 500,
  creator: { '@id': 'https://trymstene.com/#trym' },
  creditText: 'Trym Stene',
  copyrightNotice: '© Trym Stene',
  license: 'https://trymstene.com/license-the-dancing-banana/',
  acquireLicensePage: 'https://trymstene.com/license-the-dancing-banana/',
  isBasedOn: { '@id': 'https://trymstene.com/#banana-gif' },
};
const SONG = { '@type': 'MusicRecording', name: 'Peanut Butter Jelly Time', byArtist: { '@type': 'MusicGroup', name: 'The Buckwheat Boyz' } };
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Dancing Banana GIF', item: 'https://trymstene.com/dancing-banana-gif-meme/' },
    { '@type': 'ListItem', position: 2, name: 'Peanut Butter Jelly Time', item: 'https://trymstene.com/peanut-butter-jelly-time/' },
  ],
};

// ❓ the questions are ONE list (src/data/copy/pbjt-page.json): drawn in the FAQ below and made into the FAQPage here, so
// what a search engine reads is what is on the page (src/lib/faq.js; tools/check-structured-data.mjs holds it)
const faq = faqLd(PP.faq.items);
---
<BaseLayout
  title={title}
  description={description}
  ogTitle="Peanut Butter Jelly Time — the Dancing Banana, Explained"
  ogImage="https://trymstene.com/assets/og/pbjt.png"
  ogDescription={ogDescription}
  ogType="article"
  about="https://trymstene.com/#banana-gif"
  primaryImage="https://trymstene.com/peanut-butter-jelly-time/#image"
  pageExtra={{ mentions: [SONG] }}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faq)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(bananaLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbLd)} />

  <!-- hero -->
  <section class="hero">
    <div class="hero__banana">
      <img src="/assets/dancing-banana-gif.gif" alt="The Peanut Butter Jelly Time dancing banana"
           onerror="this.outerHTML='<div class=&quot;banana-fallback&quot;>🍌</div>';">
    </div>
    <p class="kicker">It's peanut butter jelly time</p>
    <h1 class="hero__title" style="font-size:clamp(2rem,8vw,3.6rem);">the peanut butter<br>jelly time banana</h1>
    <p class="hero__tag" style="text-transform:none;font-weight:500;">Same banana, older than the song — here's who made what.</p>
  </section>

  <!-- answer-first -->
  <section class="block">
    <p class="lead" style="max-width:64ch;margin-inline:auto;font-size:1.2rem;">
      The banana dancing in <strong>"Peanut Butter Jelly Time"</strong> is the original
      <strong>Dancing Banana</strong> I made back in <strong>1999</strong> — years before the song existed.
      The song is all <strong>The Buckwheat Boyz'</strong> — the banana just turned out to be a good dancer.
    </p>
  </section>

  <!-- who made what -->
  <section class="block block--yellow">
    <p class="kicker">Who made what</p>
    <h2>Three different things, three different people</h2>
    <div class="faq__item">
      <h3><PixelIcon name="banana" /> The banana — me</h3>
      <p>The Dancing Banana GIF, animated by <strong>Trym Stene in 1999</strong>. It started life as a little "celebration" emoticon on web forums, long before any song.</p>
    </div>
    <div class="faq__item">
      <h3><PixelIcon name="note" /> The song — The Buckwheat Boyz</h3>
      <p>"Peanut Butter Jelly Time" is a song by <strong>The Buckwheat Boyz</strong>. That's theirs, not mine.</p>
    </div>
    <div class="faq__item">
      <h3><PixelIcon name="floppy" /> The Flash video — someone else again</h3>
      <p>Later, someone paired my banana with their song in a <strong>Flash animation</strong> that went viral on the early internet. Different creator again — but the banana on screen is the one I drew.</p>
    </div>
  </section>

  <!-- download / make -->
  <section class="block">
    <p class="kicker">Take the banana with you</p>
    <h2>Get the dancing banana</h2>
    <p class="lead">Free to download, share and remix — the original GIF and a transparent version.</p>
    <div class="grab">
      <img src="/assets/dancing-banana-transparent.gif" alt="The Dancing Banana GIF">
      <div class="dl-buttons">
        <a class="btn btn--dark" href="/assets/dancing-banana-gif.gif" download="dancing-banana-trymstene.com.gif">Original GIF ↓</a>
        <a class="btn btn--light" href="/assets/dancing-banana-transparent.png" download="dancing-banana-transparent-trymstene.com.png">Transparent PNG ↓</a>
      </div>
    </div>
    <p class="dl-door">It's yours <PixelIcon name="banana" /> — and it can also wear a hat. <a href="/make-a-banana/" data-place="post-dl-pbjt">Dress your own →</a></p>
    <p style="margin-top:1.5rem;">
      <a class="btn btn--dark" href="/make-a-banana/"><PixelIcon name="palette" /> Make your own dancing banana →</a>
    </p>
  </section>

  <!-- FAQ -->
  <section class="block block--dark">
    <p class="kicker kicker--light">{PP.faq.kicker}</p>
    <h2>{PP.faq.heading}</h2>
    {PP.faq.items.map((it) => (
      <div class="faq__item">
        <h3>{it.q}</h3>
        <p><CopyLine s={it.a} /></p>
      </div>
    ))}
  </section>


  <script>
    // 🛍 the download moment — the ask lands when the wish is granted, never
    // before it. See OFFERS in make-it-real.js for why this page shows THIS one.
    import { wireDownloads } from '../lib/make-it-real.js';
    wireDownloads('pbjt');   // the card names the banana the way this page's visitors do
  </script>
</BaseLayout>
