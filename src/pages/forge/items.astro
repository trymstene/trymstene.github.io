---
// 🎁 THE ITEMS WORKSHOP — the Forge's Banana-World bench at its own address.
// Split out of /forge/ (task #102) so the emoji maker can court "emoji maker"
// searchers undistracted while this page speaks pure world vocabulary.
// Noindexed: the world's doors are its entrance, not Google.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ForgeStudio from '../../components/ForgeStudio.astro';

const title = 'The Items Workshop — draw gear for the Dancing Banana';
const description = 'Draw an item right on the original 1999 Dancing Banana — a hat, a sword, a rubber duck — and submit it. Approved gear goes on sale at the Banana Stand where any visitor can buy and wear it, with your name on the label — and approved furniture reaches every homestead’s phone store.';
---
<BaseLayout
  title={title}
  description={description}
  robots="noindex,follow"
  ogTitle="The Items Workshop 🎁"
  ogDescription="Draw an item on the 1999 Dancing Banana — approved gear goes on sale at the Banana Stand with your name on the label."
  ogImage="https://trymstene.com/assets/og/builder.png"
>
  <div class="fg-wrap">
    <div class="fg-head">
      <h1>the items workshop — draw gear for the dancing banana</h1>
      <p>
        <strong>Draw gear the banana wears, or furniture for a <a href="/homestead/">homestead</a></strong> —
        a hat, a sword, a rubber duck, an armchair — and send it in. Approved pieces go
        <strong>on sale</strong>: gear in the <a href="/park/">Banana Stand</a>'s back-catalog, furniture in
        the homestead phone store. Anyone can buy yours, wear or place it across Banana World, and
        <strong>your name rides along as the maker</strong>.
      </p>
    </div>

    <ForgeStudio mode="items" />

    <section class="fg-steps" aria-label="How the Items Workshop works">
      <h2>How an item reaches the world</h2>
      <div class="fg-stepgrid">
        <div class="fg-step"><b>1</b><span><strong>Pick what you're making</strong> — wearable gear the banana puts on, or furniture that stands in a homestead. The bench changes to suit it.</span></div>
        <div class="fg-step"><b>2</b><span><strong>Draw it</strong> — gear goes straight onto the banana, so where you draw is where it rides. Furniture stands on the floor, with the tile grid showing its footprint.</span></div>
        <div class="fg-step"><b>3</b><span><strong>Check it, then send it in</strong> — watch the dance, or see your furniture in a yard and a room. Name it, sign it; the verdict lands on <a href="/pass/">your pass</a>.</span></div>
        <div class="fg-step"><b>4</b><span><strong>It goes on sale, with your name on it</strong> — approved gear reaches the <a href="/park/">Banana Stand</a>'s back-catalog and furniture the <a href="/homestead/">homestead</a> phone store. Anyone can buy it, and you're credited as the maker.</span></div>
      </div>
    </section>

    <section class="fg-doorswrap" aria-label="More from Banana World">
      <h2>More from the banana world</h2>
      <div class="fg-doors">
        <a href="/park/" data-place="items-doors"><b>The Banana Stand 🏪</b><span>Where approved gear goes on sale — the back-catalog of everything visitors have made.</span></a>
        <a href="/pass/" data-place="items-doors"><b>Your Banana Pass 🎫</b><span>Your saved items live on your shelf, and submission verdicts land here.</span></a>
        <a href="/make-a-banana/" data-place="items-doors"><b>Dress the banana 🍌</b><span>Build your own dancing banana — hats, shades, captions — and download it free.</span></a>
        <a href="/forge/" data-place="items-doors"><b>The Pixel Forge 🎨</b><span>The other bench: draw emoji, emotes and animated GIFs from scratch, free.</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
