---
// 🎩 THE SUPPORTERS WALL — and the place you actually join. This page IS the
// storefront: the living wall in the park's own plaques, the recent-support
// feed, a one-off coffee, and the three tiers with in-game art of what you get.
// Every button mints its checkout on our own worker and lands straight on
// payment — no hop to anybody else's profile page.
// Data: worker-pass GET /supporters — public names only, private supporters
// already filtered server-side.
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAY, RAIL } from '../data/pay-rail.js';
const WORKER = 'https://banana-pass.trymstene.workers.dev';
const TIERS = [
  {
    key: 'blue', tier: 'sup-t1', name: 'Friend of the Banana', price: 5,
    hat: 'Blue Top Hat', blurb: 'You keep the lights on and the banana dancing.',
    perks: ['The Blue Top Hat — never for sale', 'A blue glow under your banana', 'Your name on the park board', 'Your name on this wall'],
  },
  {
    key: 'silver', tier: 'sup-t2', name: 'Patron of the Park', price: 10,
    hat: 'Silver Top Hat', blurb: 'A real part of why Banana World stays free.',
    perks: ['The Silver Top Hat — taller, pinstriped', 'Moonlight glow under your banana', 'Your name on the park board', 'Higher up this wall'],
  },
  {
    key: 'gold', tier: 'sup-t3', name: 'Legend of Banana World', price: 15,
    hat: 'Gold Top Hat', blurb: 'The tallest hat in the world, worn only by legends.',
    perks: ['The Gold Top Hat — woven satin', 'The full golden radiance', 'Your name in gold on the board', 'Top of this wall, and my gratitude'],
  },
];
---
<BaseLayout
  title="Supporters of Banana World"
  description="Join the people keeping Banana World free — three membership tiers, each with a top hat and a glow your banana wears everywhere. See the supporters wall and the latest support.">
  <link rel="stylesheet" href="/css/plaques.css" slot="head" />
  <style is:inline slot="head">
    /* ⚠️ ONE GUARD FOR THE WHOLE PAGE. `[hidden]` loses to any author
       `display:` — and it did: the supporter banner is a flex row, so the
       empty box was rendering for every visitor who was not a supporter. */
    [hidden] { display: none !important; }
    .sw { background: #14181d; color: #f2e8d8; padding: 2.4rem 1.1rem 4rem; }
    .sw__in { max-width: 940px; margin: 0 auto; }
    .sw__kicker { color: #ffd23f; font-weight: 800; font-size: 0.74rem; letter-spacing: 0.15em; text-transform: uppercase; margin: 0 0 0.4rem; }
    .sw h1 { font-family: "Archivo Black", sans-serif; font-size: clamp(1.8rem, 7vw, 2.8rem); margin: 0 0 0.7rem; color: #fff; line-height: 1.05; }
    .sw__lede { line-height: 1.6; font-size: 1rem; margin: 0 0 var(--gap-part); max-width: 60ch; opacity: 0.92; }
    /* 🧭 a way into a page this tall — three doors, not a menu */
    .sw__jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: var(--gap-part) 0 0; padding: 0; list-style: none; }
    .sw a.sw__jumpl {
      display: inline-block; text-decoration: none; font-size: 0.82rem; font-weight: 800;
      letter-spacing: 0.04em; color: #f2e8d8; padding: 0.7rem 0.9rem;
      border: 2px solid #4a5666; background: #1b2129;
    }
    /* ⚠️ the outlined chips go yellow on hover — which on the FILLED chip
       painted yellow text on a yellow background and erased the label. A
       shared :hover that only swaps a colour cannot serve both variants. */
    .sw a.sw__jumpl:not(.sw__jumpl--go):hover { border-color: #ffd23f; color: #ffd23f; }
    /* the page's purpose, carrying its price — the only thing that put a
       number above the fold for somebody who is not a supporter yet */
    .sw a.sw__jumpl--go { background: #ffd23f; color: #111; border-color: #111; }
    .sw a.sw__jumpl--go:hover { background: #ffe14d; color: #111; }
    /* headings you can land on should not land under the sticky header */
    .sw__sec { scroll-margin-top: 2rem; }
    .sw a { color: #ffd23f; }

    /* ---- the three tiers: the shop, in the world's own furniture ---- */
    .sw__tiers { display: grid; gap: var(--gap-sub); grid-template-columns: repeat(auto-fit, minmax(258px, 1fr)); margin: 0; }
    .swt {
      position: relative;
      display: flex; flex-direction: column; background: #1b2129;
      border: 3px solid #2c3542; box-shadow: 7px 7px 0 #000; overflow: hidden;
    }
    .swt--blue { border-color: #3564d9; }
    .swt--silver { border-color: #9aa4b2; }
    .swt--gold { border-color: #eda912; }
    /* the art crops to a letterbox rather than running full-square: three
       square cards stacked made the phone page a 4000px scroll */
    /* ⚠️ 5/4 put the Join button of the first card BELOW the fold on a 360
       phone that had just tapped "Memberships" — the picture was the largest
       object in the stack and the least informative part of it */
    @media (max-width: 560px) { .swt__art { aspect-ratio: 5 / 3 !important; } }
    .swt__art {
      display: block; width: 100%; height: auto; aspect-ratio: 5 / 4;
      object-fit: cover; object-position: 50% 88%;
      image-rendering: pixelated; border-bottom: 3px solid #2c3542;
    }
    .swt--blue .swt__art { border-color: #3564d9; }
    .swt--silver .swt__art { border-color: #9aa4b2; }
    .swt--gold .swt__art { border-color: #eda912; }
    .swt__body { padding: 0.9rem 1rem 1.1rem; display: flex; flex-direction: column; flex: 1; }
    .swt__name { font-family: "Archivo Black", sans-serif; font-size: 1.02rem; margin: 0 0 0.15rem; }
    .swt--blue .swt__name { color: #7fa3f5; }
    .swt--silver .swt__name { color: #dfe5ec; }
    .swt--gold .swt__name { color: #ffd84d; }
    .swt__price { font-family: "Archivo Black", sans-serif; font-size: 1.5rem; color: #fff; margin: 0 0 0.5rem; }
    .swt__price small { font-size: 0.72rem; font-family: inherit; opacity: 0.6; font-weight: 400; }
    .swt__blurb { margin: 0 0 0.7rem; font-size: 0.9rem; line-height: 1.5; opacity: 0.85; }
    .swt__plaq { margin: 0 0 0.9rem; }
    .swt__perks { list-style: none; margin: 0 0 1.1rem; padding: 0; display: grid; gap: 0.35rem; }
    .swt__perks li { font-size: 0.86rem; line-height: 1.4; display: flex; gap: 0.5rem; }
    .swt__perks li::before { content: "▸"; color: #ffd23f; flex: 0 0 auto; }
    .swt__idnote {
      margin: 0 0 0.7rem; font-size: 0.76rem; line-height: 1.45; opacity: 0.8;
      border-left: 3px solid #ffd23f; padding-left: 0.55rem;
    }
    .sw a.swt__join {
      margin-top: auto; display: block; text-align: center; text-decoration: none;
      background: #ffd23f; color: #111; font-weight: 800; padding: 0.7rem 1rem;
      border: 3px solid #111; box-shadow: 4px 4px 0 #000;
    }
    .sw a.swt__join:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 #000; }

    /* ---- the wall + the feed ---- */
    /* ⚠️ ONE COLUMN, EVERYWHERE. As a peer column the feed was a 419x251 dead
       field at 1180 — it can never fill a width it was given, because it is
       three lines. It is a SUB-PART of the wall, so it reads like one: the
       between-sections gap made it look like a fourth destination. */
    .sw__cols { display: grid; gap: var(--gap-sub); grid-template-columns: 1fr; }
    .sw__feedh {
      margin: 0 0 0.45rem; font-size: 0.6rem; font-weight: 800;
      letter-spacing: 0.13em; text-transform: uppercase; opacity: 0.6;
    }
    
    /* ── THE VERTICAL SCALE ─────────────────────────────────────────────
       ⚠️ A HEADING'S JOB IS TO BREAK CONTENT UP, so it needs space ABOVE it —
       more above than below, or it belongs to the wrong side. These headings
       had `margin: 0 0 0.2rem` and sat flush against the block before them.
         --gap-sec   between two top-level sections
         --gap-head  above a heading inside a section
         --gap-part  between a section's own sub-parts
       Nothing on this page invents its own vertical number. */
    .sw { --gap-sec: 3rem; --gap-sub: 1.75rem; --gap-part: 1.15rem; }
    @media (min-width: 780px) { .sw { --gap-sec: 3.75rem; } }
    .sw__sec + .sw__sec { margin-top: var(--gap-sec); }
    .sw h2 {
      font-family: "Archivo Black", sans-serif; font-size: 1.25rem; color: #ffd23f;
      margin: 0 0 0.3rem; line-height: 1.15;
    }
    .sw__sub { margin: 0 0 var(--gap-part); font-size: 0.86rem; opacity: 0.65; max-width: 66ch; }
    /* 🔢 THE COUNT — a number is not a design. Scaling the type up and leaving
       it floating is the laziest version of a stat; the figure gets an OBJECT
       to sit on: a banana-yellow tile, knocked a couple of degrees off square
       so it reads as something pinned to the page rather than a bigger word. */
    .sw__stat { display: flex; align-items: center; gap: 0.7rem; margin: 0; }
    .sw__stat b {
      flex: 0 0 auto; display: grid; place-items: center;
      min-width: 54px; height: 54px; padding: 0 0.5rem;
      background: #ffd23f; color: #14181d; border: 3px solid #2c3542;
      transform: rotate(-3deg);
      font-family: "Archivo Black", sans-serif; font-size: 1.7rem; line-height: 1;
    }
    .sw__stat span { font-size: 0.9rem; line-height: 1.45; opacity: 0.8; max-width: 30ch; text-wrap: balance; }

    /* lit, not boxed — the same move as the park's spotlight */
    .sw__you {
      display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;
      background: radial-gradient(70% 130% at 22% 50%, rgba(255, 210, 63, 0.16), rgba(255, 210, 63, 0) 70%);
      border-left: 3px solid #ffd23f; padding: 0.85rem 0.95rem; margin: var(--gap-part) 0 0;
    }
    .sw__youhat { image-rendering: pixelated; height: 38px; width: auto; flex: 0 0 auto; }
    .sw__youtxt { flex: 1 1 240px; margin: 0; font-size: 0.92rem; line-height: 1.5; }
    .sw a.sw__youbtn {
      flex: 0 0 auto; text-decoration: none; background: #ffd23f; color: #111;
      font-weight: 800; font-size: 0.84rem; padding: 0.55rem 0.9rem;
      border: 3px solid #111; box-shadow: 3px 3px 0 #000; white-space: nowrap;
    }
    .sw a.sw__youbtn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    /* the tier you are already on stops being a sales pitch */
    .swt--mine { outline: 3px solid #ffd23f; outline-offset: 3px; }
    /* out of flow, or the flagged card grows and the set stops lining up */
    .swt__mine {
      position: absolute; top: 0; left: 0; right: 0; z-index: 2; margin: 0;
      background: #ffd23f; color: #111; font-weight: 800;
      font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase;
      text-align: center; padding: 0.3rem;
    }
    .sw__idnote {
      margin: var(--gap-part) 0; font-size: 0.82rem; line-height: 1.5; opacity: 0.85;
      border-left: 3px solid #ffd23f; padding-left: 0.6rem;
    }
    .sw__empty { margin: 0; font-size: 0.88rem; opacity: 0.6; }
    .swf { margin: 0; padding: 0; list-style: none; }
    .swf li { border-bottom: 1px solid #242c37; padding: 0.5rem 0.1rem; font-size: 0.92rem; }
    .swf b { color: #fff; }
    .swf time { opacity: 0.55; font-size: 0.8rem; margin-left: 0.35rem; }
    /* the one-time card: same furniture, laid on its side so it reads as the
       alternative to a subscription rather than a fourth tier */
    /* ☕ THE COFFEE — the one warm panel on a dark page, in the slat's own
       wood, so the eye lands on it between the wall and the memberships.
       No card border: a torn top and bottom edge drawn from the slat art
       instead, so it reads as a plank nailed across the page. */
    .swc {
      position: relative; margin: 0; padding: 1.4rem 1.1rem 1.5rem;
      background:
        linear-gradient(rgba(224, 205, 168, 0.17), rgba(224, 205, 168, 0.04)),
        radial-gradient(80% 120% at 20% 0%, rgba(255, 210, 63, 0.12), rgba(255, 210, 63, 0) 70%);
      border-top: 3px solid #6c675c; border-bottom: 3px solid #6c675c;
    }
    /* it is a section too, so the scale owns its outer space and the panel
       only owns its inner */
    .sw__sec.swc { padding: 1.4rem 1.1rem 1.5rem; }
    /* a plank nailed across the page has to reach both edges of it */
    @media (max-width: 780px) { .sw__sec.swc { margin-inline: -1.1rem; } }
    .swc__head { display: flex; align-items: flex-start; gap: 0.8rem; margin-bottom: 1.1rem; }
    .swc__coin { image-rendering: pixelated; flex: 0 0 auto; }
    .swc__h {
      font-family: "Archivo Black", sans-serif; font-size: 1.15rem; margin: 0 0 0.3rem;
      color: #f0e6d2 !important;
    }
    .swc__sub { margin: 0; font-size: 0.87rem; line-height: 1.5; opacity: 0.8; }
    /* the amounts ARE the slats — tapping one is tapping the thing you get */
    .swc__amts { display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem 0.35rem; }
    /* ⚠️ `.sw a` paints every link banana-yellow, which on pale wood is
       invisible — the plaque's own ink has to win here.
       Drawn at x3 rather than x2: a whole INTEGER step, so the pixels stay
       square, and it lands near a 44px tap target instead of a 30px one. */
    .sw a.swc__amt {
      color: #2a2110; text-decoration: none; text-align: center;
      height: 45px; line-height: 45px; min-width: 96px; padding: 0 30px;
      font-size: 0.95rem; margin: 0 6px 8px 0;
      background-size: 36px 45px, 36px 45px, 12px 45px;
      background-position: left top, right top, 36px top;
      transition: transform 0.08s ease, filter 0.12s ease;
    }
    .sw a.swc__amt:hover { transform: translateY(-2px); --pg: rgba(255, 225, 150, 0.55); }
    .sw a.swc__amt:active { transform: translateY(1px); }
    .sw a.swc__any {
      flex: 0 0 100%; display: inline-block; margin: 0.4rem 0 0; padding: 0.75rem 0;
      font-size: 0.84rem; font-weight: 700;
      color: #e6dcc6; text-decoration: underline; text-underline-offset: 3px;
    }
    @media (max-width: 400px) {
      .sw a.swc__amt { min-width: 70px; padding: 0 24px; }
    }

    .sw__note { margin-top: var(--gap-sec); font-size: 0.85rem; opacity: 0.7; line-height: 1.6; max-width: 66ch; }
  </style>

  <section class="sw">
    <div class="sw__in">
      <section class="sw__sec">
      <p class="sw__kicker">the people keeping the banana dancing</p>
      <h1>The Supporters Wall</h1>
      <p class="sw__lede">
        The rave, the park, the bay, the builder — all free, no ads, no accounts.
        It stays that way because of these bananas.
      </p>
      <p class="sw__stat"><b id="swCount">—</b> <span>keeping the lights on</span></p>

      {/* 🧭 the page is four screens tall on a phone — three doors in, so the
          memberships are not something you have to scroll past the wall to find */}
      <ul class="sw__jump">
        <li><a class="sw__jumpl" href="#wall">The wall</a></li>
        <li><a class="sw__jumpl" href="#coffee">Buy a coffee</a></li>
        <li><a class="sw__jumpl sw__jumpl--go" href="#join">Memberships from $5</a></li>
      </ul>

      <!-- 💛 an existing supporter should never be sold what they already have -->
      <div class="sw__you" id="swYou" hidden>
        <img class="sw__youhat" id="swYouHat" src="/assets/supporters/hat-blue.png" alt="" width="38" height="34" />
        <p class="sw__youtxt" id="swYouTxt"></p>
        <a class="sw__youbtn" id="swYouManage" href="/pass/">Manage or cancel →</a>
      </div>
      </section>

      <section class="sw__sec" id="wall">
      <div class="sw__cols">
        <div>
          <h2>The wall</h2>
          <p class="sw__sub">Every membership running right now, and every coffee.</p>
          {/* the same plaques that hang on the park's board — one drawn layer,
              two surfaces, so the wall you see in the world is the wall here */}
          <div id="swWall"></div>
          <p class="sw__empty" id="swWallEmpty">Nobody is pinned up here yet. The first plaque could be yours.</p>
        </div>
        <div>
          <p class="sw__feedh">Latest</p>
          <ul class="swf" id="swFeed"></ul>
          <p class="sw__empty" id="swFeedEmpty">Nothing yet today — the wall is freshly built.</p>
        </div>
      </div>
      </section>

      <section class="sw__sec swc" id="coffee">
        <div class="swc__head">
          <img class="swc__coin" src="/assets/banana-stand/coin.png" width="44" height="44"
            alt="" loading="lazy" />
          <div>
            <h2 class="swc__h">Or just buy the banana a coffee</h2>
            <p class="swc__sub">Once, no subscription, no hat — and a slat with your name on the wall above.</p>
          </div>
        </div>
        <div class="swc__amts">
          {[3, 5, 10].map((n) => (
            <a class="bb-plaq bb-plaq--coffee swc__amt" href={`${WORKER}/pay/tip?a=${n * 100}`}
              data-tier="once" data-amt={n}>${n}</a>
          ))}
          <a class="swc__any" href={`${WORKER}/pay/tip`} data-tier="once">another amount →</a>
        </div>
      </section>

      <section class="sw__sec" id="join">
      <h2>Join the wall</h2>
      <p class="sw__sub">A membership dresses your banana. Cancel any time; the hat retires itself.</p>
      <p class="sw__idnote">Pay with the same email as <a href="/pass/">your pass</a> — that is how the hat finds you.</p>
      <div class="sw__tiers">
        {TIERS.map((t) => (
          <article class={`swt swt--${t.key}`}>
            <img class="swt__art" src={`/assets/supporters/tier-${t.key}.png`} width="480" height="480"
              alt={`A dancing banana wearing the ${t.hat}, glowing in the park`} loading="lazy" />
            <div class="swt__body">
              <h3 class="swt__name">{t.name}</h3>
              <p class="swt__price">${t.price}<small> / month</small></p>
              <p class="swt__blurb">{t.blurb}</p>
              <p class="swt__plaq"><span class={`bb-plaq bb-plaq--${t.key}`}>your name here</span></p>
              <ul class="swt__perks">{t.perks.map((p) => <li>{p}</li>)}</ul>
              <a class="swt__join" href={PAY.join(t.tier.slice(-2))}
                target={PAY.newTab ? '_blank' : null} rel="noopener"
                data-tier={t.tier}>{PAY.label}</a>
            </div>
          </article>
        ))}
      </div>
      {/* ⚠️ THE ONE THING THAT CAN GO WRONG: the hat is delivered by matching
          the payer's email to the pass's — hashed, never stored — so a
          different address means the grant waits and nothing on screen says
          so. Said ONCE under the row, where it is read; three times inside
          three cards is small print. */}
      </section>

      {/* ☕ NOT EVERYONE WANTS A SUBSCRIPTION, and a one-off should not be the
          last thing on a 4000px page. It sits right under the wall it puts you
          on, and the amounts ARE the slats you get — the button and the reward
          are the same object. */}

      <p class="sw__note">
        Payments run through <a href="https://polar.sh" rel="noopener nofollow">Polar</a>, who
        handle the card and the tax. Cancel any time from <a href="/pass/">your pass</a> — the hat
        stays on until the end of the month you already paid for, then retires itself. Names
        appear exactly as given at checkout. Your hat arrives on your banana within the hour, so
        sign in with your pass using the same email and it will know where to send it.
      </p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const API = 'https://banana-pass.trymstene.workers.dev/supporters';
      const KEY = { 'sup-t3': 'gold', 'sup-t2': 'silver', 'sup-t1': 'blue' };
      const ago = (ts) => {
        const d = Date.now() - ts, day = 86400000;
        if (d < 3600000) return 'just now';
        if (d < day) return Math.round(d / 3600000) + 'h ago';
        if (d < day * 30) return Math.round(d / day) + 'd ago';
        return new Date(ts).toLocaleDateString();
      };
      // 🎖 the wall is built from the same drawn plaques the park's board
      // hangs — one layer (/css/plaques.css), two surfaces, so the wall you
      // walk past in the world is the wall you read here.
      const ROWS = [
        { t: 'sup-t3', k: 'gold', many: 'Legends of Banana World' },
        { t: 'sup-t2', k: 'silver', many: 'Patrons of the Park' },
        { t: 'sup-t1', k: 'blue', many: 'Friends of the Banana' },
        { t: 'coffee', k: 'coffee', many: 'Bought a coffee' },
      ];
      let myName = '';
      try { myName = (localStorage.getItem('ps-name-v1') || '').trim().toLowerCase(); } catch (e) {}
      const esc = (x) => String(x).replace(/[<>&"]/g, (c) => (
        { '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));

      fetch(API).then((r) => r.json()).then((d) => {
        const members = (d.members || []).filter((m) => m.n && KEY[m.t]);
        // a one-off coffee earns a plaque too, deduped against the memberships
        const seen = new Set(members.map((m) => m.n));
        const coffees = (d.wall || [])
          .filter((w) => w.k !== 'member' && w.n && !seen.has(w.n) && (seen.add(w.n) || true))
          .map((w) => ({ n: w.n, t: 'coffee' }));
        const all = members.concat(coffees);
        document.getElementById('swCount').textContent = all.length || '—';
        document.querySelector('.sw__stat span').textContent =
          all.length === 1 ? 'banana keeping the lights on' : 'bananas keeping the lights on';

        document.getElementById('swWall').innerHTML = ROWS.map((r) => {
          const list = all.filter((m) => (m.t || 'coffee') === r.t).sort((a, b) => a.n.localeCompare(b.n));
          if (!list.length) return '';
          return '<div class="bb-plaqg bb-plaqg--' + r.k + '"><p class="bb-plaqg__k">' + r.many + '</p>'
            + list.map((m) => '<span class="bb-plaq bb-plaq--' + r.k
              + (myName && m.n.toLowerCase() === myName ? ' bb-plaq--me' : '') + '">'
              + esc(m.n) + (myName && m.n.toLowerCase() === myName ? '<i>you</i>' : '') + '</span>').join('')
            + '</div>';
        }).join('');
        if (all.length) document.getElementById('swWallEmpty').hidden = true;

        const feed = document.getElementById('swFeed');
        for (const w of (d.wall || []).slice(0, 25)) {
          const li = document.createElement('li');
          const b = document.createElement('b');
          b.textContent = w.n || 'Someone';
          li.appendChild(b);
          li.appendChild(document.createTextNode(
            w.k === 'member' ? ' joined the wall' : ' bought the banana a coffee'));
          const t = document.createElement('time');
          t.textContent = ago(w.ts);
          li.appendChild(t);
          feed.appendChild(li);
        }
        if (feed.children.length) document.getElementById('swFeedEmpty').hidden = true;
      }).catch(() => {});
      // 💛 already a supporter? say so, and turn their own tier's button into
      // the way OUT rather than a second sale. Reads 'bb-member' — the same
      // person-scoped grant the hats honour — so it needs no network call.
      (() => {
        const TIERS = { 'sup-t1': ['Friend of the Banana', 'blue', 5],
          'sup-t2': ['Patron of the Park', 'silver', 10],
          'sup-t3': ['Legend of Banana World', 'gold', 15] };
        let g = null;
        try { g = JSON.parse(localStorage.getItem('bb-member') || 'null'); } catch (e) {}
        const t = g && TIERS[g.t];
        if (!t || !(+g.until + 72 * 3600 * 1000 > Date.now())) return;
        const ends = new Date(+g.until);
        const on = ends.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
        const live = +g.until > Date.now();
        document.getElementById('swYouHat').src = '/assets/supporters/hat-' + t[1] + '.png';
        document.getElementById('swYouTxt').textContent = live
          ? 'You are a ' + t[0] + ' — thank you. $' + t[2] + ' a month, renewing ' + on + '.'
          : 'Your membership ended ' + on + '. The hat comes off shortly — you can start again any time.';
        document.getElementById('swYou').hidden = false;
        const card = document.querySelector('.swt--' + t[1]);
        if (card && live) {
          card.classList.add('swt--mine');
          const tag = document.createElement('p');
          tag.className = 'swt__mine';
          tag.textContent = 'your tier';
          card.querySelector('.swt__body').prepend(tag);
          const btn = card.querySelector('.swt__join');
          btn.textContent = 'Manage or cancel →';
          btn.href = '/pass/';
          const note = card.querySelector('.swt__idnote');
          if (note) note.remove();
        }
      })();

      document.querySelectorAll('.swt__join').forEach((a) => {
        a.addEventListener('click', () => {
          if (window.gtag) window.gtag('event', 'supporter_join_click', { tier: a.dataset.tier });
        });
      });
    })();
  </script>
</BaseLayout>
