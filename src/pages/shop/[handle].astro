---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PressBelt from '../../components/PressBelt.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import PackGrid from '../../components/PackGrid.astro';
import { getProducts, money, colorHex, firstSentence, sizeTableHtml, SITE } from '../../lib/shop.js';
import { officialFaqs, faqSchema } from '../../lib/product-faq.js';
import { STICKER_PACKS, packNumber, packSpread, packSheet, stickerSrc, previewPacks } from '../../data/sticker-packs.js';

export async function getStaticPaths() {
  const products = await getProducts();
  // previewPacks() is empty unless PACK_PREVIEW=1 — the pre-launch walk only
  return [...products, ...previewPacks(products)].map((p) => ({ params: { handle: p.handle }, props: { m: p } }));
}

const { m } = Astro.props;

// 🎟 A STICKER PACK gets its own pictures and words. Printful's blurb is about
// "kiss-cut sticker sheets" in general; ours is about which bananas are in
// this one — and the spread, not Printful's mockup, is what a shopper sees.
const packN = packNumber(m.handle);
const pack = packN ? STICKER_PACKS.find((p) => p.n === packN) : null;

// Shopify titles already open with "DANCING BANANA OFFICIAL™ …", so the old
// suffix said the brand twice and pushed these tags to 77-94 chars — long
// enough that Google truncates and rewrites them. Strip the prefix, say it once.
const branded = /^DANCING BANANA OFFICIAL/i.test(m.title);
const bare = branded ? m.title.replace(/^DANCING BANANA OFFICIAL[™\s]*/i, '').trim() : m.title;
const titleTag = pack
  ? `Dancing Banana Sticker ${pack.name} — 6 kiss-cut vinyl stickers | Trym Stene`
  : branded
    ? `Dancing Banana ${bare} — Official Merch | Trym Stene`
    : `${bare} — official Dancing Banana merch | Trym Stene`;
// the Shopify/Printful blurb never mentions a banana ("every happy camper needs
// a mug…"), so someone searching "dancing banana mug" saw a snippet about
// camping. Lead with what it actually is.
const descMeta = pack
  ? `${pack.names.join(', ')} and the Original — six kiss-cut vinyl Dancing Banana stickers on one A5 sheet, from the creator of the meme. ${money(m.pmin, m.cur)}, ships worldwide.`
  : `Dancing Banana ${bare.toLowerCase()} — ${firstSentence(m.descHtml, 90)} From ${money(m.pmin, m.cur)}, shipped worldwide.`;
const mainImg = pack ? packSpread(pack.n) : m.colors.length ? m.colorImage[m.colors[0]] : m.featured;
const ogImg = pack ? SITE + packSpread(pack.n) : m.featured;
const sizeGuide = sizeTableHtml(m); // null = no chart for this product → section hidden

const island = {
  title: m.title,
  currency: m.cur,
  priceMin: m.pmin,
  colorImage: m.colorImage,
  variants: Object.fromEntries(Object.entries(m.vmap).map(([k, v]) => [k, { id: v.id, price: v.price, available: v.available, img: v.image }])),
};

// 🛒 THE MERCHANT-LISTING TRIO. Google will surface price, availability and
// delivery in the result itself — but shippingDetails, hasMerchantReturnPolicy
// and itemCondition are what unlock it, and all three were absent.
//
// ⚠️ EVERY VALUE HERE IS REAL. Trym's answers, 8 Aug: fulfilment is 2–5
// business days plus carrier time, and there are NO general returns — only
// misprints and damage. So the policy is MerchantReturnNotPermitted, which is
// the honest category even though it reads worse than a finite window.
// ⚠️ NO aggregateRating and NO review. There are no reviews yet, and marking up
// ratings that were never given is a policy violation that costs the very rich
// results this is for. They go in when real ones exist, not before.
const SHIP = {
  '@type': 'OfferShippingDetails',
  shippingDestination: { '@type': 'DefinedRegion', addressCountry: ['US', 'GB', 'NO', 'SE', 'DK', 'DE', 'NL', 'FR', 'ES', 'CA', 'AU'] },
  deliveryTime: {
    '@type': 'ShippingDeliveryTime',
    // printed to order, so the handling window is the honest half we KNOW;
    // carrier transit varies by destination and is quoted at checkout
    handlingTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 5, unitCode: 'DAY' },
  },
};
const RETURNS = {
  '@type': 'MerchantReturnPolicy',
  applicableCountry: ['US', 'GB', 'NO', 'SE', 'DK', 'DE', 'NL', 'FR', 'ES', 'CA', 'AU'],
  returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
  merchantReturnLink: SITE + '/contact/',
};
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: m.title,
  image: pack ? [SITE + packSpread(pack.n), SITE + packSheet(pack.n), ...m.images].slice(0, 10) : m.images.slice(0, 10),
  description: pack ? descMeta : firstSentence(m.descHtml, 300),
  brand: { '@type': 'Brand', name: 'Dancing Banana Official' },
  sku: m.handle,
  ...(m.colors.length ? { color: m.colors } : {}),
  ...(m.sizes.length ? { size: m.sizes } : {}),
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: m.cur,
    lowPrice: m.pmin.toFixed(2),
    highPrice: m.pmax.toFixed(2),
    offerCount: m.variants.length,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    url: m.url,
    priceValidUntil: '2027-12-31',
    seller: { '@type': 'Organization', name: 'Trym Stene', url: SITE },
    shippingDetails: SHIP,
    hasMerchantReturnPolicy: RETURNS,
  },
};
// ❓ PER-PRODUCT FAQ — the question list lives in src/lib/product-faq.js so the
// official shop and the builder products answer "can I return it" with the SAME
// words. Two copies would drift the day one is edited.
const faqs = officialFaqs({
  title: m.title, colors: m.colors, sizes: m.sizes, hasSizeGuide: !!sizeGuide,
});
const breadcrumbSchema = {
  '@context': 'https://schema.org/',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Shop', item: SITE + '/shop/' },
    { '@type': 'ListItem', position: 3, name: m.title, item: m.url },
  ],
};
---
<BaseLayout
  title={titleTag}
  description={descMeta}
  ogTitle={m.title}
  ogType="product"
  ogImage={ogImg}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/css/shop.css" />
    <meta property="product:price:amount" content={m.pmin.toFixed(2)} />
    <meta property="product:price:currency" content={m.cur} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema(faqs))} />
  </Fragment>

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span>›</span><a href="/shop/">Shop</a><span>›</span><b>{m.title}</b>
  </nav>

  <section class="pdp" data-pdp>
    <div class="pdp__gallery">
      <img class="pdp__main" src={mainImg} alt={pack ? `${pack.name}: ${pack.names.join(', ')} and the Original` : m.title} width="800" height="800" />
      {!pack && (
        <div class="pdp__thumbs">
          {m.colors.map((c) => (
            <button class="pdp-thumb" data-color={c} aria-label={c}>
              <img src={m.colorImage[c]} alt={`${m.title} – ${c}`} loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="pdp__info">
      <h1>{m.title}</h1>
      <p class="pdp__tag">{pack
        ? 'Six kiss-cut vinyl stickers, about 5–6 cm each, on one A5 sheet — five you won\'t find anywhere else, plus the Original.'
        : firstSentence(m.descHtml, 120)}</p>
      <div class="pdp-pricetags">
        <p class="pdp__price price-tag"><small>from</small> {money(m.pmin, m.cur)}</p>
      </div>
      {/* the delivery promise belongs where the price is, not in a policy page
          nobody opens — and it is the same 2–5 days the schema declares, so a
          shopper and a crawler read one fact. Restructured, not extended: this
          is shorter than the line it replaced and says more. */}
      <p class="pdp__note">Printed to order in 2–5 days · shipping &amp; tax at checkout</p>
      <PressBelt compact label="As featured in" />

      {pack && (
        <div class="pdp-field pdp-inside">
          <div class="pdp-field__label">Inside <span>— 6 stickers, hands up</span></div>
          <ul class="pdp-inside__list">
            {pack.stickers.map((s) => (
              <li class:list={[s.hero && 'is-hero']}>
                <img src={stickerSrc(s.slug)} alt="" width={s.w} height={s.h} loading="lazy" decoding="async" />
                <span>{s.name}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {m.colors.length > 0 && (
        <div class="pdp-field">
          {/* ⚠️ THE NAME IS VISIBLE, NOT A TOOLTIP. `title=` never opens on a
              phone and ~85% of this site is mobile, so "Agave" and "Harbor
              Blue" were two indistinguishable dots to almost everyone (Trym,
              8 Aug). The chosen colour is now written out beside the label and
              updated on select — the tooltip stays for mouse users only. */}
          <div class="pdp-field__label">
            Colour <span>— {m.colors.length} {m.colors.length === 1 ? 'option' : 'options'}</span>
            <b class="pdp-field__pick" id="pdpColorName">{m.colors[0]}</b>
          </div>
          <div class="pdp-swatches">
            {m.colors.map((c) => (
              <button class="pdp-swatch" data-color={c} title={c} aria-label={c} style={`background:${colorHex(c)}`}></button>
            ))}
          </div>
        </div>
      )}

      {m.sizes.length > 0 && (
        <div class="pdp-field">
          <div class="pdp-field__label">Size {sizeGuide && <span>— <a href="#size-guide">size guide</a></span>}</div>
          <div class="pdp-sizes">
            {m.sizes.map((s) => <button class="pdp-size" data-size={s}>{s}</button>)}
          </div>
        </div>
      )}

      <button class="btn btn--dark pdp-buy" disabled>{m.sizes.length ? 'Select a size' : 'Buy →'}</button>
      <button class="btn pdp-addcart" disabled>🛒 Add to cart</button>
      <p class="pdp-stock"></p>

      <ul class="pdp-trust">
        {pack && <li>Kiss-cut: each sticker peels off the sheet on its own</li>}
        <li>Printed &amp; shipped on demand — made just for you</li>
        <li>Ships worldwide</li>
        <li>Secure checkout via Shopify</li>
        <li>Free replacement if it arrives wrong — <a href="/shop/policies/">shipping &amp; returns</a></li>
        <li>From the creator of the original 1999 dancing banana</li>
      </ul>

      {/* the sheet as it prints — AFTER the price and the button, so a phone
          sees what it costs before a second tall picture */}
      {pack && (
        <figure class="pdp-sheet">
          <img src={packSheet(pack.n)} alt={`${pack.name} — the A5 sheet as it prints`} width="1200" height="1700" loading="lazy" decoding="async" />
          <figcaption>What arrives: one A5 sheet, six kiss-cut stickers</figcaption>
        </figure>
      )}
    </div>
  </section>

  <section class="pdp-details">
    <details open>
      <summary>Product details &amp; materials</summary>
      <div class="pdp-details__body" set:html={m.descHtml}></div>
    </details>
    {sizeGuide && (
      <details id="size-guide">
        <summary>Size guide &amp; measurements</summary>
        <div class="pdp-details__body" set:html={sizeGuide}></div>
      </details>
    )}
    {/* the answers a print-on-demand buyer wants BEFORE paying — made-to-order
        timing, whether the size can be swapped, and who is actually behind it.
        Same text as the FAQPage schema, so page and crawler never disagree. */}
    <details class="pdp-faq">
      <summary>Questions people ask</summary>
      <div class="pdp-details__body">
        {faqs.map((f) => (
          <div class="pdp-faq__item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </details>
  </section>

  {pack && <PackGrid place="pdp" current={pack.n} kicker="Series 1" heading="Collect all 8" />}

  <section class="block">
    <p class="kicker">Keep going</p>
    <h2>More banana</h2>
    <p class="lead">
      <a href="/shop/">← All merch</a> ·
      <a href="/make-a-banana/"><PixelIcon name="palette" /> Make your own banana</a> ·
      <a href="/dancing-banana-gif-meme/">The story &amp; free GIF</a>
    </p>
  </section>

  <style>
    .pdp-sheet { margin: 1.6rem 0 0; max-width: 420px; }
    .pdp-sheet img {
      width: 100%; height: auto; display: block; background: #fff;
      border: var(--line); box-shadow: var(--shadow-sm);
    }
    .pdp-sheet figcaption { margin-top: 0.5rem; font-size: 0.78rem; font-weight: 700; opacity: 0.7; }
    .pdp-inside__list {
      list-style: none; margin: 0; padding: 0;
      display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.5rem 0.3rem;
    }
    @media (max-width: 520px) { .pdp-inside__list { grid-template-columns: repeat(3, 1fr); } }
    .pdp-inside__list li { text-align: center; font-size: 0.7rem; font-weight: 700; line-height: 1.2; }
    .pdp-inside__list img { height: 68px; width: auto; display: block; margin: 0 auto 0.3rem; transform: rotate(-5deg); }
    .pdp-inside__list li:nth-child(even) img { transform: rotate(5deg); }
    .pdp-inside__list li.is-hero img { height: 78px; }
  </style>

  <script id="pdp-data" type="application/json" set:html={JSON.stringify(island)}></script>
  <script src="/js/shop.js" is:inline></script>
</BaseLayout>
