---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import { getProducts, money, colorHex } from '../../lib/shop.js';
import CUSTOM from '../../../shared/products.js';

const products = await getProducts();
// the custom line is deliberately absent from getProducts() (a bare PDP would
// sell a blank product) — it comes in through its own lane, design-first
const custom = CUSTOM.filter((p) => p.live);

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Dancing Banana Shop",
  "url": "https://trymstene.com/shop/",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": products.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": p.url,
      "name": p.title,
    })),
  },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://trymstene.com/" },
    { "@type": "ListItem", "position": 2, "name": "Shop", "item": "https://trymstene.com/shop/" },
  ],
};
---
<BaseLayout
  title="Shop — Dancing Banana Merch | Trym Stene"
  description="Official Dancing Banana merch — tees, posters, mugs and more, from the creator of the meme. Printed on demand, shipped worldwide."
  ogTitle="Shop — Dancing Banana Merch"
  ogImage="https://trymstene.com/assets/og/shop.png"
  ogDescription="Official Dancing Banana merch from the creator of the meme."
>
  <link rel="stylesheet" href="/css/shop.css" slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="hero shop-hero">
    <div class="hero__banana">
      <img src="/assets/banana-strut.png" alt="The Dancing Banana strutting"
           width="240" height="240"
           onerror="this.outerHTML='<div class=&quot;banana-fallback&quot;>🍌</div>';">
    </div>
    <p class="kicker">Official merch</p>
    <h1 class="hero__title">dancing banana<br>shop</h1>
    <p class="hero__tag" style="text-transform:none;font-weight:500;">Wear the banana — the original 1999 meme, on stuff you can actually own.</p>
    <ul class="shop-trust">
      <li>Printed on demand</li>
      <li>Ships worldwide</li>
      <li>Secure Shopify checkout</li>
      <li>By the guy who made the meme</li>
    </ul>
  </section>

  <section class="block block--yellow">
    <h2 class="sr-only">The collection</h2>
    {products.length ? (
      <div class="shop-grid">
        {products.map((p) => (
          <a class="project-card shop-card" href={`/shop/${p.handle}/`}>
            <img class="shop-card__img" src={p.featured} alt={p.title} loading="lazy" width="600" height="600" />
            <div class="project-card__body">
              <h3>{p.title}</h3>
              {p.colors.length > 1 && (
                <div class="shop-card__swatches" aria-label={`${p.colors.length} colours`}>
                  {p.colors.slice(0, 6).map((c) => (
                    <span class="shop-card__swatch" style={`background:${colorHex(c)}`} title={c}></span>
                  ))}
                  {p.colors.length > 6 && <span class="shop-card__more">+{p.colors.length - 6}</span>}
                </div>
              )}
              <div class="shop-card__foot">
                <p class="shop-card__price price-tag price-tag--sm"><small>from</small> {money(p.pmin, p.cur)}</p>
                <span class="shop-card__cta">View →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="shop-status">The shop is being stocked — check back soon! <PixelIcon name="banana" /></p>
    )}
    <p class="shop-polline">Printed on demand · ships worldwide · <a href="/shop/policies/">shipping, returns &amp; policies</a></p>
  </section>

  <!-- 🎨 THE CUSTOM LANE — the shop's second half. Same shop, not a detour:
       same checkout, same free shipping. The one difference is that you design
       it first, so the tiles say so and route into the builder rather than a
       PDP (a bare custom PDP would sell a blank). -->
  <section class="block shopcustom" id="shopCustom">
    <p class="kicker">Your own banana</p>
    <h2>Not the official one? Put <em>yours</em> on it</h2>
    <p class="lead">Dress a banana — shades, hats, a caption, your own colours — and have that one
    printed instead. Same shop, same free worldwide shipping. You just design it first.</p>
    <div class="shop-grid shopcustom__grid">
      {custom.map((p) => (
        <a class="project-card shop-card shopcustom__card" href={`/make-a-banana/${p.key}/`} data-custom={p.key}>
          <span class="shop-card__img shopcustom__shot" data-custom-preview></span>
          <div class="project-card__body">
            <h3>Your banana {p.name.toLowerCase()}</h3>
            <p class="shopcustom__meta">{p.size} · {p.material}</p>
            <div class="shop-card__foot">
              <p class="shop-card__price price-tag price-tag--sm">${p.priceHint}</p>
              <span class="shop-card__cta">Design it →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <p class="shop-polline">
      <span data-custom-yours hidden>That's <strong>your</strong> banana on the tiles. </span>
      Free worldwide shipping · printed on demand · <a href="/make-a-banana/"><PixelIcon name="palette" /> open the full builder</a>
    </p>
  </section>

  <style>
    /* the custom tiles read as siblings of the official ones (same card), with
       the checkerboard ground saying "there is no photo yet — this is yours" */
    .shopcustom__shot {
      display: grid; place-items: center; aspect-ratio: 1; overflow: hidden;
      background:
        conic-gradient(from 90deg at 50% 50%, #f3efe2 0 25%, #e6e0cd 0 50%, #f3efe2 0 75%, #e6e0cd 0)
        0 0 / 22px 22px;
    }
    .shopcustom__shot canvas { width: 82%; height: auto; image-rendering: pixelated; display: block; }
    .shopcustom__meta { margin: 0.15rem 0 0.6rem; font-size: 0.76rem; opacity: 0.7; }
    .shopcustom__card .shop-card__cta { font-weight: 800; }
  </style>

  <script>
    // 🎨 the custom lane paints the visitor's own banana — but the sprite engine
    // is a heavy import for a page that is otherwise nearly JS-free, so it only
    // loads once the lane is actually about to be seen.
    const lane = document.getElementById('shopCustom');
    if (lane && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('../../scripts/shop-custom-lane.js')
          .then((m) => m.paintLane(lane)).catch(() => {});
      }, { rootMargin: '300px' });
      io.observe(lane);
    }
    document.querySelectorAll('.shopcustom__card').forEach((card) => {
      card.addEventListener('click', () => {
        if (window.gtag) window.gtag('event', 'select_item', {
          item_list_name: 'shop_custom_lane',
          items: [{ item_name: 'custom ' + (card.dataset.custom || '') }],
        });
      });
    });
  </script>

  <script>
    // funnel step clock (same sessionStorage key as the builder/PDPs): each
    // funnel event carries secs_since_prev so Pulse can average time-per-step
    const stepSecs = () => {
      const now = Date.now(); let prev = 0;
      try { prev = +(sessionStorage.getItem('fk-t') || 0); sessionStorage.setItem('fk-t', String(now)); } catch (e) {}
      const s = prev ? Math.round((now - prev) / 1000) : -1;
      return (s >= 0 && s <= 1800) ? s : undefined;
    };
    const withSecs = (p) => { const s = stepSecs(); if (s !== undefined) p.secs_since_prev = s; return p; };
    // funnel top: someone opened the shop's front page — the merch funnel's
    // first real step in Banana Pulse (before select_item / view_item)
    if (window.gtag) window.gtag('event', 'shop_view', withSecs({}));
    // funnel: which PLP card gets picked (pairs with view_item + begin_checkout
    // in /js/shop.js). gtag beacons survive the navigation.
    document.querySelectorAll('.shop-grid .shop-card').forEach((card) => {
      card.addEventListener('click', () => {
        const name = card.querySelector('h3')?.textContent?.trim();
        if (window.gtag && name) window.gtag('event', 'select_item', withSecs({ items: [{ item_name: name }] }));
      });
    });
  </script>
</BaseLayout>
