---
// 🔀 LEGACY SLUG. Shopify auto-generated this handle from the ™ title, so the
// URL shipped as dancing-banana-official%E2%84%A2-men-s-premium-tank-top —
// which reads as broken wherever it is pasted, and shows up percent-encoded in
// GA4 and Search Console. The handle was cleaned in Shopify on 8 Aug; this stub
// keeps the old link alive because it had already been shared.
//
// ⚠️ The ™ is IN THE FILENAME on purpose — that is what makes Astro emit this
// exact path. Static routes win over the [handle] dynamic route, and [handle]
// no longer generates this path anyway.
import Redirect from '../../components/Redirect.astro';
const to = 'https://trymstene.com/shop/dancing-banana-official-mens-premium-tank-top/';
---
<Redirect to={to}>This product moved to <a href={to}>a tidier link</a>.</Redirect>
