---
// 🏘️ BANANA TOWN — the hidden prototype (7 Sep 2026). NOINDEXED, not in the
// sitemap, linked from nowhere (Trym: "hidden until it's ready"). The square
// exists to be walked and judged while the town is being planned — see the
// town-centre plan. Rule Zero: the world advertises an area when it is ready.
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelIcon from '../components/PixelIcon.astro';

const title = 'Banana Town — prototype';
const description = 'The town centre of Banana World, under construction.';
---
<BaseLayout title={title} description={description} robots="noindex,nofollow">
  <style is:inline slot="head">
    .tw-wrap [hidden] { display: none !important; }
    body { background: #1a120c; }
    .tw-wrap { max-width: 1100px; margin: 0 auto; padding: 0.6rem 1rem 2.5rem; color: #fffdf5; }
    .tw-sign {
      font-family: "Archivo Black", sans-serif; text-align: center; color: #ffb347;
      font-size: clamp(1.4rem, 6.4vw, 2.2rem); line-height: 1.05; margin: 0.7rem 0 0.15rem; letter-spacing: 0.02em;
      text-shadow: 0 0 18px rgba(255, 179, 71, 0.45);
    }
    .tw-tag { text-align: center; margin: 0 0 0.8rem; font-size: 0.86rem; opacity: 0.7; }
    .tw-stage { border: 4px solid #000; box-shadow: 8px 8px 0 #000; }
    .tw-view {
      position: relative; height: min(74vh, 580px); overflow: hidden; cursor: pointer;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent; background: #1c2a14;
      /* one stacking context for everything on the map, so the travel veil on <body> outranks the toast (design library 8) */
      isolation: isolate;
    }
    .tw-world {
      position: absolute; left: 0; top: 0; will-change: transform;
      background: url('/assets/town/town.png') 0 0 / 100% 100% no-repeat; image-rendering: pixelated;
    }
    .tw-ov { position: absolute; height: auto; image-rendering: pixelated; pointer-events: none; }
    /* ⛲ the fountain: six frame images stacked in one box, each visible for a sixth of the
       cycle (its own negative delay picks the sixth). ⚠️ NOT a position-stepped strip: in a box
       of fractional width every step lands on a different sub-pixel phase and the fountain
       walks sideways. Windows overlap by 0.3% so no paint ever finds every frame hidden. */
    .tw-fountain { position: absolute; pointer-events: none; }
    .tw-fountain img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: pixelated;
      visibility: hidden; animation: tw-fount 0.9s linear infinite; }
    @keyframes tw-fount { 0%, 16.9% { visibility: visible; } 17%, 100% { visibility: hidden; } }
    @keyframes tw-fount4 { 0%, 24.9% { visibility: visible; } 25%, 100% { visibility: hidden; } }
    @keyframes tw-fount8 { 0%, 12.4% { visibility: visible; } 12.5%, 100% { visibility: hidden; } }
    @media (prefers-reduced-motion: reduce) { .tw-fountain img { animation: none; } .tw-fountain img:first-child { visibility: visible; } }
    .tw-me, .tw-npc { position: absolute; width: 4.5%; transform: translate(-50%, -100%); pointer-events: none; }
    .tw-me::after, .tw-npc::after {
      content: ''; position: absolute; left: 50%; bottom: -3px; width: 76%; aspect-ratio: 3 / 1;
      transform: translateX(-50%); background: rgba(20, 30, 18, 0.34); border-radius: 50%; z-index: -1;
    }
    .tw-me canvas, .tw-npc canvas { width: 100%; height: auto; image-rendering: pixelated; display: block; }
    .tw-npc span {
      position: absolute; left: 50%; top: -14px; transform: translateX(-50%);
      font-size: 0.5rem; font-weight: 800; letter-spacing: 0.05em; color: #fffdf5; text-shadow: 1px 1px 0 #000; white-space: nowrap;
    }
    /* the planks: the park's waypost idiom, one per door */
    .tw-plank {
      position: absolute; white-space: nowrap; transform: translate(-50%, -100%); cursor: pointer;
      background: #8a5a2b; border: 1px solid #3a230f; color: #ffe135; box-shadow: 1px 2px 0 rgba(0, 0, 0, 0.45);
      padding: 2px 8px; font-family: "Archivo Black", sans-serif; font-size: 0.5rem; letter-spacing: 0.06em;
      background-image: linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px); background-size: 100% 5px;
    }
    .tw-plank--way { pointer-events: none; font-size: 0.45rem; }
    .tw-toast {
      position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 2000; max-width: min(92%, 520px);
      background: #ffe135; color: #141208; border: 3px solid #000; box-shadow: 4px 4px 0 #000;
      padding: 0.5rem 0.8rem; font-size: 0.86rem; font-weight: 700; line-height: 1.3; pointer-events: none;
    }
    .tw-note { margin: 0.9rem 0 0; font-size: 0.84rem; opacity: 0.75; text-align: center; }
    /* 🃏 the card panel — the park's pk-panel/pk-card, in the town's brick warmth */
    .tw-panel { position: absolute; inset: 0; z-index: 1500; display: grid; place-items: center; background: rgba(0, 0, 0, 0.55); padding: 0.8rem; }
    .tw-card { background: #1a120c; color: #fffdf5; border: 4px solid #000; box-shadow: 6px 6px 0 #000; padding: 0.9rem 1rem; max-width: 380px; width: 100%; max-height: 100%; overflow: auto; }
    .tw-card h2 { font-family: "Archivo Black", sans-serif; color: #ffb347; font-size: 1rem; margin: 0 0 0.15rem; letter-spacing: 0.03em; }
    .tw-cardx { position: sticky; top: 0; float: right; z-index: 3; margin: -2px -6px 0 0.5rem; appearance: none; background: none; border: 0; padding: 0; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; color: #fffdf5; font-size: 1.15rem; font-weight: 800; line-height: 1; cursor: pointer; opacity: 0.7; }
    .tw-cardx:hover { opacity: 1; }
    .tw-card__sub { margin: 0 0 0.7rem; font-size: 0.8rem; opacity: 0.85; }
    .tw-cta { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; width: 100%; padding: 0.7rem 0.8rem; cursor: pointer; border: 3px solid #000; color: #241c00; font-family: inherit; background: linear-gradient(#ffe14d, #f2c012); box-shadow: 3px 3px 0 #000; margin-top: 0.5rem; }
    .tw-cta:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .tw-cta[disabled] { opacity: 0.55; cursor: default; }
    .tw-cta__verb { font-size: 1.05rem; font-weight: 800; white-space: nowrap; }
    .tw-cta__rew { padding: 4px 9px; border: 2px solid #000; border-radius: 999px; background: #3a2210; color: #ffd98a; white-space: nowrap; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.4px; }
    .tw-wheelwrap { position: relative; width: 220px; margin: 0.5rem auto 0.2rem; }
    .tw-wheel { display: block; width: 220px; height: 220px; border-radius: 50%; box-shadow: 0 0 0 4px #000, 4px 5px 0 4px rgba(0, 0, 0, 0.45); transition: transform 3.4s cubic-bezier(0.12, 0.7, 0.1, 1); }
    .tw-wheel__pin { position: absolute; left: 50%; top: -8px; z-index: 2; width: 0; height: 0; margin-left: -11px; border-left: 11px solid transparent; border-right: 11px solid transparent; border-top: 20px solid #ffe135; filter: drop-shadow(0 2px 0 #000); }
    .tw-pot { text-align: center; font-family: "Archivo Black", sans-serif; color: #ffe135; margin: 0.2rem 0 0; font-size: 0.9rem; letter-spacing: 0.04em; }
    .tw-result { margin: 0.6rem 0 0; font-weight: 800; min-height: 1.3em; font-size: 0.92rem; }
    .tw-rows { display: grid; gap: 0.45rem; margin: 0.5rem 0; }
    .tw-row { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; background: #2a1a10; border: 2px solid #000; padding: 0.45rem 0.6rem; }
    .tw-row b { font-size: 0.92rem; }
    .tw-row small { opacity: 0.8; font-size: 0.74rem; display: block; line-height: 1.3; }
    .tw-row button { font: inherit; font-weight: 800; font-size: 0.78rem; padding: 0.35rem 0.6rem; border: 2px solid #000; background: #ffe135; color: #141208; cursor: pointer; box-shadow: 2px 2px 0 #000; white-space: nowrap; }
    .tw-row button[disabled] { opacity: 0.45; cursor: default; box-shadow: none; }
    .tw-fine { font-size: 0.72rem; opacity: 0.7; margin: 0.6rem 0 0; line-height: 1.35; }
    .tw-tray { position: absolute; left: 10px; bottom: 12px; z-index: 901; background: #1a120c; color: #fffdf5; border: 3px solid #000; box-shadow: 4px 4px 0 #000; padding: 0.5rem 0.6rem; display: grid; gap: 0.4rem; min-width: 210px; }
    .tw-fx { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1400; pointer-events: none; }
    /* 🎛 THE ACTION BAR — the HUD's bottom half (design library §15): the park's
       .pk-actions metrics to the pixel, in the town's brick. The verb slot left,
       the heart, the travel door (world-travel.js mounts it and floors every row at 44px). */
    .tw-actions { display: flex; align-items: center; justify-content: center; gap: 0.6rem; background: #140d08; border-top: 4px solid #000; padding: 0.6rem 0.8rem; flex-wrap: wrap; touch-action: manipulation; }
    .tw-act { appearance: none; font: inherit; font-weight: 800; font-size: 0.95rem; border: 3px solid #000; box-shadow: 3px 3px 0 #000; cursor: pointer; line-height: 1; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.35rem; transition: transform 0.08s ease, box-shadow 0.08s ease; }
    .tw-act:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .tw-act--icon { background: #2a1a10; color: #fffdf5; padding: 0.5rem 0.7rem; font-size: 1.1rem; min-width: 46px; justify-content: center; }
    /* the verb slot: a GLYPH on yellow with a count badge — the HUD is icons, not words (Trym, 11 Sep) */
    .tw-act--tool { background: #ffe135; color: #241c00; padding: 0.5rem 0.7rem; min-width: 46px; justify-content: center; position: relative; }
    .tw-act svg { display: block; }
    .tw-act__n { position: absolute; top: -9px; right: -9px; min-width: 20px; height: 20px; padding: 0 5px; box-sizing: border-box; border-radius: 999px; background: #241c00; color: #ffe135; border: 2px solid #000; font-size: 0.66rem; font-weight: 800; line-height: 1; display: flex; align-items: center; justify-content: center; }
    .tw-row .pai { flex: none; margin-right: 0.5rem; color: #ffe135; }
    .tw-row__it { display: flex; align-items: center; min-width: 0; }
    .tw-row[data-say] { cursor: pointer; }
    /* the heart's float over the player — the park's .pk-float */
    .tw-float { position: absolute; transform: translate(-50%, -50%); z-index: 1950; pointer-events: none; font-family: "Archivo Black", sans-serif; font-size: 0.85rem; color: #ffe135; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000, 2px 2px 0 #000; white-space: nowrap; animation: twFloat 0.9s ease-out forwards; }
    .tw-float svg { display: block; width: 22px; height: 22px; }
    @keyframes twFloat { to { transform: translate(-50%, calc(-50% - 34px)); opacity: 0; } }
  </style>

  <main class="tw-wrap">
    <h1 class="tw-sign">BANANA TOWN</h1>
    <p class="tw-tag">the square, as a prototype. Not linked from anywhere.</p>
    <div class="tw-stage">
      <div class="tw-view" id="twView">
        <div class="tw-world" id="twWorld"></div>
        <div class="tw-toast" id="twToast" hidden></div>
        <!-- 🃏 the cards: the world's card grammar, brick-warm. Prototype: nothing is saved, no coins move -->
        <div class="tw-panel" id="twPanel" hidden>
          <div class="tw-card" role="dialog" aria-label="Town card">
            <button class="tw-cardx" id="twCardX" type="button" aria-label="close">✕</button>
            <div id="twCardBody"></div>
          </div>
        </div>
        <!-- 👝 the pocket's tray: rises from the action bar's POCKET button -->
        <div class="tw-tray" id="twTray" hidden></div>
        <canvas class="tw-fx" id="twFx" hidden></canvas>
      </div>
      <!-- 🎛 the action bar: the HUD's bottom half. POCKET is the verb slot (hidden
           until it holds something — the park's tool-slot grammar), then the heart,
           then the travel door (mounted by world-travel.js). No sound button yet:
           the town has nothing to mute. -->
      <div class="tw-actions" aria-label="town actions">
        <button class="tw-act tw-act--tool" id="twPocket" type="button" aria-label="Your pocket" hidden></button>
        <button class="tw-act tw-act--icon" id="twEmote" type="button" aria-label="Send a heart"><PixelIcon name="heart" size="1.25em" /></button>
      </div>
    </div>
    <p class="tw-note">Walk with a tap or the arrow keys. Tap a door, a sign or a banana to read what it will be. The road south goes back to the park.</p>
  </main>

  <script src="../scripts/banana-town.js"></script>
</BaseLayout>
