---
// 🏘️ BANANA TOWN — the hidden prototype (7 Sep 2026). NOINDEXED, not in the
// sitemap, linked from nowhere (Trym: "hidden until it's ready"). The square
// exists to be walked and judged while the town is being planned — see the
// town-centre plan. Rule Zero: the world advertises an area when it is ready.
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelIcon from '../components/PixelIcon.astro';

const title = 'Banana Town — prototype';
const description = 'The town centre of Banana World, under construction.';
---
<BaseLayout title={title} description={description} robots="noindex,nofollow">
  <!-- 🗣 the world's shared NPC dialogue card (design library §18) -->
  <link rel="stylesheet" href="/css/dialogue.css" slot="head" />
  <link rel="stylesheet" href="/css/weather.css" slot="head" />
  <link rel="stylesheet" href="/css/world-frame.css" slot="head" />
  <style is:inline slot="head">
    .tw-wrap [hidden] { display: none !important; }
    body { background: #1a120c; }
    .tw-wrap { max-width: var(--world-w); margin: 0 auto; padding: 0.6rem var(--world-pad) 2.5rem; color: #fffdf5; }   /* 📐 the size is /css/world-frame.css — design library §20 */
    .tw-sign {
      font-family: "Archivo Black", sans-serif; text-align: center; color: #ffb347;
      font-size: clamp(1.4rem, 6.4vw, 2.2rem); line-height: 1.05; margin: 0.7rem 0 0.15rem; letter-spacing: 0.02em;
      text-shadow: 0 0 18px rgba(255, 179, 71, 0.45);
    }
    .tw-tag { text-align: center; margin: 0 0 0.8rem; font-size: 0.86rem; opacity: 0.7; }
    .tw-stage { border: 4px solid #000; box-shadow: 8px 8px 0 #000; }
    .tw-view {
      position: relative; height: var(--world-h); overflow: hidden; cursor: pointer;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent; background: #1c2a14;
      /* one stacking context for everything on the map, so the travel veil on <body> outranks the toast (design library 8) */
      isolation: isolate;
    }
    .tw-world {
      position: absolute; left: 0; top: 0; will-change: transform;
      background: url('/assets/town/town.png') 0 0 / 100% 100% no-repeat; image-rendering: pixelated;
    }
    .tw-ov { position: absolute; height: auto; image-rendering: pixelated; pointer-events: none; }
    /* ⛲ the fountain: six frame images stacked in one box, each visible for a sixth of the
       cycle (its own negative delay picks the sixth). ⚠️ NOT a position-stepped strip: in a box
       of fractional width every step lands on a different sub-pixel phase and the fountain
       walks sideways. Windows overlap by 0.3% so no paint ever finds every frame hidden. */
    .tw-fountain { position: absolute; pointer-events: none; }
    .tw-fountain img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: pixelated;
      visibility: hidden; animation: tw-fount 0.9s linear infinite; }
    @keyframes tw-fount { 0%, 16.9% { visibility: visible; } 17%, 100% { visibility: hidden; } }
    @keyframes tw-fount4 { 0%, 24.9% { visibility: visible; } 25%, 100% { visibility: hidden; } }
    @keyframes tw-fount8 { 0%, 12.4% { visibility: visible; } 12.5%, 100% { visibility: hidden; } }
    @media (prefers-reduced-motion: reduce) { .tw-fountain img { animation: none; } .tw-fountain img:first-child { visibility: visible; } }
    .tw-me, .tw-npc { position: absolute; width: 4.5%; transform: translate(-50%, -100%); pointer-events: none; }
    .tw-me::after, .tw-npc::after {
      content: ''; position: absolute; left: 50%; bottom: -3px; width: 76%; aspect-ratio: 3 / 1;
      transform: translateX(-50%); background: rgba(20, 30, 18, 0.34); border-radius: 50%; z-index: -1;
    }
    .tw-me canvas, .tw-npc canvas { width: 100%; height: auto; image-rendering: pixelated; display: block; }
    /* the planks: the park's waypost idiom, one per door */
    .tw-plank {
      position: absolute; white-space: nowrap; transform: translate(-50%, -100%); cursor: pointer;
      background: #8a5a2b; border: 1px solid #3a230f; color: #ffe135; box-shadow: 1px 2px 0 rgba(0, 0, 0, 0.45);
      padding: 0.25em 1em; font-family: "Archivo Black", sans-serif; font-size: max(0.5rem, calc(5px * var(--ws, 1.6))); letter-spacing: 0.06em;
      background-image: linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px); background-size: 100% 5px;
    }
    /* a plank is a WORLD thing: it follows the world's scale (--ws, banana-town.js layout()) with a floor a thumb can
       read — sized in rem alone, the stalls' signs stood at desktop size over a phone's smaller stalls (Trym, 15 Sep) */
    .tw-plank--way { pointer-events: none; font-size: max(0.45rem, calc(4.5px * var(--ws, 1.6))); }
    .tw-plank--big { font-size: max(0.6rem, calc(10px * var(--ws, 1.6))); padding: 0.25em 0.875em; letter-spacing: 0.05em; }   /* the two stalls: a sign you can read from the fountain */
    /* the print shop's sign: grey metal over the sprite's own STORE band (64×22 world px) — sized in world units so it
       covers the band at every scale, with the same readable floor (Trym, 15 Sep) */
    .tw-plank--metal { font-size: max(0.62rem, calc(6.5px * var(--ws, 1.6))); padding: 0.3em 0.9em; min-width: calc(72px * var(--ws, 1.6)); min-height: calc(26px * var(--ws, 1.6)); box-sizing: border-box; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(180deg, #d7dbe3 0%, #a9afba 45%, #7d838f 100%); background-image: linear-gradient(180deg, #d7dbe3 0%, #a9afba 45%, #7d838f 100%); color: #f7f8fa; border-color: #2b2f36; text-shadow: 0 1px 0 #2b2f36, 0 0 2px rgba(0, 0, 0, 0.5); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 1px 2px 0 rgba(0, 0, 0, 0.45); }
    .tw-toast {
      position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 2000; max-width: min(92%, 520px);
      background: #ffe135; color: #141208; border: 3px solid #000; box-shadow: 4px 4px 0 #000;
      padding: 0.5rem 0.8rem; font-size: 0.86rem; font-weight: 700; line-height: 1.3; pointer-events: none;
    }
    .tw-note { margin: 0.9rem 0 0; font-size: 0.84rem; opacity: 0.75; text-align: center; }
    /* 🃏 the card panel — the park's pk-panel/pk-card, in the town's brick warmth */
    .tw-panel { position: absolute; inset: 0; z-index: 1500; display: grid; place-items: center; background: rgba(0, 0, 0, 0.55); padding: 0.8rem; }
    .tw-card { background: #1a120c; color: #fffdf5; border: 4px solid #000; box-shadow: 6px 6px 0 #000; padding: 0.9rem 1rem; max-width: 380px; width: 100%; max-height: 100%; overflow: auto; }
    .tw-card h2 { font-family: "Archivo Black", sans-serif; color: #ffb347; font-size: 1rem; margin: 0 0 0.15rem; letter-spacing: 0.03em; }
    .tw-cardx { position: sticky; top: 0; float: right; z-index: 3; margin: -2px -6px 0 0.5rem; appearance: none; background: none; border: 0; padding: 0; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; color: #fffdf5; font-size: 1.15rem; font-weight: 800; line-height: 1; cursor: pointer; opacity: 0.7; }
    .tw-cardx:hover { opacity: 1; }
    .tw-card__sub { margin: 0 0 0.7rem; font-size: 0.8rem; opacity: 0.85; }
    .tw-cta { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; width: 100%; padding: 0.7rem 0.8rem; cursor: pointer; border: 3px solid #000; color: #241c00; font-family: inherit; background: linear-gradient(#ffe14d, #f2c012); box-shadow: 3px 3px 0 #000; margin-top: 0.5rem; }
    .tw-cta:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .tw-cta[disabled] { opacity: 0.55; cursor: default; }
    .tw-cta__verb { font-size: 1.05rem; font-weight: 800; white-space: nowrap; }
    .tw-cta__rew { padding: 4px 9px; border: 2px solid #000; border-radius: 999px; background: #3a2210; color: #ffd98a; white-space: nowrap; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.4px; }
    .tw-wheelwrap { position: relative; width: 220px; margin: 0.5rem auto 0.2rem; }
    .tw-wheel { display: block; width: 220px; height: 220px; border-radius: 50%; box-shadow: 0 0 0 4px #000, 4px 5px 0 4px rgba(0, 0, 0, 0.45); transition: transform 3.4s cubic-bezier(0.12, 0.7, 0.1, 1); }
    .tw-wheel__pin { position: absolute; left: 50%; top: -8px; z-index: 2; width: 0; height: 0; margin-left: -11px; border-left: 11px solid transparent; border-right: 11px solid transparent; border-top: 20px solid #ffe135; filter: drop-shadow(0 2px 0 #000); }
    .tw-pot { text-align: center; font-family: "Archivo Black", sans-serif; color: #ffe135; margin: 0.2rem 0 0; font-size: 0.9rem; letter-spacing: 0.04em; }
    .tw-result { margin: 0.6rem 0 0; font-weight: 800; min-height: 1.3em; font-size: 0.92rem; }
    .tw-rows { display: grid; gap: 0.45rem; margin: 0.5rem 0; }
    .tw-row { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; background: #2a1a10; border: 2px solid #000; padding: 0.45rem 0.6rem; }
    .tw-row b { font-size: 0.92rem; }
    .tw-row small { opacity: 0.8; font-size: 0.74rem; display: block; line-height: 1.3; }
    .tw-row button { font: inherit; font-weight: 800; font-size: 0.78rem; padding: 0.35rem 0.6rem; border: 2px solid #000; background: #ffe135; color: #141208; cursor: pointer; box-shadow: 2px 2px 0 #000; white-space: nowrap; }
    .tw-row button[disabled] { opacity: 0.45; cursor: default; box-shadow: none; }
    .tw-fine { font-size: 0.72rem; opacity: 0.7; margin: 0.6rem 0 0; line-height: 1.35; }
    /* 🕹 a cabinet's screen: one canvas, pixel-crisp, the score riding its top edge */
    .tw-arc { position: relative; margin: 0.4rem auto 0; width: 100%; max-width: 300px; }
    .tw-arc canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; border: 3px solid #000; box-shadow: 3px 3px 0 #000; background: #17243a; touch-action: manipulation; cursor: pointer; }
    /* 🏆 the board under the screen: two tabs, five rows, your line */
    .tw-board { margin: 0.6rem auto 0; max-width: 300px; }
    .tw-board__tabs { display: flex; gap: 4px; margin-bottom: 4px; }
    .tw-board__tabs button { flex: 1; font-family: "Archivo Black", sans-serif; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 4px 6px; border: 2px solid #000; background: #2a1a10; color: #fffdf5; box-shadow: 2px 2px 0 #000; cursor: pointer; white-space: nowrap; }
    .tw-board__tabs button.is-on { background: #ffe135; color: #141208; }
    .tw-board__list { list-style: none; margin: 0; padding: 0; border: 2px solid #000; background: #2a1a10; }
    .tw-board__list li { display: grid; grid-template-columns: 1.4rem 1fr auto; gap: 6px; padding: 3px 8px; font-size: 0.8rem; border-bottom: 1px solid #3d2818; align-items: baseline; }
    .tw-board__list li:last-child { border-bottom: 0; }
    .tw-board__rank { font-family: "Archivo Black", sans-serif; opacity: 0.6; }
    .tw-board__name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tw-board__score { font-family: "Archivo Black", sans-serif; font-variant-numeric: tabular-nums; color: #ffe135; }
    .tw-board__empty { display: block; opacity: 0.7; font-size: 0.78rem; padding: 6px 8px; }
    .tw-board__me { margin: 4px 0 0; font-size: 0.78rem; opacity: 0.85; min-height: 1em; }
    .tw-arc__hud { position: absolute; top: 8px; left: 10px; right: 10px; display: flex; justify-content: space-between; font-family: "Archivo Black", sans-serif; font-size: 0.9rem; color: #ffe135; text-shadow: 1px 1px 0 #000, -1px 1px 0 #000, 1px -1px 0 #000; pointer-events: none; }
    .tw-tray { position: absolute; left: 10px; bottom: 12px; z-index: 901; background: #1a120c; color: #fffdf5; border: 3px solid #000; box-shadow: 4px 4px 0 #000; padding: 0.5rem 0.6rem; display: grid; gap: 0.4rem; min-width: 210px; }
    .tw-fx { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1400; pointer-events: none; }
    /* 🕹 inside: the room floats over a shade in the same world (the homestead's grammar); the town's
       props, people and planks stop painting while indoors, the banana rides above the shade */
    .tw-inshade { position: absolute; inset: 0; z-index: 2000; background: #0d0b14; pointer-events: none; }
    .tw-room { position: absolute; z-index: 2010; background-size: 100% 100%; image-rendering: pixelated; pointer-events: none; }
    .tw-world.is-inside :is(.tw-ov, .tw-npc, .tw-plank, .tw-fountain, .tw-litter, .tw-glow) { visibility: hidden; }
    /* 🗣 A RESIDENT'S DIALOGUE — the shared card (/css/dialogue.css, src/lib/world-dialogue.js), in the
       town's brick instead of the park's green. ⭐ There is no speech bubble anywhere in the town on
       purpose (Trym, 12 Sep): a resident speaks only in this card, and only after you walk up and tap.
       .tw-card--npc lets the tilted portrait lean out past the card's corner (the card scrolls otherwise). */
    /* ⚠️ the town's own `.tw-card h2` (1rem, a 0.15rem margin) beats the template's `.wd-card h2`
       on source order, which shortens the header and pulls the spoken line up UNDER the tilted
       portrait. The park clears its line by 8px; the town was cutting 11px into it. Give the
       dialogue card the template's own heading back. */
    .tw-card--npc h2 { font-size: 1.15rem; margin: 0 0 0.5rem; min-height: 58px; }
    .tw-card--npc { overflow: visible; --wd-btn: #2a1a10; --wd-btn-hi: #3d2818; --wd-box: #120c07; --wd-box-line: #4a3320; --wd-more: #ffb347; }
    /* the puff: the park's .pk-poof to the pixel — a flyer swept or picked up, water on the beds */
    .tw-poof { position: absolute; transform: translate(-50%, -50%); width: 3%; z-index: 1800; pointer-events: none; }
    .tw-poof span { position: absolute; inset: 0; opacity: 0; }
    .tw-poof svg { width: 100%; height: auto; image-rendering: pixelated; }
    .tw-poof__1 { animation: twPoofStep 0.75s steps(1) forwards; }
    .tw-poof__2 { animation: twPoofStep 0.75s steps(1) 0.25s forwards; }
    .tw-poof__3 { animation: twPoofStep 0.75s steps(1) 0.5s forwards; }
    @keyframes twPoofStep { 0% { opacity: 1; } 33%, 100% { opacity: 0; } }
    /* ✨ THE BURST (src/lib/world.js burstInto) — a pickup or a fix throws the park's harvest colours outward round a
       flash; the puff stays for things that merely vanish (Trym, 15 Sep: the puff is the rave's missed-drop) */
    .tw-burst { position: absolute; width: 0; height: 0; z-index: 1960; pointer-events: none; }
    .tw-burst i { position: absolute; left: 0; top: 0; width: 7px; height: 7px; transform: translate(-50%, -50%); animation: twBurst 0.85s cubic-bezier(0.2, 0.7, 0.3, 1) forwards; }
    .tw-burst__flash { position: absolute; left: 0; top: 0; width: 34px; height: 34px; border-radius: 50%; transform: translate(-50%, -50%) scale(0.3); background: radial-gradient(circle, #fffbe0 0 28%, rgba(255, 225, 53, 0.9) 29% 45%, rgba(255, 225, 53, 0) 70%); animation: twFlash 0.45s ease-out forwards; }
    @keyframes twBurst { 0% { opacity: 1; transform: translate(-50%, -50%) rotate(0); } 100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy) + 22px)) rotate(300deg) scale(0.5); } }
    @keyframes twFlash { 0% { opacity: 1; transform: translate(-50%, -50%) scale(0.3); } 60% { opacity: 0.9; transform: translate(-50%, -50%) scale(1.15); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.3); } }
    @media (prefers-reduced-motion: reduce) { .tw-burst i { display: none; } .tw-burst__flash { animation: none; opacity: 0; } }
    /* the flyers on the street: baked by the generator (litter-N.png), sized to their own pixels */
    .tw-litter { position: absolute; transform: translate(-50%, -100%); height: auto; image-rendering: pixelated; pointer-events: none; filter: drop-shadow(0 0 4px rgba(255, 225, 53, 0.85)); animation: twTodo 1.6s ease-in-out infinite alternate; }   /* the same soft glow as anything else to pick up */
    /* a home's window at night, the Mayor's in the evening: a warm glow that breathes */
    .tw-glow {
      position: absolute; width: 3.6%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; pointer-events: none;
      background: radial-gradient(circle, rgba(255, 214, 110, 1) 0%, rgba(255, 176, 50, 0.7) 34%, rgba(255, 150, 30, 0) 66%);
      animation: twGlow 2.6s ease-in-out infinite alternate;
    }
    .tw-glow--mayor { width: 4.2%; background: radial-gradient(circle, rgba(255, 200, 120, 1) 0%, rgba(255, 140, 50, 0.72) 34%, rgba(255, 110, 30, 0) 66%); }
    @keyframes twGlow { from { opacity: 0.72; } to { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { .tw-glow { animation: none; } }
    /* 🎛 THE ACTION BAR — the HUD's bottom half (design library §15): the park's
       .pk-actions metrics to the pixel, in the town's brick. The verb slot left,
       the heart, the travel door (world-travel.js mounts it and floors every row at 44px). */
    .tw-actions { display: flex; align-items: center; justify-content: center; gap: 0.6rem; background: #140d08; border-top: 4px solid #000; padding: 0.6rem 0.8rem; flex-wrap: wrap; touch-action: manipulation; }
    .tw-act { appearance: none; font: inherit; font-weight: 800; font-size: 0.95rem; border: 3px solid #000; box-shadow: 3px 3px 0 #000; cursor: pointer; line-height: 1; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.35rem; transition: transform 0.08s ease, box-shadow 0.08s ease; }
    .tw-act:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .tw-act--icon { background: #2a1a10; color: #fffdf5; padding: 0.5rem 0.7rem; font-size: 1.1rem; min-width: 46px; justify-content: center; }
    /* the verb slot: a GLYPH on yellow with a count badge — the HUD is icons, not words (Trym, 11 Sep) */
    .tw-act--tool { background: #ffe135; color: #241c00; padding: 0.5rem 0.7rem; min-width: 46px; justify-content: center; position: relative; }
    .tw-act svg { display: block; }
    .tw-act__n { position: absolute; top: -9px; right: -9px; min-width: 20px; height: 20px; padding: 0 5px; box-sizing: border-box; border-radius: 999px; background: #241c00; color: #ffe135; border: 2px solid #000; font-size: 0.66rem; font-weight: 800; line-height: 1; display: flex; align-items: center; justify-content: center; }
    .tw-row .pai { flex: none; margin-right: 0.5rem; color: #ffe135; }
    .tw-row__it { display: flex; align-items: center; min-width: 0; }
    .tw-row[data-say] { cursor: pointer; }
    /* the heart's float over the player — the park's .pk-float */
    .tw-float { position: absolute; transform: translate(-50%, -50%); z-index: 1950; pointer-events: none; font-family: "Archivo Black", sans-serif; font-size: 0.85rem; color: #ffe135; text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000, 2px 2px 0 #000; white-space: nowrap; animation: twFloat 0.9s ease-out forwards; }
    .tw-float svg { display: block; width: 22px; height: 22px; }
    @keyframes twFloat { to { transform: translate(-50%, calc(-50% - 34px)); opacity: 0; } }
    /* 🏘️ TOWN LIFE (14 Sep 2026) — the town's condition, drawn onto the props it already has.
       town-room.js owns every element here; nothing below is markup in this page. */
    /* the sky: the town's own evening and night, and a Curse Night darker than either. On the
       VIEW like the rain (design library §19), under the rain sheet (z 8) and over the map. */
    .tw-night { position: absolute; inset: 0; z-index: 7; background: #0a1024; opacity: 0; pointer-events: none; transition: opacity 3s ease; }
    /* a state sprite: frames stacked in one box like the fountain, but stepped by the room's own
       clock (a lamp pulses at 3 a second, a ghost floats at 6, a stutter is irregular — one
       keyframe per frame count would be a keyframe per sprite). is-flip mirrors the east lamps. */
    .tw-state { position: absolute; pointer-events: none; }
    .tw-state img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: pixelated; visibility: hidden; }
    .tw-state img.is-on { visibility: visible; }
    .tw-state.is-flip { transform: scaleX(-1); }
    .tw-state.is-fade { transition: opacity 1.4s ease; }
    .tw-state.is-hum { animation: twHum 2.2s ease-in-out infinite alternate; }
    .tw-state.is-flicker { animation: twFlicker 1.7s steps(1) infinite; }
    @keyframes twHum { from { filter: brightness(0.92) drop-shadow(0 0 3px rgba(150, 110, 255, 0.6)); } to { filter: brightness(1.18) drop-shadow(0 0 6px rgba(150, 110, 255, 0.9)); } }
    /* a thing to fix GLOWS, softly — the only mark on anything smaller than a lamp; a cursed object
       glows the other colour (Trym, 15 Sep: "a slight glow or something, subtle") */
    /* ⚡ the glow is a STATIC drop-shadow and the animation is opacity: animating the filter re-rasterised every
       glowing thing every frame (measured 15 Sep: paint was the town's largest cost at night) */
    .tw-state.is-todo { filter: drop-shadow(0 0 4px rgba(255, 225, 53, 0.85)); animation: twTodo 1.6s ease-in-out infinite alternate; }
    @keyframes twTodo { from { opacity: 0.7; } to { opacity: 1; } }
    /* 🔮 a cursed object stands in a dark purple fire: the pack's flame tinted by hue, a pulsing aura on the ground,
       the object's own violet edge (Trym, 15 Sep: "a dark purple flaming glow or something that looks more cursed") */
    .tw-state.is-cursed { filter: drop-shadow(0 0 2px rgba(130, 50, 230, 1)) drop-shadow(0 0 7px rgba(90, 20, 190, 0.8)); }
    .tw-state.is-flame { pointer-events: none; }
    /* the tint was picked from six rendered side by side (test-results/tint.png, 15 Sep): this one is a deep purple with a violet
       core; the lighter ones read pink, the sepia ones grey */
    .tw-state.is-flame img { filter: hue-rotate(250deg) saturate(1.6) brightness(0.6) contrast(1.3); }
    .tw-state.is-lick { opacity: 0.8; }
    .tw-aura { position: absolute; pointer-events: none; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(150, 60, 255, 0.85) 0%, rgba(110, 30, 220, 0.6) 45%, rgba(60, 0, 140, 0) 75%); animation: twAura 1.7s ease-in-out infinite; will-change: transform, opacity; }
    @keyframes twAura { 0%, 100% { transform: scale(1); opacity: 0.75; } 50% { transform: scale(1.14); opacity: 1; } }
    .tw-aura.is-born { animation: twBorn 0.9s ease-out 1, twAura 1.7s ease-in-out 0.9s infinite; }   /* a thing that APPEARS in the night: the aura blooms in */
    @keyframes twBorn { 0% { transform: scale(2.4); opacity: 0; } 60% { opacity: 1; } 100% { transform: scale(1); opacity: 0.8; } }
    /* 😱 the curse on you, after a pickup: see-through, a violet edge, afloat (the fire at the feet is a sprite) */
    .tw-me.is-cursed-me canvas { opacity: 0.66; filter: drop-shadow(0 0 3px rgba(150, 70, 255, 0.95)) drop-shadow(0 0 9px rgba(110, 30, 220, 0.7)); animation: twMeFloat 1.6s ease-in-out infinite; }
    @keyframes twMeFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
    /* one curse each (town-room.js ME_FX): the individual transform properties so the float keeps its own transform */
    .tw-me.is-me-giant canvas { scale: 1.35; transform-origin: 50% 100%; }
    .tw-me.is-me-tiny canvas { scale: 0.7; transform-origin: 50% 100%; }
    .tw-me.is-me-mirror canvas { scale: -1 1; }
    .tw-me.is-me-unseen canvas { opacity: 0.22; }
    .tw-me.is-me-blink canvas { animation: twMeFloat 1.6s ease-in-out infinite, twMeBlink 0.9s steps(1) infinite; }
    @keyframes twMeBlink { 0%, 100% { opacity: 0.66; } 40% { opacity: 0.08; } 55% { opacity: 0.66; } 70% { opacity: 0.15; } 80% { opacity: 0.66; } }
    .tw-me.is-me-purple canvas { filter: hue-rotate(250deg) saturate(1.5) drop-shadow(0 0 6px rgba(150, 70, 255, 0.95)); }
    .tw-me.is-me-cold canvas { filter: hue-rotate(185deg) saturate(0.9) brightness(1.15) drop-shadow(0 0 5px rgba(120, 200, 255, 0.9)); animation: twMeFloat 1.6s ease-in-out infinite, twShiver 0.16s steps(2) infinite; }
    @keyframes twShiver { from { translate: -1.5px 0; } to { translate: 1.5px 0; } }
    .tw-state.is-bluefire img { filter: hue-rotate(165deg) saturate(1.5) brightness(1.1); }
    .tw-me-twin { position: absolute; width: 4.5%; transform: translate(-50%, -100%); pointer-events: none; opacity: 0.6; }
    .tw-me-twin canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; filter: brightness(0) drop-shadow(0 0 4px rgba(120, 40, 220, 0.85)); }
    /* 🏷 the big red FOR SALE sign on the Coffee Cup */
    .tw-forsale { position: absolute; transform: translate(-50%, -50%) rotate(-3deg); pointer-events: none; background: #c62828; color: #fff6f6; border: 2px solid #16130a; box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.45); padding: 0.25em 0.7em; font-family: "Archivo Black", sans-serif; font-size: max(0.72rem, calc(9px * var(--ws, 1.6))); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
    @media (prefers-reduced-motion: reduce) { .tw-me.is-me-blink canvas, .tw-me.is-me-cold canvas { animation: none; } }
    @media (prefers-reduced-motion: reduce) { .tw-aura.is-born { animation: none; } .tw-me.is-cursed-me canvas { animation: none; } }
    @media (prefers-reduced-motion: reduce) { .tw-aura { animation: none; } }
    /* 👻 a ghost carries the purple too, weaker and see-through: a violet edge and a faint ellipse under it (Trym, 15 Sep) */
    .tw-state.is-haunt { filter: drop-shadow(0 0 6px rgba(140, 70, 255, 0.7)); }   /* one shadow on a thing that moves every frame */
    .tw-state.is-haunt::before { content: ''; position: absolute; left: -30%; right: -30%; bottom: -8%; height: 34%; border-radius: 50%; z-index: -1; background: radial-gradient(ellipse at center, rgba(150, 60, 255, 0.4) 0%, rgba(110, 30, 220, 0.26) 45%, rgba(60, 0, 140, 0) 75%); animation: twAura 2.4s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) { .tw-state.is-haunt::before { animation: none; } }
    @keyframes twFlicker { 0%, 100% { opacity: 1; } 71% { opacity: 0.35; } 74% { opacity: 1; } 86% { opacity: 0.5; } 89% { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { .tw-state.is-hum, .tw-state.is-flicker, .tw-state.is-todo { animation: none; } .tw-state.is-todo { filter: drop-shadow(0 0 4px rgba(255, 225, 53, 0.8)); } }
    /* a problem's mark: the questline's dashed ring, on the ground under the thing that is wrong */
    /* a problem's mark: the anchor on the ground is INVISIBLE — only the repair icon above the thing
       shows (Trym, 14 Sep: the rings "are just placed weirdly on top of the object") */
    .tw-mark { position: absolute; width: 0; height: 0; pointer-events: none; }
    /* the tools icon over the thing to fix: yellow on black, bobbing, the world's "this wants you" */
    .tw-mark__ic { position: absolute; left: 50%; width: 30px; height: 30px; margin-left: -15px; display: flex; align-items: center; justify-content: center; background: #ffe135; color: #241c00; border: 2px solid #000; box-shadow: 2px 2px 0 #000; animation: twBob 1.1s ease-in-out infinite alternate; }
    .tw-mark__ic .pai { display: block; }
    /* 🔧 the repair bar: a streetlight is WORK, so it fills while you stand there and stops if you walk off */
    .tw-work { position: absolute; width: 56px; height: 10px; margin-left: -28px; box-sizing: border-box;
      border: 2px solid #000; background: #0c140c; box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5); pointer-events: none; }
    .tw-work b { display: block; height: 100%; width: 0; background: #ffe135; }
    @keyframes twBob { from { transform: translateY(0); } to { transform: translateY(-7px); } }
    @media (prefers-reduced-motion: reduce) { .tw-mark__ic { animation: none; } }
    /* the shopfront's dark window and the fountain's dry basin are the props themselves, dimmed */
    .tw-ov.is-dark { filter: brightness(0.62) saturate(0.7); }
    .tw-state.is-shut img { filter: brightness(0.62) saturate(0.7); }   /* the shutter itself as dark as the kiosk it closes */
    /* 🚧 a shut kiosk taped off: two hazard bands across its front, a little red sign on the window */
    .tw-tape { position: absolute; pointer-events: none; transform-origin: 50% 50%; background: repeating-linear-gradient(45deg, #f2c800 0 9px, #16130a 9px 18px); border: 1px solid #16130a; box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.35); opacity: 0.94; }
    .tw-shutsign { position: absolute; transform: translate(-50%, -50%) rotate(-2deg); pointer-events: none; background: #c62828; color: #fff6f6; border: 1px solid #16130a; box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.45); padding: 0.2em 0.5em; font-family: "Archivo Black", sans-serif; font-size: max(0.42rem, calc(4.2px * var(--ws, 1.6))); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
    .tw-burst--curse .tw-burst__flash { background: radial-gradient(circle, #f0e4ff 0 28%, rgba(150, 70, 255, 0.9) 29% 45%, rgba(110, 30, 220, 0) 70%); }
    .tw-state.is-shut.is-todo img { filter: brightness(0.7) saturate(0.7); }
    .tw-world.is-inside :is(.tw-state, .tw-mark, .tw-visitor, .tw-aura, .tw-tape, .tw-shutsign, .tw-forsale, .tw-me-twin, .tw-work) { visibility: hidden; }
    /* the store's shelf and the vendor's: the town's row with the piece's own sprite in front */
    .tw-store { display: grid; gap: 0.45rem; margin: 0.5rem 0; }
    .tw-store__it { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
    .tw-store__it img { width: 44px; height: 44px; object-fit: contain; image-rendering: pixelated; flex: none; background: #120c07; border: 2px solid #000; }
    .tw-store__it b { display: block; font-size: 0.9rem; }
    .tw-store__it small { display: block; opacity: 0.8; font-size: 0.72rem; line-height: 1.3; }
    /* 📌 THE NOTICE BOARD, as a card that IS the board (Trym, 14 Sep: "a game-popup, not a
       website popup"): the wood of the in-world planks, papers pinned to it, the band stamped
       in red, the tally on three notes. The frame stays the world's (4px black, hard shadow). */
    .tw-card--board { background: #8a5a2b; background-image: linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 0, 0, 0.12) 2px, transparent 2px); background-size: 100% 6px, 64px 100%; box-shadow: inset 0 0 0 4px #5c3a18, 6px 6px 0 #000; padding: 1.1rem 1rem 1rem; }
    .tw-card--board .tw-cardx { color: #fffdf5; background: rgba(0, 0, 0, 0.35); border-radius: 0; }
    .tw-board2 { display: grid; gap: 0.7rem; }
    .tw-board2__head { display: flex; justify-content: center; margin: -0.45rem 0 0.1rem; }   /* inside the frame at every width: the card clips its overflow */
    /* the title on a plank — the same nameplate the square hangs on every door, resting on the frame */
    .tw-plank--card { position: static; transform: rotate(-1.5deg); font-size: 0.72rem; padding: 4px 12px; box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.55); cursor: default; }
    .tw-paper { position: relative; background: #f6ecd2; color: #241c00; border: 2px solid #000; box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.45); padding: 0.75rem 0.7rem 0.6rem; }
    .tw-paper--notice { transform: rotate(-0.8deg); text-align: center; }
    .tw-paper--notice p { margin: 0.35rem 0 0; font-size: 0.82rem; line-height: 1.35; }
    .tw-pin { position: absolute; left: 50%; top: -7px; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #ff8a80, #d0322a 60%, #8a1a14); border: 2px solid #000; box-shadow: 1px 2px 0 rgba(0, 0, 0, 0.5); }
    .tw-pin--b { background: radial-gradient(circle at 35% 35%, #9ad4ff, #2f7fd6 60%, #164a86); }
    /* the band, stamped: a rubber stamp's red, slightly crooked, never quite even */
    .tw-lamps { display: block; width: 220px; max-width: 100%; height: 66px; margin: 0 auto; image-rendering: pixelated; }
    .tw-next { display: block; font-size: 0.68rem; line-height: 1.3; margin: 2px 0 0; opacity: 0.9; }
    .tw-next b { color: #b8302a; }
    /* the second notice: what is going on. Red-pinned and tinted when a night is near or on */
    .tw-paper--news { transform: rotate(0.9deg); padding-top: 0.9rem; }
    .tw-paper--news p { margin: 0; font-size: 0.78rem; line-height: 1.35; }
    .tw-paper--news p + p { margin-top: 0.35rem; padding-top: 0.35rem; border-top: 1px dashed rgba(0, 0, 0, 0.25); }
    .tw-paper--news .tw-news__now { font-weight: 800; }
    .tw-paper--news.is-omen { background: #efd9d6; }
    .tw-paper--intro { margin-bottom: 0.6rem; }
    .tw-todo { margin: 0.35rem 0 0; font-size: 0.86rem; line-height: 1.4; font-weight: 700; }
    .tw-todo__h { display: block; font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.7; font-weight: 800; margin-bottom: 0.1rem; }
    .tw-paper--intro p { margin: 0; font-size: 0.84rem; line-height: 1.38; font-weight: 700; }
    /* 🌸 THE TOWN HEALTH BAR — the park's .pk-hbar, to the pixel (Trym, 15 Sep: "make it the same"):
       bottom-docked, the rave jellymeter's language (chunky dark box, hard border, bordered inner
       track), the face and the whole palette riding the band, the % riding the fill, the (i) cap
       that says it opens. Tap = the town-health card. */
    .tw-hbar {
      position: absolute; left: 50%; bottom: 8px; transform: translateX(-50%); z-index: 8;
      width: min(520px, calc(100% - 16px)); box-sizing: border-box;
      display: flex; align-items: center; gap: 8px;
      appearance: none; font: inherit; cursor: pointer;
      background: rgba(13, 18, 11, 0.9); border: 3px solid #000; padding: 6px 8px;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent;
      box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.55);
    }
    .tw-hbar:active { transform: translateX(-50%) translateY(2px); box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.55); }
    .tw-hbar__more { display: grid; place-items: center; flex: none; opacity: 0.75; color: #e8f4e8; }
    .tw-hbar__more .pai { display: block; }
    @media (hover: hover) { .tw-hbar:hover .tw-hbar__more { opacity: 1; } .tw-hbar:hover { filter: brightness(1.12); } }
    .tw-hbar__face { display: grid; place-items: center; width: 22px; height: 22px; flex: none; }
    .tw-hbar__face .pai { display: block; }
    .tw-hbar__track { position: relative; flex: 1; height: 16px; border: 2px solid #000; overflow: hidden; }
    .tw-hbar__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; transition: width 0.5s ease; }
    .tw-hbar__pct {
      position: absolute; top: 50%; left: 0; transform: translate(-100%, -50%);
      padding: 0 4px; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.05em;
      white-space: nowrap; transition: left 0.5s ease; color: #0d120b;
    }
    .tw-hbar__pct.is-out { transform: translate(2px, -50%); color: #fffdf5; }
    /* the five band palettes — the park's own, dusty browns → olive → lush green */
    .tw-hbar--p0 { border-color: #1c140c; }
    .tw-hbar--p0 .tw-hbar__face { color: #8a6a44; }
    .tw-hbar--p0 .tw-hbar__track { background: #2a2118; }
    .tw-hbar--p0 .tw-hbar__fill { background: #6b4a2c; }
    .tw-hbar--p0 .tw-hbar__pct { color: #f0e2c8; }
    .tw-hbar--p1 .tw-hbar__face { color: #b08a4a; }
    .tw-hbar--p1 .tw-hbar__track { background: #322718; }
    .tw-hbar--p1 .tw-hbar__fill { background: #8a6a38; }
    .tw-hbar--p1 .tw-hbar__pct { color: #f5ecd8; }
    .tw-hbar--p2 .tw-hbar__face { color: #c0c050; }
    .tw-hbar--p2 .tw-hbar__track { background: #2a2c16; }
    .tw-hbar--p2 .tw-hbar__fill { background: #a8a83a; }
    .tw-hbar--p3 .tw-hbar__face { color: #7cc465; }
    .tw-hbar--p3 .tw-hbar__track { background: #1c2a18; }
    .tw-hbar--p3 .tw-hbar__fill { background: #5cb04a; }
    .tw-hbar--p4 .tw-hbar__face { color: #6ff0a0; }
    .tw-hbar--p4 .tw-hbar__track { background: #16281a; }
    .tw-hbar--p4 .tw-hbar__fill { background: #35d97a; }
    .tw-hbar--p4 .tw-hbar__fill::after { content: ''; position: absolute; left: 0; right: 0; top: 2px; height: 3px; background: rgba(255, 255, 255, 0.32); }
    .tw-hbar__pct.is-out { color: #fffdf5; }
    /* the toast clears the bar's dock, the park's way */
    .tw-toast { bottom: 52px; }
    /* the card: the park's health card — ONE continuous bar, the five bands as zones, ticks at the
       band lines, a glyph per band (the live one ringed), invisible tap zones over each for the
       one-line reveal. The fill + number track live while the card is open. */
    /* the health card centres its label and number on the CARD, not on what is left beside the
       floated ✕ — the close sits in the corner instead (Trym, 15 Sep: "doesnt look centered") */
    .tw-card--health { position: relative; }
    .tw-card--health .tw-cardx { position: absolute; float: none; right: 6px; top: 6px; margin: 0; }
    .tw-bbar { position: relative; margin: 0.55rem 0 0.45rem; --ramp: linear-gradient(90deg, #8a8a96, #b08a4a, #d9c25a, #7cc465, #35d97a); }
    .tw-bglyphs { display: flex; padding-bottom: 5px; }
    .tw-bglyph { text-align: center; font-size: 15px; line-height: 1; filter: grayscale(0.5); opacity: 0.45; transition: opacity 0.3s ease, transform 0.3s ease; }
    .tw-bglyph.is-now { filter: none; opacity: 1; transform: scale(1.2); }
    .tw-bglyph.is-open { filter: none; opacity: 0.9; }
    .tw-btrack { position: relative; height: 22px; border: 2px solid #000; border-radius: 6px; overflow: hidden; background: #0c140c; }
    .tw-bramp, .tw-bfill { position: absolute; inset: 0; background: var(--ramp); }
    .tw-bramp { opacity: 0.18; }
    .tw-bfill { transition: clip-path 0.5s ease; }
    @media (prefers-reduced-motion: reduce) { .tw-bfill { transition: none; } }
    .tw-btick { position: absolute; top: 0; bottom: 0; width: 2px; background: rgba(0, 0, 0, 0.55); }
    .tw-bzone { position: absolute; top: 0; bottom: 0; appearance: none; background: transparent; border: 0; padding: 0; cursor: pointer; }
    .tw-bexp { margin: 0.1rem 0 0.55rem; font-size: 0.92rem; font-weight: 800; color: #8de08d; text-align: center; }
    .tw-bexp--sad { color: #c9913a; }
    .tw-bmeta { margin: 0.2rem 0 0; font-size: 0.76rem; font-weight: 700; opacity: 0.7; text-align: center; }
    .tw-bmeta svg { vertical-align: -2px; color: #ffd23f; }
    .tw-bpips { display: flex; gap: 3px; margin: 0.5rem auto 0; width: min(220px, 82%); }
    .tw-bpips i { flex: 1; height: 8px; background: #3a2a10; border: 2px solid #000; }
    .tw-bpips i.is-on { background: #ffe135; }
    .tw-bpips.is-done i { background: #ffd23f; box-shadow: 0 0 5px rgba(255, 225, 53, 0.8); }
    /* 🌙 the nightfall clock in the HUD's slot: sun or moon, and how long until the other */
    .wh__slot .tw-clock { display: inline-flex; align-items: center; gap: 4px; font-variant-numeric: tabular-nums; }
    .wh__slot .tw-clock b { color: #ffe135; }
    .wh__slot .tw-clock .pai { display: block; color: #ffd23f; }
    .tw-tally { display: flex; gap: 0.6rem; margin: 0.35rem 0 0; align-items: stretch; }
    .tw-paper--note { flex: 1; text-align: center; padding: 0.85rem 0.3rem 0.5rem; }
    .tw-paper--note.is-a { transform: rotate(1.6deg); } .tw-paper--note.is-b { transform: rotate(-1.2deg); } .tw-paper--note.is-c { transform: rotate(2deg); }
    .tw-paper--note .pai { display: block; margin: 0 auto 2px; color: #3a2a10; }
    .tw-paper--note b { display: block; font-family: "Archivo Black", sans-serif; font-size: 1.45rem; color: #241c00; line-height: 1.05; }
    .tw-paper--note small { display: block; font-size: 0.66rem; line-height: 1.25; margin-top: 3px; opacity: 0.85; }
    .tw-paper--list { display: grid; gap: 0.5rem; transform: rotate(0.6deg); padding-top: 1rem; }
    .tw-paper--list .tw-store__it b { font-size: 0.86rem; color: #241c00; }
    .tw-paper--list .tw-store__it small { color: #3a2a10; }
    .tw-paper--list .tw-store__it img { background: #e6d9b6; }
  </style>

  <main class="tw-wrap">
    <h1 class="tw-sign">BANANA TOWN</h1>
    <p class="tw-tag">the square, as a prototype. Not linked from anywhere.</p>
    <div class="tw-stage">
      <div class="tw-view" id="twView">
        <div class="tw-world" id="twWorld"></div>
        <div class="tw-toast" id="twToast" hidden></div>
        <!-- 🃏 the cards: the world's card grammar, brick-warm. Prototype: nothing is saved, no coins move -->
        <div class="tw-panel" id="twPanel" hidden>
          <div class="tw-card" role="dialog" aria-label="Town card">
            <button class="tw-cardx" id="twCardX" type="button" aria-label="close">✕</button>
            <div id="twCardBody"></div>
          </div>
        </div>
        <!-- 👝 the pocket's tray: rises from the action bar's POCKET button -->
        <div class="tw-tray" id="twTray" hidden></div>
        <canvas class="tw-fx" id="twFx" hidden></canvas>
      </div>
      <!-- 🎛 the action bar: the HUD's bottom half. POCKET is the verb slot (hidden
           until it holds something — the park's tool-slot grammar), then the heart,
           then the travel door (mounted by world-travel.js). No sound button yet:
           the town has nothing to mute. -->
      <div class="tw-actions" aria-label="town actions">
        <button class="tw-act tw-act--tool" id="twPocket" type="button" aria-label="Your pocket" hidden></button>
        <button class="tw-act tw-act--icon" id="twEmote" type="button" aria-label="Send a heart"><PixelIcon name="heart" size="1.25em" /></button>
      </div>
    </div>
    <p class="tw-note">Walk with a tap or the arrow keys. Tap a door, a sign or a banana to read what it will be. The road south goes back to the park.</p>
  </main>

  <script src="../scripts/banana-town.js"></script>
</BaseLayout>
