---
import BaseLayout from '../layouts/BaseLayout.astro';
import ForgeStudio from '../components/ForgeStudio.astro';

const title = 'Emoji Maker & Animated GIF Maker — Free Pixel Emotes | Pixel Forge';
const description = 'Free emoji maker & animated GIF maker in your browser: draw pixel art frame by frame, remix existing GIFs, preview at real chat size, export transparent GIFs and PNGs sized for Discord (128px), Twitch (112px), Slack and Telegram. No account, no watermark.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'The Pixel Forge',
  alternateName: ['Emoji Maker', 'Pixel Emote Maker', 'Animated GIF Maker', 'GIF Drawing Tool'],
  url: 'https://trymstene.com/forge/',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  creator: { '@id': 'https://trymstene.com/#trym' },
  featureList: 'Pixel drawing tools, brush sizes, custom colours, GIF import and remix, frame-by-frame animation, onion skinning, live chat-size preview, transparent GIF and PNG export sized for Discord, Twitch, Slack and Telegram',
  description: 'A deliberately simple pixel-art emoji and emote maker, from the creator of the 1999 Dancing Banana GIF.',
};

// ONE source for the FAQ: the visible section and the FAQPage JSON-LD both
// render from this list, so the markup can never drift from the page content
const FAQ = [
  { q: 'Is the Pixel Forge emoji maker free?',
    a: 'Yes — completely free, no account, no watermark. Draw in the browser and download transparent GIFs or PNGs ready for Discord, Twitch, Slack and Telegram.' },
  { q: 'Can I draw an animated GIF from scratch?',
    a: 'Yes — that is the whole idea. Most GIF makers only convert videos or stitch photos together; the Forge is a GIF drawing tool. You draw every frame in pixels, set the timing per frame, and export a real animated GIF.' },
  { q: 'Can I make animated Discord emojis with it?',
    a: 'Yes. Draw up to 16 frames with per-frame timing and export a transparent animated GIF at 128×128 pixels — exactly what Discord custom emojis require.' },
  { q: 'Can I make Twitch emotes with it?',
    a: 'Yes. Export at 112×112 pixels with a transparent background and Twitch auto-generates the 56px and 28px sizes when you upload.' },
  { q: 'Are the GIFs transparent?',
    a: 'Yes, every export supports transparency. Anything you leave unpainted stays see-through, so your emote floats over any chat background — no white box around it.' },
  { q: 'Can I import an existing GIF and remix it?',
    a: 'Yes. Import any GIF and it lands on the grid frame by frame, ready to redraw — including the original 1999 Dancing Banana, which is one click away.' },
  { q: 'Do I need an account or an app?',
    a: 'No. It runs entirely in your browser — nothing to install, no sign-up, no watermark. Finished pieces land on your Banana Pass so you can come back to them.' },
  { q: 'What is the Items Workshop?',
    a: 'The Forge’s second bench, at its own address: draw a wearable item directly on the dancing banana — a hat, a sword, a rubber duck — and submit it to the banana club. Approved items become drops at the live rave: another visitor catches yours, wears it everywhere, and your name rides along as the maker.' },
  { q: 'Why pixel art for emotes?',
    a: 'Emotes render at 28–32 pixels in chat, where fine detail turns to mush. Pixel art drawn on a small grid stays crisp and readable — the same reason the 1999 Dancing Banana still works everywhere.' },
];
const faqLD = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title={title}
  description={description}
  ogTitle="The Pixel Forge 🎨"
  ogDescription="The dancing banana was drawn in a tool like this in 1999. Here it is, rebuilt. Make the next one."
  ogImage="https://trymstene.com/assets/og/builder.png"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLD)} />

  <div class="fg-wrap">
    <div class="fg-head">
      <h1>the pixel forge — free emoji, emote &amp; GIF maker</h1>
      <p>
        In 1999 I drew a dancing banana in a tool about this simple — and it took over the internet.
        Here's that tool, rebuilt. Pencil, fill, frames, one great palette. <strong>Make the next one.</strong>
      </p>
    </div>

    <ForgeStudio mode="emoji" />

    <section class="fg-story">
      <h2>An emoji maker that respects the pixel</h2>
      <p>
        Most emoji makers are photo croppers with a watermark. This is a
        <strong>pixel emote maker</strong>: small grid, four tools, frame-by-frame animation,
        live preview at the exact size chat renders. Emotes live at 28–32 pixels — art drawn
        <em>for</em> that size beats anything shrunk down to it. In 1999 I drew the
        <a href="/dancing-banana-gif-meme/">dancing banana</a> in a tool this simple.
        This is that tool, rebuilt. Free, no account, no watermark.
      </p>
    </section>

    <section class="fg-exports" aria-label="Export sizes per platform">
      <h2>Sized for your platform</h2>
      <div class="fg-expgrid">
        <a href="/discord-emoji-size/" class="fg-exp"><b>128×128</b><span>Discord &amp; Slack</span><small>transparent GIF, under the caps</small></a>
        <a href="/twitch-emote-size/" class="fg-exp"><b>112×112</b><span>Twitch</span><small>56px + 28px auto-generated</small></a>
        <a href="/guides/" class="fg-exp"><b>512×512</b><span>Telegram &amp; hi-res</span><small>GIF or PNG</small></a>
        <a href="/guides/" class="fg-exp"><b>every ⧉</b><span>All platforms</span><small>the emoji size chart →</small></a>
      </div>
    </section>

    <section class="fg-steps" aria-label="How to make an emoji">
      <h2>How to make an emoji</h2>
      <div class="fg-stepgrid">
        <div class="fg-step"><b>1</b><span><strong>Pick a grid</strong> — 32×32 is the sweet spot. Or import a GIF and remix it (<em>the</em> banana is one click away).</span></div>
        <div class="fg-step"><b>2</b><span><strong>Draw</strong> — pencil, fill, eraser. Watch the live chat preview while you work.</span></div>
        <div class="fg-step"><b>3</b><span><strong>Animate</strong> — add frames, duplicate, nudge. Onion skin ghosts the previous one.</span></div>
        <div class="fg-step"><b>4</b><span><strong>Forge it</strong> — transparent GIF or PNG, ready to upload to Discord, Twitch or Slack.</span></div>
      </div>
    </section>

    <section class="fg-drawgif">
      <h2>Draw an animated GIF from scratch</h2>
      <p>
        Every big GIF maker converts video. The Forge is the other kind — a
        <strong>GIF drawing tool</strong>, like the ones the first GIF artists used. Draw each
        frame in pixels, set the timing, export a real animated GIF with real transparency.
        Nothing converted, everything <em>drawn</em>. If you can doodle, you can animate.
      </p>
    </section>

    <section class="fg-facts" aria-label="Pixel facts">
      <div class="fg-fact"><b>1989</b> GIFs learn to animate and go transparent (GIF89a) — your emotes ship in that same format</div>
      <div class="fg-fact"><b>28 px</b> the size a Twitch emote actually renders in chat — draw for it, don't shrink to it</div>
      <div class="fg-fact"><b>1999</b> the dancing banana is drawn in a tool this simple — 27 years later it's still everywhere</div>
      <div class="fg-fact"><b>256</b> colours per GIF frame, plus one transparent — constraints are where style comes from</div>
    </section>

    <section class="fg-faq" aria-label="Frequently asked questions">
      <h2>Questions, answered</h2>
      <div class="fg-faqgrid">
        {FAQ.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="fg-doorswrap" aria-label="More on trymstene.com">
      <h2>More from the banana world</h2>
      <div class="fg-doors">
        <a href="/forge/items/" data-place="forge-doors"><b>The Items Workshop 🎁</b><span>Draw a wearable right on the dancing banana and submit it to the club — approved items drop at the rave with your name riding them.</span></a>
        <a href="/make-a-banana/" data-place="forge-doors"><b>Dress the banana 🍌</b><span>Build your own dancing banana — hats, shades, captions — and download it free as a GIF or meme.</span></a>
        <a href="/dancing-banana-remixes/" data-place="forge-doors"><b>The remix gallery 🎨</b><span>Hundreds of community remixes of the dancing banana, collected since 1999. Rate your favourites.</span></a>
        <a href="/dancing-banana-gif-meme/" data-place="forge-doors"><b>The original GIF 📼</b><span>The 1999 Dancing Banana — the story, the free downloads, the whole saga.</span></a>
        <a href="/guides/" data-place="forge-doors"><b>Emoji size guides 📐</b><span>Exact emoji, emote and sticker dimensions for Discord, Twitch, Slack and the rest.</span></a>
        <a href="/rave/" data-place="forge-doors"><b>The Banana Rave 🪩</b><span>A live pixel dance floor where every banana is a real visitor. Yes, really.</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
