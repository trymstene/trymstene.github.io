---
// 🌳 THE PARK — Park 2.0 P2 PREVIEW (park-2-plan). The walkable park on the
// beach engine's chassis. QA surface only: noindexed, unlinked, absent from
// the sitemap allowlist. The live /park/ (the old stand shop) is untouched —
// the flip to this scene happens in a later phase.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="The Park"
  description="The park — a walkable corner of Banana World."
  robots="noindex"
  showFooter={false}
>
  <link rel="preload" as="image" href="/assets/park/park.png" slot="head" />
  <link rel="preconnect" href="https://banana-rave.trymstene.workers.dev" slot="head" />
  <style is:inline slot="head">
    body { background: #101a10; }
    .pk-wrap { max-width: 1000px; margin: 0 auto; padding: 0.6rem 0.8rem 2.5rem; color: #fffdf5; }
    .pk-sign {
      font-family: "Archivo Black", sans-serif; text-align: center;
      color: #8de08d; font-size: clamp(1.4rem, 6.4vw, 2.2rem); line-height: 1.05;
      margin: 0.7rem 0 0.15rem; letter-spacing: 0.02em;
      text-shadow: 0 0 12px rgba(141, 224, 141, 0.4), 0 0 30px rgba(60, 160, 80, 0.3);
    }
    .pk-tag { text-align: center; margin: 0 0 0.8rem; font-size: 0.82rem; opacity: 0.6; }

    /* the frame is on the stage so the action band sits BELOW the map inside it */
    .pk-stage { border: 4px solid #000; box-shadow: 8px 8px 0 #000; }
    /* the viewport: a window onto a world bigger than it, both axes */
    .pk-view {
      position: relative; height: min(74vh, 580px); overflow: hidden; cursor: pointer;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent;
      background: #14240f;
    }
    .pk-world {
      position: absolute; left: 0; top: 0;
      background: url('/assets/park/park.png') 0 0 / 100% 100% no-repeat;
      image-rendering: pixelated; will-change: transform;
    }
    /* ⭐ the y-sorted prop layer — z comes from each prop's ground line in JS */
    .pk-ov {
      position: absolute; pointer-events: none; image-rendering: pixelated;
      background-size: 100% 100%; background-repeat: no-repeat;
    }
    /* ⛲ the fountain — 6-frame strip; end = 100% × 6 / 5 (the stepping rule) */
    .pk-fountain {
      position: absolute; transform: translate(-50%, -100%); pointer-events: none;
      image-rendering: pixelated; background-repeat: no-repeat;
      background-image: url('/assets/park/a-fountain.png');
      background-size: 600% 100%;
      animation: pkFountain 0.9s steps(6) infinite;
    }
    @keyframes pkFountain {
      from { background-position-x: 0%; }
      to   { background-position-x: 120%; }
    }
    @media (prefers-reduced-motion: reduce) { .pk-fountain { animation: none; } }

    /* the banana — % of the world, so sprites ride the camera free */
    .pk-me { position: absolute; z-index: 6; width: 3.6%; transform: translate(-50%, -100%); pointer-events: none; }
    .pk-me::after {
      content: ''; position: absolute; left: 50%; bottom: -3px; width: 76%; aspect-ratio: 3 / 1;
      transform: translateX(-50%); background: rgba(20, 40, 18, 0.32);
      border-radius: 50%; z-index: -1;
    }
    .pk-peer {
      position: absolute; width: 3.6%; transform: translate(-50%, -100%);
      pointer-events: none; transition: left 0.18s linear, top 0.18s linear;
    }
    .pk-peer::after {
      content: ''; position: absolute; left: 50%; bottom: -3px; width: 76%; aspect-ratio: 3 / 1;
      transform: translateX(-50%); background: rgba(20, 40, 18, 0.32);
      border-radius: 50%; z-index: -1;
    }
    .pk-peer span {
      position: absolute; left: 50%; top: -14px; transform: translateX(-50%);
      font-size: 0.5rem; font-weight: 800; letter-spacing: 0.05em;
      color: #fffdf5; text-shadow: 1px 1px 0 #000; white-space: nowrap;
    }
    .pk-me canvas, .pk-peer canvas { width: 100%; height: auto; image-rendering: pixelated; display: block; }
    /* leavers go in a puff, never a blink — the world-lib smoke */
    .pk-poof { position: absolute; transform: translate(-50%, -50%); width: 3%; z-index: 1800; pointer-events: none; }
    .pk-poof span { position: absolute; inset: 0; opacity: 0; }
    .pk-poof svg { width: 100%; height: auto; image-rendering: pixelated; }
    .pk-poof__1 { animation: pkPoofStep 0.75s steps(1) forwards; }
    .pk-poof__2 { animation: pkPoofStep 0.75s steps(1) 0.25s forwards; }
    .pk-poof__3 { animation: pkPoofStep 0.75s steps(1) 0.5s forwards; }
    @keyframes pkPoofStep { 0% { opacity: 1; } 33%, 100% { opacity: 0; } }
    .pk-float {
      position: absolute; transform: translate(-50%, -50%); z-index: 1950; pointer-events: none;
      font-family: "Archivo Black", sans-serif; font-size: 0.85rem; color: #ffe135;
      text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000, 2px 2px 0 #000;
      white-space: nowrap; animation: pkFloat 0.9s ease-out forwards;
    }
    @keyframes pkFloat { to { transform: translate(-50%, calc(-50% - 34px)); opacity: 0; } }

    .pk-hint {
      position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); z-index: 7;
      background: rgba(0, 0, 0, 0.55); border: 2px solid #000; color: #fffdf5;
      font-size: 0.78rem; padding: 0.3rem 0.65rem; pointer-events: none; white-space: nowrap;
      transition: opacity 0.4s ease;
    }
    .pk-hint.is-off { opacity: 0; }
    /* 🚪 the exit confirm strip — comes on in a door zone, names where the
       road goes; walking on to the door is the yes */
    .pk-exitstrip {
      position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); z-index: 8;
      background: rgba(0, 0, 0, 0.78); border: 2px solid #ffe135; color: #ffe135;
      font-weight: 800; font-size: 0.82rem; padding: 0.35rem 0.75rem;
      pointer-events: none; white-space: nowrap;
      opacity: 0; transition: opacity 0.25s ease;
    }
    .pk-exitstrip.is-on { opacity: 1; }

    /* 🌍 THE WORLD HUD — the refined pill strip (rave/bay), park edition */
    .pk-whud {
      position: absolute; top: 8px; right: 8px; z-index: 9;
      display: flex; gap: 5px; align-items: center; justify-content: flex-end;
      flex-wrap: wrap; max-width: calc(100% - 16px);
    }
    .pk-whud > * {
      margin: 0; height: 27px; box-sizing: border-box; display: flex; align-items: center;
      gap: 5px; background: rgba(14, 22, 14, 0.82); border: 2px solid #000;
      border-radius: 6px; padding: 0 9px; font-weight: 800; font-size: 0.76rem;
      line-height: 1; color: #fffdf5; white-space: nowrap;
    }
    .pk-whud .pk-whud__lvl { color: #ffe135; border-color: #ffe135; }
    .pk-whud__lvlbar {
      flex: 0 0 42px; min-width: 42px; height: 6px; background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(0, 0, 0, 0.6); border-radius: 3px; overflow: hidden;
    }
    .pk-whud__lvlbar i { display: block; height: 100%; width: 0; background: #ffe135; transition: width 0.5s ease; }
    .pk-whud__coins img { display: block; image-rendering: pixelated; }
    .pk-whud__coins b { color: #ffe135; }
    .pk-whud__crowd { color: #8affc0; }

    /* 🎮 THE ACTION BAR — an in-flow band BELOW the map: React · Sound */
    .pk-actions {
      display: flex; align-items: center; justify-content: center; gap: 0.6rem;
      background: #101a10; border-top: 4px solid #000; padding: 0.6rem 0.8rem;
      flex-wrap: wrap; touch-action: manipulation;
    }
    .pk-act {
      appearance: none; font: inherit; font-weight: 800; font-size: 0.95rem;
      border: 3px solid #000; box-shadow: 3px 3px 0 #000; cursor: pointer;
      line-height: 1; white-space: nowrap; display: inline-flex; align-items: center;
      gap: 0.35rem; transition: transform 0.08s ease, box-shadow 0.08s ease;
    }
    .pk-act:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .pk-act--icon { background: #182a16; color: #fffdf5; padding: 0.5rem 0.7rem; font-size: 1.1rem; min-width: 46px; justify-content: center; }

    .pk-cut {
      position: fixed; inset: 0; background: #000; z-index: 60; pointer-events: none;
      opacity: 0; transition: opacity 0.12s steps(2);
    }
    .pk-cut.is-on { opacity: 1; }
    @media (prefers-reduced-motion: reduce) { .pk-cut { transition: none; } }

    /* 🌰 acorns on the grass — a rise-in like the bay's shells */
    .pk-acorn {
      position: absolute; z-index: 3; width: 0.75%; aspect-ratio: 11 / 13;
      transform: translate(-50%, -50%); pointer-events: none;
      filter: drop-shadow(1px 2px 0 rgba(20, 40, 18, 0.45));
      animation: pkRise 0.45s ease-out;
    }
    .pk-acorn svg { width: 100%; height: 100%; display: block; }
    @keyframes pkRise {
      0% { transform: translate(-50%, calc(-50% + 10px)) scale(0.5); opacity: 0; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) { .pk-acorn { animation: none; } }

    /* 🦋 butterflies — two SVG frames stepped like the poof */
    .pk-bfly {
      position: absolute; width: 0.85%; aspect-ratio: 10 / 8;
      pointer-events: none;
      filter: drop-shadow(1px 2px 0 rgba(20, 40, 18, 0.3));
    }
    .pk-bfly svg, .pk-bslot svg { width: 100%; height: 100%; display: block; }
    .pk-bfly svg .f1, .pk-bslot svg .f1 { animation: pkFlapA 0.32s steps(1) infinite; }
    .pk-bfly svg .f2, .pk-bslot svg .f2 { animation: pkFlapB 0.32s steps(1) infinite; }
    @keyframes pkFlapA { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    @keyframes pkFlapB { 0%, 49% { opacity: 0; } 50%, 100% { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) {
      .pk-bfly svg .f1, .pk-bslot svg .f1 { animation: none; }
      .pk-bfly svg .f2, .pk-bslot svg .f2 { animation: none; opacity: 0; }
    }

    /* 🐿 squirrels — legs stop when the squirrel does (crab rule) */
    .pk-squirrel {
      position: absolute; width: 0.95%; aspect-ratio: 14 / 10;
      transform: translate(-50%, -100%); pointer-events: none;
      filter: drop-shadow(1px 2px 0 rgba(20, 40, 18, 0.35));
    }
    .pk-squirrel svg { width: 100%; height: 100%; display: block; }
    .pk-squirrel svg .f1 { animation: pkFlapA 0.22s steps(1) infinite; }
    .pk-squirrel svg .f2 { animation: pkFlapB 0.22s steps(1) infinite; }
    .pk-squirrel.is-still svg .f1 { animation: none; opacity: 1; }
    .pk-squirrel.is-still svg .f2 { animation: none; opacity: 0; }

    /* 🛝 the ride animation overlays — hidden until somebody's on; frame 0 of
       each strip is the baked pose, so on/off never pops. End values per the
       stepping rule: 100% × N / (N − 1). */
    .pk-ride {
      position: absolute; display: none; pointer-events: none;
      image-rendering: pixelated; background-repeat: no-repeat;
    }
    .pk-ride.is-on { display: block; }
    .pk-ride--12 { background-size: 1200% 100%; animation: pkRide12 1.15s steps(12) infinite; }
    .pk-ride--8 { background-size: 800% 100%; animation: pkRide8 0.95s steps(8) infinite; }
    @keyframes pkRide12 { from { background-position-x: 0%; } to { background-position-x: 109.0909%; } }
    @keyframes pkRide8 { from { background-position-x: 0%; } to { background-position-x: 114.2857%; } }
    @media (prefers-reduced-motion: reduce) { .pk-ride--12, .pk-ride--8 { animation: none; } }

    /* 🪙 the tossed coin — left/top glide + an inner lift = the arc */
    .pk-coinfly {
      position: absolute; pointer-events: none;
      transition: left 0.7s linear, top 0.7s ease-in;
    }
    .pk-coinfly img {
      display: block; image-rendering: pixelated;
      animation: pkCoinArc 0.7s ease-out forwards;
    }
    @keyframes pkCoinArc {
      0% { transform: translateY(0) rotate(0); }
      45% { transform: translateY(-46px) rotate(180deg); }
      100% { transform: translateY(0) rotate(360deg); }
    }
    .pk-act--toss { background: #ffe135; color: #10240f; padding: 0.55rem 1.05rem; }
    .pk-act--toss[hidden] { display: none; }

    /* the big-moment toast */
    .pk-toast {
      position: absolute; left: 50%; top: 18%; transform: translate(-50%, 0) scale(0.9);
      z-index: 20; max-width: calc(100% - 32px); text-align: center;
      background: #101a10; color: #ffe135; border: 3px solid #ffe135;
      box-shadow: 4px 4px 0 #000; padding: 0.5rem 0.85rem;
      font-weight: 800; font-size: 0.88rem; line-height: 1.35;
      opacity: 0; pointer-events: none;
      transition: opacity 0.18s ease, transform 0.18s ease;
    }
    .pk-toast.is-on { opacity: 1; transform: translate(-50%, 0) scale(1); }

    /* 🦋 the atlas popup (the bay's collection card, park edition) */
    .pk-panel {
      position: absolute; inset: 0; z-index: 12; display: grid; place-items: center;
      background: rgba(0, 0, 0, 0.55); padding: 0.8rem;
    }
    .pk-panel[hidden] { display: none; }
    .pk-card {
      background: #101a10; color: #fffdf5; border: 4px solid #000; box-shadow: 6px 6px 0 #000;
      padding: 0.9rem 1rem; max-width: 380px; width: 100%; max-height: 100%; overflow: auto;
    }
    .pk-card h2 {
      font-family: "Archivo Black", sans-serif; color: #8de08d; font-size: 1rem;
      margin: 0 0 0.15rem; letter-spacing: 0.03em;
    }
    .pk-cardx {
      position: sticky; top: 0; float: right; z-index: 3; margin: -0.2rem -0.3rem 0 0.4rem;
      appearance: none; background: none; border: 0; line-height: 1;
      color: #fffdf5; font-size: 1.25rem; font-weight: 800; cursor: pointer;
      opacity: 0.7; padding: 4px 6px;
    }
    .pk-cardx:hover { opacity: 1; }
    .pk-panel__sub { margin: 0 0 0.7rem; font-size: 0.8rem; opacity: 0.85; }
    .pk-panel__sub b { color: #ffd98a; opacity: 1; }
    .pk-bgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; }
    .pk-bslot {
      position: relative; border: 2px solid #000; background: #182a16;
      display: grid; place-items: center; gap: 0.25rem; padding: 0.55rem 0.25rem 0.45rem;
    }
    .pk-bslot svg { width: 60%; height: auto; aspect-ratio: 10 / 8; }
    .pk-bslot span { font-size: 0.58rem; font-weight: 800; text-align: center; line-height: 1.2; }
    .pk-bslot.is-missing svg { filter: brightness(0) opacity(0.35); }
    .pk-bslot.is-missing span { opacity: 0.5; }
    .pk-bslot b {
      position: absolute; right: -2px; bottom: -4px; font-size: 0.55rem; font-weight: 800;
      background: #8de08d; color: #10240f; border: 2px solid #000; padding: 0 0.15rem;
    }
    /* the HUD collection pill is a real button */
    .pk-whud button { font-family: inherit; appearance: none; cursor: pointer; }
    .pk-whud__col.is-dim { opacity: 0.55; }
    .pk-whud__col b { color: #ffd98a; }

    /* 🌱 THE GARDEN — plants grow on the plate's soil slots */
    .pk-plant {
      position: absolute; transform: translate(-50%, -100%); pointer-events: none;
      image-rendering: pixelated; background-size: 100% 100%; background-repeat: no-repeat;
      filter: drop-shadow(1px 2px 0 rgba(20, 40, 18, 0.35));
    }
    .pk-plant.is-ready { animation: pkReadyGlint 2.2s ease-in-out infinite; }
    @keyframes pkReadyGlint {
      0%, 100% { filter: drop-shadow(1px 2px 0 rgba(20, 40, 18, 0.35)); }
      50% { filter: brightness(1.25) drop-shadow(0 0 6px rgba(255, 225, 53, 0.7)); }
    }
    @media (prefers-reduced-motion: reduce) { .pk-plant.is-ready { animation: none; } }
    /* the per-slot marker: a tiny emoji chip over the plant (HUD pill
       language) — no lawn text, the words live in the tap card. Yellow ring
       + dot = yours; ready pulses gently. Taps pass through to the slot. */
    .pk-gchip {
      position: absolute; transform: translate(-50%, -100%); pointer-events: none;
      width: 22px; height: 22px; border-radius: 999px; box-sizing: border-box;
      display: grid; place-items: center;
      background: rgba(16, 18, 28, 0.85); border: 2px solid #000;
      font-size: 11px; line-height: 1;
      box-shadow: 1px 2px 0 rgba(0, 0, 0, 0.35);
    }
    .pk-gchip.is-mine { border-color: #ffe135; }
    .pk-gchip.is-mine::after {
      content: ''; position: absolute; top: -3px; right: -3px; width: 6px; height: 6px;
      border-radius: 50%; background: #ffe135; box-shadow: 0 0 0 1px #000;
    }
    .pk-gchip.is-ready { animation: pkChipPulse 1.6s ease-in-out infinite; }
    @keyframes pkChipPulse {
      0%, 100% { transform: translate(-50%, -100%) scale(1); }
      50% { transform: translate(-50%, -100%) scale(1.14); }
    }
    @media (prefers-reduced-motion: reduce) { .pk-gchip.is-ready { animation: none; } }
    /* the seed picker rows */
    .pk-seedrow {
      appearance: none; font-family: inherit; width: 100%; cursor: pointer;
      display: flex; align-items: center; gap: 0.6rem; text-align: left;
      background: #182a16; color: #fffdf5; border: 3px solid #000;
      box-shadow: 3px 3px 0 #000; padding: 0.5rem 0.6rem; margin-bottom: 0.5rem;
    }
    .pk-seedrow:not([disabled]):hover { outline: 2px solid #8de08d; outline-offset: 1px; }
    .pk-seedrow:not([disabled]):active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .pk-seedrow[disabled] { opacity: 0.45; cursor: not-allowed; }
    .pk-seedrow i { font-style: normal; font-size: 1.5rem; line-height: 1; }
    .pk-seedrow__txt { flex: 1; display: grid; gap: 0.15rem; min-width: 0; }
    .pk-seedrow b { font-size: 0.86rem; }
    .pk-seedrow b em { font-style: normal; font-size: 0.6rem; color: #b48ae0; letter-spacing: 0.06em; }
    .pk-seedrow small { font-size: 0.68rem; opacity: 0.75; }
    .pk-seedcost {
      display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;
      font-weight: 800; font-size: 0.82rem; color: #ffe135;
    }
    .pk-seedcost img { image-rendering: pixelated; display: block; }
    .pk-seedpoor { margin: 0.2rem 0 0; font-size: 0.72rem; opacity: 0.7; }
    .pk-gplant { margin: -0.1rem 0 0.35rem; font-size: 0.82rem; font-weight: 800; color: #8de08d; }
    .pk-gwater { margin: 0 0 0.6rem; font-size: 0.78rem; color: #7db9ff; font-weight: 800; }
    .pk-gbtn { width: 100%; border: 3px solid #000; background: #7db9ff; color: #10240f;
      font-weight: 800; font-family: inherit; font-size: 0.9rem; padding: 0.55rem;
      box-shadow: 3px 3px 0 #000; cursor: pointer; white-space: nowrap; }
    .pk-gbtn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .pk-gbtn small { font-size: 0.7rem; }
    .pk-gsaved { margin: 0.6rem 0 0; font-size: 0.72rem; opacity: 0.75; }
    .pk-confetti {
      position: absolute; width: 7px; height: 7px; z-index: 1960; pointer-events: none;
      transform: translate(-50%, -50%);
      animation: pkConfetti 1.2s ease-in forwards;
    }
    @keyframes pkConfetti {
      0% { opacity: 1; transform: translate(-50%, -50%) rotate(0); }
      100% { opacity: 0; transform: translate(-50%, 40px) rotate(260deg); }
    }
    @media (prefers-reduced-motion: reduce) { .pk-confetti { display: none; } }

    /* 🧃 the cart's idle glint — reads as "something's here" from afar */
    .pk-sparkle {
      position: absolute; z-index: 1600; pointer-events: none;
      transform: translate(-50%, -50%); color: #fff3c4; font-size: 0.7rem;
      text-shadow: 0 0 6px rgba(255, 225, 53, 0.8);
      animation: pkSparkle 1.4s ease-out forwards;
    }
    @keyframes pkSparkle {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
      30% { opacity: 1; transform: translate(-50%, -80%) scale(1.1); }
      100% { opacity: 0; transform: translate(-50%, -130%) scale(0.7); }
    }
    @media (prefers-reduced-motion: reduce) { .pk-sparkle { display: none; } }

    /* 🧃 THE MERCH SHOP INTERIOR — the stand's counter scene, merch edition:
       awning, plank back wall with the goods HUNG on it, Inka big behind the
       desk. Mocks stay FLAT — the banana is the art. */
    .pk-shop {
      position: absolute; inset: 0; z-index: 40; display: flex; flex-direction: column;
      background: #14100b; overflow: hidden;
    }
    .pk-shop[hidden] { display: none; }
    .pk-shop__awning { display: flex; height: 20px; flex: 0 0 auto; border-bottom: 3px solid #000; }
    .pk-shop__awning span { flex: 1; }
    .pk-shop__awning span:nth-child(odd) { background: #c0261a; }
    .pk-shop__awning span:nth-child(even) { background: #fdf6e6; }
    .pk-shop__x {
      position: absolute; top: 28px; right: 8px; z-index: 6;
      appearance: none; font: inherit; font-weight: 800; line-height: 1;
      background: #ffe135; color: #10240f; border: 3px solid #000;
      box-shadow: 2px 2px 0 #000; width: 30px; height: 30px; cursor: pointer;
    }
    /* the back wall: warm dark planks (the stand's, shifted red-brown) */
    .pk-shop__wall {
      position: relative; flex: 1 1 auto; overflow: hidden;
      background:
        linear-gradient(rgba(0, 0, 0, 0.34), rgba(0, 0, 0, 0.05) 45%),
        repeating-linear-gradient(90deg, #5c4423 0 24px, #3f2e15 24px 27px, #543d1e 27px 51px, #3f2e15 51px 54px);
    }
    /* the goods, hung high on the planks — each on a nail with a string */
    .pk-shop__goods {
      position: absolute; left: 0; right: 0; top: 22px; z-index: 2;
      display: flex; justify-content: space-evenly; align-items: flex-start;
      padding: 0 4px;
    }
    .pk-hang {
      position: relative; display: grid; justify-items: center; gap: 3px;
      text-decoration: none; color: #fffdf5; padding-top: 14px; cursor: pointer;
    }
    .pk-hang::before {   /* the nail */
      content: ''; position: absolute; top: 0; left: 50%; width: 5px; height: 5px;
      transform: translateX(-50%); background: #1c1610; border-radius: 50%;
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25);
    }
    .pk-hang::after {    /* the string */
      content: ''; position: absolute; top: 4px; left: 50%; width: 2px; height: 11px;
      transform: translateX(-50%); background: rgba(240, 230, 200, 0.55);
    }
    .pk-hang:hover .pk-hang__mock, .pk-hang:focus-visible .pk-hang__mock { outline: 2px solid #ffe135; outline-offset: 1px; }
    .pk-hang:active { transform: translateY(2px); }
    .pk-hang__mock {
      width: 78px; height: 78px; display: grid; place-items: center;
      border: 3px solid #000; overflow: hidden;
      box-shadow: 3px 4px 0 rgba(0, 0, 0, 0.45);
    }
    .pk-hang__mock canvas { width: 66px; height: 66px; image-rendering: pixelated; display: block; }
    /* sticker: a white die-cut contour hugging the banana, on a light card */
    .pk-hang--sticker .pk-hang__mock { background: #f4f1e8; }
    .pk-hang--sticker canvas {
      filter: drop-shadow(2px 0 0 #fff) drop-shadow(-2px 0 0 #fff)
              drop-shadow(0 2px 0 #fff) drop-shadow(0 -2px 0 #fff)
              drop-shadow(1px 2px 0 rgba(0, 0, 0, 0.25));
    }
    /* magnet: same die-cut read, rounded dark border hints the fridge slab */
    .pk-hang--magnet .pk-hang__mock {
      background: #e8e4d8; border-radius: 10px;
      box-shadow: inset 0 0 0 3px #2a2a33, 3px 4px 0 rgba(0, 0, 0, 0.45);
    }
    .pk-hang--magnet canvas {
      width: 56px; height: 56px;
      filter: drop-shadow(2px 0 0 #fff) drop-shadow(-2px 0 0 #fff)
              drop-shadow(0 2px 0 #fff) drop-shadow(0 -2px 0 #fff);
    }
    /* tee: the banana printed small on a tee-coloured rectangle */
    .pk-hang--tee .pk-hang__mock { background: #1c2233; }
    .pk-hang--tee canvas { width: 40px; height: 40px; }
    /* the price tag — a tilted paper chip clipped to the mock's corner */
    .pk-hang__tag {
      position: absolute; top: 8px; right: -7px; z-index: 2; font-style: normal;
      background: #ffe135; color: #10240f; border: 2px solid #000;
      font-weight: 800; font-size: 0.62rem; line-height: 1; padding: 2px 4px;
      transform: rotate(6deg); box-shadow: 1px 2px 0 rgba(0, 0, 0, 0.4);
      white-space: nowrap;
    }
    .pk-hang b { font-size: 0.6rem; font-weight: 800; text-align: center; line-height: 1.15; text-shadow: 1px 1px 0 #000; white-space: nowrap; }
    .pk-shop__ship {
      position: absolute; left: 50%; top: 168px; transform: translateX(-50%) rotate(-2deg); z-index: 1;
      background: #8a5a2b; border: 2px solid #3a230f; color: #ffe135;
      font-family: "Archivo Black", sans-serif; font-size: 0.56rem; letter-spacing: 0.04em;
      padding: 2px 7px; white-space: nowrap; box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.45);
    }
    /* Inka — big behind the counter, feet clipped by the wall's bottom edge */
    .pk-shop__keeper {
      appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
      position: absolute; left: 50%; bottom: -74px; transform: translateX(-50%);
      width: min(360px, 86%); z-index: 3;
    }
    .pk-shop__keeper canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
    .pk-shop__bubble {
      position: absolute; left: 6px; bottom: 34%; z-index: 5;
      max-width: 46%; background: #fffdf5; color: #111; border: 3px solid #000;
      filter: drop-shadow(3px 3px 0 #000); padding: 0.35rem 0.5rem;
      font-size: 0.6rem; font-weight: 800; letter-spacing: 0.04em;
      text-transform: uppercase; line-height: 1.5;
      opacity: 0; transition: opacity 0.2s ease; pointer-events: none;
    }
    .pk-shop__bubble.is-on { opacity: 1; }
    .pk-shop__counter {
      flex: 0 0 64px; position: relative; border-top: 4px solid #000; z-index: 4;
      background: repeating-linear-gradient(90deg, #3a2b18 0 26px, #2c2113 26px 52px);
      display: grid; place-items: center; padding: 0 0.5rem;
    }
    .pk-shop__counter::before {
      content: ''; position: absolute; inset: 0 0 auto; height: 8px;
      background: #4a3820; border-bottom: 3px solid #000;
    }
    /* the honesty line lives ON the desk, not in a footer */
    .pk-shop__sign {
      background: #8a5a2b; border: 2px solid #3a230f; color: #ffe7a0;
      font-size: 0.62rem; font-weight: 800; line-height: 1.4; text-align: center;
      padding: 0.3rem 0.55rem; box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
      transform: rotate(-0.5deg); max-width: 100%;
    }
    .pk-shop button.pk-shop__back {
      flex: 0 0 auto; margin: 0.55rem 0.8rem 0.7rem; box-shadow: 3px 3px 0 #000;
      padding: 0.5rem; font-size: 0.85rem; cursor: pointer; border: 3px solid #000;
      background: #8de08d; color: #10240f; font-weight: 800; font-family: inherit;
    }

    .pk-foot { display: flex; gap: 0.8rem; margin-top: 1rem; flex-wrap: wrap; }
    .pk-btn {
      display: grid; place-items: center; text-align: center; flex: 1 1 160px;
      border: 3px solid #000; background: #8de08d; color: #10240f; font-weight: 800;
      box-shadow: 4px 4px 0 #000; padding: 0.6rem; text-decoration: none;
      font-family: inherit; font-size: 0.9rem;
    }
  </style>

  <div class="pk-wrap">
    <h1 class="pk-sign">🌳 THE PARK</h1>
    <p class="pk-tag">the green heart of Banana World</p>

    <div class="pk-stage">
      <div class="pk-view" id="pkView">
        <div class="pk-world" id="pkWorld">
          <div class="pk-me" id="pkMe"><canvas id="pkMeCv" width="150" height="150" aria-hidden="true"></canvas></div>
        </div>
        <!-- 🌍 THE WORLD HUD — LEVEL (rep bar) · COINS · collections (P3) · CROWD -->
        <div class="pk-whud" id="pkWhud">
          <span class="pk-whud__lvl"><span id="pkLvlN">LVL 1</span><span class="pk-whud__lvlbar"><i id="pkLvlFill"></i></span></span>
          <span class="pk-whud__coins"><img src="/assets/banana-stand/coin.png" width="16" height="16" alt="" /><b id="pkCoinN">0</b></span>
          <button class="pk-whud__col is-dim" id="pkBflyBtn" type="button" aria-label="butterfly collection">🦋 <b id="pkBflyN">—</b></button>
          <span class="pk-whud__crowd"><span aria-hidden="true">◍</span> <span id="pkCrowd">solo</span></span>
        </div>
        <div class="pk-hint" id="pkHint">tap to walk · arrow keys / WASD work too</div>
        <div class="pk-exitstrip" id="pkExitStrip" role="status" aria-live="polite"></div>
        <div class="pk-toast" id="pkToast" role="status" aria-live="polite"></div>

        <!-- 🦋 THE ATLAS — the meadow collection; silhouettes for the uncaught -->
        <div class="pk-panel" id="pkAtlas" hidden>
          <div class="pk-card" role="dialog" aria-label="Butterfly collection">
            <button class="pk-cardx" id="pkAtlasClose" type="button" aria-label="close">✕</button>
            <h2>the meadow's butterflies</h2>
            <p id="pkAtlasSub" class="pk-panel__sub"></p>
            <div class="pk-bgrid" id="pkAtlasGrid"></div>
          </div>
        </div>

        <!-- 🌱 THE GARDEN — seed picker / plant card, one panel, content per open -->
        <div class="pk-panel" id="pkGarden" hidden>
          <div class="pk-card" role="dialog" aria-label="The garden">
            <button class="pk-cardx" id="pkGardenClose" type="button" aria-label="close">✕</button>
            <div id="pkGardenBody"></div>
          </div>
        </div>

        <!-- 🧃 THE MERCH SHOP — a real interior (the stand's counter scene,
             merch edition): goods hung on the back wall, Inka at the desk. -->
        <div class="pk-shop" id="pkShop" role="dialog" aria-label="The merch shop" hidden>
          <div class="pk-shop__awning" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <button class="pk-shop__x" id="pkShopClose" type="button" aria-label="leave the shop">×</button>
          <div class="pk-shop__wall">
            <div class="pk-shop__goods" id="pkGoods"></div>
            <span class="pk-shop__ship">🚚 free worldwide shipping</span>
            <div class="pk-shop__bubble" id="pkKeeperBubble" role="status" aria-live="polite"></div>
            <button class="pk-shop__keeper" id="pkKeeper" type="button" aria-label="talk to Inka">
              <canvas id="pkKeeperCv" width="360" height="360"></canvas>
            </button>
          </div>
          <div class="pk-shop__counter">
            <span class="pk-shop__sign">everything else in the park costs coins. this is the one real thing — printed &amp; shipped to your door.</span>
          </div>
          <button class="pk-btn pk-shop__back" id="pkShopBack" type="button">🌳 back to the park</button>
        </div>
      </div><!-- /.pk-view -->

      <!-- 🎮 THE ACTION BAR — 🪙 toss · 🧃 browse (both proximity-gated) · React · Sound -->
      <div class="pk-actions" aria-label="park actions">
        <button class="pk-act pk-act--icon" id="pkEmote" type="button" aria-label="react">❤️</button>
        <button class="pk-act pk-act--icon" id="pkAudio" type="button" aria-label="sound" aria-pressed="false">🔇</button>
      </div>
    </div><!-- /.pk-stage -->

  </div>

  <div class="pk-cut" id="pkCut" aria-hidden="true"></div>

  <script>
    import '../scripts/banana-park.js';
  </script>
</BaseLayout>
