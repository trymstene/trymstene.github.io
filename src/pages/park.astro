    .pk-seedrow[disabled] { opacity: 0.45; cursor: not-allowed; }
    /* 🔒 level-locked seeds stay listed (aspiration) — greyed, never hidden */
    .pk-seedrow--lock { filter: grayscale(0.75); }
    .pk-glvl { margin: -0.05rem 0 0.45rem; font-size: 0.72rem; font-weight: 800; color: #8de08d; }
