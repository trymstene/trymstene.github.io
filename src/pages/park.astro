    @keyframes pkStandFlicker { 0%, 92%, 96% { opacity: 1; } 93%, 95% { opacity: 0.25; text-shadow: none; } }
    .pk-stand__tag { text-align: center; margin: 0 0 0.8rem; font-size: 0.82rem; opacity: 0.6; }
