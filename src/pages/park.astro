       invisible on a phone, and this world is 85% phones. */
    .pk-daystats { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.1rem; }
    .pk-stat {
      display: inline-flex; align-items: center; gap: 0.42rem; cursor: pointer;
