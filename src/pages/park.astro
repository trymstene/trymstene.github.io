    @media (prefers-reduced-motion: reduce) { .pk-weed.is-pulled { animation: none; opacity: 0; } }

    /* 🌸 the bloom pill — green healthy, amber 30-60, grey wilted */
    /* the bloom card's bar — ONE continuous track (progress bar first,
       phases second): the wilted→lush ramp is the fill, the same ramp sits
       faint on the track behind it, ticks at 20/40/60/80, glyphs over their
