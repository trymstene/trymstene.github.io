---
// 🌳 THE PARK — Park 2.0, THE LIVE PARK (park-2-plan, flipped 29 Jul). The
// walkable park on the beach engine's chassis; the old stand page is retired —
// its interior lives on inside this world's stand.
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelIcon from '../components/PixelIcon.astro';

// 🔍 INDEXED 30 Jul. Keyword picks are DataForSEO volumes, and the pick is as
// much about what NOT to chase: the bay already targets "banana game" (40.5K)
// and two of our own pages fighting for it is the cannibalisation trap the
// gallery taught us. So the park takes a cluster the bay can't:
//   free browser game 60.5K LOW · cozy game 40.5K LOW · garden game 18.1K HIGH
//   park game 12.1K MED · banana park 3.6K LOW · relaxing game online 3.6K LOW
// "garden game" is HIGH competition so it rides in the body, not the title —
// the title takes the two big LOW-comp phrases the page is literally true to.
const title = 'The Park — a free cozy garden game';
const description = 'Play The Park, a free cozy garden game in your browser — plant and water a shared banana park with visitors from around the world, pull the weeds, feed the birds and keep the whole place alive. No download, no account.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'The Park',
  url: 'https://trymstene.com/park/',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript. No download.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  creator: { '@id': 'https://trymstene.com/#trym' },
  description: 'A free browser garden world for custom dancing bananas — a shared park you plant, water and weed together, with players worldwide.',
};
// ⚠️ every one of these answers is also VISIBLE on the page below (the field
// guide + FAQ block) — FAQ markup whose answers only exist in JSON is exactly
// what Google's structured-data guidelines call out.
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Is The Park free to play?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The Park is a free browser game — no account, no download, no install. Your custom dancing banana walks straight in through the gate.' } },
    { '@type': 'Question', name: 'What do you do in The Park?', acceptedAnswer: { '@type': 'Answer', text: 'You keep a shared garden alive. Plant seeds in the beds, water what other people planted, pull weeds, pick up litter, skim the pond, spot the day’s birds and hunt for eggs — every one of those nudges the park’s health meter.' } },
    { '@type': 'Question', name: 'What is park health?', acceptedAnswer: { '@type': 'Answer', text: 'One number, 0 to 100, shared by everyone in the park. It sinks on its own and every weed, algae patch and piece of litter holds it down, so a park nobody tends visibly dies — the grass goes straw, the trees turn, the animals mope. Watering, planting and tidying push it back up.' } },
    { '@type': 'Question', name: 'Can you play The Park with other people?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Every other banana you see is a real visitor, live. The garden is shared too — you can water a plant somebody else put in, and the health meter is the whole park’s score, not yours.' } },
    { '@type': 'Question', name: 'How do you unlock better seeds?', acceptedAnswer: { '@type': 'Answer', text: 'By harvesting. Seeds are rated one to five stars, and your gardener level rises with every harvest: three harvests unlock three-star seeds, eight unlock four-star, fifteen unlock the five-star golden wheat. Better seeds feed the park harder and survive longer without water.' } },
    { '@type': 'Question', name: 'How do you get to The Park?', acceptedAnswer: { '@type': 'Answer', text: 'Dress a banana in the free builder and walk in. The Park sits in the middle of Banana World: the rave is down the south road, Banana Bay is along the east road, and both shops are inside the park itself.' } },
  ],
};
---
<BaseLayout
  title={title}
  description={description}
  ogTitle="The Park 🌳"
  ogImage="https://trymstene.com/assets/og/park.png"
  showFooter={false}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faq)} />
  <link rel="preload" as="image" href="/assets/park/park.png" slot="head" />
  <link rel="preconnect" href="https://banana-rave.trymstene.workers.dev" slot="head" />
  <style is:inline slot="head">
    /* ⚠️ THE HOUSE TRAP, ONE GUARD FOR THE PAGE: any author `display:` beats the
       UA [hidden] rule, so a JS-hidden control renders full-width and dead (the
       postcard's "share…" on every browser without navigator.canShare). This
       page toggles a dozen things by the attribute — none of them may paint. */
    [hidden] { display: none !important; }
    body { background: #101a10; }
    .pk-wrap { max-width: 1000px; margin: 0 auto; padding: 0.6rem 0.8rem 2.5rem; color: #fffdf5; }
    .pk-sign {
      font-family: "Archivo Black", sans-serif; text-align: center;
      color: #8de08d; font-size: clamp(1.4rem, 6.4vw, 2.2rem); line-height: 1.05;
      margin: 0.7rem 0 0.15rem; letter-spacing: 0.02em;
      text-shadow: 0 0 12px rgba(141, 224, 141, 0.4), 0 0 30px rgba(60, 160, 80, 0.3);
    }
    .pk-tag { text-align: center; margin: 0 0 0.8rem; font-size: 0.82rem; opacity: 0.6; }
    /* inside a shop, the shop's own sign IS the title — the park heading yields */
    body.pk-inside .pk-sign, body.pk-inside .pk-tag { display: none; }
    /* ⚠️ and the world STOPS. Both interiors are opaque and cover the whole
       view, so every sprite behind them was painting for nobody. Nothing else
       in the park sets `visibility`, and the only layout reads are on .pk-view
       itself — never on a world child — so hiding the layer is safe. The JS
       ticks stop too (see banana-park.js); the socket keeps itself alive. */
    body.pk-inside .pk-world { visibility: hidden; }

    /* the frame is on the stage so the action band sits BELOW the map inside it */
    .pk-stage { border: 4px solid #000; box-shadow: 8px 8px 0 #000; }
    /* the viewport: a window onto a world bigger than it, both axes */
    .pk-view {
      position: relative; height: min(74vh, 580px); overflow: hidden; cursor: pointer;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent;
      background: #14240f;
    }
    .pk-world {
      position: absolute; left: 0; top: 0;
      image-rendering: pixelated; will-change: transform;
    }
    /* 🧱 THE GROUND, on its own layer. The lush plate used to be the WORLD's
       own background, so every sprite invalidation reconciled against a
       3-megapixel upscaled surface sitting in the same layer. It lives here
       now — in the markup from the first byte, so the fetch still starts at
       parse time — with the bloom plates as its children. z-index 0 keeps the
       whole stack under every walker, so the painter's algorithm is untouched:
       only props (pk-ov) interleave with movers, and they stay in the world. */
    .pk-base {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background: url('/assets/park/park.png') 0 0 / 100% 100% no-repeat;
      image-rendering: pixelated; will-change: transform;
    }
    /* ⭐ the y-sorted prop layer — z comes from each prop's ground line in JS */
    .pk-ov {
      position: absolute; pointer-events: none; image-rendering: pixelated;
      background-size: 100% 100%; background-repeat: no-repeat;
    }

    /* ---- 📖 THE FIELD GUIDE — the indexable half of the page. Same shape
       as the rave's guide block: real answers, visible, so the FAQ markup is
       describing something a reader can actually see. ⚠️ this is what makes
       the page tall, which is exactly why banana-park.js stands the world down
       when the view scrolls out of sight. */
    .pkg { max-width: 760px; margin: 3rem auto 0; padding: 0 0.2rem; }
    .pkg__block { margin-top: 3rem; }
    .pkg__kicker {
      font-family: "Archivo Black", sans-serif; color: #8de08d; font-size: 0.7rem;
      letter-spacing: 0.18em; text-transform: uppercase; margin: 0 0 0.35rem; opacity: 0.85;
    }
    .pkg__block h2 {
      font-family: "Archivo Black", sans-serif; color: #b6f0b6;
      font-size: clamp(1.3rem, 4vw, 1.9rem); margin: 0 0 0.9rem; line-height: 1.1;
    }
    .pkg__block h3 {
      font-family: "Archivo Black", sans-serif; color: #ffe135;
      font-size: 1rem; margin: 1.6rem 0 0.5rem;
    }
    .pkg__block p, .pkg__list li { line-height: 1.65; font-size: 0.98rem; }
    .pkg__block p { margin: 0 0 0.8rem; }
    .pkg__block a { color: #ffe135; }
    .pkg__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }
    .pkg__list li { padding-left: 1.1rem; position: relative; }
    .pkg__list li::before { content: '\00B7'; position: absolute; left: 0.25rem; color: #8de08d; font-weight: 800; }
    .pkg__grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); margin-top: 1.2rem; }
    .pkg__card { background: #101a10; border: 3px solid #8de08d; box-shadow: 6px 6px 0 #000; padding: 0.9rem; }
    .pkg__thumb { height: 64px; display: flex; align-items: center; justify-content: center; margin-bottom: 0.55rem; }
    .pkg__thumb img { image-rendering: pixelated; max-height: 64px; max-width: 110px; width: auto; height: auto; }
    .pkg__card h3 { font-family: "Archivo Black", sans-serif; font-size: 0.92rem; color: #8de08d; margin: 0 0 0.35rem; text-align: center; }
    .pkg__card p { margin: 0; font-size: 0.84rem; line-height: 1.5; opacity: 0.92; }
    .pkg__seeds { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 0.4rem 0 0.9rem; }
    .pkg__seeds th, .pkg__seeds td { text-align: left; padding: 0.4rem 0.6rem 0.4rem 0; border-bottom: 1px solid rgba(141, 224, 141, 0.18); }
    .pkg__seeds th { color: #8de08d; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; }
    .pkg__faq dt { font-weight: 800; color: #ffe135; margin-top: 1.1rem; }
    .pkg__faq dd { margin: 0.3rem 0 0; line-height: 1.65; font-size: 0.98rem; }


    /* ---- 🌦 WEATHER — four composited elements, whatever is falling.
       Two tiling streak layers scrolled by transform + a scrim + a flash; no
       canvas, no element per drop, nothing added to the rAF loop. They sit in
       .pk-view (NOT .pk-world) because rain falls on the VIEWPORT, not on the
       map — it must not pan with the camera.
       ⚠️ transform/opacity only. Never animate `filter` on this page. */
    .pk-wx { position: absolute; inset: 0; pointer-events: none; z-index: 8; overflow: hidden; }
    .pk-wx__scrim, .pk-wx__rain, .pk-wx__flash {
      /* generous horizontal slack: the storm SKEWS these sheets, and a skew
         eats width proportional to HEIGHT — a tall narrow phone shifts the
         bottom edge ~138px sideways, which -30% of a 360px width cannot cover */
      position: absolute; inset: -30% -50%; display: block; opacity: 0;
      transition: opacity 2.4s ease;
    }
    .pk-wx__scrim { background: #16283a; inset: 0; }
    .pk-wx__rain {
      background-image: url('/assets/park/rain.png');
      background-repeat: repeat; background-size: 256px 256px;
    }
    .pk-wx__flash { background: #eaf4ff; inset: 0; opacity: 0; }

    /* 🌧 THE SHEETS SCROLL BY BACKGROUND-POSITION, NOT BY TRANSFORM.
       ⚠️ Deliberate exception to this page's transform/opacity-only line, and
       the reason is arithmetic: a tiling sheet has to travel a whole multiple
       of its 256px tile to loop seamlessly, and these travel 1024px — while
       inset:-30% only buys ~90px of slack. So the old transform version marched
       the sheet clean off the bottom-right and snapped it back. Measured 9 Aug
       on the live park: ZERO of 40 frames covered the view, the sheet's top
       edge sitting 86-389px BELOW a 302px-tall park. Rain was missing more
       often than it was there. Nobody saw it because drizzle is the only tier
       that has ever really run, at 0.34 opacity, where patchy reads as light.
       Scrolling the BACKGROUND instead keeps the element still and always
       covering, loops at any tile multiple, and costs a repaint only while it
       is actually raining (~6% of the time, storms 15 min a week).
       ⚠️ Both numbers must stay multiples of 256 or the loop visibly jumps.

       DIRECTION (Trym, 9 Aug): both textures lean DOWN-RIGHT — measured, the
       (+1,+1) pixel correlation is 130 on rain.png and 658 on rain-hard.png
       against ~0 the other way. The old keyframes drove them down-LEFT, so the
       rain slid sideways across its own streaks. Positive X and Y = down and to
       the right, which is the way the art points. */
    @keyframes pkRainFar  { to { background-position: 256px 1024px; } }
    @keyframes pkRainNear { to { background-position: 512px 1024px; } }
    .pk-wx__rain--far  { animation: pkRainFar 3.4s linear infinite; }
    .pk-wx__rain--near { animation: pkRainNear 1.9s linear infinite; }

    /* ☁ DRIZZLE — one thin layer, a hint of grey. Costs nothing, ever. */
    .pk-wx.is-drizzle .pk-wx__scrim { opacity: 0.20; }
    .pk-wx.is-drizzle .pk-wx__rain--far { opacity: 0.34; }

    /* 🌧 HEAVY — both layers, faster, properly dark */
    .pk-wx.is-heavy .pk-wx__scrim { opacity: 0.30; }
    .pk-wx.is-heavy .pk-wx__rain--far { opacity: 0.5; animation-duration: 2.2s; }
    .pk-wx.is-heavy .pk-wx__rain--near { opacity: 0.62; animation-duration: 1.25s; }
    .pk-wx.is-heavy .pk-wx__rain { background-image: url('/assets/park/rain-hard.png'); }

    /* ⛈ STORM — the hard sheet, wind-tilted, and the sky goes off */
    .pk-wx.is-storm .pk-wx__scrim { opacity: 0.40; }
    .pk-wx.is-storm .pk-wx__rain { background-image: url('/assets/park/rain-hard.png'); }
    .pk-wx.is-storm .pk-wx__rain--far { opacity: 0.62; animation-duration: 1.5s; }
    .pk-wx.is-storm .pk-wx__rain--near { opacity: 0.8; animation-duration: 0.8s; }
    /* the WIND is the tilt: skew both sheets and they read as driven rain.
       ⚠️ POSITIVE skew now. skewX(a) shifts x by y·tan(a) and CSS +y is DOWN,
       so the old NEGATIVE angles pushed the bottom of the sheet LEFT — tilting
       the rain against the lean of its own texture. Positive leans it down-right
       WITH the art and with the travel. The skew is a STATIC transform (same at
       both ends, nothing animating it), so it stays free. */
    .pk-wx.is-storm .pk-wx__rain--far  { animation-name: pkRainGustFar;  transform: skewX(9deg); }
    .pk-wx.is-storm .pk-wx__rain--near { animation-name: pkRainGustNear; transform: skewX(13deg); }
    /* ⚠️ 620 and 980 were NOT multiples of the 256px tile — the storm sheets
       jumped 108px and 212px sideways every loop. Snapped to 512 and 1024. */
    @keyframes pkRainGustFar  { to { background-position: 512px 1024px; } }
    @keyframes pkRainGustNear { to { background-position: 1024px 1024px; } }
    .pk-wx.is-storm .pk-wx__flash { animation: pkFlash 11s steps(1) infinite; }
    @keyframes pkFlash {
      0%, 3.2%, 100% { opacity: 0; }
      1.4% { opacity: 0.62; }  1.8% { opacity: 0; }
      2.2% { opacity: 0.44; }  2.6% { opacity: 0; }
      41%  { opacity: 0.5; }   41.5% { opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pk-wx__rain { animation: none !important; }
      .pk-wx__flash { animation: none !important; }
    }

    /* 🌦 THE POST-STORM NOTICE — not an announcement. Nothing is broadcast
       while a storm blows; this is for whoever walks in AFTERWARDS and finds
       the mess. The rave's quest-call type, one size down (Trym), and it only
       appears while the park is still under 30% — if the regulars already put
       it back to 90 there is nothing to explain. */
    /* ⚠️ NO BOX. It used to be a small dark panel pinned to the top-left corner
       with 0.5rem type in it, and Trym's verdict was that it looked bad on both
       desktop and phone — a black box shouting in a whisper. This is the RAVE's
       big-moment register instead (.rv-bigmoment), one size down: centred over
       the park, Anton, and the black comes from a ring of hard shadows rather
       than a background, so the type sits ON the world instead of covering it.
       ⚠️ pointer-events:none is load-bearing now that it is centred — the park
       walks on taps, and an overlay in the middle of the map would eat them. */
    .pk-stormnote {
      position: absolute; left: 50%; top: 26%; z-index: 600;
      width: max-content; max-width: 92%; text-align: center; pointer-events: none;
      opacity: 0; transform: translate(-50%, -8px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .pk-stormnote.is-on { opacity: 1; transform: translate(-50%, 0); }
    /* ⚠️ !important: any author display: beats the hidden attribute, and this
       page toggles the note by BOTH a class and hidden (the trap, hit before) */
    .pk-stormnote[hidden] { display: none !important; }
    .pk-stormnote b {
      display: block; font-family: "Anton", "Arial Black", sans-serif;
      font-size: clamp(1.45rem, 5.6vw, 2.5rem); line-height: 0.92;
      letter-spacing: 0.015em; text-transform: uppercase; color: #ffe135;
      text-wrap: balance;
      text-shadow:
        -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 2px 0 #000,
        -3px 0 0 #000, 3px 0 0 #000, 0 -3px 0 #000, 0 3px 0 #000,
        5px 6px 0 #000;
    }
    .pk-stormnote span {
      display: block; margin-top: 0.45rem; font-size: 0.76rem; font-weight: 800;
      letter-spacing: 0.1em; text-transform: uppercase; color: #fffdf5;
      line-height: 1.35; text-shadow: 2px 2px 0 #000;
      /* ⚠️ balance, or the last word orphans onto a line of its own — caps plus
         letter-spacing makes a two-line sub-line very easy to hit */
      text-wrap: balance;
    }
    @media (prefers-reduced-motion: reduce) { .pk-stormnote { transition: none; } }

    /* 🍂 STORM DEBRIS — leaves torn off and driven across the view. Reuses
       the leaf-pile sprites the sad phase already bakes, so it costs no art:
       five elements, transform-animated, storm only. */
    .pk-leafblow {
      position: absolute; width: 1.5%; aspect-ratio: 42 / 22; pointer-events: none;
      background: url('/assets/park/l-leaf1.png') center/contain no-repeat;
      image-rendering: pixelated; opacity: 0; will-change: transform;
    }
    .pk-wx.is-storm ~ * .pk-leafblow, .pk-leafblow.is-on { opacity: 0.9; }
    @keyframes pkLeafBlow {
      from { transform: translate3d(-12vw, 0, 0) rotate(0deg); }
      to   { transform: translate3d(112vw, 26vh, 0) rotate(720deg); }
    }
    .pk-leafblow.is-on { animation: pkLeafBlow linear infinite; }
    @media (prefers-reduced-motion: reduce) { .pk-leafblow { display: none; } }

    /* 📏 THE LEVEL METERS — water on a plant, seed in a birdhouse, both
       the same 24h countdown, so one component.
       ⚠️ THEY LIVE IN THE TAP CARD, NOT ON THE SPRITE (Trym). The garden's
       grammar is that the sprite says species / thirst / ready / yours and the
       WORDS live in the card you open — and 64 permanent gauges out on the map
       is clutter, not information. The card is also where you already are when
       you want the number: you tapped it to check. Horizontal, because that is
       the bar idiom the park-health card already set. */
    .pk-meter { margin: 0 0 0.65rem; }
    .pk-meter__top {
      display: flex; justify-content: space-between; align-items: baseline;
      gap: 0.5rem; margin-bottom: 0.26rem; font-size: 0.76rem; font-weight: 800;
    }
    .pk-meter__top b { color: #cfe8cf; }
    .pk-meter__top em {
      font-style: normal; color: #6fd46f; font-variant-numeric: tabular-nums;
    }
    .pk-meter__track {
      display: block; position: relative; height: 14px; overflow: hidden;
      border: 2px solid #000; border-radius: 5px; background: #0c140c;
    }
    .pk-meter__track i {
      position: absolute; left: 0; top: 0; bottom: 0; display: block;
      background: #6fd46f; transition: width 0.5s ease, background-color 0.5s ease;
    }
    @media (prefers-reduced-motion: reduce) { .pk-meter__track i { transition: none; } }
    .pk-meter.is-low .pk-meter__track i,
    .pk-meter--water.is-low .pk-meter__track i,
    .pk-meter--seed.is-low .pk-meter__track i { background: #ff9d2e; }
    .pk-meter.is-low .pk-meter__track i::after,
    .pk-meter.is-out .pk-meter__track i::after { opacity: 0.35; }
    .pk-meter.is-low .pk-meter__top em { color: #ffc63f; }
    .pk-meter.is-out .pk-meter__track i,
    .pk-meter--water.is-out .pk-meter__track i,
    .pk-meter--seed.is-out .pk-meter__track i { background: #ff5f5f; }
    .pk-meter.is-out .pk-meter__top em { color: #ff5f5f; }

    /* 🪓 A BED THE PARK BROKE OPEN. The core beds are baked into the plate;
       these are not, because unbroken ground has to read as plain lawn (see
       [[park-beds-plan]]). Same sprite, same processing, so an opened bed is
       indistinguishable from one that was always there.
       .is-marked = ground somebody has MARKED OUT but not yet turned: the same
       soil, faded and desaturated, so you can see what it will become. */
    /* ⚠️ width/height come from JS in WORLD units (pct of the map), like every
       other sprite here — fixed px did not shrink with the map and the ditches
       ran into each other on a phone. */
    .pk-bedsoil {
      position: absolute; transform: translate(-50%, -100%);
      background: url('/assets/park/g-bed.png') no-repeat center / contain;
      image-rendering: pixelated; pointer-events: none;
    }
    /* ⚠️ opacity + grayscale are set INLINE per dig (the ground is the progress
       bar) — the transition is what makes each dig read as a step. */
    .pk-bedsoil.is-marked { opacity: 0.26; filter: grayscale(0.7); }
    .pk-bedsoil { transition: opacity 0.45s ease, filter 0.45s ease; }

    /* 🪓 THE EARTH A DIG THROWS UP. The clods are cut from the ditch's own
       soil by the generator, so a burst is the same dirt as the bed. Four per
       dig, and every patch erupts when the last dig lands. */
    .pk-clod {
      position: absolute; pointer-events: none;      /* sized in world units by JS */
      background: url('/assets/park/g-clod.png') no-repeat 0 0 / 300% 100%;
      image-rendering: pixelated;
      animation: pkClod 0.6s cubic-bezier(0.2, 0.7, 0.5, 1) forwards;
    }
    @keyframes pkClod {
      0%   { transform: translate(-50%, -50%) scale(1); opacity: 1; }
      70%  { opacity: 1; }
      100% { transform: translate(calc(-50% + var(--cx)), calc(-50% + var(--cy) + 30px))
               rotate(var(--cr)) scale(0.85); opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .pk-clod { display: none; }
      .pk-bedsoil { transition: none; }
    }
    /* ⚠️ THE BREATHE ONLY RUNS ON UNTOUCHED GROUND (.is-fresh). It animates
       OPACITY, and so does the per-dig ramp — left on .is-marked it overrode
       every inline step and the ground pulsed instead of clearing. */
    @media (prefers-reduced-motion: no-preference) {
      .pk-bedsoil.is-fresh { animation: pkGroundBreathe 2.6s ease-in-out infinite; }
    }
    /* ⚠️ opacity only — never animate filter on this map (our own doctrine) */
    @keyframes pkGroundBreathe { 0%, 100% { opacity: 0.32; } 50% { opacity: 0.52; } }

    /* ── THE TAP CARDS (plant / birdhouse) ───────────────────────────
       The THING is the headline, its maker is a sticker somebody stuck on, and
       the meter is the hero. Trym's brief: less form, more game. */
    .pk-cardtitle {
      margin: 0 0 0.5rem; font-size: 1.25rem; line-height: 1.1; color: #ffe14d;
      text-transform: lowercase;
    }
    .pk-stickerrow {
      display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
      margin: 0 0 0.85rem;
    }
    /* 🍌 the maker's label — banana yellow, tilted, stuck on */
    .pk-sticker {
      display: inline-block; transform: rotate(-2.5deg);
      padding: 4px 10px; border: 2px solid #000; border-radius: 3px;
      background: linear-gradient(#ffe14d, #f5c518); color: #241c00;
      font-size: 0.8rem; font-weight: 800; line-height: 1.1;
      box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.6);
    }
    .pk-sticker.is-mine { background: linear-gradient(#9ff09f, #6fd46f); }
    .pk-stars { font-size: 0.8rem; letter-spacing: 1px; }
    .pk-ready { margin: -0.35rem 0 0.7rem; font-size: 0.82rem; font-weight: 800; color: #ffe14d; }
    /* a READY plant leads with the harvest, not the moisture bar */
    .pk-ready--big { font-size: 1.02rem; line-height: 1.35; margin: 0.1rem 0 0.8rem; }

    /* the meter, at hero size — this is what the card is FOR */
    .pk-meter--big { margin: 0 0 0.75rem; }
    .pk-meter--big .pk-meter__top { font-size: 0.86rem; margin-bottom: 0.4rem; }
    .pk-meter--big .pk-meter__track { height: 26px; border-radius: 7px; }

    /* 💧 WATER and 🌾 SEED look like what they are. Both are one repeating
       gradient on a ::after inside the fill, drifted with TRANSFORM (never
       background-position) so it stays on the compositor and costs nothing.
       ⚠️ the amber/red low+empty states still win — the texture is the healthy
       read, the ramp is the warning, and the warning must never be prettier. */
    .pk-meter__track i { overflow: hidden; }
    .pk-meter__track i::after {
      content: ''; position: absolute; inset: 0; left: -50%; width: 200%;
    }
    .pk-meter--water .pk-meter__track i { background: #2f8fe0; }
    .pk-meter--water .pk-meter__track i::after {
      background: repeating-linear-gradient(72deg,
        rgba(255, 255, 255, 0.30) 0 3px, rgba(255, 255, 255, 0) 3px 11px);
      animation: pkFlow 2.6s linear infinite;
    }
    .pk-meter--seed .pk-meter__track i { background: #e8b53a; }
    .pk-meter--seed .pk-meter__track i::after {
      background:
        repeating-linear-gradient(38deg, rgba(90, 55, 0, 0.34) 0 2px, rgba(0, 0, 0, 0) 2px 5px),
        repeating-linear-gradient(-52deg, rgba(255, 240, 190, 0.30) 0 2px, rgba(0, 0, 0, 0) 2px 6px);
      animation: pkGrain 9s linear infinite;
    }
    @keyframes pkFlow { to { transform: translateX(11px); } }
    @keyframes pkGrain { to { transform: translateX(6px); } }
    @media (prefers-reduced-motion: reduce) {
      .pk-meter__track i::after { animation: none; }
    }

    /* 💧 the tally: icon + number, nothing else. Tap for the names. */
    .pk-tally {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 10px; margin: 0 0 0.7rem; cursor: pointer;
      border: 2px solid #000; border-radius: 999px; background: #17301f;
      color: #dff3df; font-family: inherit; font-size: 0.86rem; font-weight: 800;
      box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
    }
    .pk-tally i { font-style: normal; font-size: 0.95rem; }
    .pk-tally em { font-style: normal; opacity: 0.6; font-size: 0.7rem; transition: transform 0.2s ease; }
    .pk-tally.is-open em { transform: rotate(180deg); }
    .pk-tally:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.5); }
    .pk-tallylist {
      display: flex; flex-wrap: wrap; gap: 4px;
      margin: -0.35rem 0 0.75rem;
    }
    /* ⚠️ a class beats [hidden] at equal specificity when it comes later —
       without this the names hang open instead of waiting for the tap */
    .pk-tallylist[hidden] { display: none; }
    .pk-tallylist span {
      padding: 3px 8px; border-radius: 999px; background: rgba(255, 255, 255, 0.07);
      font-size: 0.72rem; font-weight: 700; color: #cfe8cf;
    }
    .pk-tallylist__none { opacity: 0.6; font-style: italic; }

    /* ⭐ the action: the verb big, the reward as a pill you can SEE coming */
    /* 🍌 THE CARD CTA — banana yellow everywhere, so one colour means "this
       is the thing to press" across every card in the world.
       ⚠️ NAMED pk-cta, NOT pk-act: .pk-act is the ACTION BAR's button class and
       has been since the park was built. Calling this one .pk-act too put a
       width:100% on every action-bar button and they stacked down the screen
       instead of sitting in a row (Trym spotted it in the field). */
    .pk-cta {
      display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
      width: 100%; padding: 0.7rem 0.8rem; cursor: pointer;
      border: 3px solid #000; color: #241c00; font-family: inherit;
      background: linear-gradient(#ffe14d, #f2c012);
      box-shadow: 3px 3px 0 #000;
    }
    .pk-cta:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .pk-cta__verb { font-size: 1.05rem; font-weight: 800; white-space: nowrap; }
    /* the reward reads as a badge PINNED to the button — dark on the yellow so
       it is the second thing your eye lands on, never the first */
    .pk-cta__rew {
      padding: 4px 9px; border: 2px solid #000; border-radius: 999px;
      background: #12331d; color: #6fe38a; white-space: nowrap;
      font-size: 0.78rem; font-weight: 800; letter-spacing: 0.4px;
      box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.35);
    }

    /* 🌱 the garden tax, in the seed sheet */
    .pk-seedtax {
      margin: 0.5rem 0 0; font-size: 0.74rem; font-weight: 700; line-height: 1.4;
      color: #ffc63f;
    }

    /* 🏷 THE CHORE PILL — a chore names itself. Litter sprites are tiny and
       algae is a smudge on water, so a bare "+2" said something happened but
       never WHAT. Reads as a little sticker over the spot, then goes. */
    .pk-pill {
      position: absolute; transform: translate(-50%, -100%);
      display: flex; align-items: center; gap: 6px; white-space: nowrap;
      padding: 3px 8px; border: 2px solid #000; border-radius: 999px;
      background: #14251a; color: #dff3df; pointer-events: none;
      font-size: 11px; font-weight: 800; line-height: 1;
      box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.55);
      animation: pkPill 1.5s ease-out forwards;
    }
    .pk-pill b { color: #8de08d; }
    @keyframes pkPill {
      0%   { transform: translate(-50%, -90%) scale(0.85); opacity: 0; }
      14%  { transform: translate(-50%, -104%) scale(1); opacity: 1; }
      72%  { transform: translate(-50%, -112%) scale(1); opacity: 1; }
      100% { transform: translate(-50%, -132%) scale(1); opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) { .pk-pill { animation-duration: 1.1s; } }

    /* ✨ THE POP — what a cleared chore does. ⚠️ NOT the smoke poof: that
       means "you MISSED it" everywhere else in the world (the rave uses it for
       items nobody caught), so using it for a chore you just DID read as a
       failure. Trym. A pop is the opposite gesture: it snaps outward and goes.
       Pure CSS on the element already there, so it costs nothing extra. */
    @keyframes pkPop {
      0%   { transform: translate(-50%, -100%) scale(1); opacity: 1; }
      45%  { transform: translate(-50%, -108%) scale(1.35); opacity: 0.9; }
      100% { transform: translate(-50%, -118%) scale(0.2); opacity: 0; }
    }
    .pk-weed.is-pulled, .pk-trash.is-popped, .pk-leaf.is-popped {
      animation: pkPop 0.34s cubic-bezier(0.3, 0.9, 0.4, 1) forwards;
      pointer-events: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .pk-weed.is-pulled, .pk-trash.is-popped, .pk-leaf.is-popped { animation-duration: 0.01s; }
    }

    /* 💧 PUDDLES — they outlive the rain and fade; walk through one to
       splash it away (rep only, never health — see park-weather.js) */
    .pk-puddle {
      position: absolute; width: 2.1%; aspect-ratio: 5 / 2; pointer-events: none;
      transform: translate(-50%, -50%) scale(0.4); opacity: 0;
      transition: opacity 0.5s ease, transform 0.5s ease;
      background: radial-gradient(ellipse at 50% 50%,
        rgba(150, 196, 232, 0.62) 0%, rgba(120, 170, 210, 0.42) 55%, rgba(120, 170, 210, 0) 72%);
      border-radius: 50%;
    }
    .pk-puddle.is-in { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    .pk-puddle.is-out { opacity: 0; transform: translate(-50%, -50%) scale(1.5); }

    /* 🧭 THE WAYPOST'S PLANK — the bay's stall-sign idiom, park edition.
       The lettering is DOM, not baked: a 48px pack board cannot carry a place
       name legibly at this scale. The sprite's arrow says WHICH WAY, this
       says WHERE. */
    .pk-way {
      position: absolute; pointer-events: none; white-space: nowrap;
      transform: translate(-50%, -100%);
      background: #8a5a2b; border: 1px solid #3a230f; color: #ffe135;
      box-shadow: 1px 2px 0 rgba(0, 0, 0, 0.45);
      /* ⚠️ 0.45rem: half the stall-sign plank, then +50% back (Trym). At
         0.6rem it out-shouted its post; at 0.3rem the name stopped being
         readable on a phone. The post is world-scaled art and this is DOM at
         fixed px, so the two only agree at one size and this is it. */
      padding: 2px 6px; font-family: "Archivo Black", sans-serif;
      font-size: 0.45rem; letter-spacing: 0.03em;
      background-image: linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
      background-size: 100% 5px;
    }
    /* 🍂 the bloom-phase twins — real art swaps riding THE BLOOM (never a
       CSS filter on the world). Ground plates (sad 0-1 / mid 2-3) crossfade
       1.5s over the lush background, under every positioned walker/prop;
       each TREE's autumn twin rides its own 0.8s fade (JS staggers them). */
    .pk-plate {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-size: 100% 100%; background-repeat: no-repeat;
      image-rendering: pixelated;
      opacity: 0; transition: opacity 1.5s ease;
    }
    .pk-ovsad {
      position: absolute; inset: 0; pointer-events: none;
      background-size: 100% 100%; background-repeat: no-repeat;
      image-rendering: pixelated;
      opacity: 0; transition: opacity 0.8s ease;
    }
    /* ⛲ the fountain — 6-frame strip; end = 100% × 6 / 5 (the stepping rule) */
    .pk-fountain {
      position: absolute; transform: translate(-50%, -100%); pointer-events: none;
      image-rendering: pixelated; background-repeat: no-repeat;
      background-image: url('/assets/park/a-fountain.png');
      background-size: 600% 100%;
      animation: pkFountain 0.9s steps(6) infinite;
    }
    @keyframes pkFountain {
      from { background-position-x: 0%; }
      to   { background-position-x: 120%; }
    }
    @media (prefers-reduced-motion: reduce) { .pk-fountain { animation: none; } }
    /* 💀 the dead fountain — the pack's Turn_Off end frame, crossfaded over
       the running strip at phases 0-1 with the animals' sad grade */
    .pk-fountain-off {
      position: absolute; inset: 0; opacity: 0; pointer-events: none;
      background-image: url('/assets/park/a-fountain-off.png');
      background-size: 100% 100%; background-repeat: no-repeat;
      filter: saturate(0.6) brightness(0.92);
      transition: opacity 0.8s ease;
    }
    .pk-fountain-off.is-on { opacity: 1; }

    /* the banana — % of the world, so sprites ride the camera free */
    .pk-me {
      position: absolute; left: 0; top: 0; z-index: 6; width: 3.6%;
      transform: translate(-50%, -100%); pointer-events: none;
    }
    .pk-me::after {
      content: ''; position: absolute; left: 50%; bottom: -3px; width: 76%; aspect-ratio: 3 / 1;
      transform: translateX(-50%); background: rgba(20, 40, 18, 0.32);
      border-radius: 50%; z-index: -1;
    }
    .pk-peer {
      position: absolute; width: 3.6%; transform: translate(-50%, -100%);
      pointer-events: none; transition: left 0.18s linear, top 0.18s linear;
    }
    .pk-peer::after {
      content: ''; position: absolute; left: 50%; bottom: -3px; width: 76%; aspect-ratio: 3 / 1;
      transform: translateX(-50%); background: rgba(20, 40, 18, 0.32);
      border-radius: 50%; z-index: -1;
    }
    .pk-peer span {
      position: absolute; left: 50%; top: -14px; transform: translateX(-50%);
      font-size: 0.5rem; font-weight: 800; letter-spacing: 0.05em;
      color: #fffdf5; text-shadow: 1px 1px 0 #000; white-space: nowrap;
    }
    .pk-me canvas, .pk-peer canvas { width: 100%; height: auto; image-rendering: pixelated; display: block; }
    /* leavers go in a puff, never a blink — the world-lib smoke */
    .pk-poof { position: absolute; transform: translate(-50%, -50%); width: 3%; z-index: 1800; pointer-events: none; }
    .pk-poof span { position: absolute; inset: 0; opacity: 0; }
    .pk-poof svg { width: 100%; height: auto; image-rendering: pixelated; }
    .pk-poof__1 { animation: pkPoofStep 0.75s steps(1) forwards; }
    .pk-poof__2 { animation: pkPoofStep 0.75s steps(1) 0.25s forwards; }
    .pk-poof__3 { animation: pkPoofStep 0.75s steps(1) 0.5s forwards; }
    @keyframes pkPoofStep { 0% { opacity: 1; } 33%, 100% { opacity: 0; } }
    .pk-float {
      position: absolute; transform: translate(-50%, -50%); z-index: 1950; pointer-events: none;
      font-family: "Archivo Black", sans-serif; font-size: 0.85rem; color: #ffe135;
      text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000, 2px 2px 0 #000;
      white-space: nowrap; animation: pkFloat 0.9s ease-out forwards;
    }
    @keyframes pkFloat { to { transform: translate(-50%, calc(-50% - 34px)); opacity: 0; } }

    .pk-hint {   /* stacked clear of the health bar's bottom dock */
      position: absolute; left: 50%; bottom: 54px; transform: translateX(-50%); z-index: 7;
      background: rgba(0, 0, 0, 0.55); border: 2px solid #000; color: #fffdf5;
      font-size: 0.78rem; padding: 0.3rem 0.65rem; pointer-events: none; white-space: nowrap;
      transition: opacity 0.4s ease;
    }
    .pk-hint.is-off { opacity: 0; }
    /* 🚪 the exit confirm strip — comes on in a door zone, names where the
       road goes; walking on to the door is the yes */
    .pk-exitstrip {
      position: absolute; left: 50%; bottom: 54px; transform: translateX(-50%); z-index: 8;
      background: rgba(0, 0, 0, 0.78); border: 2px solid #ffe135; color: #ffe135;
      font-weight: 800; font-size: 0.82rem; padding: 0.35rem 0.75rem;
      pointer-events: none; white-space: nowrap;
      opacity: 0; transition: opacity 0.25s ease;
    }
    .pk-exitstrip.is-on { opacity: 1; }

    /* 🌸 THE PARK HEALTH BAR — bottom-docked, the rave jellymeter's language
       (chunky dark box, hard border, bordered inner track). The WHOLE bar's
       palette rides the current phase: dusty browns → olive → lush green.
       Tap = the park-health card. */
    .pk-hbar {
      position: absolute; left: 50%; bottom: 8px; transform: translateX(-50%); z-index: 8;
      width: min(520px, calc(100% - 16px)); box-sizing: border-box;
      display: flex; align-items: center; gap: 8px;
      appearance: none; font: inherit; cursor: pointer;
      background: rgba(13, 18, 11, 0.9); border: 3px solid #000; padding: 6px 8px;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent;
    }
    /* it OPENS the health card, so it must read as a button, not a readout:
       the world's chunky drop-shadow, a press-down, and the doctrine's own
       (i) glyph capping the right end (Trym: "doesn't look clickable") */
    .pk-hbar { box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.55); }
    .pk-hbar:active { transform: translateX(-50%) translateY(2px); box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.55); }
    .pk-hbar__more { display: grid; place-items: center; flex: none; opacity: 0.75; color: #e8f4e8; }
    .pk-hbar__more .pai { display: block; }
    @media (hover: hover) { .pk-hbar:hover .pk-hbar__more { opacity: 1; } .pk-hbar:hover { filter: brightness(1.12); } }
    .pk-hbar__face { display: grid; place-items: center; width: 22px; height: 22px; flex: none; }
    .pk-hbar__face .pai { display: block; }
    .pk-hbar__track { position: relative; flex: 1; height: 16px; border: 2px solid #000; overflow: hidden; }
    .pk-hbar__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; transition: width 0.5s ease; }
    .pk-hbar__pct {
      position: absolute; top: 50%; left: 0; transform: translate(-100%, -50%);
      padding: 0 4px; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.05em;
      white-space: nowrap; transition: left 0.5s ease; color: #0d120b;
    }
    .pk-hbar__pct.is-out { transform: translate(2px, -50%); color: #fffdf5; }
    /* the five phase palettes — face colour, track tint, fill */
    .pk-hbar--p0 { border-color: #1c140c; }
    .pk-hbar--p0 .pk-hbar__face { color: #8a6a44; }
    .pk-hbar--p0 .pk-hbar__track { background: #2a2118; }
    .pk-hbar--p0 .pk-hbar__fill { background: #6b4a2c; }
    .pk-hbar--p0 .pk-hbar__pct { color: #f0e2c8; }
    .pk-hbar--p1 .pk-hbar__face { color: #b08a4a; }
    .pk-hbar--p1 .pk-hbar__track { background: #322718; }
    .pk-hbar--p1 .pk-hbar__fill { background: #8a6a38; }
    .pk-hbar--p1 .pk-hbar__pct { color: #f5ecd8; }
    .pk-hbar--p2 .pk-hbar__face { color: #c0c050; }
    .pk-hbar--p2 .pk-hbar__track { background: #2a2c16; }
    .pk-hbar--p2 .pk-hbar__fill { background: #a8a83a; }
    .pk-hbar--p3 .pk-hbar__face { color: #7cc465; }
    .pk-hbar--p3 .pk-hbar__track { background: #1c2a18; }
    .pk-hbar--p3 .pk-hbar__fill { background: #5cb04a; }
    .pk-hbar--p4 .pk-hbar__face { color: #6ff0a0; }
    .pk-hbar--p4 .pk-hbar__track { background: #16281a; }
    .pk-hbar--p4 .pk-hbar__fill { background: #35d97a; }
    /* full bloom gets a quiet shine strip along the fill's top */
    .pk-hbar--p4 .pk-hbar__fill::after {
      content: ''; position: absolute; left: 0; right: 0; top: 2px; height: 3px;
      background: rgba(255, 255, 255, 0.32);
    }
    .pk-hbar__pct.is-out { color: #fffdf5; }

    /* 🌍 THE WORLD HUD — the refined pill strip (rave/bay), park edition */
    /* 🌍 the World HUD's styles moved to src/lib/world-hud.js — the park tints
       it with --wh-bg and nothing else. */

    /* 🎮 THE ACTION BAR — an in-flow band BELOW the map: React · Sound */

    /* ⚙ THE SOUND BUTTON IS A SETTING, NOT AN ACTION (Trym) — it is pinned to
       the right and never moves, while the things you actually DO stay centred.
       ⚠️ the ::before is a spacer the same width as the button: with an auto
       margin on each side the free space splits evenly, so the middle group is
       centred in the WHOLE bar rather than in what is left over. */
    .pk-actions::before { content: ''; min-width: 46px; margin-right: auto; }
    #pkAudio { margin-left: auto; }
    .pk-actions {
      display: flex; align-items: center; justify-content: center; gap: 0.6rem;
      background: #101a10; border-top: 4px solid #000; padding: 0.6rem 0.8rem;
      flex-wrap: wrap; touch-action: manipulation;
    }
    .pk-act {
      appearance: none; font: inherit; font-weight: 800; font-size: 0.95rem;
      border: 3px solid #000; box-shadow: 3px 3px 0 #000; cursor: pointer;
      line-height: 1; white-space: nowrap; display: inline-flex; align-items: center;
      gap: 0.35rem; transition: transform 0.08s ease, box-shadow 0.08s ease;
    }
    .pk-act:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .pk-act--icon { background: #182a16; color: #fffdf5; padding: 0.5rem 0.7rem; font-size: 1.1rem; min-width: 46px; justify-content: center; }
    /* 🧰 the tool slot — leftmost, only there while a chore is in range */
    .pk-act--tool { background: #ffe135; color: #10240f; padding: 0.55rem 1.05rem; }
    .pk-act--tool[hidden] { display: none; }

    .pk-cut {
      position: fixed; inset: 0; background: #000; z-index: 60; pointer-events: none;
      opacity: 0; transition: opacity 0.12s steps(2);
    }
    .pk-cut.is-on { opacity: 1; }
    @media (prefers-reduced-motion: reduce) { .pk-cut { transition: none; } }

    /* 🌰 acorns on the grass — a rise-in like the bay's shells */
    .pk-acorn {
      position: absolute; z-index: 3; width: 0.75%; aspect-ratio: 11 / 13;
      transform: translate(-50%, -50%); pointer-events: none;
      filter: drop-shadow(1px 2px 0 rgba(20, 40, 18, 0.45));
      animation: pkRise 0.45s ease-out;
    }
    .pk-acorn svg { width: 100%; height: 100%; display: block; }
    @keyframes pkRise {
      0% { transform: translate(-50%, calc(-50% + 10px)) scale(0.5); opacity: 0; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) { .pk-acorn { animation: none; } }

    /* 🦋 butterflies — two SVG frames stepped like the poof; phase-4 life */
    .pk-bfly {
      position: absolute; left: 0; top: 0; width: 0.85%; aspect-ratio: 10 / 8;
      pointer-events: none;
      filter: drop-shadow(1px 2px 0 rgba(20, 40, 18, 0.3));
    }
    .pk-bfly svg { width: 100%; height: 100%; display: block; }
    .pk-bfly svg .f1 { animation: pkFlapA 0.32s steps(1) infinite; }
    .pk-bfly svg .f2 { animation: pkFlapB 0.32s steps(1) infinite; }
    @keyframes pkFlapA { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    @keyframes pkFlapB { 0%, 49% { opacity: 0; } 50%, 100% { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) {
      .pk-bfly svg .f1 { animation: none; }
      .pk-bfly svg .f2 { animation: none; opacity: 0; }
    }

    /* 🐿 squirrels — legs stop when the squirrel does (crab rule) */
    .pk-squirrel {
      position: absolute; left: 0; top: 0; width: 0.95%; aspect-ratio: 14 / 10;
      transform: translate(-50%, -100%); pointer-events: none;
      filter: drop-shadow(1px 2px 0 rgba(20, 40, 18, 0.35));
    }
    .pk-squirrel svg { width: 100%; height: 100%; display: block; }
    .pk-squirrel svg .f1 { animation: pkFlapA 0.22s steps(1) infinite; }
    .pk-squirrel svg .f2 { animation: pkFlapB 0.22s steps(1) infinite; }
    .pk-squirrel.is-still svg .f1 { animation: none; opacity: 1; }
    .pk-squirrel.is-still svg .f2 { animation: none; opacity: 0; }

    /* 🐔 THE ANIMALS — farm-pack strips: 6 walk frames, frame 0 = standing.
       End value per the stepping rule: 100% × 6 / 5 = 120%. */
    .pk-animal {
      position: absolute; left: 0; top: 0; pointer-events: none; image-rendering: pixelated;
      background-repeat: no-repeat; background-size: 600% 100%;
      filter: drop-shadow(1px 2px 0 rgba(20, 40, 18, 0.35));
