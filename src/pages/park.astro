    .pk-seedpoor { margin: 0.2rem 0 0; font-size: 0.72rem; opacity: 0.7; }
    /* ⛲ the wish card's 8-ball reveal — the answer fades in for ceremony */
    .pk-wishline {
      margin: 0.45rem 0 0.35rem; min-height: 1.5em; font-size: 0.94rem;
