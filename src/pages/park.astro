    .pk-stand__awning { display: flex; height: 26px; }
    .pk-stand__awning span { flex: 1; }
    .pk-stand__awning span:nth-child(odd) { background: #ffe135; }
    .pk-stand__awning span:nth-child(even) { background: #241d33; }
    .pk-stand__window {
      position: relative;
      background:
        linear-gradient(rgba(0, 0, 0, 0.30), rgba(0, 0, 0, 0.06) 45%),
        repeating-linear-gradient(90deg, #6b5617 0 24px, #4a3a0d 24px 27px, #63500f 27px 51px, #4a3a0d 51px 54px);
      height: clamp(170px, 38vw, 218px); overflow: hidden;
    }
    .pk-stand__keeper {
      appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
      display: block; width: min(400px, 92%); margin: 0 auto; position: relative; z-index: 1;
    }
    .pk-stand__keeper canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; margin-top: -13%; }
    /* items hung on the planks behind the keeper — pure shop dressing */
    .pk-stand__decor {
      position: absolute; z-index: 0; image-rendering: pixelated; pointer-events: none;
      filter: drop-shadow(2px 2px 0 rgba(0, 0, 0, 0.35));
    }
    .pk-stand__decor svg { width: 100%; height: auto; display: block; }
    .pk-stand__bubble {
      position: absolute; right: 2.5%; top: 6px; z-index: 3;
      max-width: 39%; background: #fffdf5; color: #111; border: 3px solid #000;
      box-shadow: 4px 4px 0 #000; padding: 0.32rem 0.55rem; font-size: 0.74rem;
      font-weight: 700; opacity: 0; transition: opacity 0.2s ease; pointer-events: none;
    }
    .pk-stand__bubble.is-on { opacity: 1; }
    .pk-stand__bubble::after {
      content: ''; position: absolute; left: 14%; bottom: -9px;
      border: 5px solid transparent; border-top-color: #000;
    }
    .pk-stand__counter {
      height: 74px; border-top: 4px solid #000; position: relative;
      background: repeating-linear-gradient(90deg, #3a2b18 0 26px, #2c2113 26px 52px);
    }
    .pk-stand__counter::before {
      content: ''; position: absolute; inset: 0 0 auto; height: 8px;
      background: #4a3820; border-bottom: 3px solid #000;
    }
    .pk-stand__wallet {
      position: absolute; left: 4%; top: 54%; transform: translateY(-50%); z-index: 2;
      display: flex; align-items: center; gap: 0.5rem;
    }
    .pk-stand__wallet img { height: auto; image-rendering: pixelated; filter: drop-shadow(2px 3px 0 rgba(0, 0, 0, 0.45)); }
    .pk-stand__wallet b {
      font-family: "Archivo Black", sans-serif; color: #ffe135; font-size: 1.2rem;
      text-shadow: 2px 2px 0 #000;
    }
    /* the desk buttons: step back to the park / back to the club */
    .pk-stand__deskbtns {
      position: absolute; right: 3%; top: 54%; transform: translateY(-50%); z-index: 2;
      display: flex; gap: 0.55rem;
    }
    .pk-stand__deskbtn {
      appearance: none; display: flex; align-items: center; justify-content: center;
      width: 44px; height: 40px; padding: 0; cursor: pointer;
      background: #ffe135; color: #111; border: 3px solid #000;
      box-shadow: 3px 3px 0 #000; text-decoration: none; font-family: inherit;
    }
    .pk-stand__deskbtn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .pk-stand__deskbtn--leave { font-weight: 800; font-size: 0.82rem; line-height: 1; padding: 0 10px; white-space: nowrap; }
    .pk-stand__deskbtn svg { display: block; image-rendering: pixelated; }
    .pk-stand__shelf { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; margin-top: 1rem; }
    @media (min-width: 560px) { .pk-stand__shelf { grid-template-columns: repeat(4, 1fr); } }
    .pk-tile {
      appearance: none; position: relative; border: 3px solid #000; background: #17121f;
      color: #fffdf5; box-shadow: 5px 5px 0 #000; cursor: pointer;
      padding: 0.55rem 0.3rem 0.5rem; display: grid; justify-items: center; gap: 0.3rem;
      font-family: inherit; transition: transform 0.08s ease;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent;
    }
    .pk-tile:active { transform: translate(2px, 2px); box-shadow: 3px 3px 0 #000; }
    .pk-tile.is-picked { outline: 3px solid #ffe135; outline-offset: 2px; }
    .pk-tile__art { height: 52px; display: flex; align-items: center; justify-content: center; }
    .pk-tile__art svg { height: 48px; width: auto; max-width: 62px; image-rendering: pixelated; }
    .pk-tile b { font-size: 0.62rem; font-weight: 700; text-align: center; line-height: 1.15; opacity: 0.9; }
    .pk-tile__slot {
      font-size: 0.5rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
      color: #b9b2d0; border: 2px solid #000; background: #241d33; padding: 0.05rem 0.3rem;
    }
    .pk-price { display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 800; color: #ffe135; }
    .pk-price img { image-rendering: pixelated; }
    .pk-tile .pk-price { font-size: 0.78rem; }
    .pk-tile .pk-price img { width: 14px; }
    .pk-tile__lock { position: absolute; top: -7px; right: -6px; width: 18px; display: none; }
    .pk-tile.is-locked .pk-tile__lock { display: block; }
    .pk-tile__lock svg { width: 100%; height: auto; image-rendering: pixelated; display: block; filter: drop-shadow(1px 1px 0 rgba(0, 0, 0, 0.6)); }
    .pk-tile__own {
      position: absolute; top: -8px; right: -6px; display: none;
      background: #37d67a; color: #06220f; border: 2px solid #000;
      font-size: 0.5rem; font-weight: 800; letter-spacing: 0.08em; padding: 0.1rem 0.3rem;
      box-shadow: 2px 2px 0 #000;
    }
    .pk-tile.is-owned .pk-tile__own { display: block; }
    .pk-tile.is-owned .pk-tile__art { filter: drop-shadow(0 0 5px rgba(55, 214, 122, 0.45)); }
    .pk-stand__head {
      font-family: "Archivo Black", sans-serif; color: #ffe135; font-size: 0.85rem;
      letter-spacing: 0.06em; margin: 1.3rem 0 0.7rem; text-transform: lowercase;
    }
    .pk-stand__spot {
      display: flex; gap: 0.9rem; align-items: center; margin-top: 1rem;
      border: 4px solid #000; box-shadow: 6px 6px 0 #000; background: #241d33; padding: 0.9rem;
    }
    .pk-stand__spot[hidden] { display: none; }
    .pk-stand__spotart {
      flex: 0 0 96px; height: 96px; display: flex; align-items: center; justify-content: center;
      border: 3px solid #000; background: #17121f;
    }
    .pk-stand__spotart svg { height: 76px; width: auto; max-width: 84px; image-rendering: pixelated; }
    .pk-stand__spotmeta { flex: 1; min-width: 0; }
    .pk-stand__spotmeta h2 { font-family: "Archivo Black", sans-serif; color: #ffe135; font-size: 1.05rem; margin: 0 0 0.2rem; }
    .pk-stand__spotmeta p { margin: 0 0 0.6rem; font-size: 0.85rem; opacity: 0.85; }
    .pk-stand__spotrow { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
    .pk-price--big { font-size: 1.15rem; }
    .pk-price--big img { width: 22px; }
    .pk-stand button.pk-btn--buy {
      flex: 0 1 auto; padding: 0.5rem 0.9rem; font-size: 0.85rem; cursor: pointer;
      border: 3px solid #000; box-shadow: 5px 5px 0 #000;
      background: #ffe135; color: #111; font-weight: 800; font-family: inherit;
    }
    .pk-stand button.pk-btn--buy.is-poor { background: #17121f; color: #fffdf5; opacity: 0.85; }
    .pk-stand button.pk-btn--buy.is-owned { background: #37d67a; color: #06220f; }
    @media (max-width: 420px) { .pk-stand__spot { flex-wrap: wrap; } .pk-stand__spotmeta { flex-basis: 100%; } }
    @media (prefers-reduced-motion: reduce) { .pk-stand__sign .pk-stand__flick { animation: none; } }
  </style>

  <div class="pk-wrap">
    <h1 class="pk-sign">🌳 THE PARK</h1>
    <p class="pk-tag">the green heart of Banana World</p>

    <div class="pk-stage">
      <div class="pk-view" id="pkView">
        <div class="pk-world" id="pkWorld">
          <div class="pk-me" id="pkMe"><canvas id="pkMeCv" width="150" height="150" aria-hidden="true"></canvas></div>
        </div>
        <!-- 🌍 THE WORLD HUD — LEVEL (rep bar) · COINS · BLOOM · CROWD -->
        <div class="pk-whud" id="pkWhud">
          <span class="pk-whud__lvl"><span id="pkLvlN">LVL 1</span><span class="pk-whud__lvlbar"><i id="pkLvlFill"></i></span></span>
          <span class="pk-whud__coins"><img src="/assets/banana-stand/coin.png" width="16" height="16" alt="" /><b id="pkCoinN">0</b></span>
          <span class="pk-whud__crowd"><span aria-hidden="true">◍</span> <span id="pkCrowd">solo</span></span>
        </div>
        <button class="pk-hbar" id="pkHBar" type="button" aria-label="park health">
          <span class="pk-hbar__face" id="pkHFace" aria-hidden="true"></span>
          <span class="pk-hbar__track"><i class="pk-hbar__fill" id="pkHFill"></i><b class="pk-hbar__pct" id="pkHPct">—</b></span>
        </button>
        <div class="pk-hint" id="pkHint">tap to walk · arrow keys / WASD work too</div>
        <div class="pk-exitstrip" id="pkExitStrip" role="status" aria-live="polite"></div>
        <div class="pk-toast" id="pkToast" role="status" aria-live="polite"></div>

        <!-- 🌱 THE GARDEN — seed picker / plant card, one panel, content per open -->
        <div class="pk-panel" id="pkGarden" hidden>
          <div class="pk-card" role="dialog" aria-label="The garden">
            <button class="pk-cardx" id="pkGardenClose" type="button" aria-label="close">✕</button>
            <div id="pkGardenBody"></div>
          </div>
        </div>

        <!-- 🍌 OLD PEEL — the park's first full RPG NPC: tilted waist-up
             portrait + a question deck (future NPCs reuse pk-card--npc). -->
        <div class="pk-panel" id="pkOldPanel" hidden>
          <div class="pk-card pk-card--npc" role="dialog" aria-label="Old Peel">
            <div class="pk-npcpop" aria-hidden="true"><canvas id="pkOldPortrait" width="390" height="390"></canvas></div>
            <button class="pk-cardx" id="pkOldClose" type="button" aria-label="close">✕</button>
            <h2>old peel</h2>
            <p class="pk-npcsay" id="pkOldLine"></p>
            <div class="pk-npcq" id="pkOldQs"></div>
            <div class="pk-npcbox" id="pkOldBox" hidden>
              <p id="pkOldBoxText" aria-live="polite"></p>
              <span class="pk-npcbox__more" aria-hidden="true">▼</span>
            </div>
          </div>
        </div>

        <!-- 🧃 THE MERCH SHOP — a real interior (the stand's counter scene,
             merch edition): goods hung on the back wall, Inka at the desk. -->
        <div class="pk-shop" id="pkShop" role="dialog" aria-label="The merch shop" hidden>
          <div class="pk-shop__awning" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <button class="pk-shop__x" id="pkShopClose" type="button" aria-label="leave the shop">×</button>
          <div class="pk-shop__wall">
            <div class="pk-shop__goods" id="pkGoods"></div>
            <span class="pk-shop__ship">🚚 free worldwide shipping</span>
            <div class="pk-shop__bubble" id="pkKeeperBubble" role="status" aria-live="polite"></div>
            <button class="pk-shop__keeper" id="pkKeeper" type="button" aria-label="talk to Inka">
              <canvas id="pkKeeperCv" width="360" height="360"></canvas>
            </button>
          </div>
          <div class="pk-shop__counter">
            <span class="pk-shop__sign">everything else in the park costs coins. this is the one real thing — printed &amp; shipped to your door.</span>
          </div>
          <button class="pk-btn pk-shop__back" id="pkShopBack" type="button">🌳 back to the park</button>
        </div>

        <!-- 🍌🏪 THE BANANA STAND — the coin shop: the old /park/ page's
             counter room reproduced EXACTLY (sign, kiosk, keeper, desk wallet
             + desk buttons, spotlight, shelf, back-catalog) over the same
             ported commerce plumbing (own_<id> pass stats + instant equip). -->
        <div class="pk-stand" id="pkStand" role="dialog" aria-label="The Banana Stand" hidden>
          <div class="pk-stand__wrap">
            <p class="pk-stand__sign">THE BANANA <span class="pk-stand__flick">STAND</span></p>
            <p class="pk-stand__tag">there's always money in the banana stand</p>
            <div class="pk-stand__kiosk">
              <div class="pk-stand__bubble" id="pkStandBubble" role="status" aria-live="polite"></div>
              <div class="pk-stand__awning" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
              </div>
              <div class="pk-stand__window">
                <button class="pk-stand__keeper" id="pkStandKeeper" aria-label="The shopkeeper">
                  <canvas id="pkStandKeeperCv" width="360" height="360" aria-hidden="true"></canvas>
                </button>
              </div>
              <div class="pk-stand__counter">
                <div class="pk-stand__wallet" aria-label="Your bananacoins">
                  <img src="/assets/banana-stand/coin.png" width="44" alt="" aria-hidden="true" />
                  <b id="pkStandWallet">0</b>
                </div>
                <div class="pk-stand__deskbtns">
                  <button class="pk-stand__deskbtn pk-stand__deskbtn--leave" id="pkStandBack" type="button" aria-label="Leave the banana stand" title="leave — back to the park">Leave</button>
                  <a class="pk-stand__deskbtn" href="/rave/" data-place="stand" aria-label="Back to the club" title="back to the club">
                    <PixelIcon name="mirrorball" size="22px" />
                  </a>
                </div>
              </div>
            </div>

            <!-- the SPOTLIGHT: tap a shelf tile and the item takes the stage -->
            <div class="pk-stand__spot" id="pkStandSpot" hidden>
              <div class="pk-stand__spotart" id="pkStandSpotArt"></div>
              <div class="pk-stand__spotmeta">
                <h2 id="pkStandSpotName"></h2>
                <p id="pkStandSpotDesc"></p>
                <div class="pk-stand__spotrow">
                  <span class="pk-price pk-price--big"><img src="/assets/banana-stand/coin.png" width="22" alt="" aria-hidden="true" /><b id="pkStandSpotPrice"></b></span>
                  <button class="pk-btn pk-btn--buy" id="pkStandBuy" type="button">buy</button>
                </div>
              </div>
            </div>

            <!-- the SHELF: every item in stock, built from the manifest -->
            <div class="pk-stand__shelf" id="pkStandShelf" aria-label="The banana stand's stock"></div>
            <h2 class="pk-stand__head" id="pkStandBackHead" hidden>missed drops — the back-catalog</h2>
            <div class="pk-stand__shelf" id="pkStandBackShelf" aria-label="Drops you missed" hidden></div>
          </div>
        </div>
      </div><!-- /.pk-view -->

      <!-- 🎮 THE ACTION BAR — 🪙 toss · 🧃 browse (both proximity-gated) · React · Sound -->
      <div class="pk-actions" aria-label="park actions">
        <button class="pk-act pk-act--tool" id="pkTool" type="button" hidden></button>
        <button class="pk-act pk-act--icon" id="pkEmote" type="button" aria-label="react">❤️</button>
        <button class="pk-act pk-act--icon" id="pkAudio" type="button" aria-label="sound" aria-pressed="false">🔇</button>
      </div>
    </div><!-- /.pk-stage -->

  </div>

  <div class="pk-cut" id="pkCut" aria-hidden="true"></div>

  <script>
    import '../scripts/banana-park.js';
  </script>
</BaseLayout>
