    /* 🍌 the stand keeper seen through the hut window, outdoors — the old
       page's scene-1 look. The wrapper is the window cutout and clips him;
       the canvas keeps the old geometry (64% of the hut, centred, top 26%)
       re-expressed relative to the window rect. Set dressing, never a target. */
    .pk-standnpc { position: absolute; overflow: hidden; pointer-events: none; }
    .pk-standnpc canvas {
      position: absolute; left: -7.1%; top: -29.1%; width: 114.3%;
      image-rendering: pixelated;
    }

    /* 🧃 THE MERCH SHOP INTERIOR — the stand's counter scene, merch edition:
       awning, plank back wall with the goods HUNG on it, Inka big behind the
       desk. Mocks stay FLAT — the banana is the art. */
    .pk-shop {
      position: absolute; inset: 0; z-index: 40; display: flex; flex-direction: column;
      background: #14100b; overflow: hidden;
    }
    .pk-shop[hidden] { display: none; }
    .pk-shop__awning { display: flex; height: 20px; flex: 0 0 auto; border-bottom: 3px solid #000; }
    .pk-shop__awning span { flex: 1; }
    .pk-shop__awning span:nth-child(odd) { background: #c0261a; }
    .pk-shop__awning span:nth-child(even) { background: #fdf6e6; }
    .pk-shop__x {
      position: absolute; top: 28px; right: 8px; z-index: 6;
      appearance: none; font: inherit; font-weight: 800; line-height: 1;
      background: #ffe135; color: #10240f; border: 3px solid #000;
      box-shadow: 2px 2px 0 #000; width: 30px; height: 30px; cursor: pointer;
    }
    /* the back wall: warm dark planks (the stand's, shifted red-brown) */
    .pk-shop__wall {
      position: relative; flex: 1 1 auto; overflow: hidden;
      background:
        linear-gradient(rgba(0, 0, 0, 0.34), rgba(0, 0, 0, 0.05) 45%),
        repeating-linear-gradient(90deg, #5c4423 0 24px, #3f2e15 24px 27px, #543d1e 27px 51px, #3f2e15 51px 54px);
    }
    /* the goods, hung high on the planks — each on a nail with a string */
    .pk-shop__goods {
      position: absolute; left: 0; right: 0; top: 22px; z-index: 2;
      display: flex; justify-content: space-evenly; align-items: flex-start;
      padding: 0 4px;
    }
    .pk-hang {
      position: relative; display: grid; justify-items: center; gap: 3px;
      text-decoration: none; color: #fffdf5; padding-top: 14px; cursor: pointer;
    }
    .pk-hang::before {   /* the nail */
      content: ''; position: absolute; top: 0; left: 50%; width: 5px; height: 5px;
      transform: translateX(-50%); background: #1c1610; border-radius: 50%;
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25);
    }
    .pk-hang::after {    /* the string */
      content: ''; position: absolute; top: 4px; left: 50%; width: 2px; height: 11px;
      transform: translateX(-50%); background: rgba(240, 230, 200, 0.55);
    }
    .pk-hang:hover .pk-hang__mock, .pk-hang:focus-visible .pk-hang__mock { outline: 2px solid #ffe135; outline-offset: 1px; }
    .pk-hang:active { transform: translateY(2px); }
    .pk-hang__mock {
      width: 78px; height: 78px; display: grid; place-items: center;
      border: 3px solid #000; overflow: hidden;
      box-shadow: 3px 4px 0 rgba(0, 0, 0, 0.45);
    }
    .pk-hang__mock canvas { width: 66px; height: 66px; image-rendering: pixelated; display: block; }
    /* sticker: a white die-cut contour hugging the banana, on a light card */
    .pk-hang--sticker .pk-hang__mock { background: #f4f1e8; }
    .pk-hang--sticker canvas {
      filter: drop-shadow(2px 0 0 #fff) drop-shadow(-2px 0 0 #fff)
              drop-shadow(0 2px 0 #fff) drop-shadow(0 -2px 0 #fff)
              drop-shadow(1px 2px 0 rgba(0, 0, 0, 0.25));
    }
    /* mug: makeMugMockup already draws the whole ceramic, so the frame just
       gives it a shelf to sit on — no contour, or it'd outline the mug body */
    .pk-hang--mug .pk-hang__mock { background: #f4f1e8; }
    .pk-hang--mug canvas { width: 62px; height: 62px; }
    /* tee: the banana printed small on a tee-coloured rectangle */
    .pk-hang--tee .pk-hang__mock { background: #1c2233; }
    .pk-hang--tee canvas { width: 40px; height: 40px; }
    /* the price tag — a tilted paper chip clipped to the mock's corner */
    .pk-hang__tag {
      position: absolute; top: 8px; right: -7px; z-index: 2; font-style: normal;
      background: #ffe135; color: #10240f; border: 2px solid #000;
      font-weight: 800; font-size: 0.62rem; line-height: 1; padding: 2px 4px;
      transform: rotate(6deg); box-shadow: 1px 2px 0 rgba(0, 0, 0, 0.4);
      white-space: nowrap;
    }
    .pk-hang b { font-size: 0.6rem; font-weight: 800; text-align: center; line-height: 1.15; text-shadow: 1px 1px 0 #000; white-space: nowrap; }
    .pk-shop__ship {
      position: absolute; left: 50%; top: 168px; transform: translateX(-50%) rotate(-2deg); z-index: 1;
      background: #8a5a2b; border: 2px solid #3a230f; color: #ffe135;
      font-family: "Archivo Black", sans-serif; font-size: 0.56rem; letter-spacing: 0.04em;
      padding: 2px 7px; white-space: nowrap; box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.45);
    }
    /* Inka — big behind the counter, feet clipped by the wall's bottom edge */
    .pk-shop__keeper {
      appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
      position: absolute; left: 50%; bottom: -74px; transform: translateX(-50%);
      width: min(360px, 86%); z-index: 3;
    }
    .pk-shop__keeper canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
    .pk-shop__bubble {
      position: absolute; left: 6px; bottom: 34%; z-index: 5;
      max-width: 46%; background: #fffdf5; color: #111; border: 3px solid #000;
      filter: drop-shadow(3px 3px 0 #000); padding: 0.35rem 0.5rem;
      font-size: 0.6rem; font-weight: 800; letter-spacing: 0.04em;
      text-transform: uppercase; line-height: 1.5;
      opacity: 0; transition: opacity 0.2s ease; pointer-events: none;
    }
    .pk-shop__bubble.is-on { opacity: 1; }
    .pk-shop__counter {
      flex: 0 0 64px; position: relative; border-top: 4px solid #000; z-index: 4;
      background: repeating-linear-gradient(90deg, #3a2b18 0 26px, #2c2113 26px 52px);
      display: grid; place-items: center; padding: 0 0.5rem;
    }
    .pk-shop__counter::before {
      content: ''; position: absolute; inset: 0 0 auto; height: 8px;
      background: #4a3820; border-bottom: 3px solid #000;
    }
    /* the honesty line lives ON the desk, not in a footer */
    .pk-shop__sign {
      background: #8a5a2b; border: 2px solid #3a230f; color: #ffe7a0;
      font-size: 0.62rem; font-weight: 800; line-height: 1.4; text-align: center;
      padding: 0.3rem 0.55rem; box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
      transform: rotate(-0.5deg); max-width: 100%;
    }
    .pk-shop button.pk-shop__back {
      flex: 0 0 auto; margin: 0.55rem 0.8rem 0.7rem; box-shadow: 3px 3px 0 #000;
      padding: 0.5rem; font-size: 0.85rem; cursor: pointer; border: 3px solid #000;
      background: #8de08d; color: #10240f; font-weight: 800; font-family: inherit;
    }

    .pk-foot { display: flex; gap: 0.8rem; margin-top: 1rem; flex-wrap: wrap; }
    .pk-btn {
      display: grid; place-items: center; text-align: center; flex: 1 1 160px;
      border: 3px solid #000; background: #8de08d; color: #10240f; font-weight: 800;
      box-shadow: 4px 4px 0 #000; padding: 0.6rem; text-decoration: none;
      font-family: inherit; font-size: 0.9rem;
    }

    /* 🍌🏪 THE BANANA STAND INTERIOR — the old /park/ counter room, kept
       EXACT (Trym: "the exact version + the inside room we made"): neon sign,
       yellow awning, gold planks + hung decor, big keeper, desk wallet + desk
       buttons, spotlight + shelf. bs- CSS lifted verbatim, pk- namespaced. */
    .pk-stand {
      position: absolute; inset: 0; z-index: 40; overflow-y: auto; overflow-x: hidden;
      scrollbar-gutter: stable; background: #0d0b14; color: #fffdf5;
    }
    .pk-stand[hidden] { display: none; }
    .pk-stand__wrap { max-width: 560px; margin: 0 auto; padding: 0.6rem 0.8rem 2.5rem; }
    .pk-stand__sign {
      font-family: "Archivo Black", sans-serif; text-align: center;
      color: #ffe135; font-size: clamp(1.4rem, 6.4vw, 2.2rem); line-height: 1.05;
      margin: 0.7rem 0 0.15rem; letter-spacing: 0.02em;
      text-shadow: 0 0 12px rgba(255, 225, 53, 0.55), 0 0 30px rgba(255, 225, 53, 0.25);
    }
    .pk-stand__sign .pk-stand__flick { animation: pkStandFlicker 7s steps(1) infinite; }
    @keyframes pkStandFlicker { 0%, 92%, 96% { opacity: 1; } 93%, 95% { opacity: 0.25; text-shadow: none; } }
    .pk-stand__tag { text-align: center; margin: 0 0 0.8rem; font-size: 0.82rem; opacity: 0.6; }
    .pk-stand__kiosk { position: relative; border: 4px solid #000; box-shadow: 8px 8px 0 #000; background: #17121f; }
    .pk-stand__awning { display: flex; height: 26px; }
    .pk-stand__awning span { flex: 1; }
    .pk-stand__awning span:nth-child(odd) { background: #ffe135; }
    .pk-stand__awning span:nth-child(even) { background: #241d33; }
    .pk-stand__window {
      position: relative;
      background:
        linear-gradient(rgba(0, 0, 0, 0.30), rgba(0, 0, 0, 0.06) 45%),
        repeating-linear-gradient(90deg, #6b5617 0 24px, #4a3a0d 24px 27px, #63500f 27px 51px, #4a3a0d 51px 54px);
      height: clamp(170px, 38vw, 218px); overflow: hidden;
    }
    .pk-stand__keeper {
      appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
      display: block; width: min(400px, 92%); margin: 0 auto; position: relative; z-index: 1;
    }
    .pk-stand__keeper canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; margin-top: -13%; }
    /* items hung on the planks behind the keeper — pure shop dressing */
    .pk-stand__decor {
      position: absolute; z-index: 0; image-rendering: pixelated; pointer-events: none;
      filter: drop-shadow(2px 2px 0 rgba(0, 0, 0, 0.35));
    }
    .pk-stand__decor svg { width: 100%; height: auto; display: block; }
    .pk-stand__bubble {
      position: absolute; right: 2.5%; top: 6px; z-index: 3;
      max-width: 39%; background: #fffdf5; color: #111; border: 3px solid #000;
      box-shadow: 4px 4px 0 #000; padding: 0.32rem 0.55rem; font-size: 0.74rem;
      font-weight: 700; opacity: 0; transition: opacity 0.2s ease; pointer-events: none;
    }
    .pk-stand__bubble.is-on { opacity: 1; }
    .pk-stand__bubble::after {
      content: ''; position: absolute; left: 14%; bottom: -9px;
      border: 5px solid transparent; border-top-color: #000;
    }
    .pk-stand__counter {
      height: 74px; border-top: 4px solid #000; position: relative;
      background: repeating-linear-gradient(90deg, #3a2b18 0 26px, #2c2113 26px 52px);
    }
    .pk-stand__counter::before {
      content: ''; position: absolute; inset: 0 0 auto; height: 8px;
      background: #4a3820; border-bottom: 3px solid #000;
    }
    .pk-stand__wallet {
      position: absolute; left: 4%; top: 54%; transform: translateY(-50%); z-index: 2;
      display: flex; align-items: center; gap: 0.5rem;
    }
    .pk-stand__wallet img { height: auto; image-rendering: pixelated; filter: drop-shadow(2px 3px 0 rgba(0, 0, 0, 0.45)); }
    .pk-stand__wallet b {
      font-family: "Archivo Black", sans-serif; color: #ffe135; font-size: 1.2rem;
      text-shadow: 2px 2px 0 #000;
    }
    /* the desk buttons: step back to the park / back to the club */
    .pk-stand__deskbtns {
      position: absolute; right: 3%; top: 54%; transform: translateY(-50%); z-index: 2;
      display: flex; gap: 0.55rem;
    }
    .pk-stand__deskbtn {
      appearance: none; display: flex; align-items: center; justify-content: center;
      width: 44px; height: 40px; padding: 0; cursor: pointer;
      background: #ffe135; color: #111; border: 3px solid #000;
      box-shadow: 3px 3px 0 #000; text-decoration: none; font-family: inherit;
    }
    .pk-stand__deskbtn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .pk-stand__deskbtn--leave { font-weight: 800; font-size: 0.82rem; line-height: 1; padding: 0 10px; white-space: nowrap; }
    .pk-stand__deskbtn svg { display: block; image-rendering: pixelated; }
    .pk-stand__shelf { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; margin-top: 1rem; }
    @media (min-width: 560px) { .pk-stand__shelf { grid-template-columns: repeat(4, 1fr); } }
    /* 👕 THE HUNG TEE — the way out to real merch, and it is scenery, not a
       panel. It takes one of the four hooks on the keeper's wall and carries
       the visitor's OWN banana, rendered by the same mockup the shop uses.
       ⚠️ A box of text below the shelf was the first attempt and it sat under
       the fold (Trym: "not just another box with text placed somewhere"). */
    /* ⚠️ IT HANGS PAST THE BOTTOM ON PURPOSE. The window clips at exactly the
       counter's top edge, so a shirt that overflows it reads as hanging on the
       wall BEHIND the desk — the counter appears to cover its hem for free.
       Tilted like its neighbours (they sit at -4°…+4°) so the wall looks hung
       by hand rather than laid out on a grid. */
    /* ⚠️ z-index ABOVE THE KEEPER. The shopkeeper is a <button> at z-index:1
       spanning 92% of the window, so its box covers this corner even though its
       canvas is transparent here — the shirt looked on top while every click
       went to the keeper ("*polishes the counter*") instead of the shop. */
    .pk-stand__tee {
      position: absolute; z-index: 2; display: block; cursor: pointer; text-decoration: none;
      transform: rotate(var(--tilt, 0deg));
      filter: drop-shadow(3px 4px 0 rgba(0,0,0,0.45));
    }
    .pk-stand__tee canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
    .pk-stand__tee:hover { transform: rotate(var(--tilt, 0deg)) translateY(-2px); }
    .pk-stand__tee:active { transform: rotate(var(--tilt, 0deg)) translateY(1px); }
    /* the sticker-pill that separates it from everything else on the wall:
       those are coins, this one is money */
    /* ⚠️ ON the hem, not below the element: the mockup canvas is SQUARE with
       transparent space under the garment, so a `bottom:-6%` pill landed past
       the window's edge and got clipped away entirely. */
    .pk-stand__tee-pill {
      position: absolute; left: 50%; bottom: 27%; transform: translateX(-50%) rotate(-5deg);
      white-space: nowrap; background: #e0322e; color: #fff;
      font-family: "Archivo Black", sans-serif; font-size: 0.52rem; letter-spacing: 0.1em;
      padding: 3px 7px; border: 2px solid #111; box-shadow: 2px 2px 0 rgba(0,0,0,0.5);
    }
    @media (prefers-reduced-motion: reduce) { .pk-stand__tee:hover { transform: none; } }
    .pk-tile {
      appearance: none; position: relative; border: 3px solid #000; background: #17121f;
      color: #fffdf5; box-shadow: 5px 5px 0 #000; cursor: pointer;
      padding: 0.55rem 0.3rem 0.5rem; display: grid; justify-items: center; gap: 0.3rem;
      font-family: inherit; transition: transform 0.08s ease;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent;
    }
    .pk-tile:active { transform: translate(2px, 2px); box-shadow: 3px 3px 0 #000; }
    .pk-tile.is-picked { outline: 3px solid #ffe135; outline-offset: 2px; }
    .pk-tile__art { height: 52px; display: flex; align-items: center; justify-content: center; }
    .pk-tile__art svg { height: 48px; width: auto; max-width: 62px; image-rendering: pixelated; }
    .pk-tile b { font-size: 0.62rem; font-weight: 700; text-align: center; line-height: 1.15; opacity: 0.9; }
    .pk-tile__slot {
      font-size: 0.5rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
      color: #b9b2d0; border: 2px solid #000; background: #241d33; padding: 0.05rem 0.3rem;
    }
    .pk-price { display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 800; color: #ffe135; }
    /* price coins smooth-downscale the 44px art — never pixelate small coins */
    .pk-tile .pk-price { font-size: 0.78rem; }
    .pk-tile .pk-price img { width: 14px; }
    .pk-tile__lock { position: absolute; top: -7px; right: -6px; width: 18px; display: none; }
    .pk-tile.is-locked .pk-tile__lock { display: block; }
    .pk-tile__lock svg { width: 100%; height: auto; image-rendering: pixelated; display: block; filter: drop-shadow(1px 1px 0 rgba(0, 0, 0, 0.6)); }
    .pk-tile__own {
      position: absolute; top: -8px; right: -6px; display: none;
      background: #37d67a; color: #06220f; border: 2px solid #000;
      font-size: 0.5rem; font-weight: 800; letter-spacing: 0.08em; padding: 0.1rem 0.3rem;
      box-shadow: 2px 2px 0 #000;
    }
    .pk-tile.is-owned .pk-tile__own { display: block; }
    .pk-tile.is-owned .pk-tile__art { filter: drop-shadow(0 0 5px rgba(55, 214, 122, 0.45)); }
    /* an already-bought community piece stays on the shelf, quieted down —
       the wall of what the community made is worth seeing either way */
    .pk-tile.is-owned.is-back { opacity: 0.55; }
    .pk-tile.is-owned.is-back .pk-price { display: none; }
    .pk-stand__head {
      font-family: "Archivo Black", sans-serif; color: #ffe135; font-size: 0.85rem;
      letter-spacing: 0.06em; margin: 1.3rem 0 0.7rem; text-transform: lowercase;
    }
    .pk-stand__spot {
      display: flex; gap: 0.9rem; align-items: center; margin-top: 1rem;
      border: 4px solid #000; box-shadow: 6px 6px 0 #000; background: #241d33; padding: 0.9rem;
    }
    .pk-stand__spot[hidden] { display: none; }
    .pk-stand__spotart {
      flex: 0 0 96px; height: 96px; display: flex; align-items: center; justify-content: center;
      border: 3px solid #000; background: #17121f;
    }
    .pk-stand__spotart svg { height: 76px; width: auto; max-width: 84px; image-rendering: pixelated; }
    .pk-stand__spotmeta { flex: 1; min-width: 0; }
    .pk-stand__spotmeta h2 { font-family: "Archivo Black", sans-serif; color: #ffe135; font-size: 1.05rem; margin: 0 0 0.2rem; }
    .pk-stand__spotmeta p { margin: 0 0 0.6rem; font-size: 0.85rem; opacity: 0.85; }
    .pk-stand__spotrow { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
    .pk-price--big { font-size: 1.15rem; }
    .pk-price--big img { width: 22px; }
    .pk-stand button.pk-btn--buy {
      flex: 0 1 auto; padding: 0.5rem 0.9rem; font-size: 0.85rem; cursor: pointer;
      border: 3px solid #000; box-shadow: 5px 5px 0 #000;
      background: #ffe135; color: #111; font-weight: 800; font-family: inherit;
    }
    .pk-stand button.pk-btn--buy.is-poor { background: #17121f; color: #fffdf5; opacity: 0.85; }
    .pk-stand button.pk-btn--buy.is-owned { background: #37d67a; color: #06220f; }
    @media (max-width: 420px) { .pk-stand__spot { flex-wrap: wrap; } .pk-stand__spotmeta { flex-basis: 100%; } }
    @media (prefers-reduced-motion: reduce) { .pk-stand__sign .pk-stand__flick { animation: none; } }

    /* ─── 🌳 THE PARK-DAY CARD — who's here + your stats + share, the bay's
       beach-day card in the park's greens; sits below the view. ─────────── */
    .pk-side {
      margin-top: 1rem; background: #14240f; border: 3px solid #000;
