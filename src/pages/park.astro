    .pk-trash--1 { width: 0.69%; aspect-ratio: 19 / 17; background-image: url('/assets/park/t-litter1.png'); }
    .pk-trash--2 { width: 0.69%; aspect-ratio: 19 / 17; background-image: url('/assets/park/t-litter2.png'); }
    .pk-trash--3 { width: 0.62%; aspect-ratio: 1; background-image: url('/assets/park/t-litter3.png'); }
    .pk-weed.is-pulled { animation: pkWeedPull 0.24s ease-in forwards; }
    @keyframes pkWeedPull {
      0% { transform: translate(-50%, -100%) rotate(0); }
