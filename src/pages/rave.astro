    /* 🫧 JELLY BOSS: a banana-density blob (28×24 grid) that bounces around
       the floor and splits when you run into it — constant idle wobble, a
       soft jelly glow, sizes by generation set inline */
    .rv-jboss {
      position: absolute; transform: translate(-50%, -50%); pointer-events: none;
      image-rendering: pixelated; filter: drop-shadow(0 3px 7px rgba(255, 77, 157, 0.4));
      animation: rvJbWob 0.9s ease-in-out infinite;
    }
    .rv-jboss svg { width: 100%; height: auto; display: block; }
    @keyframes rvJbWob {
      50% { transform: translate(-50%, -50%) scale(1.07, 0.93); }
    }
    @media (prefers-reduced-motion: reduce) { .rv-jboss { animation: none; } }
    /* 🎈 THE POP: banana-density balloons (20×30 grid) drift down from the
       rig, sway, settle into a bob — walking through one pops it */
    .rv-qballoon {
      position: absolute; width: 34px; transform: translate(-50%, -50%);
      pointer-events: none; image-rendering: pixelated;
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.35));
    }
    .rv-qballoon svg { width: 100%; height: auto; display: block; }
    /* the ceiling phase: falling INSIDE the stage block, over the LED + DJ.
       will-change keeps the fall composited — phones dropped frames on the
       repaint path and the fall read as steps, not a glide */
    .rv-qballoon--chute { z-index: 30; will-change: left, top; }
    /* 📸 PHOTO TIME: a taped frame ON the floor tiles (z under the dancers),
       the camera flash, and the LED slide that shows tonight's photo */
    .rv-photoframe {
      position: absolute; z-index: 60; pointer-events: none;
      border: 3px dashed #fffdf5;
      box-shadow: 0 0 18px rgba(255, 253, 245, 0.35), inset 0 0 24px rgba(255, 253, 245, 0.12);
      animation: rvFramePulse 1.2s ease-in-out infinite;
    }
    @keyframes rvFramePulse {
      50% { border-color: #ffe135; box-shadow: 0 0 26px rgba(255, 225, 53, 0.5), inset 0 0 30px rgba(255, 225, 53, 0.15); }
    }
    .rv-photoflash {
      position: absolute; inset: 0; z-index: 640; background: #fff; pointer-events: none;
      animation: rvPhotoFlash 0.6s steps(3) forwards;
    }
    @keyframes rvPhotoFlash { 0% { opacity: 1; } 60% { opacity: 0.5; } 100% { opacity: 0; } }
    .rv-s-photo { padding: 0; }
    .rv-s-photo img { width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; display: block; }
    @media (prefers-reduced-motion: reduce) { .rv-photoframe, .rv-photoflash { animation: none; } }
    /* 🎯 the standing instruction line — between the floor and the action bar */
    .rv-questhint {
      background: #0d0b14; border: 3px solid #ffe135; border-top-width: 0;
      color: #ffe135; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.05em;
      text-transform: uppercase; text-align: center; padding: 0.4rem 0.6rem;
    }
    .rv-questhint[hidden] { display: none; }
    .rv-emote-btn--fire { border-color: #ff9e2c; }
    .rv-emote-btn--fire:hover { background: #ff9e2c; }
    /* 🍌💨 the food fight — the throw button shares .rv-emote-btn's base look;
       these only recolour it orange + handle the cooldown state */
    .rv-throw-btn { border-color: #ff9e2c; }
    .rv-throw-btn:hover:not([disabled]) { background: #ff9e2c; }
    .rv-throw-btn[disabled] { opacity: 0.4; cursor: default; }
    /* the shot = the golden-rain crescent, tumbling + glowing (Trym's ask) */
    .rv-nade {
      position: absolute; width: 26px; height: 16px; margin: -8px 0 0 -13px;
      z-index: 350; pointer-events: none;
    }
    .rv-nade svg { width: 100%; height: 100%; filter: drop-shadow(0 0 3px #ffe135) drop-shadow(0 0 2px #fff6c8); animation: rvNadeSpin 0.5s linear infinite; }
    @keyframes rvNadeSpin { to { transform: rotate(360deg); } }
    /* the landing poof — a quick pixel pop, gone (no litter) */
    .rv-nadepop { position: absolute; width: 20px; height: 20px; margin: -10px 0 0 -10px; z-index: 340; pointer-events: none; }
    .rv-nadepop svg { width: 100%; height: 100%; animation: rvNadePop 0.35s ease-out forwards; }
    @keyframes rvNadePop { 0% { transform: scale(0.4); opacity: 1; } 100% { transform: scale(1.4); opacity: 0; } }
    /* 🎯 the target lock — four green CORNER brackets that breathe in/out
       around the banana (subtle but clearly "locked"); child of the raver
       wrap so it glides with them for free */
    .rv-lock { position: absolute; inset: 14%; pointer-events: none; z-index: 200; animation: rvLockBreathe 1.5s ease-in-out infinite; }
    .rv-lock i { position: absolute; width: 6px; height: 6px; border: 2px solid rgba(90, 224, 122, 0.85); }
    .rv-lock i:nth-child(1) { top: 0; left: 0; border-right: 0; border-bottom: 0; }
    .rv-lock i:nth-child(2) { top: 0; right: 0; border-left: 0; border-bottom: 0; }
    .rv-lock i:nth-child(3) { bottom: 0; left: 0; border-right: 0; border-top: 0; }
    .rv-lock i:nth-child(4) { bottom: 0; right: 0; border-left: 0; border-top: 0; }
    @keyframes rvLockBreathe { 0%, 100% { transform: scale(0.9); opacity: 0.7; } 50% { transform: scale(1.04); opacity: 1; } }
    /* the banana splash on a splat */
    .rv-splash { position: absolute; width: 58px; height: 58px; margin: -29px 0 0 -29px; z-index: 360; pointer-events: none; }
    .rv-splash svg { width: 100%; height: 100%; animation: rvSplashPop 0.46s ease-out forwards; }
    @keyframes rvSplashPop { 0% { transform: scale(0.35); opacity: 1; } 100% { transform: scale(1.5); opacity: 0; } }
    /* MY hit landed — a yellow confirm ring (did I hit? YES) */
    .rv-hitring {
      position: absolute; width: 30px; height: 30px; margin: -15px 0 0 -15px; z-index: 362;
      border: 3px solid #ffe135; border-radius: 50%; pointer-events: none;
      box-shadow: 0 0 8px rgba(255, 225, 53, 0.7);
      animation: rvHitRing 0.5s ease-out forwards;
    }
    @keyframes rvHitRing { 0% { transform: scale(0.35); opacity: 1; } 100% { transform: scale(1.9); opacity: 0; } }
    /* floating combat number, red '-N' (gaming-style) */
    .rv-dmg {
      position: absolute; transform: translate(-50%, 0); z-index: 363; pointer-events: none;
      font-family: "Archivo Black", sans-serif; font-size: 0.95rem; color: #ff4747;
      -webkit-text-stroke: 3px #16121f; paint-order: stroke fill; white-space: nowrap;
      animation: rvDmg 1s ease-out forwards;
    }
    .rv-dmg--good { color: #5ae07a; } /* +N when you scoop your spill back */
    @keyframes rvDmg {
      0% { opacity: 0; transform: translate(-50%, 0) scale(0.6); }
      16% { opacity: 1; transform: translate(-50%, -4px) scale(1.18); }
      100% { opacity: 0; transform: translate(-50%, -26px) scale(1); }
    }
    .rv-hitwiggle { animation: rvHitW 0.5s ease-out; }
    @keyframes rvHitW { 0% { rotate: 0deg; } 20% { rotate: -14deg; } 45% { rotate: 11deg; } 70% { rotate: -6deg; } 100% { rotate: 0deg; } }
    .rv-throwpop { animation: rvThrowP 0.25s ease-out; }
    @keyframes rvThrowP { 40% { scale: 1.12; } 100% { scale: 1; } }
    @media (prefers-reduced-motion: reduce) {
      .rv-nade svg, .rv-splash svg, .rv-nadepop svg, .rv-hitring, .rv-dmg, .rv-hitwiggle, .rv-throwpop, .rv-lock { animation-duration: 0.01s; }
    }
    .rv-stage-btn {
      background: #0d0b14; color: #fffdf5; border: 3px solid #ffe135; cursor: pointer;
      font-weight: 800; font-size: 0.7rem; letter-spacing: 0.04em; padding: 0.55rem 0.8rem;
      min-height: 48px;
      touch-action: manipulation; -webkit-tap-highlight-color: transparent; user-select: none;
