  <script>
    import '../scripts/banana-rave.js';
    import { mountHud } from '../lib/world-hud.js';
    // 🌍 THE WORLD HUD, club edition. The park and the bay let world-hud.js BUILD
    // their chips; the club hands it the ones it already has.
    // ⚠️ WHY ADOPT INSTEAD OF BUILD: the floor engine owns rvLvlRow / rvWalletChip
    // / rvCount / rvStatus and writes to them from six places, including the
    // socket's reconnect paths. Taking that over would mean editing the most
    // fragile file in the project to change nothing a visitor can see. So the HUD
    // takes the NODES, not the job — same container, same stylesheet, same look,
    // and the engine keeps updating the same ids it always did.
    // ⚠️ 'strip' layout, not 'overlay': the dancefloor is short (min(50vh,440px))
    // and an overlay would sit on the dancers' heads.
    (function () {
      const club = document.querySelector('.rv-club');
      if (!club) return;
      const count = document.getElementById('rvCount');
      const status = document.getElementById('rvStatus');
      let crowd = null;
      if (count) {
        crowd = document.createElement('span');
        crowd.className = 'wh__crowd';
        crowd.innerHTML = '<span aria-hidden="true">◍</span>';
        crowd.appendChild(count);
        // the engine writes 'live' / 'reconnecting…' / 'solo mode…' / 'open in
        // another tab' into rvStatus — it rides the crowd chip or it is unseen
        if (status) {
          crowd.insertAdjacentHTML('beforeend', '<span aria-hidden="true" class="rv-whchip__sep">·</span>');
          crowd.appendChild(status);
        }
      }
      const hud = mountHud({
        mount: club,
        layout: 'strip',
        theme: { bg: '#1c1338', border: '#3a2d63', text: '#efe9ff' },
        chips: [],
        adopt: [document.getElementById('rvLvlRow'),
                document.getElementById('rvWalletChip'),
                crowd],
      });
      // the strip belongs at the TOP of the club frame, above the booth
      if (hud) club.insertBefore(hud.el, club.firstChild);
    })();
  </script>
  <script>
    // 🕯 RETURN TO SENDER — dark until launch (see homestead.astro for the
    // full note). ?questtest sticky-on · ?questtest=off · flip QUEST_LIVE ×4.
    const QUEST_LIVE = true;
    try {
      if (/[?&]questtest=off/.test(location.search)) localStorage.removeItem('bwq-dev');
      else if (/[?&]questtest/.test(location.search)) localStorage.setItem('bwq-dev', '1');
      if (QUEST_LIVE || localStorage.getItem('bwq-dev') === '1') {
        import('../lib/world-quest.js').then((m) => m.bootQuest());
      }
    } catch (e) { /* quest is optional garnish */ }
  </script>
  <div class="rv-cut" id="rvCut" aria-hidden="true"></div>
