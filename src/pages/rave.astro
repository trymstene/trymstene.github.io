    /* the broom leaning on the counter */
    .rv-broomprop { position: absolute; width: 15px; left: 94%; top: -48px; z-index: 4; line-height: 0; filter: drop-shadow(0 0 5px rgba(255, 214, 80, 0.5)); }
    /* narrow phones: the jelly mixer's left edge reaches ~178px into a ~350px
       floor, so the desk crew compresses into the strip between the EXIT door
