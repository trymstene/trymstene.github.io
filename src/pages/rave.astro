    .rv-stat.is-on { background: #3b2c56; border-color: #ff4d9d; }
    .rv-statcap {
      flex: 1 0 100%; margin: 0.5rem 0 0; min-height: 1.05rem;
      font-size: 0.76rem; font-weight: 700; color: #b8b3c7;
    }
