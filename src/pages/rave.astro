    .rv-emote-btn[data-emote="confetti"] { display: none !important; } /* clap folds into the reaction */
    .rv-flameglyph { font-size: 1.5em; line-height: 1; }              /* the reaction button's 🔥 while on stage */

    /* the World HUD — level · coins · crowd, a strip above the LED screen
       (top of the club frame); the JELLY meter stays alone in the mixer */
    /* 🌍 the strip itself is src/lib/world-hud.js (.wh / .wh--strip). Left here:
       the club's own band chrome, and the shape of the two chips the HUD ADOPTS
       rather than builds — the engine still owns those nodes. */
    .rv-club > .wh--strip { background: #120b22; border-bottom: 2px solid #2a1f4d; }
    .wh .rv-wallet img { width: 16px; height: 16px; }
    .wh .rv-mixer__lvl { display: flex; align-items: center; gap: 6px; color: #ffe135; border-color: #ffe135 !important; }
    .wh .rv-mixer__lvlbar { flex: 0 0 46px; min-width: 46px; height: 6px; }
