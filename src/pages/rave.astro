      /* ⚠️ NO flex:1 STRETCH any more — the buttons keep their own size on a
         phone exactly like the park's and the bay's do, so all three action
         bars read as the same control surface. */
      .rv-emotes { flex: 1 1 100%; justify-content: center; }
