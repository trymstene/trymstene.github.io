    /* ⚠️ …and while you are inside it, THE BAY STOPS. The scene is opaque and
       covers the whole view, so every sprite behind it was drawing for nobody
       — and the shy runs its OWN loop on top, so that was two worlds at once.
       Nothing else on this page sets `visibility`, and the only layout reads
       are on .bh-view itself, so hiding the layer is safe. The JS ticks stand
       down too (banana-beach.js); the presence socket keeps its own beat. */
    body.bh-inside .bh-world { visibility: hidden; }

    /* 🥥 COCONUT SHY — a full interior scene laid over the beach view. */
    .bh-coco {
      position: absolute; inset: 0; z-index: 40; display: flex; flex-direction: column;
      background: #17110a; overflow: hidden;
    }
    .bh-coco[hidden] { display: none; }
    .bh-coco__awning { display: flex; height: 20px; flex: 0 0 auto; border-bottom: 3px solid #000; }
    .bh-coco__awning span { flex: 1; }
    .bh-coco__awning span:nth-child(odd) { background: #e23b3b; }
    .bh-coco__awning span:nth-child(even) { background: #fdf6e6; }
    .bh-coco__hud {
      position: absolute; top: 28px; left: 8px; right: 8px; z-index: 6;
      display: flex; align-items: center; gap: 0.45rem; pointer-events: none;
    }
    .bh-coco__hud .bh-tix,
    .bh-coco__coins {
      background: rgba(0, 0, 0, 0.5); border: 2px solid #000; padding: 0.14rem 0.45rem;
      font-weight: 800; font-size: 0.82rem; color: #ffe135;
    }
    .bh-coco__hud .bh-x { margin-left: auto; pointer-events: auto; }
    .bh-coco__stage {
      position: relative; flex: 1 1 auto; overflow: hidden;
      background:
        linear-gradient(rgba(0, 0, 0, 0.34), rgba(0, 0, 0, 0.04) 42%),
        repeating-linear-gradient(90deg, #6b5617 0 24px, #4a3a0d 24px 27px, #63500f 27px 51px, #4a3a0d 51px 54px);
    }
    /* z-index 5 puts the pitch (and its ball / coconuts / aim children) ABOVE
       the keeper canvas (z3) and the desk (z4). The keeper's big transparent
       canvas overlays the whole pitch, so without this the ball sat behind it
       and drags couldn't reach the pitch. */
    .bh-coco__pitch {
      position: absolute; inset: 0; z-index: 5;
      touch-action: none; cursor: grab; -webkit-tap-highlight-color: transparent;
    }
    .bh-coco__pitch:active { cursor: grabbing; }
    /* one ball flies at a time — say so with the cursor too, or a mid-flight
       drag is indistinguishable from a dead control */
    .bh-coco__pitch.is-waiting,
    .bh-coco__pitch.is-waiting:active { cursor: progress; }
    /* the shelf the coconuts sit on */
    .bh-coco__rail {
      position: absolute; left: 5%; right: 5%; height: 9px;
      background: #4a3820; border: 2px solid #000; box-shadow: 0 3px 0 rgba(0, 0, 0, 0.45);
    }
    .bh-coco__post {
      position: absolute; width: 7px; transform: translateX(-50%);
      background: linear-gradient(#7a5a2e, #543a1a); border: 2px solid #000; z-index: 1;
    }
    .bh-coco__coco {
      position: absolute; width: 36px; height: 36px; transform: translate(-50%, -50%);
      z-index: 2; image-rendering: pixelated; will-change: transform, left, top;
    }
    .bh-coco__coco svg { width: 100%; height: 100%; display: block; }
    .bh-coco__ball {
      position: absolute; width: 44px; height: 44px; transform: translate(-50%, -50%);
      z-index: 6; image-rendering: pixelated; filter: drop-shadow(1px 2px 0 rgba(0, 0, 0, 0.4));
    }
    .bh-coco__ball svg { width: 100%; height: 100%; display: block; }
    /* the drag-aim guide: a row of dots tracing the ball's CURVED flight path */
    .bh-coco__aimdot {
      position: absolute; width: 9px; height: 9px; border-radius: 50%;
      background: rgba(255, 225, 53, 0.92); transform: translate(-50%, -50%);
      pointer-events: none; z-index: 5; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35);
    }
    .bh-coco__aimdot[hidden] { display: none; }
    /* the keeper — BIG and far left, so it reads as standing WITH him at the
       counter (the banana-stand scale), not a doll in a giant shed. The drawn
       banana only fills ~52% of its square canvas (transparent padding), and
       sits at 45% across / feet at 85% down — so the canvas is displayed LARGE
       (~288px → a ~150px banana) and shifted left to land the banana far-left,
       feet behind the counter. Independent of the exterior CSS entirely. */
    /* size + left + bottom are set in JS (layoutCocoVendor) from the stage
       size and the banana's measured bbox, so the WAIST pins to the counter
       top and the keeper is ~2× — the transparent canvas padding makes CSS %
       sizing lie about the banana's real size, so JS drives it. */
    .bh-coco__vendor {
      position: absolute; left: 0; bottom: 0; width: 240px;
      z-index: 3; pointer-events: none;
    }
    .bh-coco__vendor canvas { width: 100%; height: auto; image-rendering: pixelated; display: block; }
    /* a full-width counter across the bottom; the keeper stands behind it */
    .bh-coco__desk {
      position: absolute; left: 0; right: 0; bottom: 0; height: 34px; z-index: 4; pointer-events: none;
      background: repeating-linear-gradient(90deg, #3a2b18 0 24px, #2c2113 24px 48px);
      border-top: 5px solid #4a3820; box-shadow: inset 0 4px 0 rgba(0, 0, 0, 0.35);
    }
    .bh-coco__toast {
      position: absolute; left: 50%; top: 12%; transform: translateX(-50%); z-index: 7;
      font-family: "Archivo Black", sans-serif; font-size: 1.15rem; color: #ffe135;
      text-shadow: 2px 2px 0 #000; pointer-events: none; animation: bhCocoToast 0.9s ease-out forwards;
    }
    @keyframes bhCocoToast { to { transform: translate(-50%, -26px); opacity: 0; } }
    .bh-coco__foot { flex: 0 0 auto; padding: 0.55rem 0.8rem; display: grid; min-height: 44px; align-content: center; }
    .bh-coco__foot .bh-btn { margin-top: 0; width: 100%; }
    .bh-coco__back { flex: 0 0 auto; width: auto; margin: 0 0.8rem 0.7rem; }
    @media (prefers-reduced-motion: reduce) {
      .bh-coco__toast { animation: none; }
    }

    /* ─── 🏖 THE BEACH HUT INTERIOR — the park merch shop's room, ported to
       the bay. Same anatomy on purpose (Trym: "same shop-menu as the banana
       stand"): striped awning, plank back wall with the goods HUNG on it, the
       keeper big behind a counter. The palette is the hut's own exterior —
       sea-teal awning over driftwood planks — so walking in feels like walking
       into the building you just tapped. ── */
    .bh-hut {
      position: absolute; inset: 0; z-index: 40; display: flex; flex-direction: column;
      background: #17110a; overflow: hidden;
    }
    .bh-hut[hidden] { display: none; }
    .bh-hut__awning { display: flex; height: 20px; flex: 0 0 auto; border-bottom: 3px solid #000; }
    .bh-hut__awning span { flex: 1; }
    .bh-hut__awning span:nth-child(odd) { background: #2c8e8c; }
    .bh-hut__awning span:nth-child(even) { background: #f7ebcd; }
    /* ⚠️ THE × SITS IN THE AWNING, not over the wall: at the park's
       top:28px/right:8px it landed straight on the third good's price tag,
       which on a phone-width pane is only ~40px from the edge. */
    .bh-hut__x { position: absolute; top: 0; right: 6px; width: 32px; height: 30px; z-index: 6; pointer-events: auto; }
    .bh-hut__wall {
      position: relative; flex: 1 1 auto; overflow: hidden;
      background:
        linear-gradient(rgba(0, 0, 0, 0.34), rgba(0, 0, 0, 0.05) 45%),
        repeating-linear-gradient(90deg, #6b5030 0 24px, #4a3620 24px 27px, #61492c 27px 51px, #4a3620 51px 54px);
    }
    /* the wares, hung high on the planks — each on a nail with a string */
    .bh-hut__goods {
      position: absolute; left: 0; right: 0; top: 40px; z-index: 2;
      display: flex; justify-content: space-evenly; align-items: flex-start; padding: 0 4px;
    }
    .bh-hang {
      position: relative; display: grid; justify-items: center; gap: 3px;
      text-decoration: none; color: #fffdf5; padding-top: 14px; cursor: pointer;
    }
    .bh-hang::before {   /* the nail */
      content: ''; position: absolute; top: 0; left: 50%; width: 5px; height: 5px;
      transform: translateX(-50%); background: #1c1610; border-radius: 50%;
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25);
    }
    .bh-hang::after {    /* the string */
      content: ''; position: absolute; top: 4px; left: 50%; width: 2px; height: 11px;
      transform: translateX(-50%); background: rgba(240, 230, 200, 0.55);
    }
    .bh-hang:hover .bh-hang__mock, .bh-hang:focus-visible .bh-hang__mock { outline: 2px solid #ffe135; outline-offset: 1px; }
    .bh-hang:active { transform: translateY(2px); }
    .bh-hang__mock {
      width: 78px; height: 78px; display: grid; place-items: center;
      border: 3px solid #000; overflow: hidden; box-shadow: 3px 4px 0 rgba(0, 0, 0, 0.45);
    }
    .bh-hang__mock canvas { width: 66px; height: 66px; image-rendering: pixelated; display: block; }
    .bh-hang--sticker .bh-hang__mock { background: #f4f1e8; }
    .bh-hang--sticker canvas {
      filter: drop-shadow(2px 0 0 #fff) drop-shadow(-2px 0 0 #fff)
              drop-shadow(0 2px 0 #fff) drop-shadow(0 -2px 0 #fff)
              drop-shadow(1px 2px 0 rgba(0, 0, 0, 0.25));
    }
    /* mug: makeMugMockup draws the whole ceramic — no die-cut contour here */
    .bh-hang--mug .bh-hang__mock { background: #f4f1e8; }
    .bh-hang--mug canvas { width: 62px; height: 62px; }
    .bh-hang--tee .bh-hang__mock { background: #1c2233; }
    .bh-hang--tee canvas { width: 40px; height: 40px; }
    .bh-hang__tag {
      position: absolute; top: 8px; right: -7px; z-index: 2; font-style: normal;
      background: #ffe135; color: #10240f; border: 2px solid #000;
      font-weight: 800; font-size: 0.62rem; line-height: 1; padding: 2px 4px;
      transform: rotate(6deg); box-shadow: 1px 2px 0 rgba(0, 0, 0, 0.4); white-space: nowrap;
    }
    .bh-hang b { font-size: 0.6rem; font-weight: 800; text-align: center; line-height: 1.15; text-shadow: 1px 1px 0 #000; white-space: nowrap; }
    /* ⚠️ NO SEPARATE SHIPPING STRIP on the wall. The park hangs one at a fixed
       top:168px, which on this portrait pane lands inside the speech bubble's
       band — and the wall is only ~400px tall here, so goods + strip + bubble
       + a full-height keeper cannot all fit above her hat. The promise moved
       onto the counter sign instead, which came out SHORTER for it. */
    /* Palma — big behind the counter, feet clipped by the wall's bottom edge */
    .bh-hut__keeper {
      appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
      position: absolute; left: 50%; bottom: -74px; transform: translateX(-50%);
      width: min(360px, 86%); z-index: 3;
    }
    .bh-hut__keeper canvas { display: block; width: 100%; height: auto; image-rendering: pixelated; }
    /* ⚠️ 34% is a FLOOR, not a preference: below it the bubble's box drops onto
       Palma's hat brim. (It looked wrong at 34% until the shipping strip moved
       down — the strip was the collision, not the bubble.) */
    .bh-hut__bubble {
      position: absolute; left: 6px; bottom: 34%; z-index: 5;
      max-width: 46%; background: #fffdf5; color: #111; border: 3px solid #000;
      filter: drop-shadow(3px 3px 0 #000); padding: 0.35rem 0.5rem;
      font-size: 0.6rem; font-weight: 800; letter-spacing: 0.04em;
      text-transform: uppercase; line-height: 1.5;
      opacity: 0; transition: opacity 0.2s ease; pointer-events: none;
    }
    .bh-hut__bubble.is-on { opacity: 1; }
    .bh-hut__counter {
      flex: 0 0 64px; position: relative; border-top: 4px solid #000; z-index: 4;
      background: repeating-linear-gradient(90deg, #43331d 0 26px, #332616 26px 52px);
      display: grid; place-items: center; padding: 0 0.5rem;
    }
    .bh-hut__counter::before {
      content: ''; position: absolute; inset: 0 0 auto; height: 8px;
      background: #a87c46; border-bottom: 3px solid #000;
    }
    .bh-hut__sign {
      background: #8a5a2b; border: 2px solid #3a230f; color: #ffe7a0;
      font-size: 0.62rem; font-weight: 800; line-height: 1.4; text-align: center;
      padding: 0.3rem 0.55rem; box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
      transform: rotate(-0.5deg); max-width: 100%;
    }
    .bh-hut__back { flex: 0 0 auto; width: auto; margin: 0.55rem 0.8rem 0.7rem; }

    /* 🍹 PALMA IN THE WINDOW, outdoors — the stand-keeper treatment on the
       hut's own opening. Set dressing only: the building stays the tap target,
       so pointer-events are off and the box is clipped to HUT.win. */
    .bh-hutnpc { position: absolute; overflow: hidden; pointer-events: none; }
    .bh-hutnpc canvas {
      display: block; width: 100%; height: auto;
      image-rendering: pixelated; margin-top: -13%;
    }

    /* ─── 🏖 THE BEACH-DAY CARD — who's here + your stats + share, the beach's
       answer to the rave's side panel. Warm sunset palette instead of club
       purple; sits below the view so it works in the bay's single column. ── */
    .bh-side {
      margin-top: 1rem; background: #1e1408; border: 3px solid #000;
      box-shadow: 6px 6px 0 #000; padding: 0.9rem 1rem 1.1rem; color: #fffdf5;
    }
    .bh-side h2 {
      margin: 0 0 0.55rem; font-size: 0.95rem; color: #ffd98a; letter-spacing: 0.02em;
    }
    /* ⚠️ who is here and what YOU did are two different things — they were
       running together into one wall of boxes (Trym: cramped) */
    .bh-side__h2 {
      margin-top: 1.5rem; padding-top: 1.1rem;
      border-top: 2px solid rgba(255, 255, 255, 0.08);
    }
    .bh-roster { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.32rem; }
    .bh-roster li {
      display: flex; justify-content: space-between; gap: 0.6rem; align-items: center;
      font-size: 0.82rem; font-weight: 700; padding: 0.3rem 0.55rem;
      background: #2a1c0c; border: 2px solid #000;
    }
    .bh-roster li.is-you { color: #ffe135; }
    .bh-roster__tag { font-size: 0.6rem; opacity: 0.8; font-weight: 800; letter-spacing: 0.04em; }
    /* 🎮 THE DAY BADGES — the park's, in the bay's sands. Content-sized
       pills that wrap, so the card is as big as its numbers instead of a
       two-column grid of full-width rows with a lake of space on desktop.
       ⚠️ the label is behind a TAP, never a title attribute (invisible on a
       phone, and this world is 85% phones). */
    .bh-daystats { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.1rem; }
    .bh-stat {
      display: inline-flex; align-items: center; gap: 0.42rem; cursor: pointer;
      padding: 0.44rem 0.72rem; border: 2px solid #000; border-radius: 999px;
      background: #2a1c0c; color: #ffe9cf; font-family: inherit;
      box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.45);
    }
    .bh-stat i { font-style: normal; font-size: 1rem; line-height: 1; }
    .bh-stat b { color: #ffe135; font-size: 1.02rem; font-variant-numeric: tabular-nums; }
    .bh-stat.is-time b { color: #ff9d4d; }
    .bh-stat:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.45); }
    .bh-stat.is-on { background: #45300f; border-color: #ff9d4d; }
    .bh-statcap {
      flex: 1 0 100%; margin: 0.5rem 0 0; min-height: 1.05rem;
      font-size: 0.76rem; font-weight: 700; color: #c8a887;
    }
    .bh-sharebtn {
      appearance: none; width: 100%; margin-top: 0.95rem; cursor: pointer; font-family: inherit;
      background: #ffe135; color: #111; border: 3px solid #000; box-shadow: 3px 3px 0 #000;
      font-weight: 800; font-size: 0.92rem; padding: 0.6rem;
      display: flex; align-items: center; justify-content: center; gap: 0.4rem;
    }
    .bh-sharebtn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .bh-door { margin-top: 0.7rem; }
    .bh-door a {
      display: block; text-align: center; padding: 0.55rem; font-weight: 800; font-size: 0.9rem;
      color: #fffdf5; background: #2a1c0c; border: 3px solid #000; text-decoration: none;
    }
    .bh-door a:hover { background: #38260f; }
    .bh-sidenote { margin: 0.75rem 0 0; font-size: 0.72rem; opacity: 0.82; line-height: 1.45; }
    .bh-sidenote a { color: #ffd98a; }

    /* the share-card lightbox — same pattern as the rave's, beach-dressed */
    .bh-sharemodal {
      position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center;
      justify-content: center; background: rgba(8, 5, 2, 0.82); padding: 1rem;
    }
    .bh-sharemodal[hidden] { display: none; }
    .bh-sharemodal__box {
      position: relative; max-width: min(88vw, 520px); width: 100%;
      background: #1e1408; border: 4px solid #ffe135; box-shadow: 10px 10px 0 #000; padding: 0.9rem;
    }
