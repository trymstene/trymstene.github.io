    .bh-sharemodal__row { display: flex; gap: 0.5rem; margin-top: 0.7rem; flex-wrap: wrap; }
    .bh-sharemodal__row button {
      flex: 1; min-width: 130px; appearance: none; cursor: pointer; font-family: inherit;
      font-weight: 800; font-size: 0.82rem; padding: 0.5rem; gap: 0.35rem;
