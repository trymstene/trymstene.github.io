      display: flex; align-items: center; justify-content: center;
    }
    .bh-sharemodal__row button:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #000; }
    .bh-sharemodal__close {
      position: absolute; top: -18px; right: -18px; width: 40px; height: 40px;
      background: #ffe135; color: #111; border: 3px solid #111; font-weight: 800;
      font-size: 1.2rem; cursor: pointer;
    }
  </style>

  <div class="bh-wrap">
    <h1 class="bh-sign">🏖 BANANA BAY</h1>
    <p class="bh-tag">the sun never quite sets here</p>

    <!-- the map + its action band in ONE bordered frame (the Rave's .rv-club
         shape): the action bar is a band BELOW the map, never over the play. -->
    <div class="bh-stage">
    <div class="bh-view" id="bhView">
