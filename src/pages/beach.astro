      <!-- 🌍 THE WORLD HUD is built by src/lib/world-hud.js — LEVEL · COINS ·
           TICKETS · rally · CROWD. Shell/fish stats stay with their NPCs
           (Shelly & Gil) — walk up to them to see your collection. -->
      <div class="bh-hint" id="bhHint">tap to walk · tap the ball · hit ⛏ Dig (or Space) to dig</div>
      <div class="bh-exitstrip" id="bhExitStrip" role="status" aria-live="polite"></div>

      <!-- 🎡 THE STALL VIEW — one frame, every stall. Name + tickets in the
           header, the game in the middle, cost/PLAY in the footer. It's a
           view state over the live beach, never a route. -->
      <div class="bh-panel bh-panel--stall" id="bhStallPanel" hidden>
        <div class="bh-card bh-card--stall" role="dialog" aria-label="Midway stall">
          <div class="bh-stallhead">
            <h3 id="bhStallName"></h3>
            <span class="bh-tix" id="bhStallTickets">🎟 0</span>
            <button class="bh-x" id="bhStallClose" type="button" aria-label="Leave the stall">×</button>
          </div>
          <div class="bh-stallbody" id="bhStallBody"></div>
          <div class="bh-stallfoot" id="bhStallFoot"></div>
        </div>
      </div>

      <!-- 🏴 THE TREASURE reward panel (historic chest ids). Tickets are shown
           as SLOTS, not a total: the same haul split into piles reads as
           treasure instead of a receipt. -->
      <div class="bh-panel" id="bhChestPanel" hidden>
        <div class="bh-card bh-card--chest" role="dialog" aria-label="Treasure chest">
          <img class="bh-chesthero" src="/assets/banana-stand/chest.png" width="88" alt="" aria-hidden="true" />
          <h3 class="bh-chesth" id="bhChestH">a buried chest</h3>
          <p class="bh-chestsub" id="bhChestSub"></p>
          <div class="bh-cslots" id="bhChestSlots"></div>
          <button class="bh-btn" id="bhChestBtn" type="button"></button>
        </div>
      </div>

      <div class="bh-panel" id="bhShellPanel" hidden>
        <div class="bh-card bh-card--npc" role="dialog" aria-label="Shelly's shell collection">
          <div class="bh-npcpop" aria-hidden="true"><canvas id="bhShellyPortrait" width="195" height="195"></canvas></div>
          <button class="bh-cardx" id="bhShellClose" type="button" aria-label="close">✕</button>
          <h2>shelly</h2>
          <p id="bhShellSub" class="bh-panel__sub">washed up on the tide.</p>
          <div class="bh-grid" id="bhShellGrid"></div>
        </div>
      </div>

      <!-- 🏴‍☠️ CAPTAIN SABREFACE'S DESK — the buried-treasure hunt. Kept lean:
           his map + one line, no wall of rules (the ✕ closes it, backdrop too). -->
      <div class="bh-panel" id="bhDigPanel" hidden>
        <div class="bh-card bh-card--npc" role="dialog" aria-label="Captain Sabreface's desk">
          <div class="bh-npcpop" aria-hidden="true"><canvas id="bhCapPortrait" width="195" height="195"></canvas></div>
          <button class="bh-cardx" id="bhDigClose" type="button" aria-label="close">✕</button>
          <h2>captain sabreface</h2>
          <p id="bhDigSay">"treasure's buried on this bay, matey."</p>
          <canvas class="bh-digmap" id="bhDigMap" width="450" height="180" aria-label="the torn treasure map"></canvas>
          <p class="bh-mapclue" id="bhDigClue"></p>
          <div class="bh-diglog" id="bhDigLog"></div>
        </div>
      </div>

      <!-- 🐟 GIL'S LEDGER — the fish collection. Silhouettes for what you
           haven't caught (a visible gap is the whole engine of a collection),
           rarity colour + your personal best on what you have. -->
      <div class="bh-panel" id="bhLedger" hidden>
        <div class="bh-card bh-card--npc" role="dialog" aria-label="Gil's fish ledger">
          <div class="bh-npcpop" aria-hidden="true"><canvas id="bhGilPortrait" width="195" height="195"></canvas></div>
          <button class="bh-cardx" id="bhLedgerClose" type="button" aria-label="close">✕</button>
          <h2>gil’s ledger</h2>
          <p id="bhLedgerSub" class="bh-panel__sub"></p>
          <div class="bh-ledgerbar"><i id="bhLedgerFill"></i></div>
          <p id="bhLedgerNext" class="bh-tradestat"></p>
          <div class="bh-fishgrid" id="bhFishGrid"></div>
        </div>
      </div>

      <!-- 🔎 THE SPECIMEN CARD — tap any shell or fish to flip it up close.
           Replaces the old title= hovers (dead on touch): a big pixel preview,
           its rarity, how many you've found, and the keeper's note. ONE card,
           shared by both boards, sits above the collection grids. -->
      <div class="bh-panel bh-panel--detail" id="bhDetail" hidden>
        <div class="bh-detailcard" role="dialog" aria-label="Specimen details">
          <button class="bh-detailcard__x" id="bhDetailClose" type="button" aria-label="close">✕</button>
          <div class="bh-detailcard__art"><i id="bhDetailSprite" aria-hidden="true"></i></div>
          <span class="bh-tierpill" id="bhDetailTier"></span>
          <h3 class="bh-detailcard__name" id="bhDetailName"></h3>
          <p class="bh-detailcard__have" id="bhDetailHave"></p>
          <p class="bh-detailcard__desc" id="bhDetailDesc"></p>
        </div>
      </div>

      <!-- 🎣 the fishing catch reveal -->
      <div class="bh-panel" id="bhFishCatch" hidden>
        <div class="bh-card bh-card--catch" role="dialog" aria-label="Your catch">
          <h2>on the line!</h2>
          <div class="bh-catch" id="bhCatchBody"></div>
          <button class="bh-btn" id="bhCatchGo" type="button">cast again</button>
          <button class="bh-btn bh-btn--dark" id="bhCatchLeave" type="button">leave the dock</button>
        </div>
      </div>

      <!-- 🥥 COCONUT SHY — the one stall you step INSIDE. A full interior scene
           over the beach (banana-stand's counter, pier edition): striped awning,
           the keeper at his desk on the left, the coconut pitch front-and-centre.
           Drag back from the ball and release to fling. -->
      <div class="bh-coco" id="bhCoco" role="dialog" aria-label="Coconut Hut" hidden>
        <div class="bh-coco__awning" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="bh-coco__hud">
          <span class="bh-tix" id="bhCocoTix">🎟 0</span>
          <span class="bh-coco__coins">🪙 <span id="bhCocoCoins">0</span></span>
          <button class="bh-x" id="bhCocoClose" type="button" aria-label="Leave the stall">×</button>
        </div>
        <div class="bh-coco__stage">
          <div class="bh-coco__pitch" id="bhCocoPitch"></div>
          <div class="bh-coco__vendor" aria-hidden="true"><canvas id="bhCocoVendorCv" width="360" height="360"></canvas></div>
          <div class="bh-coco__desk" aria-hidden="true"></div>
        </div>
        <div class="bh-coco__foot" id="bhCocoFoot"></div>
        <button class="bh-btn bh-coco__back" id="bhCocoBack" type="button">🏖 back to the beach</button>
      </div>

      <!-- 🏖 THE BEACH HUT — the bay's one real-money room. Same interior the
           park's merch shop uses (awning, plank wall with the goods HUNG on
           it, the keeper big behind the counter), in the bay's key: Trym's
           "same shop-menu as the banana stand… make the wares in the interior
           stand out in the background of the shopkeeper". -->
      <div class="bh-hut" id="bhHut" role="dialog" aria-label="The Beach Hut" hidden>
        <div class="bh-hut__awning" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <button class="bh-x bh-hut__x" id="bhHutClose" type="button" aria-label="Leave the Beach Hut">×</button>
        <div class="bh-hut__wall">
          <div class="bh-hut__goods" id="bhHutGoods"></div>
          <div class="bh-hut__bubble" id="bhHutBubble" role="status" aria-live="polite"></div>
          <button class="bh-hut__keeper" id="bhHutKeeper" type="button" aria-label="talk to Palma">
            <canvas id="bhHutKeeperCv" width="360" height="360"></canvas>
          </button>
        </div>
        <div class="bh-hut__counter">
          <span class="bh-hut__sign">🚚 the one real thing on this bay — printed &amp; posted to your door</span>
        </div>
        <button class="bh-btn bh-hut__back" id="bhHutBack" type="button">🏖 back to the beach</button>
      </div>
    </div><!-- /.bh-view -->

    <!-- 🎮 THE ACTION BAR — the Rave's control band, beach edition: an in-flow
         band BELOW the map, inside the same frame. React · ⛏ Dig · Sound. -->
    <div class="bh-actions" aria-label="beach actions">
      <button class="bh-act bh-act--icon" id="bhEmote" type="button" aria-label="react"><PixelIcon name="heart" size="1.25em" /></button>
      <button class="bh-act bh-act--dig" id="bhDigBtn" type="button" aria-label="dig">⛏ Dig</button>
      <button class="bh-act bh-act--icon" id="bhAudio" type="button" aria-label="sound" aria-pressed="false">🔇</button>
    </div>
    </div><!-- /.bh-stage -->

    <!-- 🏖 THE BEACH-DAY CARD: who's on the beach, your day's stats, and a
         shareable postcard — the beach's version of the rave's side panel. -->
    <aside class="bh-side">
      <h2>🏖 on the beach</h2>
      <ol class="bh-roster" id="bhRoster"><li class="is-you"><span>you</span><span class="bh-roster__tag">YOU</span></li></ol>
      <h2 class="bh-side__h2">your beach day</h2>
      <div class="bh-daystats" id="bhDayStats"></div>
      <button class="bh-sharebtn" id="bhShareDay" type="button">📸 share my beach day</button>
      <div class="bh-door"><a href="/make-a-banana/" data-place="beach">Dress your banana →</a></div>
      <p class="bh-sidenote">Everyone here is a real visitor. Walk with the arrow keys / WASD or tap the sand — tap the ball to play it, hit ⛏ Dig to dig for treasure.</p>
    </aside>

    <div class="bh-foot" id="bhFoot">
      <a class="bh-btn" href="/park/?beach" data-place="beach">🌳 back to the park</a>
    </div>

    <!-- ===== below the bay: the field guide (short, visual — see park.astro) ===== -->
    <div class="bhg">
      <section class="bhg__block" id="what">
        <p class="bhg__kicker">the fine print, in sand</p>
        <h2>what is this place?</h2>
        <p>
          The bay is the park&rsquo;s lazy east end &mdash; a beach where the sun never quite sets.
          <strong>Free, in the browser, no account</strong> &mdash; and every banana on the sand is a real
          visitor, live.
        </p>
      </section>

      <section class="bhg__block" id="do">
        <p class="bhg__kicker">the loop</p>
        <h2>what do you actually do here?</h2>
        <div class="bhg__grid">
          <article class="bhg__card">
            <div class="bhg__thumb"><i style="width:16px;height:16px;background-image:url(/assets/beach/fish.png);transform:scale(3)"></i></div>
            <h3>fish</h3>
            <p>Cast from the pier, reel on the bite. The rarest ones fight back.</p>
          </article>
          <article class="bhg__card">
            <div class="bhg__thumb"><img src="/assets/beach/dig-patch.png" alt="a diggable sand patch — beach pixel sprite" loading="lazy" /></div>
            <h3>dig</h3>
            <p>&#9935; patches in the sand hide shells and better. First shovel wins.</p>
          </article>
          <article class="bhg__card">
            <div class="bhg__thumb"><i style="width:16px;height:16px;background-image:url(/assets/beach/shells.png);transform:scale(3)"></i></div>
            <h3>shells</h3>
            <p>The tide leaves them on the sand &mdash; collect the lot.</p>
          </article>
          <article class="bhg__card">
            <div class="bhg__thumb"><i style="width:28px;height:28px;background-image:url(/assets/beach/volleyball.png);transform:scale(2)"></i></div>
            <h3>rally</h3>
            <p>Tap the ball, keep it up &mdash; the whole beach counts the rally together.</p>
          </article>
          <article class="bhg__card">
            <div class="bhg__thumb"><img src="/assets/beach/pier.png" alt="the pier — beach pixel sprite" loading="lazy" /></div>
            <h3>the grabber</h3>
            <p>The machine on the pier: coins in, claw down, prizes up to the giant plush.</p>
          </article>
        </div>
        <p style="margin-top:1.2rem">
          Everything you earn lands on <a href="/pass/">your pass</a>. <a href="/park/?beach">The park</a> is
          one road west; <a href="/rave/">the rave</a> is past it.
        </p>
      </section>
    </div>
  </div>

  <!-- 📸 the share-card lightbox (our own preview, not the OS sheet) -->
  <div class="bh-sharemodal" id="bhShareModal" hidden>
    <div class="bh-sharemodal__box">
      <button class="bh-sharemodal__close" id="bhShareClose" aria-label="Close">×</button>
      <div class="bh-sharemodal__card" id="bhShareSlot"></div>
      <div class="bh-sharemodal__row">
        <button id="bhShareDl">⬇ download</button>
        <button id="bhShareCopy">⧉ copy image</button>
        <button id="bhShareSys" hidden>share…</button>
      </div>
    </div>
  </div>

  <div class="bh-cut" id="bhCut" aria-hidden="true"></div>

  <script>
    import '../scripts/banana-beach.js';
  </script>
  <script>
    // 🕯 RETURN TO SENDER — dark until launch (see homestead.astro for the
    // full note). ?questtest sticky-on · ?questtest=off · flip QUEST_LIVE ×4.
    const QUEST_LIVE = true;
    try {
      if (/[?&]questtest=off/.test(location.search)) localStorage.removeItem('bwq-dev');
      else if (/[?&]questtest/.test(location.search)) localStorage.setItem('bwq-dev', '1');
      if (QUEST_LIVE || localStorage.getItem('bwq-dev') === '1') {
        import('../lib/world-quest.js').then((m) => m.bootQuest());
      }
    } catch (e) { /* quest is optional garnish */ }
  </script>
</BaseLayout>
