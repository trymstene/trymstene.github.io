        <div class="bh-capbubble" id="bhGilBubble" role="status" aria-live="polite"></div>
        <!-- 🐚 SHELLY — keeps the shell board up the beach -->
        <div class="bh-cap bh-shelly" id="bhShelly"><canvas id="bhShellyCv" width="150" height="150" aria-hidden="true"></canvas></div>
        <div class="bh-capbubble" id="bhShellyBubble" role="status" aria-live="polite"></div>
