---
// 🍌 BANANA MAIL™ — the executive correspondence system. Trym's private inbox
// client for worker-contact: token-gated (fragment or localStorage, never in
// the page source), noindex, absent from the sitemap allowlist. Over-the-top
// corporate-mailroom theme on purpose — it's the admin room of a banana empire.
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Banana HQ';
const description = 'Authorized banana personnel only.';
---
<BaseLayout title={title} description={description} showFooter={false} robots="noindex">
  <style is:inline slot="head">
    /* 🧁 THE SOFT PASS, HQ EDITION (Trym, 13 Aug — "same design revision as
       Pulse"): paper/ink hard-shadow boxes → rounded DARK cards, one accent
       per department (mail cool, gallery purple, names orange, items hot,
       users green, world banana), pill chips, KPI colour cycle. Class names
       and layout rules untouched — this is a reskin, the JS never noticed. */
    body { background: #0d0b16; }
    .bm-wrap {
      --hbg: #0d0b16; --hpanel: #171326; --hcard: #1c1631; --hline: #292144;
      --hink: #f4eeff; --hdim: #9a90b8; --hinput: #0a0814;
      --nana: #ffe135; --hot2: #ff5d8f; --ok: #5ee08a; --cool: #5ec8e0;
      --purp: #c99cff; --org: #ffb45e;
      max-width: 820px; margin: 0 auto; padding: 1.1rem 0.9rem 4rem; color: var(--hink);
      color-scheme: dark;   /* form-control chrome (textarea scrollbars, selects) matches */
    }
    /* 🫧 THE SOFTER PASS (3 Sep 2026, Trym: "less boxy, softer modern look").
       Hard 2px lines were doing the grouping; air, a lifted surface and one
       hairline do it now. Radii go up, padding goes up, the ink stays. Class
       names are untouched — this is a reskin and the JS never noticed. */
    .bm-wrap .bm-mail, .bm-wrap .bm-gate, .bm-wrap .bm-card, .bm-wrap .bm-row,
    .bm-wrap .bm-box, .bm-wrap .bm-user, .bm-wrap .bm-kpi {
      border-color: rgba(244, 238, 255, 0.07) !important;
      border-width: 1px !important;
      border-radius: 18px;
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.03) inset, 0 6px 18px rgba(0, 0, 0, 0.28);
    }
    .bm-wrap .bm-mail { border-left-width: 1px !important; }
    .bm-wrap .bm-chip { border-color: rgba(244, 238, 255, 0.09); border-width: 1px; }
    .bm-wrap .bm-tab { border-width: 1px; border-color: rgba(244, 238, 255, 0.08); border-radius: 999px; }
    .bm-wrap input, .bm-wrap select, .bm-wrap textarea {
      border-width: 1px !important; border-color: rgba(244, 238, 255, 0.1) !important; border-radius: 14px; }

    /* 📈 THE WORLD DESK. One column on a phone, two where there is room.
       Colour does one job at a time: identity for areas and faucets, ink for a
       lone series, and the status hues are reserved for state. */
    /* ⚠️ THE SCALE HANGS ON .bm-wrap, NOT ON THE PANE'S ID. Tokens declared on
       #bmPanePulse are invisible to anything that renders the desk outside that
       one element — the analyst overlay and the bench page both do — and a
       margin of var(--sp5) with no --sp5 is a DROPPED DECLARATION, not a
       fallback. Every spacing fix silently did nothing there. */
    .bm-wrap {
      /* ONE SPACING SCALE. Everything on the desk steps through these, so a
         header can never sit closer to its own table than to the panel above
         it — which is what "no space around the header" meant. */
      --sp1: 0.35rem; --sp2: 0.6rem; --sp3: 0.95rem; --sp4: 1.5rem; --sp5: 2.4rem;
      --r-sm: 12px; --r-md: 16px; --r-lg: 18px;
      /* THE THREE VOICES (Trym, 3 Sep: "stats should be presented in a
         different highlight than description and titles of stats - and it
         should all be consistent"). A VALUE is always the loudest thing in its
         block; its LABEL is recessive; explanatory PROSE is quietest. Nothing
         on this desk may print a number quieter than the words around it. */
      --num-xl: 1.55rem; --num-lg: 1.15rem; --num-md: 0.88rem;
    }
    #bmPanePulse { --acc: var(--nana); }
    /* ⚠️ Space Grotesk's default figures are PROPORTIONAL — its "1" is much
       narrower than its "0" — so a column of numbers does not line up and the
       eye cannot run down it. Every figure on the desk is tabular. Scoped to
       .bm-wrap, NOT the pane id: the overlay and the bench render outside it. */
    .bm-wrap .hqp-tv, .bm-wrap .hqp-gv, .bm-wrap .hqp-tval, .bm-wrap .hqp-rval,
    .bm-wrap .hqp-bval, .bm-wrap .hqp-fnum, .bm-wrap .hqp-abigv, .bm-wrap .hqp-tip,
    .bm-wrap .ps-stat b, .bm-wrap .ps-devv, .bm-wrap .ps-rbadge, .bm-wrap .hqp-fdrop,
    .bm-wrap .hqp-cap, .bm-wrap .ps-rline, .bm-wrap .hqp-tsub, .bm-wrap .hqp-rsub {
      font-variant-numeric: tabular-nums;
    }
    .hqp-sec { margin: var(--sp4) 0 var(--sp5); }
    .hqp-sec:first-child { margin-top: 0; }
    .hqp-h { display: flex; align-items: center; gap: var(--sp1); margin: 0 0 var(--sp2); }
    .hqp-htitle { font-family: "Archivo Black", sans-serif; font-size: 1.02rem; letter-spacing: 0.01em; }
    .hqp-i { width: 22px; height: 22px; flex: none; border: 0; border-radius: 999px; cursor: pointer;
      background: rgba(244, 238, 255, 0.09); color: var(--hdim); font: 600 0.78rem/1 inherit; }
    .hqp-i:hover { background: rgba(244, 238, 255, 0.16); color: var(--hink); }
    .hqp-note { margin: 0 0 var(--sp3); padding: 0.75rem 0.9rem; border-radius: var(--r-sm);
      background: rgba(244, 238, 255, 0.05); color: var(--hdim); font-size: 0.84rem; line-height: 1.45; }
    /* ⚠️ a fixed column count leaves a hole on any room whose KPI count is not
       a multiple of it — 6 tiles in 4 columns, 7 in 3. Flex lets the last row
       grow into the gap instead. */
    .hqp-tiles { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 0.9rem; }
    .hqp-tiles > * { flex: 1 1 clamp(8rem, 30%, 14rem); }
    .hqp-tile { background: var(--hcard); border-radius: 18px; padding: 0.8rem 0.9rem;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28); }
    .hqp-tval { font-family: "Archivo Black", sans-serif; font-size: var(--num-xl); line-height: 1.05;
      font-variant-numeric: tabular-nums; }
    .hqp-tlab { color: var(--hdim); font-size: 0.72rem; letter-spacing: 0.06em;
      text-transform: uppercase; margin-top: 0.2rem; }
    .hqp-tsub { color: var(--hdim); font-size: 0.72rem; opacity: 0.8; margin-top: 0.2rem;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hqp-tile.is-ok .hqp-tval { color: var(--ok); }
    .hqp-tile.is-warn .hqp-tval { color: var(--org); }
    .hqp-chart { position: relative; background: var(--hcard); border-radius: 18px; padding: 0.5rem 0.4rem 0.2rem;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28); }
    .hqp-svg { display: block; width: 100%; height: auto; touch-action: pan-y; }
    .hqp-tip { position: absolute; top: 6px; transform: translateX(-50%); pointer-events: none;
      background: #0a0814; color: var(--hink); border-radius: 999px; padding: 0.2rem 0.6rem;
      font-size: 0.74rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .hqp-cap { color: var(--hdim); font-size: 0.76rem; line-height: 1.5; margin: var(--sp1) 0 0 0; }
    /* a caption closes the thing above it — whatever comes next is a new thing */
    .hqp-sec > .hqp-cap + * { margin-top: var(--sp3); }
    .hqp-bars { display: grid; gap: 0.45rem; background: var(--hcard); border-radius: 18px; padding: 0.85rem 0.9rem;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28); }
    .hqp-bar { display: grid; grid-template-columns: 5.6rem 1fr 3rem; align-items: center; gap: 0.55rem; }
    .hqp-blab { color: var(--hdim); font-size: 0.78rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hqp-btrack { height: 12px; border-radius: 999px; background: rgba(244, 238, 255, 0.07); overflow: hidden; }
    .hqp-bfill { height: 100%; border-radius: 999px; }
    .hqp-bval { text-align: right; font-size: var(--num-md); font-weight: 700; color: var(--hink);
      font-variant-numeric: tabular-nums; }
    .hqp-rates { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; }
    .hqp-rate { background: var(--hcard); border-radius: 18px; padding: 0.8rem 0.6rem; text-align: center;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28); }
    .hqp-rval { font-family: "Archivo Black", sans-serif; font-size: 1.35rem; font-variant-numeric: tabular-nums; }
    .hqp-rlab { color: var(--hdim); font-size: 0.72rem; letter-spacing: 0.06em;
      text-transform: uppercase; margin-top: 0.2rem; }
    .hqp-rsub { color: var(--hdim); font-size: 0.68rem; opacity: 0.75; margin-top: 0.15rem; }
    .hqp-funnel { display: grid; gap: 0.4rem; background: var(--hcard); border-radius: 18px; padding: 0.9rem;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28); }
    .hqp-fstep { display: grid; gap: 0.25rem; }
    .hqp-fbar { height: 10px; border-radius: 999px; min-width: 3%; }
    .hqp-flab { display: flex; justify-content: space-between; gap: 0.6rem; align-items: baseline; }
    .hqp-fname { font-size: 0.82rem; }
    .hqp-fnum { color: var(--hink); font-size: var(--num-md); font-weight: 700;
      font-variant-numeric: tabular-nums; }
    .hqp-fstep.is-work .hqp-fname { color: var(--nana); }
    /* 📊 PULSE 2.0 — the shell. Not the site's content grid: this is a
       control room, so it goes wide, dark and dense, and it stacks on a
       phone instead of shrinking. */
    #bmPanePulse { --acc: var(--nana); }
    .ps-bar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 0.9rem;
      flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
      padding: 0.6rem 0.8rem; margin: 0 0 0.8rem; border-radius: 18px;
      background: rgba(10, 8, 20, 0.92); backdrop-filter: blur(6px);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4); }
    .ps-bar::-webkit-scrollbar { display: none; }
    .ps-stat { display: grid; line-height: 1.05; flex: none; }
    .ps-stat b { font-family: "Archivo Black", sans-serif; font-size: var(--num-lg);
      font-variant-numeric: tabular-nums; }
    .ps-stat span { color: var(--hdim); font-size: 0.66rem; letter-spacing: 0.04em; text-transform: uppercase; }
    .ps-stat.is-hot b { color: var(--ok); }
    .ps-spark { margin-left: auto; flex: none; width: 120px; height: 26px; }
    .ps-range { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; margin: 0 0 0.8rem; }
    .ps-rlab { color: var(--hdim); font-size: 0.74rem; margin-right: 0.2rem; }
    .ps-chip { border: 1px solid rgba(244, 238, 255, 0.1); background: var(--hcard); color: var(--hink);
      border-radius: 999px; padding: 0.3rem 0.75rem; font: inherit; font-size: 0.74rem; cursor: pointer; }
    .ps-chip[aria-pressed="true"] { background: var(--acc, var(--nana)); border-color: transparent; color: #14101f; font-weight: 700; }
    .ps-rooms { display: flex; gap: 0.4rem; overflow-x: auto; scrollbar-width: none; margin: 0 0 1rem; padding-bottom: 0.2rem;
      -webkit-mask-image: linear-gradient(90deg, #000 0, #000 88%, transparent 100%);
      mask-image: linear-gradient(90deg, #000 0, #000 88%, transparent 100%); }
    @media (min-width: 760px) { .ps-rooms { -webkit-mask-image: none; mask-image: none; } }
    .ps-rooms::-webkit-scrollbar { display: none; }
    .ps-room { flex: none; border: 1px solid rgba(244, 238, 255, 0.1); background: var(--hcard); color: var(--hdim);
      border-radius: 999px; padding: 0.4rem 0.9rem; font: inherit; font-size: 0.76rem; letter-spacing: 0.05em;
      cursor: pointer; position: relative; }
    .ps-room[aria-pressed="true"] { color: #14101f; background: var(--racc); border-color: transparent; font-weight: 700; }
    .ps-rbadge { margin-left: 0.35rem; font-size: 0.68rem; opacity: 0.8; }
    .ps-body { min-height: 40vh; }
    .ps-mapcard { position: relative; border-radius: 18px; overflow: hidden;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35); }
    .pm-wrap { position: relative; }
    .pm-cv { display: block; width: 100%; height: auto; image-rendering: pixelated;
      background: #151129; touch-action: pan-y; }
    .pm-tip { position: absolute; transform: translate(-50%, -120%); pointer-events: none; white-space: pre;
      background: #0a0814; color: var(--hink); border-radius: 12px; padding: 0.35rem 0.6rem;
      font-size: 0.7rem; line-height: 1.35; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5); }
    .ps-zoom { position: absolute; right: 8px; top: 8px; z-index: 2; display: grid; gap: 4px; }
    .ps-zbtn { width: 30px; height: 30px; border: 0; border-radius: 999px; background: rgba(10, 8, 20, 0.8);
      color: var(--hink); font: inherit; font-size: 0.9rem; cursor: pointer; }
    /* ⚠️ the three mode chips and the event selector are DIFFERENT controls —
       "theres not enough space between the LIVE, Range stickerpills and grabbed
       the gif event-selector". They get their own groups and a real gap. */
    .ps-modes { display: flex; gap: 0.9rem; flex-wrap: wrap; align-items: center;
      margin: var(--sp3) 0 var(--sp2); }
    .ps-mchips { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; }
    .ps-lens { border: 1px solid rgba(244, 238, 255, 0.1); background: var(--hcard); color: var(--hink);
      border-radius: 999px; padding: 0.35rem 0.75rem; font: inherit; font-size: 0.74rem;
      max-width: 100%; }
    .ps-legend { color: var(--hdim); font-size: 0.74rem; margin: 0 0 var(--sp2); }
    .ps-hotline { background: rgba(94, 224, 138, 0.12); color: var(--ok); border-radius: var(--r-sm);
      padding: 0.5rem 0.8rem; font-size: 0.78rem; margin: 0 0 var(--sp2); }
    /* ⚠️ "theres no padding on the sides and the text is squeezed into the
       side-edges". Padding alone does NOT fix a marquee: the text scrolls
       THROUGH the padding box to x=0. It needs the padding AND a mask that
       fades both edges — the same device the room strip already uses. */
    .ps-ticker { overflow: hidden; border-radius: var(--r-sm); background: var(--hcard);
      padding: 0.5rem 0; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 3.5%, #000 96.5%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0, #000 3.5%, #000 96.5%, transparent 100%); }
    .ps-tickin { display: inline-block; white-space: nowrap; padding-left: 35%;
      animation: ps-tick 26s linear infinite; font-size: 0.78rem; }
    .ps-ticker:hover .ps-tickin, .ps-ticker:focus-within .ps-tickin { animation-play-state: paused; }
    @keyframes ps-tick { to { transform: translateX(-100%); } }
    .ps-tev { border: 0; background: none; color: var(--hink); font: inherit; font-size: 0.78rem;
      cursor: pointer; padding: 0; text-decoration: underline dotted rgba(244, 238, 255, 0.3); }
    .ps-tlead, .ps-tsep { color: var(--hdim); }
    /* ⚠️ "no space around the header 'On screen right now' and the newsticker
       above" — renderNow's first section header used to sit flush on the
       ticker, because .ps-lists had no rule at all. */
    .ps-lists { margin: var(--sp5) 0 0; }
    .ps-tnote { margin: var(--sp2) 0 0; padding: 0.7rem 0.85rem; border-radius: var(--r-sm);
      background: rgba(244, 238, 255, 0.05); color: var(--hink); font-size: 0.8rem; line-height: 1.45; }
    /* a ticker that does not move can simply be padded like anything else */
    @media (prefers-reduced-motion: reduce) {
      .ps-ticker { padding: 0.5rem 0.9rem; -webkit-mask-image: none; mask-image: none;
        overflow-x: auto; }
      .ps-tickin { animation: none; padding-left: 0; }
    }

    /* what they are holding, right now */
    .ps-devs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: var(--sp2) 0 0; }
    .ps-dev { flex: 1 1 8rem; display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto;
      gap: 0 0.55rem; align-items: center; background: var(--hcard); border-radius: 16px; padding: 0.6rem 0.8rem; }
    .ps-devi { grid-row: span 2; font-size: 1.35rem; line-height: 1; }
    .ps-devn { color: var(--hdim); font-size: 0.74rem; letter-spacing: 0.04em; text-transform: uppercase; }
    .ps-devv { color: var(--hink); font-size: var(--num-md); font-weight: 700; font-variant-numeric: tabular-nums; }

    .hqp-tbl { display: grid; gap: 1px; background: rgba(244, 238, 255, 0.09); border-radius: var(--r-md);
      overflow: hidden; margin: var(--sp2) 0 0; }
    /* ⚠️ THE LEADER. This desk goes wide, so a short label on the left and a
       lone number 1,400px away on the right is genuinely hard to pair up —
       "its hard to read which line is which number". A dotted rule carries the
       eye across, the way a ledger or a menu does. It is a grid item in
       column 2, so it grows to exactly the gap between the two. */
    .hqp-trow { display: grid; grid-template-columns: minmax(0, max-content) 1fr max-content;
      align-items: baseline; background: var(--hcard); padding: 0.5rem 0.75rem; }
    .hqp-tk { grid-column: 1; }
    .hqp-tv { grid-column: 3; }
    .hqp-trow::after { content: ''; grid-column: 2; align-self: center; height: 0;
      margin: 0 0.7rem; border-bottom: 1px dotted rgba(244, 238, 255, 0.18); }
    .hqp-trow.is-head::after { border: 0; }
    /* ⚠️ "sometimes where its alot of information in a big table its hard to
       read which line is which number" — banding gives the eye a rail, and the
       hover works on EVERY row, not only the tappable ones. */
    .hqp-trow:nth-child(even) { background: #201a37; }
    .hqp-trow:hover { background: #271f45; }
    /* the mid-separators Trym asked for: a real rule every five rows, so a long
       list can be counted down instead of slid off */
    .hqp-trow:nth-child(5n + 1):not(:first-child) { box-shadow: inset 0 1px 0 rgba(244, 238, 255, 0.2); }
    .hqp-trow.is-tap { cursor: pointer; }
    .hqp-tk { font-size: 0.82rem; min-width: 0; max-width: 100%;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* ⚠️ THIS WAS INVERTED. The value was --hdim at 0.76rem under a key in full
       ink at 0.82rem, so every table on the desk whispered its own numbers. */
    .hqp-tv { color: var(--hink); font-size: var(--num-md); font-weight: 700;
      white-space: nowrap; font-variant-numeric: tabular-nums; }
    .hqp-tv.is-zero { color: var(--hdim); font-weight: 400; }

    .ps-rpt { position: relative; flex: none; margin-left: 0.5rem; border: 1px solid rgba(244, 238, 255, 0.12);
      background: var(--hcard); color: var(--hink); border-radius: 999px; padding: 0.35rem 0.8rem;
      font: inherit; font-size: 0.72rem; letter-spacing: 0.03em; cursor: pointer; white-space: nowrap; }
    .ps-rptdot { position: absolute; top: -4px; right: -4px; width: 10px; height: 10px;
      background: var(--hot2); border: 2px solid #0a0814; box-shadow: 0 0 8px var(--hot2); }
    .ps-veil { position: fixed; inset: 0; z-index: 40; background: rgba(6, 4, 14, 0.86);
      display: grid; place-items: start center; overflow-y: auto; padding: 1.2rem 0.8rem 3rem; }
    .ps-rcard { position: relative; width: min(640px, 100%); background: var(--hcard, #1c1631); color: var(--hink, #f4eeff);
      border-radius: 22px; padding: 1.4rem 1.1rem 1.2rem; display: grid; gap: 0.6rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6); }
    .ps-rx { position: absolute; right: 10px; top: 10px; width: 32px; height: 32px; border: 0;
      border-radius: 999px; background: rgba(244, 238, 255, 0.1); color: var(--hink); font: inherit; cursor: pointer; }
    .ps-rload { color: var(--hdim); font-size: 0.85rem; }
    .ps-verdict { justify-self: start; border-radius: 999px; padding: 0.2rem 0.8rem; font-size: 0.68rem;
      letter-spacing: 0.08em; text-transform: uppercase; background: rgba(244, 238, 255, 0.1); color: var(--hdim); }
    .ps-verdict.is-notable { background: rgba(255, 93, 143, 0.18); color: var(--hot2); }
    .ps-verdict.is-quiet { background: rgba(94, 224, 138, 0.16); color: var(--ok); }
    .ps-verdict.is-thin, .ps-verdict.is-no-baseline { background: rgba(255, 180, 94, 0.16); color: var(--org); }
    .ps-rhead { font-family: "Archivo Black", sans-serif; font-size: 1.15rem; line-height: 1.25; margin: 0; }
    .ps-rbody { color: var(--hdim); font-size: 0.86rem; line-height: 1.55; margin: 0; }
    .ps-read { display: grid; grid-template-columns: 1.5rem 1fr; gap: 0.5rem; align-items: start; }
    .ps-ricon { font-size: 1rem; line-height: 1.4; overflow: hidden; }
    .ps-rtext { font-size: 0.85rem; line-height: 1.5; }
    .ps-rec { border-left: 3px solid var(--nana); padding-left: 0.75rem; font-size: 0.85rem; line-height: 1.5; }
    .ps-rsub { margin: 0.6rem 0 0; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--hdim); }
    .ps-rline { margin: 0; font-size: 0.82rem; line-height: 1.5; color: var(--hink); }
    .ps-rnote { background: rgba(255, 225, 53, 0.08); border-radius: 12px; padding: 0.6rem 0.75rem;
      font-size: 0.82rem; line-height: 1.5; }

    .hqp-bars2 { display: flex; align-items: flex-end; gap: 4px; height: 110px;
      background: var(--hcard); border-radius: 18px; padding: 0.7rem; }
    .hqp-b2 { flex: 1 1 0; max-width: 64px; height: 100%; display: flex; align-items: flex-end; cursor: pointer; }
    .hqp-b2f { width: 100%; background: var(--acc, var(--nana)); border-radius: 6px 6px 0 0; }
    .hqp-warn { color: var(--hot2); font-size: 0.74rem; }
    .hqp-real { color: var(--hot2); font-weight: 700; }
    .hqp-trow.is-head, .hqp-trow.is-head:hover, .hqp-trow.is-head:nth-child(even) { background: transparent; }
    .hqp-trow.is-head .hqp-tk, .hqp-trow.is-head .hqp-tv { color: var(--hdim); font-size: 0.66rem;
      font-weight: 400; letter-spacing: 0.07em; text-transform: uppercase; }

    /* 📊 A REAL TABLE — aligned columns, each under its own header.
       The downloads panel used to print "180 · 170 · 9 · 140 · 5.3%" into ONE
       cell beneath a five-word header, and Trym circled it in red as
       unreadable. Wide ones scroll INSIDE themselves; the page never does. */
    .hqp-grid { margin: var(--sp2) 0 0; border-radius: var(--r-md);
      background: rgba(244, 238, 255, 0.09); overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .hqp-grid::-webkit-scrollbar { height: 6px; }
    .hqp-grid::-webkit-scrollbar-thumb { background: rgba(244, 238, 255, 0.2); border-radius: 999px; }
    .hqp-gin { display: grid; gap: 1px; min-width: max-content; }
    .hqp-grow { display: grid; grid-template-columns: var(--cols); gap: 1.1rem;
      background: var(--hcard); padding: 0.55rem 0.85rem; align-items: baseline; }
    .hqp-grow:nth-child(even) { background: #201a37; }
    .hqp-grow:hover { background: #271f45; }
    .hqp-grow:nth-child(5n + 1):not(:first-child) { box-shadow: inset 0 1px 0 rgba(244, 238, 255, 0.2); }
    .hqp-grow.is-head, .hqp-grow.is-head:hover, .hqp-grow.is-head:nth-child(even) {
      background: var(--hpanel); box-shadow: inset 0 -1px 0 rgba(244, 238, 255, 0.28); }
    .hqp-gh { color: var(--hdim); font-size: 0.66rem; letter-spacing: 0.07em;
      text-transform: uppercase; white-space: nowrap; }
    .hqp-gk { color: var(--hink); font-size: 0.82rem; min-width: 0; }
    .hqp-gv { color: var(--hink); font-size: var(--num-md); font-weight: 700;
      font-variant-numeric: tabular-nums; white-space: nowrap; }
    .hqp-gv.is-zero { color: var(--hdim); font-weight: 400; }
    .hqp-gsub { color: var(--hdim); font-size: 0.7rem; }
    .hqp-area { background: var(--hcard); border-radius: 18px; padding: 0.9rem; margin: 0 0 0.6rem;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28); }
    .hqp-area.is-dead { opacity: 0.5; }
    .hqp-aname { font-family: "Archivo Black", sans-serif; font-size: 0.95rem; }
    .hqp-aq { color: var(--hdim); font-size: 0.78rem; line-height: 1.4; margin: 0.25rem 0 0.5rem; }
    .hqp-abig { display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
    .hqp-abigv { font-family: "Archivo Black", sans-serif; font-size: var(--num-xl); line-height: 1.1;
      font-variant-numeric: tabular-nums; color: var(--hink); }
    .hqp-abigl { color: var(--hdim); font-size: 0.86rem; }
    .hqp-fdrop { color: var(--hdim); font-size: 0.7rem; }
    .hqp-fwork { color: var(--hot2); font-size: 0.72rem; font-weight: 700; }
    .hqp-fstore { color: var(--hdim); font-weight: 400; }
    .hqp-fstep { cursor: pointer; }

    .hqp-analyst { background: var(--hcard); border-radius: 18px; padding: 1rem;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28); display: grid; gap: 0.55rem; }
    .hqp-verdict { justify-self: start; border-radius: 999px; padding: 0.15rem 0.7rem;
      font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase;
      background: rgba(244, 238, 255, 0.1); color: var(--hdim); }
    /* ⚠️ THESE MUST MATCH WHAT analyse() ACTUALLY RETURNS. The four verdicts are
       notable / quiet / thin / no-baseline; this block used to style is-good,
       is-up, is-watch, is-down, is-bad and is-alarm — six classes the analyst
       has never once emitted — so the pill was grey for its whole life. */
    .hqp-verdict.is-notable { background: rgba(255, 93, 143, 0.18); color: var(--hot2); }
    .hqp-verdict.is-quiet { background: rgba(94, 224, 138, 0.16); color: var(--ok); }
    .hqp-verdict.is-thin, .hqp-verdict.is-no-baseline { background: rgba(255, 180, 94, 0.16); color: var(--org); }
    .hqp-ahead { font-family: "Archivo Black", sans-serif; font-size: 1rem; line-height: 1.25; }
    .hqp-abody { color: var(--hdim); font-size: 0.85rem; line-height: 1.5; }
    .hqp-aread { display: grid; grid-template-columns: 1.4rem 1fr; gap: 0.5rem; align-items: start; }
    .hqp-aicon { font-size: 0.95rem; line-height: 1.4; overflow: hidden; }
    .hqp-atext { font-size: 0.84rem; line-height: 1.45; }
    .hqp-arec { border-left: 2px solid var(--nana); padding-left: 0.7rem; font-size: 0.84rem; line-height: 1.45; }
    .hqp-empty { color: var(--hdim); font-size: 0.85rem; padding: 0.9rem; line-height: 1.5; }
    .hqp-foot { color: var(--hdim); font-size: 0.72rem; opacity: 0.75; margin-top: 1rem; }
    @media (min-width: 620px) {
      /* three across, and an orphan stays a third wide instead of stretching
         the full width of the desk */
      .hqp-tiles > * { flex-basis: 22%; max-width: calc((100% - 1.2rem) / 3); }
    }

    /* 📱 THE DESK ON A PHONE. Until now every media query on this page pointed
       the OTHER way (min-width), so the control room simply rendered at desktop
       proportions on a 393px screen: 11px chips beside a 16px select, tap
       targets in the twenties, and a lens dropdown wider than the viewport. */
    @media (max-width: 620px) {
      /* 44px is the floor for anything a thumb has to hit */
      .ps-chip, .ps-room { min-height: 44px; display: inline-flex; align-items: center;
        padding: 0.5rem 0.9rem; }
      .ps-lens { min-height: 44px; width: 100%; max-width: 100%; }
      .ps-mchips { width: 100%; }
      /* the (i) keeps its small circle — a 44px disc beside a heading is a
         blob — and grows an invisible hit area instead */
      .hqp-i { width: 30px; height: 30px; font-size: 0.88rem; position: relative; }
      .hqp-i::after { content: ''; position: absolute; left: 50%; top: 50%;
        width: 44px; height: 44px; transform: translate(-50%, -50%); }
      .ps-zbtn { width: 44px; height: 44px; }
      .hqp-trow.is-tap, .hqp-fstep { min-height: 44px; }
      /* the ticker's explainers were 18.7px tall AND moving */
      .ps-tev { padding: 0.35rem 0; }
      /* the sticky bar scrolls, so its last control could sit off the edge */
      .ps-bar { flex-wrap: wrap; row-gap: 0.5rem; }
      .ps-spark { margin-left: auto; }
      .ps-rpt { min-height: 44px; margin-left: 0; }
      /* a tooltip anchored at a pin near the edge ran past the card, which clips */
      .pm-tip { max-width: 70vw; white-space: pre-wrap; }
    }

    /* form controls never below 16px → iOS won't zoom-jump on focus */
    .bm-wrap input, .bm-wrap select, .bm-wrap textarea { font-size: 16px; }
    /* each department carries its own colour temperature (the Pulse-room trick) */
    #bmPaneMail { --acc: var(--cool); }
    #bmPaneGal { --acc: var(--purp); }
    #bmPaneRave { --acc: var(--org); }
    #bmPaneItems { --acc: var(--hot2); }
    #bmPaneUsers { --acc: var(--ok); }
    #bmPaneWorld { --acc: var(--nana); }
    #bmPaneDev { --acc: #8fb6ff; }
    .bm-letterhead {
      background: var(--hpanel); color: var(--hink); border: 2px solid var(--hline);
      border-top: 4px solid var(--nana); box-shadow: 0 10px 26px rgba(0,0,0,0.35);
      padding: 0.95rem 1.05rem; border-radius: 18px; display: flex; align-items: center; gap: 0.85rem;
    }
    .bm-letterhead__badge {
      flex: 0 0 auto; width: 44px; height: 44px; display: grid; place-items: center;
      background: var(--nana); border-radius: 12px; font-size: 1.6rem; line-height: 1;
    }
    .bm-letterhead h1 { margin: 0; font-size: clamp(1.35rem, 6.5vw, 2rem); color: var(--nana); letter-spacing: 0.01em; line-height: 1.05; }
    .bm-letterhead .bm-sub { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--hdim); margin: 0.3rem 0 0; }
    .bm-letterhead .bm-est { font-size: 0.55rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--nana); opacity: 0.82; margin: 0.18rem 0 0; }
    @media (max-width: 400px) { .bm-letterhead .bm-est { display: none; } }

    /* the security checkpoint */
    .bm-gate { margin-top: 1.2rem; border: 2px solid var(--hline); background: var(--hpanel); border-radius: 18px; padding: 1.1rem; text-align: center; }
    .bm-gate p { margin: 0 0 0.8rem; font-size: 0.9rem; }
    .bm-gate .bm-gate__row { display: flex; gap: 0.6rem; max-width: 420px; margin-inline: auto; }
    .bm-gate input { flex: 1; min-width: 0; padding: 0.6rem 0.7rem; border: 2px solid var(--hline); background: var(--hinput); color: var(--hink); font-family: inherit; font-size: 0.95rem; border-radius: 10px; }
    .bm-gate .bm-wrong { color: var(--hot2); font-weight: 700; font-size: 0.8rem; margin-top: 0.6rem; }

    /* toolbar */
    .bm-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 1.2rem 0 0.9rem; }
    .bm-count { font-weight: 800; font-size: 0.85rem; margin-right: auto; color: var(--acc, var(--nana)); }
    .bm-chip {
      display: inline-flex; align-items: center; gap: 0.3rem; min-height: 34px;
      border: 2px solid var(--hline); background: var(--hinput); padding: 0.3rem 0.7rem;
      font-family: inherit; font-weight: 800; font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase;
      cursor: pointer; border-radius: 999px; color: var(--hink); text-decoration: none;
    }
    .bm-chip:hover { border-color: var(--acc, var(--nana)); }
    .bm-chip[aria-pressed="true"] { background: var(--acc, var(--nana)); border-color: var(--acc, var(--nana)); color: #14101f; }
    .bm-chip--ghost { border-style: dashed; opacity: 0.72; }

    /* mail cards */
    .bm-mail { border: 2px solid var(--hline); border-left: 5px solid var(--hline); background: var(--hpanel); border-radius: 14px; margin: 0 0 0.9rem; position: relative; overflow: hidden; }
    .bm-mail--unread { border-left-color: var(--hot2); }
    .bm-mail__head { width: 100%; display: block; text-align: left; background: none; border: none; font-family: inherit; color: var(--hink); padding: 0.8rem 0.9rem; cursor: pointer; }
    .bm-mail__top { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--hdim); }
    .bm-stamp {
      border: 2px solid transparent; padding: 0.1rem 0.4rem; border-radius: 6px;
      background: var(--nana); color: #14101f; transform: rotate(2deg); font-size: 0.58rem;
    }
    .bm-stamp--licensing { background: var(--hot2); color: #fff; transform: rotate(-2deg); }
    .bm-mail__from { font-weight: 800; font-size: 0.98rem; margin: 0.35rem 0 0; word-break: break-word; }
    .bm-mail__from .bm-dot { display: inline-block; width: 9px; height: 9px; border-radius: 999px; background: var(--hot2); box-shadow: 0 0 7px var(--hot2); margin-right: 0.4rem; vertical-align: 1px; }
    .bm-mail__peek { font-size: 0.82rem; color: var(--hdim); margin: 0.25rem 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bm-mail__body { padding: 0 0.9rem 0.9rem; }
    .bm-mail__msg { white-space: pre-wrap; font-family: inherit; font-size: 0.92rem; line-height: 1.55; margin: 0.2rem 0 0.9rem; border-top: 2px dashed var(--hline); padding-top: 0.8rem; word-break: break-word; }
    .bm-mail__actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    /* 💬 the pass-reply desk inside a mail — the road back when there is no email */
    .bm-stamp--pass { background: var(--ok); color: #14101f; transform: rotate(-1deg); }
    .bm-passreply { margin-top: 0.9rem; border: 2px solid var(--hline); border-left: 4px solid var(--ok); border-radius: 12px; background: var(--hcard); padding: 0.7rem 0.8rem; }
    .bm-passreply__head { margin: 0 0 0.5rem; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ok); }
    .bm-passreply__row { display: flex; gap: 0.5rem; align-items: stretch; }
    .bm-passreply__row textarea { flex: 1; min-width: 0; resize: vertical; font-family: inherit; padding: 0.5rem 0.6rem; border: 2px solid var(--hline); border-radius: 10px; background: var(--hinput); color: var(--hink); }
    .bm-btn--passgo { background: var(--ok); border-color: var(--ok); color: #14101f; }
    .bm-passreply__label { margin: 0.7rem 0 0.3rem; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--hdim); }
    .bm-passreply__msg { font-size: 0.8rem; line-height: 1.45; padding: 0.4rem 0.55rem; margin-bottom: 0.35rem; border: 2px solid var(--hline); border-radius: 10px; background: var(--hinput); word-break: break-word; }
    .bm-passreply__msg time { color: var(--hdim); font-size: 0.68rem; white-space: nowrap; }
    /* key-gate rows OUTSIDE .bm-gate (users desk, email lookup) were raw
       white HTML inputs — one dark rule for every gate row on the page */
    .bm-gate__row input { flex: 1; min-width: 0; padding: 0.6rem 0.7rem; border: 2px solid var(--hline); background: var(--hinput); color: var(--hink); font-family: inherit; font-size: 0.95rem; border-radius: 10px; }
    .bm-btn {
      display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
      border: 2px solid var(--hline); background: var(--hcard); padding: 0.5rem 0.9rem;
      font-family: inherit; font-weight: 800; font-size: 0.82rem; cursor: pointer; border-radius: 10px; text-decoration: none; color: var(--hink);
    }
    .bm-btn:hover { border-color: var(--acc, var(--nana)); }
    .bm-btn--shred { background: var(--hot2); border-color: var(--hot2); color: #fff; }
    .bm-btn--shred[data-arm="1"] { background: #0a0814; color: var(--hot2); }
    .bm-mail--shredding { transition: transform 0.35s ease, opacity 0.35s ease; transform: translateX(40px) rotate(2deg); opacity: 0; }

    .bm-empty { text-align: center; padding: 2.5rem 1rem; border: 2px dashed var(--hline); border-radius: 14px; color: var(--hdim); }
    .bm-empty .bm-big { font-size: 2rem; }
    .bm-empty p { margin: 0.4rem 0 0; font-weight: 700; }

    .bm-fine { text-align: center; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--hdim); margin-top: 2rem; line-height: 1.8; }
    @media (max-width: 480px) { .bm-count { flex-basis: 100%; } }

    /* DEPARTMENTS — a horizontally-scrolling pill strip that can NEVER overflow
       the viewport (the old flex:1 tabs ran off small screens sideways). Each
       tab lights in its department's accent when selected. */
    .bm-tabs {
      display: flex; gap: 0.45rem; margin: 1.2rem -0.9rem 0.5rem; padding: 0.15rem 0.9rem 0.75rem;
      overflow-x: auto; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch;
      scrollbar-width: none; border-bottom: 2px solid var(--hline);
    }
    .bm-tabs::-webkit-scrollbar { display: none; }
    .bm-tab {
      flex: 0 0 auto; scroll-snap-align: start; white-space: nowrap;
      display: inline-flex; align-items: center; gap: 0.35rem;
      border: 2px solid var(--hline); background: var(--hinput); padding: 0.5rem 0.9rem; min-height: 42px;
      font-family: inherit; font-weight: 800; font-size: 0.82rem; letter-spacing: 0.01em;
      cursor: pointer; border-radius: 999px; color: var(--hink);
    }
    #bmTabMail { --tacc: var(--cool); } #bmTabGal { --tacc: var(--purp); }
    #bmTabRave { --tacc: var(--org); } #bmTabItems { --tacc: var(--hot2); }
    #bmTabUsers { --tacc: var(--ok); } #bmTabWorld { --tacc: var(--nana); }
    .bm-tab:hover { border-color: var(--tacc, var(--nana)); }
    .bm-tab[aria-selected="true"] { background: var(--tacc, var(--nana)); border-color: var(--tacc, var(--nana)); color: #14101f; }
    .bm-tab .bm-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 1.35em; height: 1.35em; padding: 0 0.3em; border-radius: 999px; background: var(--hot2); color: #fff; font-size: 0.66rem; margin-left: 0.15rem; font-variant-numeric: tabular-nums; }
    /* ⚠️ ONE GUARD FOR THE WHOLE DESK, AND IT EARNS ITS KEEP IMMEDIATELY.
       `[hidden]` is a UA rule, so ANY author `display:` beats it — which is why
       the Items badge painted as a bare red dot with no number: the pill was
       never hidden, it was just empty until its fetch landed. Same trap as the
       pass page, third time in this codebase. */
    [hidden] { display: none !important; }

    /* ── 👤 THE USERS DESK ── a table that reads like a table: fixed columns,
       tabular numerals, one row per pass. The old ledger crammed seven
       emoji-prefixed facts into a wrapping sentence per person, which is
       unscannable the moment there is more than one of them. The tiles ride
       Pulse's KPI colour cycle so the row of numbers reads varied, not walled. */
    .hq-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(115px, 1fr)); gap: 0.5rem; margin: 0.9rem 0; }
    .hq-tile { border: 2px solid var(--hline); border-left: 5px solid var(--kc, var(--nana)); background: var(--hcard); border-radius: 14px; padding: 0.55rem 0.65rem; }
    .hq-tiles > :nth-child(6n+1) { --kc: var(--nana); } .hq-tiles > :nth-child(6n+2) { --kc: var(--cool); }
    .hq-tiles > :nth-child(6n+3) { --kc: var(--ok); } .hq-tiles > :nth-child(6n+4) { --kc: var(--hot2); }
    .hq-tiles > :nth-child(6n+5) { --kc: var(--purp); } .hq-tiles > :nth-child(6n+6) { --kc: var(--org); }
    .hq-tile b { display: block; font-size: 1.35rem; line-height: 1.1; font-variant-numeric: tabular-nums; color: var(--kc, var(--nana)); }
    .hq-tile span { display: block; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--hdim); margin-top: 0.15rem; }
    .hq-tools { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; margin: 0.9rem 0 0.7rem; }
    .hq-tools input, .hq-tools select {
      font-family: inherit; font-size: 0.85rem; padding: 0.45rem 0.6rem;
      border: 2px solid var(--hline); border-radius: 10px; background: var(--hinput); color: var(--hink); min-width: 0;
    }
    .hq-tools input { flex: 1 1 170px; }

    .hq-row {
      width: 100%; display: grid; gap: 0.2rem 0.7rem; align-items: center; text-align: left;
      grid-template-columns: 1fr auto auto auto; font-family: inherit; cursor: pointer;
      border: 2px solid var(--hline); background: var(--hpanel); border-radius: 12px;
      padding: 0.5rem 0.7rem; margin-bottom: 0.5rem; color: var(--hink);
    }
    .hq-row:hover { border-color: var(--acc, var(--nana)); }
    .hq-row[aria-expanded="true"] { border-color: var(--acc, var(--nana)); background: var(--hcard); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .hq-row__who { min-width: 0; }
    .hq-row__name { font-weight: 800; font-size: 0.95rem; overflow-wrap: anywhere; }
    .hq-row__sub { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--hdim); }
    .hq-num { font-variant-numeric: tabular-nums; font-weight: 800; font-size: 0.85rem; white-space: nowrap; color: var(--acc, var(--nana)); }
    .hq-lvl { background: var(--acc, var(--nana)); color: #14101f; padding: 0.15rem 0.45rem; font-size: 0.7rem; font-weight: 800; white-space: nowrap; border-radius: 6px; }
    /* the recovery flag — the one column the email rail made possible.
       ⚠️ a text pill, not an emoji: this is DATA, and it has to be unambiguous
       at a glance on every device rather than depending on a colour-emoji font. */
    .hq-rec { font-size: 0.58rem; font-weight: 800; letter-spacing: 0.06em; padding: 0.2rem 0.4rem; border-radius: 999px; white-space: nowrap; }
    .hq-rec--yes { background: rgba(94, 224, 138, 0.16); box-shadow: inset 0 0 0 2px rgba(94, 224, 138, 0.55); color: var(--ok); }
    .hq-rec--no { background: rgba(255, 93, 143, 0.14); box-shadow: inset 0 0 0 2px rgba(255, 93, 143, 0.5); color: var(--hot2); }
    .hq-rec--unknown { background: rgba(255, 255, 255, 0.06); box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.22); color: rgba(255, 253, 245, 0.65); }
    @media (max-width: 560px) {
      .hq-row { grid-template-columns: 1fr auto; }
      .hq-row__who { grid-column: 1 / -1; }
    }

    .hq-open { border: 2px solid var(--acc, var(--nana)); border-top: none; background: var(--hcard); border-radius: 0 0 12px 12px; margin: -0.5rem 0 0.9rem; padding: 0.9rem 1rem 1.1rem; }
    /* labelled sections give the open row AIR — the pill wall read as one smear */
    .hq-sec { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--hdim); margin: 1rem 0 0.5rem; }
    .hq-sec:first-child { margin-top: 0.1rem; }
    .hq-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 0.45rem; }
    .hq-stat { background: var(--hinput); border: 2px solid var(--hline); border-radius: 10px; padding: 0.4rem 0.55rem; }
    .hq-stat b { display: block; font-size: 1rem; font-variant-numeric: tabular-nums; color: var(--acc, var(--nana)); }
    .hq-stat span { font-size: 0.56rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--hdim); }
    .hq-gear { display: flex; flex-wrap: wrap; gap: 0.3rem; max-height: 92px; overflow: auto; }
    .hq-gearchip { font-size: 0.68rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 999px; background: var(--hinput); box-shadow: inset 0 0 0 2px var(--hline); overflow-wrap: anywhere; }
    .hq-facts { display: flex; flex-wrap: wrap; gap: 0.25rem 0.4rem; margin: 0 0 0.7rem; }
