        <div class="bm-gate__row" id="bmUGate" style="max-width:420px;">
          <input id="bmLedgerKey" type="password" placeholder="pass admin key" autocomplete="off" aria-label="Pass admin key" />
          <button class="bm-btn" id="bmLedgerLoad" type="button">Open →</button>
        </div>
        <p class="bm-livenote">Synced passes only — a visitor who never logged in lives in their own browser
          and has no record here. Gated by <b>PASS_ADMIN_KEY</b> on the pass worker.</p>
        <div id="bmUTiles" class="hq-tiles" hidden></div>
        <div class="hq-tools" id="bmUTools" hidden>
          <input id="bmUSearch" type="search" placeholder="search a name or id…" autocomplete="off" aria-label="Search users" />
          <select id="bmUSort" aria-label="Sort users">
            <option value="recent">last seen</option>
            <option value="coins">most coins</option>
            <option value="rep">most rep</option>
            <option value="badges">most badges</option>
            <option value="new">newest</option>
            <option value="risk">can't recover</option>
          </select>
        </div>
        <div id="bmLedgerList"></div>

        <h3 style="margin:1.6rem 0 0.5rem;font-size:0.95rem;">✉️ find a pass by email</h3>
        <p class="bm-livenote">The site stores no addresses — but it can still go address → pass, which is exactly
          what honours a deletion request from someone who logged in by email.</p>
        <div class="bm-gate__row" style="max-width:420px;">
          <input id="bmUMail" type="email" placeholder="them@example.com" autocomplete="off" aria-label="Email to look up" />
          <button class="bm-btn" id="bmUMailGo" type="button">Find →</button>
        </div>
        <p class="hq-said" id="bmUMailOut"></p>

        <h3 style="margin:1.6rem 0 0.5rem;font-size:0.95rem;">🧾 what this desk has done</h3>
        <div class="bm-bar" style="margin-top:0;"><button class="bm-chip" id="bmULogRefresh" type="button">↻ load the log</button></div>
        <div id="bmULog"></div>
      </div>

      <p class="bm-fine">
        Banana HQ — head office of the Banana World.<br>
        Unauthorized peeling is prohibited and punishable by dance-off.<br>
        <button class="bm-chip bm-chip--ghost" id="bmLogout" type="button" style="margin-top:0.5rem;">🚪 clock out</button>
      </p>
    </div>
  </div>

  <script>
    // Trym's editorial items (baked at build; runtime overrides merge on top
    // in the live desk so the inputs always show the CURRENT values)
    import editorialBase from '../data/gallery.json';
    import { parseDesign } from '../lib/sticker-core.js';
    import { memeGif } from '../lib/meme-gif.js';
    import { drawComposite, assetsReady, NFRAMES, BASE_CYCLE_S } from '../lib/banana-engine.js';
    import { wearToCustom } from '../lib/wear-render.js';

    const API = new URLSearchParams(location.search).get('api') || 'https://banana-contact.trymstene.workers.dev';
    // 🚀 community pages are built at BUILD TIME, so an approval is invisible
    // until the site rebuilds — a maker following "you're live" hit a 404 for
    // up to a day. Approving asks for a rebuild; the toast tells the truth
    // either way, because a silent failure is what caused this in the first
    // place. Needs Actions: read+write on the PAT.
    // the desk had no notification channel — errors used alert() and successes
    // said nothing. One line, bottom-centre, house colours.
    function bmToast(msg) {
      let t = document.getElementById('bmToast');
      if (!t) {
        t = document.createElement('div');
        t.id = 'bmToast';
        t.style.cssText = 'position:fixed;left:50%;bottom:18px;transform:translateX(-50%);z-index:9999;'
          + 'max-width:min(92vw,420px);padding:0.6rem 0.9rem;border:3px solid #000;background:#ffe135;'
          + 'color:#111;font-weight:800;font-size:0.78rem;line-height:1.4;box-shadow:5px 5px 0 #000;text-align:center;';
        document.body.appendChild(t);
      }
      t.textContent = msg;
      t.hidden = false;
      clearTimeout(bmToast._t);
      bmToast._t = setTimeout(() => { t.hidden = true; }, 6000);
    }
    let rebuildAt = 0;
    async function askRebuild(what) {
      if (Date.now() - rebuildAt < 60000) return;   // one dispatch per minute is plenty
      rebuildAt = Date.now();
      try {
        const r = await fetch(API + '/dev/gh', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, action: 'deploy' }),
        });
        const j = await r.json().catch(() => ({}));
        bmToast(j.ok ? '🚀 rebuilding the site — ' + what + ' is live in a few minutes'
          : '⚠ approved, but the rebuild was refused (' + (j.err || 'no reason') + ') — it goes live on the nightly build');
      } catch (e) {
        bmToast('⚠ approved, but the rebuild could not be reached — it goes live on the nightly build');
      }
    }
    const READ_KEY = 'inbox-read-v1';
    const el = (id) => document.getElementById(id);

    let token = '';
    let mails = [];
    let topic = 'all';

    const readSet = () => { try { return new Set(JSON.parse(localStorage.getItem(READ_KEY) || '[]')); } catch (e) { return new Set(); } };
    const saveRead = (s) => { try { localStorage.setItem(READ_KEY, JSON.stringify([...s].slice(-500))); } catch (e) {} };

    function fmtDate(ts) {
      const d = new Date(ts);
      return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) + ', ' +
        d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    }

    function render() {
      const read = readSet();
      const list = el('bmList');
      list.textContent = '';
      const shown = mails.filter((m) => topic === 'all' || m.topic === topic);
      const unread = mails.filter((m) => !read.has(m.key)).length;
      el('bmCount').textContent = '📥 ' + mails.length + ' item' + (mails.length === 1 ? '' : 's') + ' of official correspondence' + (unread ? ' · ' + unread + ' unread' : '');

      // topic chips, built from the data
      const topics = ['all', ...new Set(mails.map((m) => m.topic || 'general'))];
      const chips = el('bmChips');
      chips.textContent = '';
      topics.forEach((t) => {
        const b = document.createElement('button');
        b.className = 'bm-chip';
        b.type = 'button';
        b.textContent = t;
        b.setAttribute('aria-pressed', String(t === topic));
        b.onclick = () => { topic = t; render(); };
        chips.appendChild(b);
      });

      if (!shown.length) {
        const d = document.createElement('div');
        d.className = 'bm-empty';
        d.innerHTML = '<div class="bm-big">🏝</div><p>Inbox zero. The bananas rest.</p>';
        list.appendChild(d);
        return;
      }

      shown.forEach((m) => {
        const isRead = read.has(m.key);
        const card = document.createElement('article');
        card.className = 'bm-mail' + (isRead ? '' : ' bm-mail--unread');

        const head = document.createElement('button');
        head.className = 'bm-mail__head';
        head.type = 'button';
        const top = document.createElement('div');
        top.className = 'bm-mail__top';
        const stamp = document.createElement('span');
        stamp.className = 'bm-stamp' + (m.topic === 'licensing' ? ' bm-stamp--licensing' : '');
        stamp.textContent = m.topic || 'general';
        top.appendChild(stamp);
        // 🎫 a pass-holder is reachable even without an email
        if (m.pass) {
          const ps = document.createElement('span');
          ps.className = 'bm-stamp bm-stamp--pass';
          ps.textContent = '🎫 ' + (m.passName || 'pass-holder');
          top.appendChild(ps);
        }
        top.appendChild(document.createTextNode(' stamped ' + fmtDate(m.ts) + ' · agent ' + String(m.sender || '?').slice(0, 8)));
        const from = document.createElement('p');
        from.className = 'bm-mail__from';
        if (!isRead) { const dot = document.createElement('span'); dot.className = 'bm-dot'; from.appendChild(dot); }
        from.appendChild(document.createTextNode((m.name || 'anonymous banana') + (m.email ? ' <' + m.email + '>' : '')));
        const peek = document.createElement('p');
        peek.className = 'bm-mail__peek';
        peek.textContent = String(m.message || '').slice(0, 90);
        head.appendChild(top); head.appendChild(from); head.appendChild(peek);

        const body = document.createElement('div');
        body.className = 'bm-mail__body';
        body.hidden = true;
        const msg = document.createElement('pre');
        msg.className = 'bm-mail__msg';
        msg.textContent = m.message || '';
        const actions = document.createElement('div');
        actions.className = 'bm-mail__actions';
        if (m.email) {
          const reply = document.createElement('a');
          reply.className = 'bm-btn';
          reply.href = 'mailto:' + encodeURIComponent(m.email) + '?subject=' + encodeURIComponent('Re: your message to the banana guy 🍌');
          reply.textContent = '✉ reply';
          actions.appendChild(reply);
        }
        const shred = document.createElement('button');
        shred.className = 'bm-btn bm-btn--shred';
        shred.type = 'button';
        shred.textContent = '🗑 shred';
        shred.onclick = async () => {
          if (shred.dataset.arm !== '1') { shred.dataset.arm = '1'; shred.textContent = '⚠ shred, really?'; setTimeout(() => { shred.dataset.arm = ''; shred.textContent = '🗑 shred'; }, 3000); return; }
          shred.disabled = true; shred.textContent = 'shredding…';
          try {
            const r = await fetch(API + '/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, keys: [m.key] }) });
            const d = await r.json();
            if (d.ok) {
              card.classList.add('bm-mail--shredding');
              setTimeout(() => { mails = mails.filter((x) => x.key !== m.key); render(); }, 360);
            } else { shred.disabled = false; shred.textContent = '🗑 shred'; }
          } catch (e) { shred.disabled = false; shred.textContent = '🗑 shred'; }
        };
        actions.appendChild(shred);
        body.appendChild(msg); body.appendChild(actions);

        // 💬 THE PASS REPLY DESK — a sender with a pass id is reachable even
        // with no email: the reply is stored per-pass at worker-contact and
        // lands on their My Pass as a "Message from Trym" world notification.
        // The stored replies ARE the correspondence archive, shown under the
        // box. History loads lazily on first open.
        let loadHist = null;
        if (m.pass) {
          const pr = document.createElement('div');
          pr.className = 'bm-passreply';
          pr.innerHTML = '<p class="bm-passreply__head">🎫 reply to their Pass'
            + ' — lands in My Pass as “Message from Trym”' + (m.email ? '' : ' (they left no email)') + '</p>'
            + '<div class="bm-passreply__row"><textarea rows="2" maxlength="2000" placeholder="write back…"></textarea>'
            + '<button class="bm-btn bm-btn--passgo" type="button">💬 send</button></div>'
            + '<div class="bm-passreply__hist"></div>';
          const ta = pr.querySelector('textarea');
          const send = pr.querySelector('.bm-btn--passgo');
          const hist = pr.querySelector('.bm-passreply__hist');
          // ✍️ the TEMPLATE: greeting + signature pre-written, the caret lands
          // in the middle — Trym only thinks about the message itself
          const greet = 'Hey ' + (m.passName || m.name || 'banana friend') + '! 🍌\n\n';
          ta.value = greet + '\n\nBest regards,\nTrym — the banana guy';
          ta.rows = 6;
          ta.addEventListener('focus', () => {
            if (ta.dataset.c) return;
            ta.dataset.c = '1';
            ta.setSelectionRange(greet.length, greet.length);
          });
          const loadHist0 = async () => {
            try {
              const r = await fetch(API + '/replies?pass=' + encodeURIComponent(m.pass));
              const rows = await r.json();
              hist.innerHTML = '';
              if (Array.isArray(rows) && rows.length) {
                const h = document.createElement('p');
                h.className = 'bm-passreply__label';
                h.textContent = '↩ your replies to this pass';
                hist.appendChild(h);
                rows.forEach((rp) => {
                  const d = document.createElement('div');
                  d.className = 'bm-passreply__msg';
                  d.textContent = rp.text;
                  const t = document.createElement('time');
                  t.textContent = ' — ' + fmtDate(rp.ts);
                  d.appendChild(t);
                  hist.appendChild(d);
                });
              }
            } catch (e) {}
          };
          send.onclick = async () => {
            const text = ta.value.trim();
            if (!text) { ta.focus(); return; }
            send.disabled = true; send.textContent = 'sending…';
            try {
              const r = await fetch(API + '/reply', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token, pass: m.pass, text, re: String(m.message || '').slice(0, 300) }),
              });
              const d = await r.json();
              if (d.ok) {
                ta.value = '';
                send.textContent = '✓ delivered';
                loadHist0();
                setTimeout(() => { send.disabled = false; send.textContent = '💬 send'; }, 2500);
              } else { send.disabled = false; send.textContent = '💬 send'; }
            } catch (e) { send.disabled = false; send.textContent = '💬 send'; }
          };
          loadHist = loadHist0;
          body.appendChild(pr);
        }

        head.onclick = () => {
          body.hidden = !body.hidden;
          if (!body.hidden && loadHist) { loadHist(); loadHist = null; }   // once, on first open
          if (!read.has(m.key)) { const s = readSet(); s.add(m.key); saveRead(s); card.classList.remove('bm-mail--unread'); const dt = from.querySelector('.bm-dot'); if (dt) dt.remove(); render0nly(); }
        };
        card.appendChild(head); card.appendChild(body);
        list.appendChild(card);
      });

      function render0nly() { // refresh just the counter without collapsing open mails
        const rd = readSet();
        const un = mails.filter((x) => !rd.has(x.key)).length;
        el('bmCount').textContent = '📥 ' + mails.length + ' item' + (mails.length === 1 ? '' : 's') + ' of official correspondence' + (un ? ' · ' + un + ' unread' : '');
      }
    }

    async function load() {
      const r = await fetch(API + '/messages?token=' + encodeURIComponent(token));
      if (r.status === 403) return false;
      mails = await r.json();
      return true;
    }

    // ---- 🗑 the spam quarantine: lazy-loaded raw data, inspected once in a
    // while — reason tag says which gate fired (honeypot / too-fast / bad-origin)
    let spamLoaded = false;
    async function renderSpam() {
      const list = el('bmSpamList');
      list.textContent = 'opening the bin…';
      let items = [];
      try { items = await (await fetch(API + '/spam?token=' + encodeURIComponent(token))).json(); }
      catch (e) { list.textContent = 'couldn’t open the bin — try again.'; return; }
      list.textContent = '';
      if (!items.length) {
        list.innerHTML = '<p class="bm-livenote">🗑 the bin is empty — no gate has fired since the quarantine went live.</p>';
        return;
      }
      items.forEach((m) => {
        const card = document.createElement('article');
        card.className = 'bm-mail';
        const head = document.createElement('button');
        head.className = 'bm-mail__head';
        head.type = 'button';
        const top = document.createElement('div');
        top.className = 'bm-mail__top';
        const stamp = document.createElement('span');
        stamp.className = 'bm-stamp bm-stamp--licensing'; // red-ish = flagged
        stamp.textContent = m.reason || 'spam';
        top.appendChild(stamp);
        top.appendChild(document.createTextNode(' caught ' + fmtDate(m.ts)));
        const from = document.createElement('p');
        from.className = 'bm-mail__from';
        from.textContent = (m.name || 'no name') + (m.email ? ' <' + m.email + '>' : '');
        const peek = document.createElement('p');
        peek.className = 'bm-mail__peek';
        peek.textContent = String(m.message || '').slice(0, 90);
        head.appendChild(top); head.appendChild(from); head.appendChild(peek);
        const body = document.createElement('div');
        body.className = 'bm-mail__body';
        body.hidden = true;
        const msg = document.createElement('pre');
        msg.className = 'bm-mail__msg';
        msg.textContent = m.message || '';
        const actions = document.createElement('div');
        actions.className = 'bm-mail__actions';
        if (m.email) {
          const reply = document.createElement('a');
          reply.className = 'bm-btn';
          reply.href = 'mailto:' + encodeURIComponent(m.email) + '?subject=' + encodeURIComponent('Re: your message to the banana guy 🍌');
          reply.textContent = '✉ reply (it was real!)';
          actions.appendChild(reply);
        }
        const shred = document.createElement('button');
        shred.className = 'bm-btn bm-btn--shred';
        shred.type = 'button';
        shred.textContent = '🗑 shred';
        shred.onclick = async () => {
          shred.disabled = true;
          try {
            const r = await fetch(API + '/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, keys: [m.key] }) });
            if ((await r.json()).ok) card.remove(); else shred.disabled = false;
          } catch (e) { shred.disabled = false; }
        };
        actions.appendChild(shred);
        body.appendChild(msg); body.appendChild(actions);
        head.onclick = () => { body.hidden = !body.hidden; };
        card.appendChild(head); card.appendChild(body);
        list.appendChild(card);
      });
    }
    el('bmSpamToggle').onclick = () => {
      const pane = el('bmSpamPane');
      pane.hidden = !pane.hidden;
      if (!pane.hidden && !spamLoaded) { spamLoaded = true; renderSpam(); }
    };

    async function boot() {
      // token: URL fragment (from the old bookmark redirect) → localStorage → ask
      const frag = new URLSearchParams(location.hash.slice(1));
      if (frag.get('gkey')) { // gallery key may ride the same bookmark fragment
        gkey = frag.get('gkey');
        try { localStorage.setItem('gallery-key', gkey); } catch (e) {}
      }
      if (frag.get('token')) {
        token = frag.get('token');
        history.replaceState(null, '', location.pathname); // never leave it visible
      } else {
        try { token = localStorage.getItem('inbox-token') || ''; } catch (e) {}
      }
      if (frag.get('gkey') && !frag.get('token')) history.replaceState(null, '', location.pathname);
      if (token && await load().catch(() => false)) {
        try { localStorage.setItem('inbox-token', token); } catch (e) {}
        el('bmApp').hidden = false;
        render();
        return;
      }
      token = '';
      el('bmGate').hidden = false;
    }

    el('bmClockIn').onclick = async () => {
      token = el('bmToken').value.trim();
      el('bmWrong').hidden = true;
      if (token && await load().catch(() => false)) {
        try { localStorage.setItem('inbox-token', token); } catch (e) {}
        el('bmGate').hidden = true;
        el('bmApp').hidden = false;
        render();
      } else {
        token = '';
        el('bmWrong').hidden = false;
      }
    };
    el('bmToken').addEventListener('keydown', (e) => { if (e.key === 'Enter') el('bmClockIn').click(); });

    el('bmReadAll').onclick = () => {
      const s = readSet();
      mails.forEach((m) => s.add(m.key));
      saveRead(s);
      render();
    };
    el('bmLogout').onclick = () => {
      try { localStorage.removeItem('inbox-token'); } catch (e) {}
      try { localStorage.removeItem('gallery-key'); } catch (e) {}
      location.reload();
    };

    // ── 🖼 THE CURATION DESK — the gallery inbox under the same roof ──
    const GAL = 'https://banana-share.trymstene.workers.dev';
    let gkey = '';
    try { gkey = localStorage.getItem('gallery-key') || ''; } catch (e) {}
    let galItems = null; // null = not loaded yet

    function setTab(which) { // 'mail' | 'gal' | 'rave' | 'items' | 'users' | 'world'
      el('bmTabUsers').setAttribute('aria-selected', String(which === 'users'));
      el('bmPaneUsers').hidden = which !== 'users';
      if (which === 'users') usersBoot();
      el('bmTabMail').setAttribute('aria-selected', String(which === 'mail'));
      el('bmTabGal').setAttribute('aria-selected', String(which === 'gal'));
      el('bmTabRave').setAttribute('aria-selected', String(which === 'rave'));
      el('bmTabItems').setAttribute('aria-selected', String(which === 'items'));
      el('bmTabWorld').setAttribute('aria-selected', String(which === 'world'));
      el('bmPaneMail').hidden = which !== 'mail';
      el('bmPaneGal').hidden = which !== 'gal';
      el('bmPaneRave').hidden = which !== 'rave';
      el('bmPaneItems').hidden = which !== 'items';
      el('bmPaneWorld').hidden = which !== 'world';
      el('bmTabPulse').setAttribute('aria-selected', String(which === 'pulse'));
      el('bmPanePulse').hidden = which !== 'pulse';
      if (which === 'pulse') pulseLoad();
      el('bmTabDev').setAttribute('aria-selected', String(which === 'dev'));
      el('bmPaneDev').hidden = which !== 'dev';
      if (which === 'dev') devLoad();
      if (which === 'gal') galBoot();
      if (which === 'rave') raveLoad();
      if (which === 'items') itemsLoad();
      if (which === 'world') worldLoad();
    }
    el('bmTabMail').onclick = () => setTab('mail');
    el('bmTabGal').onclick = () => setTab('gal');
    el('bmTabRave').onclick = () => setTab('rave');
    el('bmTabItems').onclick = () => setTab('items');
    el('bmTabUsers').onclick = () => setTab('users');
    el('bmTabWorld').onclick = () => setTab('world');
    el('bmTabPulse').onclick = () => setTab('pulse');
    el('bmTabDev').onclick = () => setTab('dev');
    // ⚠️ the markup can show a pane but it cannot RUN one. Pulse opens first, so
    // it needs the same setTab that every other tab gets from a click — without
    // this the desk renders an empty pane and waits for a tab press.
    // ⚠️⭐ BUT NOT HERE. The call is at the BOTTOM of this module, and moving it
    // back up breaks the whole desk. setTab('pulse') runs pulseLoad(), which
    // reads `pulseAt` — declared seven lines BELOW this comment. Reading a `let`
    // before its declaration throws, and the throw does not stop at Pulse: it
    // aborts the rest of the module, so the items desk, the rave desk and the
    // dev desk were never wired at all. The page still LOOKED like Banana HQ.

    // ── 📈 THE WORLD DESK ──
    // Two reads, both server truth: the pass rollup (one file a day, written
    // by a cron that pages the whole bucket) and the yard census (arithmetic
    // inside a loop the stats route already runs). Nothing here is GA4, so
    // nothing here is lost to a consent banner or an adblocker.
    let pulseMod = null, pulseApp = null, pulseAt = 0;
    async function pulseLoad(force) {
      const host = el('bmPulse');
      if (!force && Date.now() - pulseAt < 60000 && host.childElementCount) return;
      const key = (localStorage.getItem('pass-admin-key-v1') || '').trim();
      if (!key) {
        host.innerHTML = '';
        const p = document.createElement('div');
        p.className = 'hqp-empty';
        p.textContent = 'The world desk reads the pass ledger. Open the Users tab and paste the pass admin key once — it is remembered on this device.';
        host.appendChild(p);
        return;
      }
      if (!host.childElementCount) {
        const p = document.createElement('div');
        p.className = 'hqp-empty';
        p.textContent = 'reading the world…';
        host.appendChild(p);
      }
      try {
        if (!pulseMod) pulseMod = await import('../scripts/pulse-shell.js');
        // 📡 Google comes THROUGH worker-contact — the dashboard token lives
        // there as a secret, so no GA4 credential reaches this browser and
        // there is one door. The workers' own numbers come straight.
        // the key rides a HEADER now — a token in a URL ends up in history,
        // in the console and in screenshots of the console
        // a failed read comes back as { __err } so a room can SAY what happened
        // instead of sitting on a loading line forever
        const px = (r, q) => fetch(API + '/pulse?r=' + r + (q || ''), { headers: { 'X-Inbox-Token': token || '' } })
          .then(async (x) => {
            if (x.ok) return x.json();
            let why = 'the dashboard answered ' + x.status;
            try { const j = await x.json(); if (j && j.err) why = j.err; } catch (e) {}
            return { __err: why };
          })
          .catch((e) => ({ __err: 'could not reach the dashboard (' + String(e.message || e).slice(0, 80) + ')' }));
        if (pulseApp) pulseApp.destroy();
        pulseApp = pulseMod.mountPulse(host, {
          live: () => px('live'),
          range: (from, to) => px('range', '&from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to)),
          analyst: () => px('analyst'),
          report: () => px('report'),
          ledger: () => Promise.all([
            fetch(PASS_ADMIN_API + '/admin/rollup?days=30&key=' + encodeURIComponent(key))
              .then((r) => (r.ok ? r.json() : null)).catch(() => null),
            fetch(WORLD_API + '/yards/stats').then((r) => (r.ok ? r.json() : null)).catch(() => null),
          ]).then(([roll, world]) => ({ roll, world })),
        });
        pulseAt = Date.now();
      } catch (e) {
        host.innerHTML = '';
        const p = document.createElement('div');
        p.className = 'hqp-empty';
        p.textContent = 'the world desk could not be read — try again in a moment';
        host.appendChild(p);
      }
    }

    // ── 🛠 THE DEV DESK — the rig's mission control ──
    // Reads: GitHub public API (public repo, ~4 calls per open — the 60/hr
    // unauthenticated limit is plenty). Writes: worker-contact /dev/gh with
    // the inbox token; the worker holds the PAT. pat:false = buttons stay
    // disabled and the read-only note shows.
    const GH_API = 'https://api.github.com/repos/trymstene/trymstene.github.io';
    let devPat = false, devPinged = false;
    const devAgo = (iso) => {
      const sec = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
      if (sec < 3600) return Math.round(sec / 60) + 'm ago';
      if (sec < 86400) return Math.round(sec / 3600) + 'h ago';
      return Math.round(sec / 86400) + 'd ago';
    };
    const devEsc = (t) => String(t || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    // ⚠️ OPTIMISTIC BY DESIGN: GitHub's read API is eventually-consistent —
    // refetching right after a write renders GHOSTS (a merged PR came back
    // "open" and regrew its merge button on Trym's screen). So actions update
    // the DOM locally and NEVER auto-refetch; the ↻ chip or a tab re-open
    // reconciles once GitHub has caught up.
    async function devAct(num, action, note, btn) {
      if (btn) btn.disabled = true;
      try {
        const r = await fetch(API + '/dev/gh', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, number: num, action, body: note || '' }) });
        const j = await r.json();
        if (!j.ok) throw new Error(j.err || 'no');
        if (action === 'approve' || action === 'dismiss') devRecent(num, action);
        return true;
      } catch (e) {
        if (btn) { btn.disabled = false; btn.textContent = '✕ ' + String(e.message || 'github said no').slice(0, 50) + ' — retry'; }
        return false;
      }
    }
    const devRecent = (n, action) => {
      try {
        const m = JSON.parse(sessionStorage.getItem('bmDevRecent') || '{}');
        if (action) { m[n] = { a: action, t: Date.now() }; sessionStorage.setItem('bmDevRecent', JSON.stringify(m)); return; }
        const r = m[n];
        return r && Date.now() - r.t < 300000 ? r.a : null;
      } catch (e) { return null; }
    };
    const devFade = (card) => { card.style.transition = 'opacity 0.45s, transform 0.45s'; card.style.opacity = '0'; card.style.transform = 'translateX(14px)'; setTimeout(() => card.remove(), 480); };
    const devBumpCount = (id, delta) => { const e2 = el(id); const n = parseInt(e2.textContent, 10); if (!isNaN(n)) e2.textContent = Math.max(0, n + delta); };
    function devIssueCard(it) {
      const card = document.createElement('div');
      card.className = 'bm-devcard';
      const labels = (it.labels || []).map((l) => {
        const n = typeof l === 'string' ? l : l.name;
        const cls = n === 'approved' ? ' bm-devlabel--approved' : n === 'dismissed' ? ' bm-devlabel--dismissed' : '';
        return '<span class="bm-devlabel' + cls + '">' + devEsc(n) + '</span>';
      }).join('');
      const body = String(it.body || '').replace(/[#*`>\[\]()]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 220);
      card.innerHTML =
        '<div class="bm-devtitle"><a href="' + devEsc(it.html_url) + '" target="_blank" rel="noopener">#' + it.number + ' — ' + devEsc(it.title) + '</a></div>'
        + '<div class="bm-devmeta"><span>' + devAgo(it.created_at) + '</span><span>💬 ' + (it.comments || 0) + '</span>' + labels + '</div>'
        + (body ? '<div class="bm-devbody">' + devEsc(body) + (String(it.body || '').length > 220 ? '…' : '') + '</div>' : '')
        + '<div class="bm-devacts">'
        + '<button type="button" class="bm-devok" data-a="approve">✅ approve</button>'
        + '<button type="button" data-a="talk">💬 comment</button>'
        + '<button type="button" class="bm-devno" data-a="dismiss">✕ dismiss</button>'
        + '</div>'
        + '<div class="bm-devcomment"><textarea placeholder="a note for the team… (rides along with approve/dismiss too)"></textarea>'
        + '<div class="bm-devacts"><button type="button" data-a="send">💬 send comment</button></div></div>';
      const ta = card.querySelector('textarea');
      const commentBox = card.querySelector('.bm-devcomment');
      const already = (it.labels || []).some((l) => (l.name || l) === 'approved');
      card.querySelectorAll('button').forEach((b) => {
        const a = b.dataset.a;
        if (!devPat && a !== 'talk') b.disabled = true;
        if (already && a === 'approve') { b.disabled = true; b.textContent = '✅ approved'; }
        b.onclick = async () => {
          if (a === 'talk') { commentBox.classList.toggle('is-open'); if (commentBox.classList.contains('is-open')) ta.focus(); return; }
          if (a === 'send') {
            if (!ta.value.trim()) return;
            b.textContent = '⏳ sending…';
            if (await devAct(it.number, 'comment', ta.value.trim(), b)) {
              ta.value = ''; commentBox.classList.remove('is-open');
              b.textContent = '💬 send comment'; b.disabled = false;
              const meta = card.querySelector('.bm-devmeta span:nth-child(2)');
              if (meta) meta.textContent = '💬 ' + ((parseInt(meta.textContent.replace(/\D/g, ''), 10) || 0) + 1);
            }
            return;
          }
          b.textContent = a === 'approve' ? '⏳ approving…' : '⏳ dismissing…';
          if (await devAct(it.number, a, ta.value.trim(), b)) {
            if (a === 'approve') {
              b.textContent = '✅ approved';
              const meta = card.querySelector('.bm-devmeta');
              if (meta && !meta.querySelector('.bm-devlabel--approved')) meta.insertAdjacentHTML('beforeend', '<span class="bm-devlabel bm-devlabel--approved">approved</span>');
            } else {
              devFade(card);
              devBumpCount('bmDevQueueN', -1);
              const badge = el('bmDevBadge');
              if (badge) { const n = Math.max(0, (parseInt(badge.textContent, 10) || 1) - 1); badge.textContent = n; badge.hidden = !n; }
            }
          }
        };
      });
      return card;
    }
    async function devLoad() {
      const put = (id, v) => { el(id).textContent = v; };
      if (!devPinged) {
        devPinged = true;
        try {
          const j = await (await fetch(API + '/dev/ping?token=' + encodeURIComponent(token))).json();
          devPat = !!j.pat;
        } catch (e) { devPat = false; }
        el('bmDevMode').hidden = devPat;
      }
      try {
        const runs = await (await fetch(GH_API + '/actions/runs?per_page=1')).json();
        const r0 = (runs.workflow_runs || [])[0];
        put('bmDevDeploy', r0 ? ((r0.conclusion === 'success' ? '✅' : r0.status !== 'completed' ? '⏳' : '❌') + ' ' + devAgo(r0.updated_at)) : '—');
      } catch (e) { put('bmDevDeploy', '?'); }
      try {
        const issues = (await (await fetch(GH_API + '/issues?state=open&per_page=30')).json())
          .filter((x) => !x.pull_request);
        put('bmDevQueueN', issues.length);
        const badge = el('bmDevBadge');
        if (badge) { badge.textContent = issues.length; badge.hidden = !issues.length; }
        const q = el('bmDevQueue');
        q.replaceChildren();
        const shown = issues.filter((it) => devRecent(it.number) !== 'dismissed');
        shown.forEach((it) => {
          if (devRecent(it.number) === 'approve' && !(it.labels || []).some((l) => (l.name || l) === 'approved')) {
            it.labels = [...(it.labels || []), { name: 'approved' }]; // GitHub's cache is behind our own action
          }
        });
        if (!shown.length) q.innerHTML = '<p class="bm-devempty">the desk is clear — nobody has filed anything 🍃</p>';
        else shown.forEach((it) => q.appendChild(devIssueCard(it)));
      } catch (e) { el('bmDevQueue').innerHTML = '<p class="bm-devempty">github is not answering — try a refresh</p>'; }
      try {
        const prs = (await (await fetch(GH_API + '/pulls?state=open&per_page=15')).json())
          .filter((pr) => devRecent(pr.number) !== 'merged');
        put('bmDevPrN', prs.length);
        const host = el('bmDevPrs');
        host.replaceChildren();
        if (!prs.length) { host.innerHTML = '<p class="bm-devempty">nothing in flight — the workshop is quiet 🔧</p>'; return; }
        for (const pr of prs) {
          const card = document.createElement('div');
          card.className = 'bm-devcard';
          card.innerHTML = '<div class="bm-devtitle"><a href="' + devEsc(pr.html_url) + '" target="_blank" rel="noopener">#' + pr.number + ' — ' + devEsc(pr.title) + '</a></div>'
            + '<div class="bm-devmeta"><span>' + devEsc(pr.head ? pr.head.ref : '') + '</span><span>' + devAgo(pr.created_at) + '</span><span class="bm-devci" id="bmDevCi' + pr.number + '">⏳ checks…</span></div>';
          host.appendChild(card);
          fetch(GH_API + '/commits/' + pr.head.sha + '/check-runs').then((x) => x.json()).then((cr) => {
            const cruns = cr.check_runs || [];
            const bad = cruns.some((c) => c.conclusion && c.conclusion !== 'success' && c.conclusion !== 'neutral' && c.conclusion !== 'skipped');
            const running = cruns.some((c) => c.status !== 'completed');
            const ci = el('bmDevCi' + pr.number);
            if (!ci) return;
            ci.textContent = !cruns.length ? '— no checks' : running ? '⏳ running' : bad ? '❌ checks failing' : '✅ checks green';
            ci.className = 'bm-devci ' + (running ? 'bm-devci--run' : bad ? 'bm-devci--bad' : 'bm-devci--ok');
            // 🔀 the merge button appears only for a green, actionable PR —
            // and only when the worker holds the key
            if (devPat && !running && !bad && cruns.length) {
              const acts = document.createElement('div');
              acts.className = 'bm-devacts';
              acts.innerHTML = '<button type="button" class="bm-devok">🔀 merge it</button>';
              const mb = acts.querySelector('button');
              mb.onclick = async () => {
                mb.disabled = true; mb.textContent = '⏳ merging…';
                try {
                  const r2 = await fetch(API + '/dev/gh', { method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token, number: pr.number, action: 'merge' }) });
                  const j2 = await r2.json();
                  if (!j2.ok) throw new Error(j2.err || 'no');
                  devRecent(pr.number, 'merged');
                  mb.textContent = '🎉 merged';
                  const ciPill = el('bmDevCi' + pr.number);
                  if (ciPill) { ciPill.textContent = '🎉 merged'; ciPill.className = 'bm-devci bm-devci--ok'; }
                  devBumpCount('bmDevPrN', -1);
                  setTimeout(() => devFade(card), 1400);
                } catch (e2) { mb.textContent = '✕ ' + String(e2.message || 'github said no').slice(0, 60) + ' — retry'; mb.disabled = false; }
              };
              card.appendChild(acts);
            }
          }).catch(() => {});
        }
      } catch (e) { el('bmDevPrs').innerHTML = '<p class="bm-devempty">github is not answering — try a refresh</p>'; }
    }
    el('bmDevRefresh').onclick = () => devLoad();
    el('bmDevFileBtn').onclick = async () => {
      const title = el('bmDevNewTitle').value.trim();
      if (!title) { el('bmDevNewTitle').focus(); return; }
      const btn = el('bmDevFileBtn');
      btn.disabled = true; btn.textContent = '⏳ filing…';
      try {
        const r = await fetch(API + '/dev/gh', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, action: 'file', title, body: el('bmDevNewBody').value.trim() }) });
        const j = await r.json();
        if (!j.ok) throw new Error(j.err || 'no');
        const it = { number: j.number, title, body: el('bmDevNewBody').value.trim(),
          html_url: 'https://github.com/trymstene/trymstene.github.io/issues/' + j.number,
          created_at: new Date().toISOString(), comments: 0, labels: [{ name: 'from-hq' }] };
        const q = el('bmDevQueue');
        const empty = q.querySelector('.bm-devempty');
        if (empty) empty.remove();
        q.prepend(devIssueCard(it));
        devBumpCount('bmDevQueueN', 1);
        el('bmDevNewTitle').value = ''; el('bmDevNewBody').value = '';
        btn.textContent = '✅ filed as #' + j.number;
        setTimeout(() => { btn.textContent = '📝 put it on the desk'; btn.disabled = false; }, 1800);
      } catch (e) { btn.textContent = '✕ github said no — retry'; btn.disabled = false; }
    };

    // ── 🌍 THE WORLD DESK — live headcounts from the rooms ──
    const WORLD_API = 'https://banana-rave.trymstene.workers.dev';
    // light=true (the 30s tick) refreshes only the cheap room headcounts;
    // yard stats + the shop's REAL cart test + review counts load on open
    // and manual refresh — the buyable check talks to Shopify and must never
    // ride an interval
    async function worldLoad(light) {
      const put = (id, v) => { el(id).textContent = v; };
      try {
        const r = await fetch(WORLD_API + '/count').then((x) => x.json());
        put('bmWorldClub', r.count ?? '?');
      } catch (e) { put('bmWorldClub', '?'); }
      try {
        const p = await fetch(WORLD_API + '/park-count').then((x) => x.json());
        put('bmWorldPark', p.count ?? '?');
      } catch (e) { put('bmWorldPark', '?'); }
      try {
        const b = await fetch(WORLD_API + '/beach-count').then((x) => x.json());
        put('bmWorldBeach', b.count ?? '?');
      } catch (e) { put('bmWorldBeach', '?'); }
      if (light) return;
      try {
        const y = await fetch(WORLD_API + '/yards/stats').then((x) => x.json());
        put('bmWorldYards', y.yards ?? '?');
        put('bmWorldYardsDay', y.day ?? '?');
        put('bmWorldYardsWeek', y.week ?? '?');
        // 👥 the census — names are VISITOR INPUT: textContent only
        const box = el('bmYardList');
        box.textContent = '';
        const STAGE = ['🪧 plot', '⛺ tent', '🛖 cabin', '🏠 house'];
        (y.list || []).forEach((e2) => {
          const row = document.createElement('a');
          row.className = 'hq-yard' + (e2.qa ? ' hq-yard--qa' : '');
          row.href = '/homestead/' + e2.slug + '/';
          const nm = document.createElement('b');
          nm.textContent = e2.name || e2.slug;
          const st = document.createElement('span');
          st.textContent = STAGE[e2.stage] || STAGE[0];
          const when = document.createElement('span');
          when.className = 'hq-yard__when';
          const d2 = Math.floor((Date.now() - (e2.updated || 0)) / 86400000);
          when.textContent = (e2.qa ? 'QA · ' : '') + (d2 === 0 ? 'built on today' : d2 === 1 ? 'yesterday' : d2 + ' days ago');
          row.append(nm, st, when);
          box.appendChild(row);
        });
      } catch (e) { put('bmWorldYards', '?'); put('bmWorldYardsDay', '?'); put('bmWorldYardsWeek', '?'); }
      try {
        put('bmWorldShop', '…');
        const h = await fetch('https://banana-sticker.trymstene.workers.dev/health?buyable=1').then((x) => x.json());
        const entries = h.buyable && typeof h.buyable === 'object' ? Object.values(h.buyable) : null;
        const bad = entries ? entries.some((p2) => ['verdict', 'published', 'channels']
          .some((k) => String((p2 || {})[k] || '').includes('❌'))) : null;
        el('bmWorldShop').textContent = bad === null ? '?' : bad ? '✗ CHECK IT' : '✓ buyable';
        el('bmWorldShop').style.color = bad ? 'var(--hot2)' : '';
      } catch (e) { put('bmWorldShop', '?'); }
      // review + mail counts ride data other desks already fetched
      try {
        const g = parseInt(el('bmGalBadge').textContent || '0', 10) || 0;
        const it = parseInt(el('bmItemsBadge').textContent || '0', 10) || 0;
        put('bmWorldReviews', g + it);
      } catch (e) { put('bmWorldReviews', '?'); }
      try {
        const rd = readSet();
        put('bmWorldUnread', mails.filter((x) => !rd.has(x.key)).length);
      } catch (e) { put('bmWorldUnread', '?'); }
    }
    el('bmWorldRefresh').onclick = () => worldLoad(false);
    setInterval(() => { if (!el('bmPaneWorld').hidden && !document.hidden) worldLoad(true); }, 30000);

    // ── 👤 THE USERS DESK ────────────────────────────────────────────────
    // Was a read-only ledger that printed seven emoji facts per person in one
    // wrapping line. Now: summary tiles, search, sort, one row per pass, and
    // every row opens onto controls that CAN change something.
    // ⚠️ NAMES ARE VISITOR INPUT — textContent only, never innerHTML, same rule
    // as the mail room.
    // ⚠️ WHAT THE CONTROLS DELIBERATELY DO NOT OFFER: lowering rep/jelly,
    // revoking gear, clearing a name. Blobs merge by MAX (and a blank name
    // loses to the stored one), so the player's very next sync would restore
    // the old value and the edit would vanish with no error. Taking coins is
    // offered because it raises coins_spent, which the merge keeps.
    const PASS_ADMIN_API = 'https://banana-pass.trymstene.workers.dev';
    const LKEY = 'pass-admin-key-v1';
    let uRows = null, uOpen = null;
    try { el('bmLedgerKey').value = localStorage.getItem(LKEY) || ''; } catch (e) {}
    const uKey = () => el('bmLedgerKey').value.trim();
    const ago = (t) => {
      if (!t) return 'never';
      const d = Math.floor((Date.now() - t) / 86400000);
      return d <= 0 ? 'today' : d === 1 ? 'yesterday' : d + ' days ago';
    };
    const tile = (n, label) => {
      const d = document.createElement('div');
      d.className = 'hq-tile';
      const b = document.createElement('b'); b.textContent = n;
      const s2 = document.createElement('span'); s2.textContent = label;
      d.append(b, s2);
      return d;
    };

    async function usersBoot() { if (uRows === null && uKey()) ledgerLoad(); }

    async function ledgerLoad() {
      const key = uKey();
      const box = el('bmLedgerList');
      if (!key) { box.textContent = 'The vault wants a key.'; return; }
      try { localStorage.setItem(LKEY, key); } catch (e) {}
      box.textContent = 'Opening the vault…';
      try {
        const r = await fetch(PASS_ADMIN_API + '/admin/ledger?key=' + encodeURIComponent(key));
        if (!r.ok) throw new Error(r.status);
        const d = await r.json();
        uRows = d.passes || [];
        const tiles = el('bmUTiles');
        tiles.textContent = '';
        tiles.hidden = false;
        tiles.append(
          tile(d.sum.passes, 'passes'),
          tile(d.sum.withMail, 'can log back in'),
          tile(d.sum.passes - d.sum.withMail, 'one device only'),
          tile(d.sum.activeWeek, 'active this week'),
          tile(d.sum.coins.toLocaleString('en-GB'), 'coins in circulation'),
          tile(d.sum.badges, 'badges earned'),
        );
        el('bmUTools').hidden = uRows.length < 2;
        el('bmUCount').textContent = '👤 ' + d.sum.passes + ' pass' + (d.sum.passes === 1 ? '' : 'es')
          + (d.truncated ? ' (first ' + d.scanned + ' scanned)' : '');
        usersRender();
      } catch (e) {
        el('bmUTiles').hidden = true;
        box.textContent = '❌ the vault says no — wrong key, or PASS_ADMIN_KEY is not set on the worker yet.';
      }
    }

    function usersRender() {
      const box = el('bmLedgerList');
      box.textContent = '';
      if (!uRows) return;
      const q = (el('bmUSearch').value || '').trim().toLowerCase();
      const sort = el('bmUSort').value;
      const cmp = {
        recent: (a, b) => b.updated - a.updated,
        coins: (a, b) => b.coins - a.coins,
        rep: (a, b) => b.rep - a.rep,
        badges: (a, b) => b.badges - a.badges,
        new: (a, b) => b.created - a.created,
        risk: (a, b) => (a.mail === b.mail ? b.rep - a.rep : a.mail === true ? 1 : b.mail === true ? -1 : b.rep - a.rep),
      }[sort] || ((a, b) => b.updated - a.updated);
      const rows = uRows
        .filter((p) => !q || (p.name || '').toLowerCase().includes(q) || p.id.includes(q))
        .sort(cmp);
      if (!rows.length) {
        box.appendChild(Object.assign(document.createElement('p'), {
          className: 'bm-livenote',
          textContent: uRows.length ? 'Nobody matches that.' : 'No synced passes yet — the ledger fills as people log in.',
        }));
        return;
      }
      rows.forEach((p) => {
        const row = document.createElement('button');
        row.className = 'hq-row';
        row.type = 'button';
        row.setAttribute('aria-expanded', String(uOpen === p.id));
        const who = document.createElement('span');
        who.className = 'hq-row__who';
        const nm = document.createElement('span');
        nm.className = 'hq-row__name';
        nm.textContent = p.name || 'no name yet';
        const sub = document.createElement('span');
        sub.className = 'hq-row__sub';
        sub.textContent = p.id + ' · seen ' + ago(p.updated);
        who.append(nm, document.createElement('br'), sub);
        const lvl = document.createElement('span');
        lvl.className = 'hq-lvl';
        lvl.textContent = 'LVL ' + p.level;
        const coins = document.createElement('span');
        coins.className = 'hq-num';
        coins.textContent = '🪙 ' + p.coins;
        const rec = document.createElement('span');
        // mail === null means the scan was truncated before it could prove
        // recovery either way — say UNKNOWN rather than accusing a pass of
        // being one dead phone from gone
        rec.className = 'hq-rec ' + (p.mail === null ? 'hq-rec--unknown' : p.mail ? 'hq-rec--yes' : 'hq-rec--no');
        rec.textContent = p.mail === null ? '—' : p.mail ? 'EMAIL' : 'DEVICE';
        rec.title = p.mail === null ? 'not read this scan — the ledger was truncated'
          : p.mail ? 'has an email — can log in anywhere' : 'device only — a lost device is a lost pass';
        row.append(who, lvl, coins, rec);
        row.onclick = () => { uOpen = uOpen === p.id ? null : p.id; usersRender(); };
        box.appendChild(row);
        if (uOpen === p.id) box.appendChild(userPanel(p));
      });
    }

    // the open row, in three LABELLED sections (Trym: the pill-wall read as
    // one dense smear): the numbers as mini stat cells, the gear as its own
    // chip shelf, then the give controls
    function userPanel(p) {
      const wrap = document.createElement('div');
      wrap.className = 'hq-open';
      const sec = (t) => {
        const h = document.createElement('p');
        h.className = 'hq-sec';
        h.textContent = t;
        return h;
      };

      wrap.appendChild(sec('📊 the numbers'));
      const stats = document.createElement('div');
      stats.className = 'hq-stats';
      [
        [p.badges, 'badges'], [p.rep, 'rep'], [p.jelly, 'jelly'],
        [p.days, 'days played'], [p.devices, 'devices'], [p.shelf, 'on the shelf'],
        [p.coinsEarned, 'coins earned'], [p.coinsSpent, 'coins spent'],
        // 📜 the tape: how many events the player's devices reported, and the
        // drift — what their ledger moved beyond what those events explain.
        // 0 = every coin has a story. Big and growing = look at the events.
        // (advisory: a device on old JS reports no events at all)
        [p.ev || 0, 'events logged'], [p.drift || 0, 'drift' + (p.unsure ? ' · ' + p.unsure + ' unsure' : '')],
        // 💰 the server wallet: coins above ARE it once frozen; refused = spends the server would not carry
        [p.wallet ? p.refused || 0 : '—', p.wallet ? 'refused spends' : 'wallet not frozen yet'],
        // 📏 faucet rules: events a rule refused, and homestead events that named no faucet (old JS)
        [p.rr || 0, 'rule refusals' + (p.unruled ? ' · ' + p.unruled + ' unnamed' : '')],
      ].forEach(([v, label]) => {
        const c = document.createElement('div');
        c.className = 'hq-stat';
        const b = document.createElement('b');
        b.textContent = String(v);
        const s2 = document.createElement('span');
        s2.textContent = label;
        c.append(b, s2);
        stats.appendChild(c);
      });
      wrap.appendChild(stats);

      if (Array.isArray(p.evLast) && p.evLast.length) {
        wrap.appendChild(sec('📜 the last events'));
        const tape = document.createElement('div');
        tape.className = 'hq-gear';
        p.evLast.slice().reverse().forEach((e) => {
          const s2 = document.createElement('span');
          s2.className = 'hq-gearchip';
          const when = new Date(e.t || 0);
          s2.textContent = when.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) + ' '
            + when.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })
            + ' · ' + (e.a || '?') + ' · ' + e.k + ' ' + (e.d > 0 ? '+' : '') + e.d + (e.s ? ' (' + e.s + ')' : '');
          tape.appendChild(s2);
        });
        wrap.appendChild(tape);
      }

      wrap.appendChild(sec('🎒 the gear'));
      const gearBox = document.createElement('div');
      gearBox.className = 'hq-gear';
      const gearList = [...p.gear, ...(p.glow ? ['glowstick 🥢'] : [])];
      if (gearList.length) {
        gearList.forEach((g) => {
          const s2 = document.createElement('span');
          s2.className = 'hq-gearchip';
          s2.textContent = g;
          gearBox.appendChild(s2);
        });
      } else {
        const s2 = document.createElement('span');
        s2.className = 'hq-gearchip';
        s2.textContent = 'no gear yet';
        gearBox.appendChild(s2);
      }
      wrap.appendChild(gearBox);

      wrap.appendChild(sec('🎁 give things'));
      const said = document.createElement('p');
      said.className = 'hq-said';
      const give = document.createElement('div');
      give.className = 'hq-give';

      const field = (label, ph, act, btn, cls) => {
        const cell = document.createElement('div');
        const lb = document.createElement('label');
        lb.textContent = label;
        const row = document.createElement('div');
        row.className = 'hq-give__row';
        const inp = document.createElement('input');
        inp.type = 'text';
        inp.inputMode = act === 'gear' ? 'text' : 'numeric';
        inp.placeholder = ph;
        const go = document.createElement('button');
        go.type = 'button';
        go.className = 'hq-mini ' + (cls || 'hq-mini--go');
        go.textContent = btn;
        go.onclick = async () => {
          const v = inp.value.trim();
          if (!v) return;
          // supporter (member:) gear rides the live BMAC grant, never an own_
          // stat — a granted stat would be permanent (max-merge) and meaningless
          if (act === 'gear' && /^tophat(blue|silver|gold)$/.test(v)) {
            said.textContent = '🎩 supporter hats come from a live membership, not a grant — nothing sent';
            return;
          }
          go.disabled = true;
          said.textContent = 'Sending…';
          try {
            const body = { key: uKey(), id: p.id };
            body[act] = act === 'gear' ? v : Number(v);
            const r = await fetch(PASS_ADMIN_API + '/admin/grant', {
              method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
            });
            const d = await r.json();
            if (!r.ok) throw new Error(d.error || r.status);
            said.textContent = '✅ ' + d.did.join(', ') + ' — now 🪙 ' + d.coins + ' · ⭐ ' + d.rep;
            inp.value = '';
            Object.assign(p, { coins: d.coins, rep: d.rep, jelly: d.jelly });
          } catch (e) {
            said.textContent = '❌ ' + ((e && e.message) || 'that did not go through');
          }
          go.disabled = false;
        };
        row.append(inp, go);
        cell.append(lb, row);
        return cell;
      };
      give.append(
        field('give coins', '100', 'coins', 'give'),
        field('take coins', '100', 'take', 'take'),
        field('give rep', '50', 'rep', 'give'),
        field('give jelly', '10', 'jelly', 'give'),
        field('grant gear by id', 'tophat', 'gear', 'grant'),
      );
      wrap.append(give, said);

      const note = document.createElement('p');
      note.className = 'bm-livenote';
      note.style.margin = '0.6rem 0 0';
      note.textContent = 'Only gives, and coins back. Taking rep, revoking gear or wiping a name would be '
        + 'undone by the player’s next sync (blobs merge by MAX), so those are not offered rather than '
        + 'pretending. Bad names get struck on the 📇 Names desk.';
      wrap.appendChild(note);

      // 🗑 erase — two clicks here, and the worker still demands the id back
      const danger = document.createElement('div');
      danger.style.cssText = 'margin-top:0.7rem;display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;';
      const era = document.createElement('button');
      era.type = 'button';
      era.className = 'hq-mini hq-mini--danger';
      era.textContent = '🗑 erase this pass';
      era.onclick = async () => {
        if (era.dataset.arm !== '1') {
          era.dataset.arm = '1';
          era.textContent = '⚠️ erase for good?';
          setTimeout(() => { if (era.dataset.arm === '1') { era.dataset.arm = ''; era.textContent = '🗑 erase this pass'; } }, 5000);
          return;
        }
        era.disabled = true;
        said.textContent = 'Erasing…';
        try {
          const r = await fetch(PASS_ADMIN_API + '/admin/erase', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ key: uKey(), id: p.id, confirm: p.id }),
          });
          const d = await r.json();
          if (!r.ok) throw new Error(d.error || r.status);
          uOpen = null;
          uRows = uRows.filter((x) => x.id !== p.id);
          usersRender();
        } catch (e) {
          said.textContent = '❌ ' + ((e && e.message) || 'could not erase');
          era.disabled = false;
        }
      };
      const dnote = document.createElement('span');
      dnote.style.cssText = 'font-size:0.68rem;opacity:0.7;';
      dnote.textContent = 'their pass and every way into it. Not recoverable.';
      danger.append(era, dnote);
      wrap.appendChild(danger);
      return wrap;
    }

    el('bmLedgerLoad').onclick = ledgerLoad;
    el('bmURefresh').onclick = ledgerLoad;
    el('bmLedgerKey').addEventListener('keydown', (e) => { if (e.key === 'Enter') ledgerLoad(); });
    el('bmUSearch').addEventListener('input', usersRender);
    el('bmUSort').addEventListener('change', usersRender);

    // ✉️ address → pass. The one direction the hashing leaves open, and the
    // reason a deletion request can be honoured at all.
    el('bmUMailGo').onclick = async () => {
      const out = el('bmUMailOut');
      const email = el('bmUMail').value.trim();
      if (!email) return;
      out.textContent = 'Looking…';
      try {
        const r = await fetch(PASS_ADMIN_API + '/admin/find', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: uKey(), email }),
        });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || r.status);
        if (!d.found) { out.textContent = '🤷 no pass uses that address.'; return; }
        out.textContent = '✅ that address opens pass ' + d.id + ' — search it above to open the row.';
        el('bmUSearch').value = d.id;
        usersRender();
      } catch (e) {
        out.textContent = '❌ ' + ((e && e.message) || 'lookup failed');
      }
    };

    el('bmULogRefresh').onclick = async () => {
      const box = el('bmULog');
      box.textContent = 'Loading…';
      try {
        const r = await fetch(PASS_ADMIN_API + '/admin/log?key=' + encodeURIComponent(uKey()));
        if (!r.ok) throw new Error(r.status);
        const d = await r.json();
        box.textContent = '';
        if (!d.rows.length) { box.textContent = 'Nothing yet — this desk has changed nothing.'; return; }
        d.rows.forEach((row) => {
          const line = document.createElement('div');
          line.className = 'hq-logrow';
          const t = document.createElement('time');
          t.textContent = new Date(row.at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
          const what = document.createElement('b');
          what.textContent = (row.act === 'erase' ? '🗑 erased ' : '🎁 granted ') + row.id;
          const det = document.createElement('span');
          det.textContent = row.detail || '';
          line.append(t, what, det);
          box.appendChild(line);
        });
      } catch (e) {
        box.textContent = '❌ the log needs the same key.';
      }
    };

    // ── 🎁 THE ITEM DROPS DESK — the ownership-stack curation gate ──
    // Shares the gallery key. Pending items render ON a dancing banana (the
    // engine's custom channel), approve/reject hit /catalog/moderate; the
    // live-catalog list below supports retiring items.
    const CAT_API = 'https://banana-share.trymstene.workers.dev';
    // 🕺 LIVE approval previews (Trym: "I can't judge a wolf tail from a still")
    // — every card's banana DANCES the full 8-frame cycle on the shared world
    // beat, wearing the submitted item. The turned frames matter most: that's
    // where the auto-mirror flips the art and placement sins show up.
    const liveCards = new Set();
    setInterval(() => {
      if (document.hidden || !liveCards.size) return;
      const cyc = BASE_CYCLE_S * 1000;
      const f = Math.floor(((Date.now() % cyc) / cyc) * NFRAMES) % NFRAMES;
      liveCards.forEach((c) => {
        if (!c.cv.isConnected) { liveCards.delete(c); return; }
        if (f !== c.lastF) { c.lastF = f; c.draw(f); }
      });
    }, 120);
    function itemCard(it, { live } = {}) {
      const card = document.createElement('article');
      card.className = 'bm-mail';
      const body = document.createElement('div');
      body.style.cssText = 'display:flex;gap:0.9rem;padding:0.8rem;flex-wrap:wrap;align-items:center;';
      const cv = document.createElement('canvas');
      cv.width = cv.height = 220;
      cv.style.cssText = 'width:150px;height:150px;image-rendering:pixelated;flex:none;background:#f4f1e8;border:3px solid var(--ink);';
      const custom = wearToCustom(it.wear);
      // 🏡 a DECOR submission isn't worn — show the piece itself
      const isDecor = it.wear && it.wear.anchor === 'decor';
      if (isDecor) {
        // 🏡 DECOR reads differently at a glance (Trym: separate from
        // wearables in the queue): green frame + a corner ribbon + where/tiles
        card.style.borderLeft = '6px solid #2e7d32';
        cv.style.display = 'none';
        const box = document.createElement('div');
        box.style.cssText = 'position:relative;width:150px;height:150px;flex:none;display:grid;place-items:center;background:#e8f0e2;border:3px solid #2e7d32;';
        box.innerHTML = (custom && custom.art) || '—';
        const sv = box.querySelector('svg');
        if (sv) { sv.style.width = '120px'; sv.style.height = '120px'; }
        const rib = document.createElement('span');
        rib.textContent = '🏡 DECOR';
        rib.style.cssText = 'position:absolute;top:-12px;left:-8px;background:#2e7d32;color:#fff;font-size:0.6rem;font-weight:800;letter-spacing:0.08em;padding:2px 8px;transform:rotate(-4deg);';
        box.appendChild(rib);
        body.appendChild(box);
      }
      const outfit = {
        hat: 'none', glasses: 'none', extras: {}, top: '', bottom: '',
        bg: 'transparent', captions: false, effect: 'none',
        custom: (!isDecor && custom) || undefined,
      };
      const draw = (f) => drawComposite(cv.getContext('2d'), 220, f, outfit);
      if (!isDecor) assetsReady().then(() => {
        // the item svg decodes async — early redraws so the card never shows
        // a bare banana; then the beat ticker keeps it dancing
        draw(2);
        setTimeout(() => draw(2), 500);
        setTimeout(() => draw(2), 1600);
        liveCards.add({ cv, draw, lastF: -1 });
      });
      const meta = document.createElement('div');
      meta.style.cssText = 'flex:1;min-width:220px;display:flex;flex-direction:column;gap:0.4rem;';
      const titleIn = document.createElement('input');
      titleIn.value = it.title || '';
      titleIn.placeholder = 'item name';
      titleIn.maxLength = 40;
      titleIn.style.cssText = 'font:inherit;font-weight:800;padding:0.35rem 0.5rem;border:3px solid var(--ink);';
      const byIn = document.createElement('input');
      byIn.value = it.by || '';
      byIn.placeholder = 'maker credit (optional)';
      byIn.maxLength = 24;
      byIn.style.cssText = 'font:inherit;padding:0.35rem 0.5rem;border:3px solid var(--ink);';
      const info = document.createElement('p');
      info.className = 'bm-livenote';
      info.style.margin = '0';
      const spotTxt = isDecor
        ? '🏡 ' + (it.wear.where === 'indoor' ? 'indoor' : 'yard') + ' decor'
          + (it.wear.fw ? ' · ' + Math.max(1, Math.ceil(it.wear.fw / 16)) + '×' + Math.max(1, Math.ceil((it.wear.fh || 16) / 16)) + ' tiles' : '')
        : 'rides the ' + (it.wear && it.wear.anchor === 'hand' ? (it.wear.hand || '') + ' hand' : (it.wear && it.wear.anchor) || '?');
      // 📦 a retired row used to render EXACTLY like a live one -- nothing
      // read `it.retired` -- so taking something off sale left no trace on the
      // only screen that could show it, and pressing retire again was a silent
      // no-op re-put. The state has to be on the card, or it does not exist.
      const gone = !!(live && it.retired);
      info.textContent = (live ? (gone ? 'off sale · added ' : 'live since ') : spotTxt + ' · sent ')
        + new Date(it.added || it.created).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      // dimmed, not boxed: this list already has edges and a retired item is a
      // quieter version of the same thing, not a different kind of thing
      if (gone) cv.style.opacity = '0.4';
      const row = document.createElement('div');
      row.style.cssText = 'display:flex;gap:0.5rem;flex-wrap:wrap;';
      // `after` = what to do instead of dropping the card. Approve and reject
      // finish a submission, so the card goes; retire does NOT finish anything
      // -- the item is still there, just off sale -- so it stays and re-renders.
      const mod = async (payload, btn, after) => {
        btn.disabled = true;
        try {
          const r = await fetch(CAT_API + '/catalog/moderate?key=' + encodeURIComponent(gkey), {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
          });
          const d = await r.json().catch(() => ({}));
          if (d.ok) {
            // (the askRebuild call that stood here has never run: this desk sends
            // 'ok', 'no' or 'remove' and the worker 400s anything else, so
            // action === 'approve' was unreachable. Left as a comment rather
            // than "fixed" to 'ok' — rebuildAt is module scope shared with the
            // gallery desk and its 60s throttle returns before any toast, so
            // wiring it would fire a silent no-op on a batch of approvals.)
            if (after) after(); else { card.remove(); itemsCount(); }
            return;
          }
          btn.textContent = d.error || 'failed'; btn.disabled = false;
        } catch (e) { btn.textContent = 'failed — retry'; btn.disabled = false; }
      };
      if (live) {
        // ONE button, both directions. `unretire` has existed in the worker
        // since retire did and had no control anywhere in the site, so a retire
        // could only be undone by hand-POSTing the worker.
        const flip = document.createElement('button');
        flip.className = 'bm-btn' + (gone ? '' : ' bm-btn--shred');
        flip.type = 'button';
        const restLabel = gone ? '↩ put back on sale' : '📦 retire from catalog';
        flip.textContent = restLabel;
        flip.onclick = () => {
          // arming guards the destructive direction only -- putting something
          // back on sale is not a thing anyone needs protecting from
          if (!gone && flip.dataset.arm !== '1') {
            flip.dataset.arm = '1'; flip.textContent = '⚠ retire, really?';
            setTimeout(() => { flip.dataset.arm = ''; flip.textContent = restLabel; }, 3000);
            return;
          }
          // the button always SAID retire; it sent 'remove', which deleted the
          // art out from under everyone holding it. 'retire' takes it off sale
          // and leaves every copy people already own exactly where it is.
          mod({ id: it.id, action: gone ? 'unretire' : 'retire' }, flip,
            () => card.replaceWith(itemCard({ ...it, retired: gone ? 0 : 1 }, { live: true })));
        };
        titleIn.disabled = true; byIn.disabled = true;
        row.appendChild(flip);
      } else {
        const ok = document.createElement('button');
        ok.className = 'bm-btn';
        ok.type = 'button';
        ok.textContent = '✓ into the catalog';
        ok.onclick = () => mod({ id: it.id, action: 'ok', title: titleIn.value.trim(), by: byIn.value.trim() }, ok);
        const no = document.createElement('button');
        no.className = 'bm-btn bm-btn--shred';
        no.type = 'button';
        no.textContent = '✕ not this one';
        no.onclick = () => mod({ id: it.id, action: 'no' }, no);
        row.appendChild(ok); row.appendChild(no);
      }
      meta.appendChild(titleIn); meta.appendChild(byIn); meta.appendChild(info); meta.appendChild(row);
      body.appendChild(cv); body.appendChild(meta);
      card.appendChild(body);
      return card;
    }
    function itemsCount() {
      const n = el('bmItemsList').querySelectorAll('article').length;
      el('bmItemsCount').textContent = '🎁 ' + n + ' item' + (n === 1 ? '' : 's') + ' awaiting review';
      const b = el('bmItemsBadge');
      if (b) { b.hidden = n === 0; b.textContent = n; }
    }
    async function itemsLoad() {
      if (!gkey) {
        el('bmItemsList').innerHTML = '<p class="bm-livenote">Unlock the gallery desk first — this desk shares its key.</p>';
        el('bmCatList').innerHTML = '';
        return;
      }
      el('bmItemsList').innerHTML = '<p class="bm-livenote">Opening the workshop…</p>';
      try {
        const r = await fetch(CAT_API + '/catalog/inbox?key=' + encodeURIComponent(gkey));
        if (!r.ok) throw new Error(r.status);
        const items = await r.json();
        el('bmItemsList').textContent = '';
        if (!items.length) el('bmItemsList').innerHTML = '<p class="bm-livenote">🏝 No items waiting. The workshops are quiet.</p>';
        items.forEach((it) => el('bmItemsList').appendChild(itemCard(it)));
        itemsCount();
      } catch (e) { el('bmItemsList').innerHTML = '<p class="bm-livenote">Couldn’t open the inbox — try refresh.</p>'; }
      try {
        const r2 = await fetch(CAT_API + '/catalog/items.json', { cache: 'reload' });
        const cat = await r2.json();
        el('bmCatList').textContent = '';
        if (!cat.length) el('bmCatList').innerHTML = '<p class="bm-livenote">Nothing in the catalog yet — approve something above, or submit from the Forge.</p>';
        // on sale first, off sale after -- otherwise a retired row hides in the
        // middle of the list and the state is only findable by reading every card
        cat.slice().sort((x, y) => (x.retired ? 1 : 0) - (y.retired ? 1 : 0))
          .forEach((it) => el('bmCatList').appendChild(itemCard(it, { live: true })));
      } catch (e) { el('bmCatList').innerHTML = '<p class="bm-livenote">Couldn’t read the catalog.</p>'; }
    }
    el('bmItemsRefresh').onclick = itemsLoad;

    // ── 🪩 THE RAVE NAMES DESK — Trym's quick swipe on floor names ──
    // Uses the SAME key value as the gallery desk (set RAVE_KEY on worker-rave
    // to the gallery.local.json key). Fails closed until the secret exists.
    const RAVE_API = 'https://banana-rave.trymstene.workers.dev';
    const rEsc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    async function raveLoad() {
      if (!gkey) { el('bmRaveList').innerHTML = '<p class="bm-livenote">Unlock the gallery desk first — this desk shares its key.</p>'; return; }
      let d;
      try {
        const r = await fetch(RAVE_API + '/names?key=' + encodeURIComponent(gkey));
        if (r.status === 403) { el('bmRaveList').innerHTML = '<p class="bm-livenote">403 — set the RAVE_KEY secret on worker-rave (same value as the gallery key).</p>'; return; }
        if (!r.ok) throw new Error(r.status);
        d = await r.json();
      } catch (e) { el('bmRaveList').innerHTML = '<p class="bm-livenote">Could not reach the floor — try again.</p>'; return; }
      const fmt = (t) => new Date(t).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
      const live = new Set(d.live || []);
      el('bmRaveList').innerHTML =
        '<p class="bm-count">' + (d.live || []).length + ' named right now · ' + (d.names || []).length + ' seen recently · ' + (d.strikes || []).length + ' struck</p>'
        + ((d.strikes || []).length
          ? '<p class="bm-livenote">🔨 struck: ' + d.strikes.map((s) => rEsc(s) + ' <button class="bm-chip bm-chip--ghost" data-unstrike="' + rEsc(s) + '">undo</button>').join(' · ') + '</p>'
          : '')
        // ONE ROW PER VISITOR (keyed by sid on the worker) — a renamer no longer
        // spams the list; ×N flags a name-cycler, and their past names still show
        + (d.names || []).map((x) => '<div class="bm-bar" style="justify-content:space-between;align-items:flex-start;">'
          + '<span>' + (live.has(x.n) ? '🟢 ' : '') + '<b>' + rEsc(x.n) + '</b> '
          + (x.count > 1 ? '<span style="background:#ffe135;color:#111;font-weight:800;font-size:0.6rem;padding:1px 5px;border-radius:2px;vertical-align:middle;">×' + x.count + ' names</span> ' : '')
          + '<span style="opacity:0.55;font-size:0.75rem;">' + fmt(x.at) + '</span>'
          + ((x.vars && x.vars.length) ? '<br><span style="opacity:0.5;font-size:0.72rem;">also tried: ' + x.vars.map(rEsc).join(' · ') + '</span>' : '')
          + '</span>'
          + '<button class="bm-chip" data-strike="' + rEsc(x.n) + '">🔨 strike</button></div>').join('')
        || '<p class="bm-livenote">No names seen yet — the floor is all outfit-names so far.</p>';
      el('bmRaveList').querySelectorAll('[data-strike]').forEach((b) => { b.onclick = () => raveStrike(b.dataset.strike, false); });
      el('bmRaveList').querySelectorAll('[data-unstrike]').forEach((b) => { b.onclick = () => raveStrike(b.dataset.unstrike, true); });
    }
    async function raveStrike(t, remove) {
      try {
        const r = await fetch(RAVE_API + '/strike?key=' + encodeURIComponent(gkey), {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ t, remove }),
        });
        if (!r.ok) { alert('strike failed (' + r.status + ')'); return; }
      } catch (e) { alert('strike failed'); return; }
      raveLoad();
    }
    el('bmRaveRefresh').onclick = raveLoad;
    el('bmStrikeAdd').onclick = () => { const v = el('bmStrikeInput').value.trim(); if (v) { raveStrike(v, false); el('bmStrikeInput').value = ''; } };

    // pending ↔ live sub-desks
    function setGalMode(live) {
      el('bmModePending').setAttribute('aria-pressed', String(!live));
      el('bmModeLive').setAttribute('aria-pressed', String(live));
      el('bmGalPending').hidden = live;
      el('bmGalLive').hidden = !live;
      if (live) liveBoot();
    }
    el('bmModePending').onclick = () => setGalMode(false);
    el('bmModeLive').onclick = () => setGalMode(true);

    async function galLoad() {
      const r = await fetch(GAL + '/gallery/pending-list?key=' + encodeURIComponent(gkey));
      if (!r.ok) return false;
      galItems = await r.json();
      return true;
    }
    async function galBoot() {
      if (gkey && galItems === null) {
        if (await galLoad().catch(() => false)) { el('bmGalModes').hidden = false; galRender(); return; }
        gkey = '';
      }
      if (!gkey) { el('bmGkeyGate').hidden = false; el('bmGalCount').textContent = ''; return; }
      el('bmGalModes').hidden = false;
      galRender();
    }
    el('bmGkeySave').onclick = async () => {
      gkey = el('bmGkey').value.trim();
      if (gkey && await galLoad().catch(() => false)) {
        try { localStorage.setItem('gallery-key', gkey); } catch (e) {}
        el('bmGkeyGate').hidden = true;
        el('bmGalModes').hidden = false;
        galRender();
      } else { gkey = ''; el('bmGkey').value = ''; el('bmGkey').placeholder = '❌ wrong key — try again'; }
    };
    el('bmGkey').addEventListener('keydown', (e) => { if (e.key === 'Enter') el('bmGkeySave').click(); });

    function galBadge() {
      const b = el('bmGalBadge');
      const n = galItems ? galItems.length : 0;
      b.hidden = !n;
      b.textContent = n;
    }
    function galRender() {
      const list = el('bmGalList');
      list.textContent = '';
      galBadge();
      el('bmGalCount').textContent = '🖼 ' + galItems.length + ' submission' + (galItems.length === 1 ? '' : 's') + ' awaiting curation';
      if (!galItems.length) {
        const d = document.createElement('div');
        d.className = 'bm-empty';
        d.innerHTML = '<div class="bm-big">🖼</div><p>Curation desk clear. The gallery rests.</p>';
        list.appendChild(d);
        return;
      }
      galItems.forEach((it) => {
        const card = document.createElement('article');
        card.className = 'bm-pend';
        const box = document.createElement('div');
        box.className = 'bm-pend__img';
        const img = document.createElement('img');
        img.src = GAL + '/gallery/pending/' + it.id + '.gif?key=' + encodeURIComponent(gkey);
        img.alt = '';
        box.appendChild(img);
        const meta = document.createElement('div');
        meta.className = 'bm-pend__meta';
        const titleIn = document.createElement('input');
        titleIn.value = it.title || '';
        titleIn.maxLength = 60;
        titleIn.placeholder = 'title — becomes the page';
        const tagsIn = document.createElement('input');
        tagsIn.maxLength = 120;
        tagsIn.placeholder = 'tags, comma-separated (monday, work, vibes…)';
        tagsIn.style.marginTop = '0.4rem';
        const line = document.createElement('p');
        line.className = 'bm-pend__line';
        line.textContent = (it.transparent ? 'sticker (transparent)' : 'gif (solid)') + ' · ' + it.kb + ' KB · by ' +
          (it.by || 'anonymous') + ' · ' + fmtDate(it.created);
        const actions = document.createElement('div');
        actions.className = 'bm-mail__actions';
        const hang = document.createElement('button');
        hang.className = 'bm-btn bm-btn--hang';
        hang.type = 'button';
        hang.textContent = '🖼 hang it';
        const bin = document.createElement('button');
        bin.className = 'bm-btn bm-btn--shred';
        bin.type = 'button';
        bin.textContent = '🗑 reject';
        async function moderate(action) {
          hang.disabled = bin.disabled = true;
          try {
            const r = await fetch(GAL + '/gallery/moderate?key=' + encodeURIComponent(gkey), {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: it.id, action, title: titleIn.value, tags: tagsIn.value }),
            });
            const d = await r.json();
            if (d.ok) {
              if (action === 'approve') askRebuild('the banana');
              card.classList.add('bm-mail--shredding');
              setTimeout(() => { galItems = galItems.filter((x) => x.id !== it.id); galRender(); }, 360);
              return;
            }
            alert(d.error || 'failed');
          } catch (e) { alert('the desk is busy — try again'); }
          hang.disabled = bin.disabled = false;
        }
        hang.onclick = () => moderate('approve');
        bin.onclick = () => {
          if (bin.dataset.arm !== '1') { bin.dataset.arm = '1'; bin.textContent = '⚠ reject, really?'; setTimeout(() => { bin.dataset.arm = ''; bin.textContent = '🗑 reject'; }, 3000); return; }
          moderate('reject');
        };
        actions.appendChild(hang); actions.appendChild(bin);
        meta.appendChild(titleIn); meta.appendChild(tagsIn); meta.appendChild(line); meta.appendChild(actions);
        card.appendChild(box); card.appendChild(meta);
        list.appendChild(card);
      });
    }
    // ── the LIVE catalogue: BOTH lanes (Trym's editorial + community),
    //    search / filter / sort / edit — scales to 100s ──
    let liveItems = null;
    let liveFilter = 'all';
    async function liveLoad() {
      const [ap, ov] = await Promise.all([
        fetch(GAL + '/gallery/approved', { cache: 'no-store' }).then((r) => r.ok ? r.json() : []),
        fetch(GAL + '/gallery/overrides', { cache: 'no-store' }).then((r) => r.ok ? r.json() : {}).catch(() => ({})),
      ]);
      const mine = editorialBase.map((i) => ({
        lane: 'mine', key: i.id,
        title: (ov[i.id] && ov[i.id].title) || i.title,
        tags: (ov[i.id] && Array.isArray(ov[i.id].tags)) ? ov[i.id].tags : i.tags,
        kind: i.kind, img: '/assets/gallery-bananas/' + i.file,
        href: '/banana-memes/' + i.id + '/', ts: Date.parse(i.added) || 0, by: null,
      }));
      const comm = (ap || []).map((c) => ({
        lane: 'community', key: c.slug,
        title: c.title, tags: c.tags || [], by: c.by || '', params: c.params || '',
        kind: c.transparent ? 'sticker' : 'gif',
        img: GAL + '/gallery/gif/' + c.slug + '.gif?v=' + (c.updated || c.approved || c.created || 0),
        href: '/banana-memes/by/' + c.slug + '/', ts: c.approved || 0,
      }));
      liveItems = [...comm, ...mine];
      return true;
    }
    async function liveBoot() {
      if (liveItems === null) { if (!(await liveLoad().catch(() => false))) { liveItems = []; } }
      liveRender();
    }
    el('bmLiveQ').addEventListener('input', () => liveRender());
    el('bmLiveSort').addEventListener('change', () => liveRender());

    function liveRender() {
      const q = el('bmLiveQ').value.trim().toLowerCase();
      const sort = el('bmLiveSort').value;
      let shown = liveItems.filter((it) => {
        const hay = (it.title + ' ' + (it.by || '') + ' ' + it.key + ' ' + it.tags.join(' ')).toLowerCase();
        if (q && !hay.includes(q)) return false;
        if (liveFilter === 'untagged') return !it.tags.length;
        if (liveFilter === 'mine') return it.lane === 'mine';
        if (liveFilter === 'community') return it.lane === 'community';
        if (liveFilter === 'sticker') return it.kind === 'sticker';
        if (liveFilter === 'gif') return it.kind === 'gif';
        return true;
      });
      shown = shown.slice().sort((a, b) =>
        sort === 'old' ? a.ts - b.ts :
        sort === 'az' ? a.title.localeCompare(b.title) :
        b.ts - a.ts);

      // filter chips with live counts
      const chips = el('bmLiveChips');
      chips.textContent = '';
      const untagged = liveItems.filter((it) => !it.tags.length).length;
      [['all', 'all (' + liveItems.length + ')'],
       ['untagged', '🏷 untagged (' + untagged + ')'],
       ['mine', '🍌 mine'], ['community', '👥 community'],
       ['sticker', 'stickers'], ['gif', 'gifs']].forEach(([v, label]) => {
        const b = document.createElement('button');
        b.className = 'bm-chip';
        b.type = 'button';
        b.textContent = label;
        b.setAttribute('aria-pressed', String(liveFilter === v));
        b.onclick = () => { liveFilter = v; liveRender(); };
        chips.appendChild(b);
      });

      const list = el('bmLiveList');
      list.textContent = '';
      if (!shown.length) {
        const d = document.createElement('div');
        d.className = 'bm-empty';
        d.innerHTML = '<div class="bm-big">🔍</div><p>No bananas match.</p>';
        list.appendChild(d);
        return;
      }
      shown.forEach((it) => {
        const row = document.createElement('article');
        row.className = 'bm-live';
        const box = document.createElement('div');
        box.className = 'bm-live__img';
        const img = document.createElement('img');
        img.loading = 'lazy';
        img.src = it.img;
        img.alt = '';
        box.appendChild(img);

        const meta = document.createElement('div');
        meta.className = 'bm-live__meta';
        const titleIn = document.createElement('input');
        titleIn.value = it.title || '';
        titleIn.maxLength = 60;
        titleIn.placeholder = 'title';
        const row2 = document.createElement('div');
        row2.className = 'bm-live__row2';
        const tagsIn = document.createElement('input');
        tagsIn.value = it.tags.join(', ');
        tagsIn.maxLength = 120;
        tagsIn.placeholder = 'tags, comma-separated';
        row2.appendChild(tagsIn);
        let byIn = null;
        if (it.lane === 'community') {
          byIn = document.createElement('input');
          byIn.value = it.by || '';
          byIn.maxLength = 24;
          byIn.placeholder = 'creator (byline)';
          row2.appendChild(byIn);
        }

        const foot = document.createElement('div');
        foot.className = 'bm-live__foot';
        const view = document.createElement('a');
        view.href = it.href;
        view.target = '_blank';
        view.textContent = '↗ view';
        foot.appendChild(view);
        foot.appendChild(document.createTextNode(
          (it.lane === 'mine' ? '🍌 mine' : '👥 community') + ' · ' + it.kind + (it.ts ? ' · ' + fmtDate(it.ts) : '')));
        const save = document.createElement('button');
        save.className = 'bm-btn bm-live__save';
        save.type = 'button';
        save.textContent = '💾 save';
        const markDirty = () => row.classList.add('bm-live--dirty');
        titleIn.oninput = tagsIn.oninput = markDirty;
        if (byIn) byIn.oninput = markDirty;
        save.onclick = async () => {
          save.disabled = true; save.textContent = 'saving…';
          try {
            const payload = it.lane === 'mine'
              ? { eid: it.key, title: titleIn.value, tags: tagsIn.value }
              : { slug: it.key, title: titleIn.value, tags: tagsIn.value, by: byIn ? byIn.value : undefined };
            const r = await fetch(GAL + '/gallery/edit?key=' + encodeURIComponent(gkey), {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const d = await r.json();
            if (d.ok && d.entry) {
              if (d.entry.title) { it.title = d.entry.title; titleIn.value = d.entry.title; }
              if (Array.isArray(d.entry.tags)) { it.tags = d.entry.tags; tagsIn.value = it.tags.join(', '); }
              if (d.entry.by !== undefined && byIn) { it.by = d.entry.by; byIn.value = it.by; }
              row.classList.remove('bm-live--dirty');
              save.textContent = '✓ saved';
              setTimeout(() => { save.textContent = '💾 save'; save.disabled = false; }, 1200);
              return;
            }
            alert(d.error || 'failed');
          } catch (e) { alert('the desk is busy — try again'); }
          save.disabled = false; save.textContent = '💾 save';
        };
        foot.appendChild(save);
        // RE-RENDER: re-bake this item's GIF from its stored params with the
        // current caption font (Anton) and overwrite it in R2. Pixel-identical
        // to what visitors download (shared meme-gif renderer).
        if (it.lane === 'community' && it.params) {
          const rr = document.createElement('button');
          rr.className = 'bm-btn'; rr.type = 'button'; rr.textContent = '🔁 re-render';
          rr.title = 'Re-bake the GIF from stored params with the current font (Anton)';
          rr.onclick = async () => {
            rr.disabled = true; rr.textContent = 'rendering…';
            try {
              const st = parseDesign(new URLSearchParams(it.params));
              const { blob } = await memeGif(st);
              rr.textContent = 'uploading…';
              const r = await fetch(GAL + '/gallery/replace?key=' + encodeURIComponent(gkey) + '&slug=' + encodeURIComponent(it.key), {
                method: 'POST', headers: { 'Content-Type': 'image/gif' }, body: blob });
              const d = await r.json();
              if (d.ok) {
                img.src = GAL + '/gallery/gif/' + it.key + '.gif?v=' + d.updated; // bust the preview
                rr.textContent = '✓ re-rendered';
                setTimeout(() => { rr.textContent = '🔁 re-render'; rr.disabled = false; }, 1500);
                return;
              }
              rr.textContent = 'error: ' + (d.error || '?');
            } catch (e) { console.error(e); rr.textContent = 'render failed'; }
            setTimeout(() => { rr.textContent = '🔁 re-render'; rr.disabled = false; }, 2200);
          };
          foot.appendChild(rr);
        }
        meta.appendChild(titleIn); meta.appendChild(row2); meta.appendChild(foot);
        row.appendChild(box); row.appendChild(meta);
        list.appendChild(row);
      });
    }

    // preload the badge so the tab shows the pending count on arrival
    if (gkey) galLoad().then((ok) => { if (ok) galBadge(); }).catch(() => {});
    if (gkey) { // 🎁 badge: pending item submissions at a glance
      fetch(CAT_API + '/catalog/inbox?key=' + encodeURIComponent(gkey))
        .then((r) => (r.ok ? r.json() : []))
        .then((items) => { const b = el('bmItemsBadge'); if (b && items.length) { b.hidden = false; b.textContent = items.length; } })
        .catch(() => {});
    }

    // ⚠️ LAST, ON PURPOSE — see the note beside the tab wiring above. Opening a
    // tab runs that tab's loader, so nothing may open one until every desk in
    // this module has been declared.
    setTab('pulse');

    boot();
  </script>
</BaseLayout>
