---
// Shared hreflang mesh — identical on the banana hub + every language page, generated from the one registry
// (src/data/locale-codes.js), so a new language joins every page's mesh at once and the list can never drift.
import { LANG_LINKS } from '../data/locale-codes.js';
const base = 'https://trymstene.com';
const xDefault = base + '/dancing-banana-gif-meme/';
---
{LANG_LINKS.map((a) => <link rel="alternate" hreflang={a.code} href={base + a.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />
