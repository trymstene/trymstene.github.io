---
// Canonical site navigation — the single source of truth for every page.
// Banana-world verbs only; Trym-side links live in the footer + /me. Mobile = slide-in (js/main.js).
import PixelIcon from './PixelIcon.astro';
---
<header class="nav">
  <a class="nav__brand" href="/">TRYM<span>STENE</span></a>
  <button class="nav__toggle" aria-label="Menu" aria-expanded="false">
    <span class="nav__ic nav__ic--open"><PixelIcon name="burger" /></span>
    <span class="nav__ic nav__ic--close"><PixelIcon name="close" /></span>
  </button>
  <nav class="nav__links">
    <div class="nav__group nav__group--banana">
      <a href="/dancing-banana-gif-meme/">Download</a>
      <a href="/make-a-banana/" data-place="nav">Make a Banana</a>
      <a href="/forge/">Pixel Forge</a>
      {/* 🛍 the ONE nav item that asks for money — inverted so it reads as a
          door rather than one more equal word. Sits after the two MAKING
          tools, which is where someone has just made something worth printing.
          ⭐ 8 Aug: HOT PINK on white and named in full. It was the least-used
          item in the whole nav — 89 internal arrivals from 54 people in 28
          days, against 8,889 for the builder — so blending in with the yellow
          was costing it. Nothing to lose by shouting.
          ⚠️ "Join the Rave" was removed from the nav here. It measured as the
          #2 destination, but Trym: "that is all ad traffic so the data sucks".
          The rave is still reached from the frontpage, the park, the beach,
          the homestead and fast travel — it just no longer takes a nav slot
          from the one item that asks for money. */}
      <a class="nav__shop" href="/shop/" data-place="nav">Official Banana Shop</a>
      {/* nav says "Banana Gallery" (the place); SEO metadata keeps "Banana
          Memes" (the query) — Trym's call, avoids gallery-vs-memes confusion */}
      <a href="/banana-memes/">Banana Gallery</a>
      <a class="nav__pass" href="/pass/" title="Your banana pass">🎫 My Pass</a>
    </div>
  </nav>
  <div class="nav__backdrop"></div>
</header>

<script>
  // Scroll-aware nav: hide on scroll-down, show on a deliberate scroll-up.
  // Asymmetric hysteresis — hides after a little down-scroll, but needs a real
  // up-scroll to return, so minor scroll-adjusting doesn't pop it back open.
  (() => {
    const nav = document.querySelector('.nav');
    if (!nav) return;
    const HIDE_AT = 10, SHOW_AT = -48, TOP_ALWAYS = 64;
    let lastY = Math.max(0, window.scrollY), acc = 0, ticking = false;
    function tick() {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      const dy = y - lastY;
      lastY = y;
      if (nav.classList.contains('open')) { acc = 0; return; }   // menu open → never hide
      if (y < TOP_ALWAYS) { nav.classList.remove('nav--hidden'); acc = 0; return; }
      if ((dy > 0) !== (acc > 0)) acc = 0;   // direction flipped → reset the accumulator
      acc += dy;
      if (acc > HIDE_AT) nav.classList.add('nav--hidden');
      else if (acc < SHOW_AT) nav.classList.remove('nav--hidden');
    }
    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(tick); }
    }, { passive: true });
  })();

  // 🪪 THE PASS LINK BECOMES YOU. Once someone has a name (and, after one
  // visit to /pass/, a face), the generic door reads as their own.
  // ⚠️ NO ENGINE HERE. This nav is on every page; the avatar is a data URL
  // baked by /pass/ where the compositor already runs. Reading it is free.
  (() => {
    const a = document.querySelector('.nav__pass');
    if (!a) return;
    let name = '', av = '';
    try {
      name = (localStorage.getItem('ps-name-v1') || '').trim().slice(0, 18);
      av = localStorage.getItem('ps-avatar-v1') || '';
    } catch (e) { return; }
    if (!name && !av) return;            // no pass yet — leave the door generic
    a.classList.add('nav__pass--me');
    a.title = name ? name + ' — your banana pass' : 'Your banana pass';
    a.textContent = '';
    if (av) {
      const im = new Image(22, 22);
      im.className = 'nav__pface'; im.src = av; im.alt = '';
      a.appendChild(im);
    } else {
      a.appendChild(document.createTextNode('🎫 '));
    }
    // ⚠️ textContent, never innerHTML — the name is user-typed
    const sp = document.createElement('span');
    sp.textContent = name || 'My Pass';
    a.appendChild(sp);
  })();

  // 📊 NAV CLICKS. Asked "which nav items get clicked most?" on 8 Aug and there
  // was no answer to give: nothing here was instrumented, so the best available
  // proxy was pageviews-minus-landings, which cannot tell a nav click from any
  // other link on the page. One delegated listener fixes that for good.
  // Deliberately fires on the CAPTURE-free bubble and never preventDefaults —
  // navigation must not wait on an analytics call.
  (() => {
    const nav = document.querySelector('.nav');
    if (!nav) return;
    nav.addEventListener('click', (e) => {
      const a = e.target.closest('a[href]');
      if (!a || !nav.contains(a) || !window.gtag) return;
      window.gtag('event', 'nav_click', {
        // the pass link carries the visitor's own name once claimed — send the
        // STABLE slot, never the label, or the report fills with real names
        nav_item: a.classList.contains('nav__pass') ? 'My Pass'
          : (a.classList.contains('nav__brand') ? 'Brand'
            : (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 40)),
        nav_href: a.getAttribute('href'),
        // the same markup is the desktop bar and the mobile slide-in panel
        nav_mode: nav.classList.contains('open') ? 'mobile' : 'desktop',
      });
    });
  })();
</script>
