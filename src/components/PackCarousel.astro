---
// 🎟 THE PACK CAROUSEL — one pack at a time, slim enough to sit between the
// download buttons and the text that ranks. Trym, 5 Sep: "a smaller type of
// banner ... that rotates or swipes through different sticker packs ... above
// the fold somewhere ... without taking all of the attention" — and, the same
// night: "make the image the background of the tile, so the whole banner
// becomes a visual image, with the pack name and description, the price in
// its own sticker pill; remove the arrows, keep it swipeable".
//
// It is a scroll-snap track: swiping is native, the dots and the timer just
// scroll it, and with JavaScript off it is still a row you can swipe. Each
// slide IS the pack's wide picture (build-pack-art.py `banner`: the group on
// the right, the left kept quiet for the words). Auto-advance stops on hover,
// touch, focus, when off-screen, and under prefers-reduced-motion.
//
//   <PackCarousel place="gif_hero" />
import { getProducts, money } from '../lib/shop.js';
import { STICKER_PACKS, PACK_PRICE, SET_PRICE, packBanner, packProducts, previewPacks } from '../data/sticker-packs.js';

export interface Props {
  place?: string;      // GA4 label: which slot on which page sent someone to a pack
}
const { place = 'carousel' } = Astro.props;

let products = [];
try { products = await getProducts(); } catch (e) { products = []; }
const have = packProducts([...products, ...previewPacks(products)]);
const slides = STICKER_PACKS.map((p) => ({ ...p, href: have[p.n] ? `/shop/${have[p.n].handle}/` : '/shop/#sticker-packs' }));
---
<div class="pkc" data-place={place} aria-roledescription="carousel" aria-label="Sticker packs">
  <div class="pkc__track" tabindex="0">
    {slides.map((p, i) => (
      <a class="pkc__slide" href={p.href} data-name={`Sticker ${p.num}`}
         aria-label={`Sticker ${p.num}, ${p.name}: ${p.names.join(', ')} and the Original, ${money(PACK_PRICE, 'USD')}`}>
        <img class="pkc__bg" src={packBanner(p.n)} alt="" width="1200" height="480" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        <span class="pkc__text">
          <span class="pkc__num">Sticker {p.num} · 6 stickers</span>
          <b class="pkc__name">{p.name}</b>
          <span class="pkc__names">{p.names.join(' · ')}</span>
          <span class="pkc__row">
            <span class="price-tag price-tag--sm">{money(PACK_PRICE, 'USD')}</span>
            <span class="pkc__set">all 8 · {money(SET_PRICE, 'USD')}</span>
            <span class="pkc__go">See the pack →</span>
          </span>
        </span>
      </a>
    ))}
  </div>
  <span class="pkc__dots" aria-hidden="true">{slides.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</span>
</div>

<style>
  /* --pkc-max: a page can widen the tile to its own column (the GIF hero does) */
  .pkc { position: relative; max-width: var(--pkc-max, min(560px, 100%)); text-align: left; }
  /* the track: one slide per screen, native swipe, no scrollbar.
     ⚠️ contain: inline-size — eight 100%-wide slides otherwise give the track an
     intrinsic width of eight screens, and a shrink-to-fit parent (the phone hero,
     a centred flex column) grows to match and pushes the title off the screen. */
  .pkc__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: 100%; contain: inline-size;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    border: var(--line); box-shadow: var(--shadow-sm); background: var(--ink);
  }
  .pkc__track::-webkit-scrollbar { display: none; }
  .pkc__track:focus-visible { outline: 3px solid var(--hot); outline-offset: 2px; }
  /* the slide is the picture: 5:2 like the banner, so nothing is cropped on a desk */
  .pkc__slide {
    position: relative; scroll-snap-align: start; display: block; aspect-ratio: 5 / 2;
    text-decoration: none; color: #fff; overflow: hidden; isolation: isolate;
  }
  .pkc__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right center; display: block; }
  /* the scrim: ink from the left so the words read on every ground — the bananas stand to the right */
  /* ⚠️ the scrim is a ::before, i.e. FIRST in tree order — without a z-index the
     picture (a later absolutely-positioned sibling) paints over it and the words
     land on bare bananas. Scrim 1, words 2, picture stays at 0. */
  .pkc__slide::before {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(90deg, rgba(17, 17, 17, 0.86) 0%, rgba(17, 17, 17, 0.66) 40%, rgba(17, 17, 17, 0) 66%);
  }
  .pkc__text {
    position: absolute; left: 0; top: 0; bottom: 0; width: 60%; padding: 0.7rem 0.9rem; z-index: 2;
    display: flex; flex-direction: column; justify-content: center; gap: 0.18rem; min-width: 0;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.7);
  }
  .pkc__num { font-size: 0.64rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--banana); }
  .pkc__name { font-family: "Archivo Black", system-ui, sans-serif; font-size: clamp(1.35rem, 5.6vw, 1.85rem); line-height: 1; }
  .pkc__names {
    font-size: 0.74rem; line-height: 1.3; opacity: 0.92;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .pkc__row { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; margin-top: 0.45rem; text-shadow: none; }
  .pkc__row .price-tag { transform: rotate(-3deg); }
  .pkc__set {
    font-size: 0.6rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap;
    background: var(--paper); color: var(--ink); border: 2px solid var(--ink); padding: 0.22rem 0.45rem; transform: rotate(2deg);
  }
  .pkc__go { font-weight: 800; font-size: 0.86rem; color: var(--banana); white-space: nowrap; text-shadow: 0 1px 0 rgba(0, 0, 0, 0.7); }
  .pkc__slide:hover .pkc__go { text-decoration: underline; }
  /* the dots ride the picture's corner: a swipe hint and a way to jump */
  .pkc__dots { position: absolute; right: 0.75rem; bottom: 0.55rem; display: flex; gap: 6px; z-index: 2; }
  .pkc__dots i { width: 8px; height: 8px; border: 2px solid #fff; background: rgba(17, 17, 17, 0.45); display: block; transform: rotate(45deg); cursor: pointer; }
  .pkc__dots i.on { background: var(--banana); border-color: var(--banana); }
  /* a phone tile: taller, one line of names, no View link — the whole tile is
     the link and the price tag says so; two lines and a third row crowded the
     bananas off the picture */
  @media (max-width: 430px) {
    .pkc__slide { aspect-ratio: 16 / 10; }
    .pkc__text { width: 66%; padding: 0.6rem 0.7rem; }
    .pkc__names { -webkit-line-clamp: 1; }
    .pkc__go { display: none; }
    .pkc__slide::before { background: linear-gradient(90deg, rgba(17, 17, 17, 0.88) 0%, rgba(17, 17, 17, 0.7) 48%, rgba(17, 17, 17, 0) 74%); }
    .pkc__row { gap: 0.5rem; }
  }
</style>

<script>
  // one tiny controller per carousel: timer and dots. Swipe is the browser's.
  document.querySelectorAll<HTMLElement>('.pkc').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.pkc__track')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.pkc__slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('.pkc__dots i')];
    const place = root.dataset.place || 'carousel';
    const n = slides.length;
    let idx = 0, timer = 0, paused = false, seen = false;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // the slide about to show gets its picture now, so a rotation never lands on a blank
    const warm = (i: number) => { const img = slides[(i + n) % n]?.querySelector('img'); if (img && img.loading === 'lazy') img.loading = 'eager'; };
    const go = (i: number, smooth = true) => {
      idx = (i + n) % n;
      warm(idx); warm(idx + 1);
      track.scrollTo({ left: idx * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
    };
    const mark = () => {
      const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      if (i !== idx) idx = i;
      dots.forEach((d, k) => d.classList.toggle('on', k === idx));
    };
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(mark); }, { passive: true });
    // the timer: 4 s a pack, only while on screen, never while a hand or a cursor is on it
    const tick = () => { if (!paused && seen && !still) go(idx + 1); };
    const start = () => { stop(); timer = window.setInterval(tick, 4000); };
    const stop = () => { if (timer) clearInterval(timer); timer = 0; };
    const rest = () => { stop(); if (!still) timer = window.setInterval(tick, 7000); };   // a nudge earns a longer pause
    dots.forEach((d, k) => d.addEventListener('click', () => { go(k); rest(); }));
    ['pointerenter', 'touchstart', 'focusin'].forEach((ev) => root.addEventListener(ev, () => { paused = true; }, { passive: true }));
    ['pointerleave', 'touchend', 'focusout'].forEach((ev) => root.addEventListener(ev, () => { paused = false; }, { passive: true }));
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => { seen = es.some((e) => e.isIntersecting); }, { threshold: 0.5 }).observe(root);
    } else seen = true;
    start();
    // keep the snapped slide on resize (the track width changes)
    addEventListener('resize', () => go(idx, false));
    slides.forEach((a) => a.addEventListener('click', () => {
      const w = window as any;
      if (w.gtag) w.gtag('event', 'select_item', { item_list_name: 'packs_' + place, items: [{ item_name: a.dataset.name || '' }] });
    }));
  });
</script>
