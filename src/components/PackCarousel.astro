---
// 🎟 THE PACK CAROUSEL — one pack at a time, slim enough to sit between the
// download buttons and the text that ranks. Trym, 5 Sep: "a smaller type of
// banner ... that rotates or swipes through different sticker packs ... above
// the fold somewhere ... without taking all of the attention".
//
// It is a scroll-snap track: swiping is native, the arrows and the timer just
// scroll it, and with JavaScript off it is still a row you can swipe. Eight
// 240px thumbs together weigh less than one grid card. Auto-advance stops on
// hover, touch, focus, when off-screen, and under prefers-reduced-motion.
//
//   <PackCarousel place="gif_hero" />
import { getProducts } from '../lib/shop.js';
import { STICKER_PACKS, PACK_PRICE, SET_PRICE, packThumb, packProducts, previewPacks } from '../data/sticker-packs.js';

export interface Props {
  place?: string;      // GA4 label: which slot on which page sent someone to a pack
  kicker?: string;
}
const { place = 'carousel', kicker = 'Now on paper' } = Astro.props;

let products = [];
try { products = await getProducts(); } catch (e) { products = []; }
const have = packProducts([...products, ...previewPacks(products)]);
const slides = STICKER_PACKS.map((p) => ({ ...p, href: have[p.n] ? `/shop/${have[p.n].handle}/` : '/shop/#sticker-packs' }));
---
<div class="pkc" data-place={place} aria-roledescription="carousel" aria-label="Sticker packs">
  <div class="pkc__head">
    <span class="pkc__kicker">{kicker} · <b>{slides.length} sticker packs</b></span>
    <span class="pkc__deal">${PACK_PRICE.toFixed(2)} each · all eight ${SET_PRICE.toFixed(2)}</span>
  </div>
  <div class="pkc__track" tabindex="0">
    {slides.map((p, i) => (
      <a class="pkc__slide" href={p.href} data-name={`Sticker ${p.num}`} aria-label={`${p.num}, ${p.name}: ${p.names.join(', ')} and the Original, $${PACK_PRICE.toFixed(2)}`}>
        <img src={packThumb(p.n)} alt="" width="240" height="240" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
        <span class="pkc__text">
          <span class="pkc__num">{p.num} · 6 kiss-cut stickers</span>
          <b class="pkc__name">{p.name}</b>
          <span class="pkc__names">{p.names.join(' · ')}</span>
        </span>
        <span class="pkc__go">View →</span>
      </a>
    ))}
  </div>
  <div class="pkc__ctl">
    <button class="pkc__arrow" type="button" data-dir="-1" aria-label="Previous pack">‹</button>
    <span class="pkc__dots" aria-hidden="true">{slides.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</span>
    <button class="pkc__arrow" type="button" data-dir="1" aria-label="Next pack">›</button>
  </div>
</div>

<style>
  .pkc { max-width: min(560px, 100%); text-align: left; }
  .pkc__head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 0.2rem 0.6rem; flex-wrap: wrap;
    font-size: 0.74rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; opacity: 0.75;
    margin: 0 0 0.35rem;
  }
  .pkc__kicker, .pkc__deal { white-space: nowrap; }
  /* the track: one slide per screen, native swipe, no scrollbar.
     ⚠️ contain: inline-size — eight 100%-wide slides otherwise give the track an
     intrinsic width of eight screens, and a shrink-to-fit parent (the phone hero,
     a centred flex column) grows to match and pushes the title off the screen. */
  .pkc__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: 100%; contain: inline-size;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    border: var(--line); box-shadow: var(--shadow-sm); background: var(--paper); color: var(--ink);
  }
  .pkc__track::-webkit-scrollbar { display: none; }
  .pkc__track:focus-visible { outline: 3px solid var(--hot); outline-offset: 2px; }
  .pkc__slide {
    scroll-snap-align: start; display: grid; grid-template-columns: 96px 1fr auto; gap: 0.8rem;
    align-items: center; padding: 0.55rem 0.8rem 0.55rem 0.55rem; text-decoration: none; color: inherit;
  }
  .pkc__slide img { width: 96px; height: 96px; display: block; border: 3px solid var(--ink); }
  .pkc__text { display: grid; gap: 0.12rem; min-width: 0; }
  .pkc__num { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.6; }
  .pkc__name { font-family: "Archivo Black", system-ui, sans-serif; font-size: 1.15rem; line-height: 1; }
  .pkc__names {
    font-size: 0.76rem; line-height: 1.3; opacity: 0.75;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .pkc__go { font-weight: 800; color: var(--hot); white-space: nowrap; font-size: 0.9rem; align-self: end; }
  .pkc__slide:hover .pkc__go { text-decoration: underline; }
  .pkc__ctl { display: flex; align-items: center; justify-content: center; gap: 0.6rem; margin-top: 0.4rem; }
  .pkc__arrow {
    width: 30px; height: 30px; border: 3px solid var(--ink); background: var(--paper); color: var(--ink);
    font-size: 1.1rem; line-height: 1; cursor: pointer; padding: 0; box-shadow: 2px 2px 0 var(--ink);
  }
  .pkc__arrow:hover { background: var(--ink); color: var(--banana); }
  .pkc__dots { display: flex; gap: 5px; }
  .pkc__dots i { width: 7px; height: 7px; border: 2px solid var(--ink); background: transparent; display: block; transform: rotate(45deg); }
  .pkc__dots i.on { background: var(--hot); }
  @media (max-width: 420px) {
    .pkc__slide { grid-template-columns: 84px 1fr; }
    .pkc__slide img { width: 84px; height: 84px; }
    .pkc__go { grid-column: 2; justify-self: end; }
    .pkc__head { font-size: 0.68rem; }
  }
</style>

<script>
  // one tiny controller per carousel: timer, arrows, dots. Swipe is the browser's.
  document.querySelectorAll<HTMLElement>('.pkc').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.pkc__track')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.pkc__slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('.pkc__dots i')];
    const place = root.dataset.place || 'carousel';
    const n = slides.length;
    let idx = 0, timer = 0, paused = false, seen = false;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // the slide about to show gets its picture now, so a rotation never lands on a blank
    const warm = (i: number) => { const img = slides[(i + n) % n]?.querySelector('img'); if (img && img.loading === 'lazy') img.loading = 'eager'; };
    const go = (i: number, smooth = true) => {
      idx = (i + n) % n;
      warm(idx); warm(idx + 1);
      track.scrollTo({ left: idx * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
    };
    const mark = () => {
      const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      if (i !== idx) idx = i;
      dots.forEach((d, k) => d.classList.toggle('on', k === idx));
    };
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(mark); }, { passive: true });
    root.querySelectorAll<HTMLButtonElement>('.pkc__arrow').forEach((b) => {
      b.addEventListener('click', () => { go(idx + Number(b.dataset.dir)); rest(); });
    });
    // the timer: 4 s a pack, only while on screen, never while a hand or a cursor is on it
    const tick = () => { if (!paused && seen && !still) go(idx + 1); };
    const start = () => { stop(); timer = window.setInterval(tick, 4000); };
    const stop = () => { if (timer) clearInterval(timer); timer = 0; };
    const rest = () => { stop(); if (!still) timer = window.setInterval(tick, 7000); };   // a nudge earns a longer pause
    ['pointerenter', 'touchstart', 'focusin'].forEach((ev) => root.addEventListener(ev, () => { paused = true; }, { passive: true }));
    ['pointerleave', 'touchend', 'focusout'].forEach((ev) => root.addEventListener(ev, () => { paused = false; }, { passive: true }));
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => { seen = es.some((e) => e.isIntersecting); }, { threshold: 0.5 }).observe(root);
    } else seen = true;
    start();
    // keep the snapped slide on resize (the track width changes)
    addEventListener('resize', () => go(idx, false));
    slides.forEach((a) => a.addEventListener('click', () => {
      const w = window as any;
      if (w.gtag) w.gtag('event', 'select_item', { item_list_name: 'packs_' + place, items: [{ item_name: a.dataset.name || '' }] });
    }));
  });
</script>
