---
// 🏳️‍🌈 the Progress Pride flag, drawn in the site's own pixel grammar (26x18 cells, crisp edges).
// It marks trymstene.com and Banana World as a safe space; the footer links it to /community/.
// Not a PixelIcon: those are one-colour glyphs, and a flag keeps its colours.
// `width` in px (default 26); the height follows the 26:18 grid.
const { width = 26 } = Astro.props;
const w = Number(width) || 26, h = Math.round(w * 18 / 26);
