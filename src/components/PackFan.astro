---
// 🎟 THE PACK FAN — the eight pack heroes as real kiss-cut stickers, laid across
// the page and gently alive. Trym, 5 Sep: "rotate and animate each sticker".
// Transforms only (compositor-cheap, never `filter`), still under
// prefers-reduced-motion, and one row on every width from 360 up — at phone
// size the stickers shrink rather than wrap, so the band stays a band.
//
//   <PackFan />              the band — the front page, the GIF page
//   <PackFan size="hero" />  the shop's top
import { HEROES, stickerSrc } from '../data/sticker-packs.js';
const { size = 'band' } = Astro.props;
// fixed, deliberate tilts — a random set would reshuffle on every build
const TILT = [-9, 6, -4, 8, -7, 5, -10, 7];
---
<div class:list={['pkfan', `pkfan--${size}`]} aria-hidden="true">
  {HEROES.map((h, i) => (
    <img class="pkfan__s" src={stickerSrc(h.slug)} alt="" width={h.w} height={h.h}
         loading={size === 'hero' ? 'eager' : 'lazy'} decoding="async"
         style={`--r:${TILT[i]}deg;--d:${(i * 0.37).toFixed(2)}s;--z:${i % 2 ? 2 : 1}`} />
  ))}
</div>

<style>
  /* ⚠️ a grid, not flex: a flex row SHRANK the images to fit the phone and
     squashed the pixel art sideways. Grid tracks take the natural width, so on
     a phone the eight become two rows of four at a size the hats still read. */
  .pkfan {
    display: grid; grid-template-columns: repeat(4, auto); justify-content: center;
    align-items: end; row-gap: 0.5rem; margin: 0 auto; max-width: 1100px; padding: 0.4rem 0;
  }
  .pkfan--band { --h: clamp(70px, 22vw, 96px); --ov: -0.7rem; }
  .pkfan--hero { --h: clamp(96px, 27vw, 130px); --ov: -0.9rem; }
  @media (min-width: 720px) {
    .pkfan { grid-template-columns: repeat(8, auto); }
    .pkfan--band { --h: clamp(90px, 10vw, 150px); }
    .pkfan--hero { --h: clamp(100px, 13vw, 160px); }
  }
  .pkfan__s {
    height: var(--h); width: auto; margin: 0 var(--ov); position: relative; z-index: var(--z);
    transform: rotate(var(--r));
    animation: pkbob 2.6s ease-in-out var(--d) infinite alternate;
  }
  .pkfan__s:hover { animation-play-state: paused; transform: rotate(0) scale(1.1); z-index: 5; }
  @keyframes pkbob {
    from { transform: rotate(var(--r)) translateY(0); }
    to   { transform: rotate(calc(var(--r) + 4deg)) translateY(-7px); }
  }
  @media (prefers-reduced-motion: reduce) { .pkfan__s { animation: none; } }
</style>
