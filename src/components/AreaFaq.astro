---
// ❓ an area's questions, under its frame (design library §37). The words are the area's copy file ({ kicker, heading,
// items: [{ q, a }] }); the page makes its FAQPage from the same list with faqLd() (src/lib/faq.js), so what a search
// engine reads is what is on the screen.
import { linkParts } from '../lib/faq.js';
const { faq } = Astro.props;
---
<section class="ag__block" id="faq">
  <p class="ag__kicker">{faq.kicker}</p>
  <h2>{faq.heading}</h2>
  <dl class="ag__faq">
    {faq.items.map((it) => (
      <Fragment><dt>{it.q}</dt><dd>{linkParts(it.a).map((p) => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}</dd></Fragment>
    ))}
  </dl>
</section>
